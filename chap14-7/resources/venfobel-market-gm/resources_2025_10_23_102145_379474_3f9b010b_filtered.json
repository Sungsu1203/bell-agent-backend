ner\").find(\"input[name=search_type]:checked\").val() == 3) {\n\t\tpopupOpen(\"https://kmdisco.org:446/INTE_SEARCH/Inte_Search.jsp?vSearchName=\" + $(\"#userSearchForm\").find(\"input[name=sc_word]\").val(), \"kmdisco\", \"1400\", \"800\");\n\t}\n}\n\nfunction popupOpen(url,id,w,h,r,s){\n\tvar popId = id;\n\tvar popUrl = url;\n\tvar screenW = window.screen.width;\n\tvar screenH = window.screen.height;\n\tvar w = (w==undefined) ? screenW : w;\n\tvar h = (h==undefined) ? screenH : h;\n\tvar lft = (screenW - w)/2;\n\tvar t = (screenH - h)/2 -50;\n\tvar popOption = \"width=\"+w+\", height=\"+h+\", left=\"+lft+\", top=\"+t+\", resizable=no, scrollbars=yes;\";\n\n\twindow.open(popUrl,id,popOption);\n}\n</script>\n\n\t\t</header>\r\n\t\t<main id=\"user-container\" class=\"user-container\">\t\t\r\n\t\t<div id=\"layer-popups\" class=\"index-width\"></div>\r\n\t\t\r\n\t\t<div class=\"position-relative index-width\"><div id=\"floating_banner_left\" class=\"view-aside left-wing\" data-scroll=\"y\" data-top-margin=\"20\" data-down-margin=\"15\" data-duration=\"300\" style=\"width:120px;\">\n<!--기사뷰SH--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/29.js?1760660382\"></script><!--//기사뷰SH--><div style=\"margin-top:5px\"></div><!--기사뷰SJ--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/31.js?1760660374\"></script><!--//기사뷰SJ--></div>\n<div id=\"floating_banner_right\" class=\"view-aside right-wing\" data-scroll=\"y\" data-top-margin=\"20\" data-down-margin=\"15\" data-duration=\"300\" style=\"width:120px;\">\n<!--기사뷰SI--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/30.js?1760660378\"></script><!--//기사뷰SI--><div style=\"margin-top:5px\"></div><!--기사뷰SK--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/32.js?1760660370\"></script><!--//기사뷰SK--><div style=\"margin-top:5px\"></div><!--기사뷰SM--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/33.js?1760660359\"></script><!--//기사뷰SM--></div>\n</