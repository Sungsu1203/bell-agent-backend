 title, url, img);\r\n\t\t}\r\n\r\n\t\t});\r\n\t});\r\n</script>\n<style>#article-view { --grid-gutter-x: 3.125rem; --grid-width: calc(var(--content-max-width) + var(--grid-side-width) + var(--grid-body-border-width)); --grid-side-width: calc(18.75rem + var(--grid-gutter-x)); --grid-body-width: calc(100% - var(--grid-side-width)); --grid-body-border-width: 1px; --grid-body-border-color: var(--nd-gray-200, #e8e8e9); /* sticky tool */ --sticky-tool-width: 3rem; --sticky-tool-gutter-x: calc((.5 * ((var(--nd-index-width, 75rem) - var(--grid-width)))) - var(--sticky-tool-width)); /* defalut size 1200px */ --sticky-tool-offset-y: 5.5rem; /* content */ --content-max-width: 778px; /* shoulder */ --nd-shoulder-display: block; --nd-shoulder-width: max-content; --nd-shoulder-max-width: 100%; --nd-shoulder-margin: 0; --nd-shoulder-padding: 0; --nd-shoulder-font-size: 1rem; --nd-shoulder-font-weight: 500; --nd-shoulder-line-height: 26px; --nd-shoulder-color: var(--nd-body-color, #000); --nd-shoulder-bg: transparent; --nd-shoulder-border: 0; --nd-shoulder-border-radius: 0; --shoulder-icon-width: 0.3125rem; --shoulder-icon-height: var(--shoulder-icon-width); --shoulder-icon-margin-x: 1.5rem; /* heading */ --nd-heading-margin-bottom: 0; --nd-heading-font-size: 2.125rem; --nd-heading-font-weight: 700; --nd-heading-line-height: 45px; --nd-heading-letter-spacing: -1px; /* subheading */ --nd-subheading-margin-bottom: 0; --nd-subheading-padding-left: 13px; --nd-subheading-font-size: 1.0625rem; --nd-subheading-font-weight: 500; --nd-subheading-line-height: 26px; --nd-subheading-border: 3px solid #151515; /* tag */ --nd-tag-font-size: 0.875rem; --nd-tag-font-weight: 400; --nd-tag-line-height: 22px; --nd-tag-color: var(--nd-dark, #212529); --nd-tag-bg: var(--nd-gray-200, #e8e8e9); --nd-tag-border: 0; --nd-tag-border-radius: 0.1875rem; --nd-tag-hover-color: var(--nd-body-color, #000); --nd-tag-hover-bg: transparent; --nd-tag-hover-border-color: transparent; --nd-tag-group-gap: 0.5rem; --nd-