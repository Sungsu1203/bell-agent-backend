=\"100%\" height=\"500\" frameBorder=\"0\"></iframe>\r\n</div><script src=\"https://cdn.medipana.com/comment/comment.js\"></script>\r\n<script>\r\n$comment.service_code\t\t= 'news';\t\t// 현재 이용 서비스 (중요!!)\r\n$comment.parent_idxno\t\t= '322553';\t\t// 댓글 부모 게시물 번호\r\n$comment.member_check\t\t= 'GUEST';\t\t// 회원여부\r\n$comment.member_nd\t\t= '';\t\t// 회원여부\r\n$comment.captcha_view\t\t= 'Y';\t\t// 캡챠 노출 (로그인 및 권한에 따른 노출 상태)\r\n$comment.bbs_table\t\t= undefined;\t\t// 게시판 테이블\r\n$comment.comment_orderby\t= 'I',\t\t// 댓글 정렬\r\n$comment.comment_page\t\t= 1,\t\t// 댓글 페이징\r\n$comment.comment_count\t\t= 0,\t\t// 댓글 총 갯수\r\n$comment.commentConfigSet();\t\t// 댓글 설정 불러오기 (중요!!)\r\n\r\n$(document).ready(function(e){\r\n\r\n\t// 댓글 정렬 변경\r\n\t$('#comment').on('click', '.btn-comment-orderby', function(e){\r\n\t\t$comment.commentList('load', $comment.comment_page, $comment.comment_orderby=$(this).data('data'));\t// 댓글 불러오기\r\n//\t\t$comment.moveScroll($comment.list_container);\t\t// 자동 스크롤 이동\r\n\t});\r\n\r\n\t// 답글 정렬 변경\r\n\t$('#comment').on('click', '.btn-sub-comment-orderby', function(e){\r\n\t\tvar reply_parent_idxno = $(this).data('idxno');\r\n\t\t$('#comment-item-'+reply_parent_idxno+'-sub .comment-sub-orderby').val($(this).data('orderby'));\r\n\t\t$comment.commentSubList(reply_parent_idxno, 'reload');\r\n//\t\t$comment.moveScroll($comment.list_container);\t\t// 자동 스크롤 이동\r\n\t});\r\n\r\n\t// 댓글 더보기\r\n\t$('#comment').on('click', '.btn-comment-more', function(e){\r\n\t\t$comment.moveScroll($(this));\t\t// 자동 스크롤 이동\r\n\t\t$comment.commentList('add', ++$comment.comment_page, $comment.comment_orderby);\t\t// 댓글 추가하기\r\n\t});\r\n\r\n\t// 댓글 쓰기\r\n\t$('#comment').on('click', '.btn-comment-save', function(e){\r\n\t\tif( $comment.textLength($(this).closest('form').find('.comment-content')) ){\t\t// 저장 이벤트 전 글자 수 체크 (스팸 방지)\r\n\t\t$comment.commentWrite($(this).closest('form'));\t\t// 댓글 저장\r\n\t\t}\r\n\t});\r\n\r\n\t// 댓글 쓰기 상단 이동 버튼 처리\r\n\t$('#comment').on('click', '.btn-comment-write', function(e){\r\n\t\t$comment.moveScroll($('.comment-write'), true);\t\t// 자동 스크롤 이동\r\n\t\t$('#comment > .comment-write .comment-content').focus();\r\n\t});\r\n\r\n\t// 댓글 작성 글자수 제한\r\n\t$('#comment').on('change keyup keydown keypress', '.comment-content', function(e){\r\n\t\t$comment.textLength($(this));\r\n\t});\r\n\r\n\t\r\n\t// 댓글 삭제 모달 열기\r\n\t$('#comment').on('click', '.btn-comment-delete', function(e){\r\n\t\tvar cmtItem = $(this).closest('.user-textbox');\r\n\r\n\t\t$comment.reveal_delete.find('.mode').val($(this).data('mode'));\r\n\t\t$comment.reveal_delete.find('.idxno').val(cmtItem.data('idxno'));\r\n\t\t$comment.reveal_delete.find('.reply-parent-idxno').val(cmtItem.data('reply-parent-idxno'));\r\n\t\t$comment.reveal_delete.find('.user-id').val(cmtItem.data('user-id'));\r\n\t\t$comment.reveal_delete.find('.password').val('');\r\n\r\n\t\t$comment.reveal_delete.foundation('open');\r\n\t});\r\n\r\n\t// 댓글 삭제 시 엔터 이벤트\r\n\t$('#comment-reveal-delete .password').keydown(function(e) {\r\n\t\tif (e.keyCode == 13) return false;\r\n\t});\r\n\r\n\t// 댓글 삭제\r\n\t$('#comment-reveal-delete').on('click', '.btn-comment-delete-ok', function(e){\r\n\t\t$comment.commentDelete($(this).closest('form'));\t\t// 댓글 삭제\r\n\t});\r\n\r\n\t// 댓글 답글 보기 / 더보기\r\n\t$('#comment').on('click', '.btn-comment-sub', function(e){\r\n\t\tvar sub_item = $(this).closest('.comment-item'),\r\n\t\treply_parent_idxno = sub_item.data('reply-parent-idxno'),\r\n\t\tsub_mode = $(this).data('sub-mode');\r\n\r\n\t\t$comment.commentSubList(reply_parent_idxno, sub_mode);\t\t// 답글 보기\r\n\t});\r\n\r\n\t// 답글 쓰기 폼 열기\r\n\t$('#comment').on('click', '.btn-comment-sub-write', function(e){\r\n\t\tvar sub_item = $(this).closest('.comment-item'),\r\n\t\tsub_write_form = sub_item.find('form[name=\"commentWriteForm\"]');\r\n\r\n\t\t$(this).hide();\r\n\t\tsub_write_form.show().find('textarea.comment-content').focus();\r\n\r\n\t\t$comment.moveScroll(sub_write_form);\t\t// 자동 스크롤 이동\r\n\t});\r\n\r\n\t// 댓글 추천/반대\r\n\t$('#comment').on('click', '.btn-comment-vote', function(e){\r\n\t\tvar cmtItem = $(this).closest('.user-vote');\r\n\t\t$comment.commentVote($(this), $(this).data('mode'), cmtItem.data('idxno'));\t\t// 댓글 추천/반대\r\n\t});\r\n\r\n\t// 댓글 작성란 비활성 이벤트\r\n\t$('#comment').on('click', '.comment-write .comment-content', function(e){\r\n\t\tif( $(this).prop('readonly') == true ){\r\n\t\tvar login_url = $(this).closest('.comment-write').find('.btn-comment-login').prop('href');\r\n\r\n\t\tif($comment.member_check == 'GUEST') location.href=login_url;\r\n\t\telse alert('댓글 작성 권한이 없습니다. 관리자에게 문의하세요');\r\n\t\t}\r\n\t});\r\n\r\n\t// 댓글 옵션 레이어 토글\r\n\t$('#comment').on('click', '.user-tb-h-del button', function(){\r\n\t\tvar optionBox = $(this).closest('.user-tb-h-del').find('.user-delete');\r\n\t\tif(optionBox.is(':visible') == false){\r\n\t\t$('.user-delete').hide();\r\n\t\toptionBox.show();\r\n\t\t} else optionBox.hide();\r\n\t});\r\n\r\n\t// 베스트 댓글 안내\r\n\t$('.cl-s-explain a').on('mouseover', function(){\r\n\t\t$(this).next('p').show();\r\n\t}).on('mouseout', function(){\r\n\t\t$(this).next('p').hide();\r\n\t});\r\n\r\n\t\t// 댓글 작성자 정보 OPEN\r\n\t$('#comment').on('click', '.user-comment-info', function(){\r\n\r\n\t\tvar infoId = $(this).closest('.comment-item').attr('id');\r\n\t\t$comment.userCommentInfo($(this).closest('.user-textbox').data('user-id'));\r\n\r\n\t\t$('html, body').addClass('block');\r\n\r\n\t\t// 댓글 작성자 정보 CLOSE\r\n\t\t$(document).on('click', '.cmt-info-block, .cmt-info-close', function(e){\r\n\r\n\t\tvar $tgPoint\t\t= $(e.target);\r\n\t\tvar $commentArea\t= $tgPoint.closest('.cmt-info'); // .hasClass('cmt-info');\r\n\t\tvar closeBool\t\t= true;\r\n\r\n\t\tif($commentArea.length) {\r\n\t\tif(!$tgPoint.hasClass('icon-close-thin')) closeBool = false;\r\n\t\t}\r\n\r\n\t\tif(closeBool) {\r\n\t\t$('html, body').removeClass('block');\r\n\t\t$('#userCommentInfo').remove();\r\n\t\t}\r\n//\t\tlocation.href='#'+infoId;\r\n\t\t});\r\n\t});\r\n\t\r\n\t$('#comment').on('click', '.my-cmt', function(e){\r\n\t\t$('#myIframeBox').attr(\"src\", \"/comment/myComment.html\");\r\n\t\t$('#myCommnetView').foundation('open');\r\n\t});\r\n});\r\n</script>\r\n\r\n\r\n\t\t</article>\r\n\t\t<aside class=\"atlview-grid-side\">\r\n\t\t<div class=\"sticky-container\" data-sticky-container>\r\n\t\t<div class=\"sticky\" data-sticky data-anchor=\"articleViewCon\" data-dynamic-height=\"true\" data-check-every=\"0\" data-margin-top=\"5\" data-sticky-on=\"large\">\r\n\t\t\r\n<!--SB 기사뷰우측1--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/18.js?1760660426\"></script><!--//SB 기사뷰우측1--><article class=\"box-skin\">\r\n<header class=\"header\"></header>\r\n<section class=\"content\"></section>\r\n</article><div class=\"box-margins \" style=\"margin-bottom:10px;\"></div><!--SG 기사뷰우측2--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/19.js?1760660422\"></script><!--//SG 기사뷰우측2--><article class=\"box-skin\">\r\n<header class=\"header\"></header>\r\n<section class=\"content\"></section>\r\n</article><div class=\"box-margins \" style=\"margin-bottom:40px;\"></div><article class=\"box-skin\">\r\n<header class=\"header\"><strong>메디파나 <span class=\"user-point\">핫</span> 클릭 뉴스</strong></header>\r\n<section class=\"content\"><style>@import url(\"https://fonts.googleapis.com/css2?family=PT+Serif&display=swap\"); #skin-91 { --frame-width: 3.975rem; --item-height: var(--frame-width); --gutter-y: 1rem; --item-border: 1px solid var(--global-border-color, #e8e8e9); --nd-atx-title-font-size: 1.063rem; --nd-atx-title-line-height: 24px; --global-border-radius: 0.1875rem; } #skin-91 > .item { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.75rem; /*min-height: var(--item-height);*/ } #skin-91 > .item::after { content: normal; } #skin-91 > .item .frame { flex: 0 0 auto; width: var(--frame-width); max-width: 100%; border-radius: 0.1875rem; } #skin-91 > .item > *:not(.frame) { flex: 1 1 0; min-width: 0; max-width: 100%