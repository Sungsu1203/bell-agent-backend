ght;    '></div>\r\n\t\t<div class='footADright fadBG' style='  background-size: 1px 100%; background-position: right;   '></div>\r\n\t\t<div class='ad'>\t\t\r\n\t\t<div class='footADClose' onclick='closeFootAD()'><img src='//www.dailypharm.com/Users/images/common/scclose.png'/></div>\r\n\t\t<a target='_blank' href='//www.dailypharm.com//Users/ADManager_2017/ADMamagerCountStat.html?ID=6882' >\r\n\t\t<img src='//pds.dailypharm.com/ADManager_2017/etc/screenview/6882.jpg?time=1761125404' border='0' style='width:100%;height:auto;'>\r\n\t\t</a>\r\n\t\t</div>\r\n\t\t\r\n\t\t<canvas id=\"canvas\" style=\"display:none;\" width=\"1240\" height=\"42\"></canvas>\r\n\r\n\r\n\r\n\t</div>\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\r\n\tconst img = document.querySelector('.footerAD .ad a img');\r\n\tlet imageUrl = img.src;\r\n\tconsole.log(imageUrl);\r\n\r\n\timg.crossOrigin = \"anonymous\";  // New line added\r\n\timg.src = imageUrl;  // Ensure this line is present\r\n\r\n     img.onload = function() {\r\n         const canvas = document.getElementById('canvas');\r\n         const context = canvas.getContext('2d');\r\n\r\n         // Set canvas dimensions to match the image\r\n         canvas.width = img.width;\r\n         canvas.height = img.height;\r\n\r\n         // Draw the image onto the canvas\r\n         context.drawImage(img, 0, 0);\r\n\r\n         // Get the image data from the canvas\r\n         const imageData = context.getImageData(0, 0, img.width, img.height);\r\n         const data = imageData.data;\r\n\r\n         // Get the first pixel (top-left corner)\r\n         const firstPixel = {\r\n             r: data[0],\r\n             g: data[1],\r\n             b: data[2],\r\n             a: data[3]\r\n         };\r\n\r\n         // Get the last pixel (bottom-right corner)\r\n         const lastPixelIndex = (img.width * img.height - 1) * 4;\r\n         const lastPixel = {\r\n             r: data[lastPixelIndex],\r\n             g: data[lastPixelIndex + 1],\r\n             b: data[lastPixelIndex + 2],\r\n             a: data[lastPixelIndex + 3]\r\n         };\r\n\r\n         // Convert to hex color code\r\n         function rgbToHex(r, g, b) {\r\n             return \"#\" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);\r\n         }\r\n\r\n         const firstPixelColor = rgbToHex(firstPixel.r, firstPixel.g, firstPixel.b);\r\n         const lastPixelColor = rgbToHex(lastPixel.r, lastPixel.g, lastPixel.b);\r\n\r\n         $(\".footADLeft\").css(\"background\",firstPixelColor)\r\n         $(\".footADright\").css(\"background\",lastPixelColor)\r\n\r\n         console.log(\"First Pixel Color:\", firstPixelColor);\r\n         console.log(\"Last Pixel Color:\", lastPixelColor);\r\n     };\r\n\r\n</script>\r\n    <!-- ScreenView -->\r\n\t<script type=\"text/javascript\">\r\n        $(\".d_commentNum\").on(\"click\", function () {\r\n            //alert(\"111\");\r\n            $('html,body').animate({ scrollTop: $(\".replySection\").offset().top }, 1000);\r\n        });\r\n    </script> \r\n\r\n    <!--<script type=\"text/javascript\" src=\"//nscreen.neoebiz.co.kr/xJqScreen.php?data=dailypharm\"></script>-->\r\n\r\n</body>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n    var viewCnt = 4;\r\n\r\n    function pageDrug (num) {\r\n        var drugSize = $(\".drugTable\").find(\".drugInfo\").size();\r\n        for (var i = 0; i < drugSize; i++) {\r\n            if (i > num) {\r\n                $(\".drugTable\").find(\".drugInfo\").eq(i).hide();\r\n            }\r\n        }\r\n\r\n    }\r\n\r\n    function drugLeft () {\r\n        var drugSize = $(\".drugTable\").find(\".drugInfo\").size();\r\n        for (var i = 0; i <= viewCnt; i++) {\r\n            $(\".drugTable\").find(\".drugInfo\").eq(drugSize - 1).after($(\".drugTable\").find(\".drugInfo\").eq(0));\r\n        }\r\n        pageDrug(viewCnt);\r\n        for (var i = 0; i <= viewCnt; i++) {\r\n            $(\".drugTable\").find(\".drugInfo\").eq(i).