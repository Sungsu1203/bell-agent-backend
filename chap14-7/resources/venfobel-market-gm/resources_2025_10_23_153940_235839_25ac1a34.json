sm\">\n\t\t<input type=\"hidden\" name=\"news_search_type\" value=\"1\">\n\t\t<label class=\"show-for-sr\" for=\"search\">기사검색</label>\n\t\t\n\t\t<input type=\"text\" name=\"sc_word\" id=\"search\" class=\"gl-search-input\" onkeydown=\"if(event.keyCode==13){if(this.form.sc_word.value != ''){news_search();}else{alert('검색어를 입력해주세요');return false;}}\" placeholder=\"검색어를 입력해주세요\" title=\"기사검색\">\n\t\t<button type=\"button\" class=\"gl-search-btn\" aria-label=\"기사검색\" onclick=\"if(this.form.sc_word.value != ''){news_search();}else{alert('검색어를 입력해주세요');this.form.sc_word.focus();return false;}\"><i class=\"icon-search-thin\"></i></button>\n\t\t</form>\n\t\t</div>\n\t\t</div>\n\t\t<!--// 검색 -->\n\t</div>\n\t\n\n</nav>\n<!--// 메뉴바 -->\n\n<!-- 기사리스트 //-->\n\n<script>\n// search opener\n$(function(){\n\tconst GL_SEARCH = $(\".gl-search-container\");\n\tGL_SEARCH.on(\"click\", \".gl-search-action\", function(e) {\n\t\tconst _parent = $(e.delegateTarget);\n\n\t\tif(_parent.hasClass(\"is-active\")) {\n\t\t_parent.removeClass(\"is-active\");\n\t\t} else {\n\t\t_parent.addClass(\"is-active\").find(\".gl-search-input\").focus();\n\t\t}\n\t});\n});\n\nfunction news_search() {\n\tif ($(\".gl-search-container\").find(\"input[name=search_type]:checked\").val() == 1) {\n\t\t$(\"#userSearchForm\").submit();\n\t} else if ($(\".gl-search-container\").find(\"input[name=search_type]:checked\").val() == 2) {\n\t\tpopupOpen(\"https://www.health.kr/drug_info/_dreamdrug/drug_list.asp?search_type=combined&search_keyword=\" + $(\"#userSearchForm\").find(\"input[name=sc_word]\").val(), \"health\", \"1400\", \"800\");\n\t} else if ($(\".gl-search-container\").find(\"input[name=search_type]:checked\").val() == 3) {\n\t\tpopupOpen(\"https://kmdisco.org:446/INTE_SEARCH/Inte_Search.jsp?vSearchName=\" + $(\"#userSearchForm\").find(\"input[name=sc_word]\").val(), \"kmdisco\", \"1400\", \"800\");\n\t}\n}\n\nfunction popupOpen(url,id,w,h,r,s){\n\tvar popId = id;\n\tvar popUrl = url;\n\tvar screenW = window.screen.width;\n\tvar screenH = window.screen.height;\n\tvar w = (w==undefined) ? screenW : w;\n\tvar h = (h==undefined) ? screenH : h;\n\tvar lft = (screenW - w)/2;\n\tvar t = (screenH - h)/2 -50;\n\tvar popOption = \"width=\"+w+\", height=\"+h+\", left=\"+lft+\", top=\"+t+\", resizable=no, scrollbars=yes;\";\n\n\twindow.open(popUrl,id,popOption);\n}\n</script>\n\n\t\t</header>\r\n\t\t<main id=\"user-container\" class=\"user-container\">\t\t\r\n\t\t<div id=\"layer-popups\" class=\"index-width\"></div>\r\n\t\t\r\n\t\t<div class=\"position-relative index-width\"><div id=\"floating_banner_left\" class=\"view-aside left-wing\" data-scroll=\"y\" data-top-margin=\"20\" data-down-margin=\"15\" data-duration=\"300\" style=\"width:120px;\">\n<!--기사뷰SH--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/29.js?1760660382\"></script><!--//기사뷰SH--><div style=\"margin-top:5px\"></div><!--기사뷰SJ--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/31.js?1760660374\"></script><!--//기사뷰SJ--></div>\n<div id=\"floating_banner_right\" class=\"view-aside right-wing\" data-scroll=\"y\" data-top-margin=\"20\" data-down-margin=\"15\" data-duration=\"300\" style=\"width:120px;\">\n<!--기사뷰SI--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/30.js?1760660378\"></script><!--//기사뷰SI--><div style=\"margin-top:5px\"></div><!--기사뷰SK--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/32.js?1760660370\"></script><!--//기사뷰SK--><div style=\"margin-top:5px\"></div><!--기사뷰SM--><script src=\"https://cdn.medipana.com/bannerpop/uploads/js_multi/33.js?1760660359\"></script><!--//기사뷰SM--></div>\n</div>\t\t\r\n\t\t<div class=\"position-relative index-width\" id=\"wingBanner\">\r\n\t\t<div class=\"wing-banner-left\">\r\n\t\t</div>\r\n\t\t<div class=\"wing-banner-right\">\r\n\t\t</div>\r\n\t\t</div>\r\n<script src=\"https://cdn.medipana.com/script/share.sns.js\"></script>\r\n<script>\r\n\tvar site_ismobile\t\t= '';\t\t// 현재 모바일접속 여부\r\n\tvar kakaojavascriptkey\t= 'fa22c5c4c34e5a1f4d6d25fcddfdbc37';\t// 카카오앱 자바스크립트키\r\n\tvar articleIdxno\t\t= '293250';\r\n\tvar snsKakaoSend\t\t= function(sns, url, title, desc, img){\t\t// kakao용 함수\r\n\t\tif(sns == \"kakao\") {\r\n\t\tsendKakaoTalk(url, title, desc, img);\r\n\t\t}else if(sns == \"kakaostory\") {\r\n\t\tshareStory(url, title, desc, img);\r\n\t\t}\r\n\t\t};\r\n\r\n\t$(document).ready(function(e) {\r\n\t\t\r\n\t\t$('button.sns-share-btns').on('click', function(e) {\r\n\t\tvar sns\t\t= $(this).data('sharesns');\r\n\t\tvar title\t= $(this).data('title');\r\n\t\tvar desc\t= $(this).data('desc');\r\n\t\tvar url\t\t= $(this).data('url');\r\n\t\tvar img\t\t= $(this).data('image');\r\n\r\n\t\tif(sns == \"link\") return true;\r\n\r\n\t\t// SNS 공유 통계 집계 (공유하기에 영향을 주지않도록 체크하지는 않음)\r\n\t\tsnsShareStats(articleIdxno, sns);\r\n\r\n\t\tif($.inArray(sns, [\"kakao\",\"kakaostory\"])>=0){\r\n\t\t// kakao가 이미 로딩 되었다면 실행 or not, url 로딩 시킴\r\n\t\tif(\"Kakao\" in window) snsKakaoSend(sns, url, title, desc, img);\r\n\t\telse{\r\n\t\tvar script=document.createElement(\"script\");\r\n\t\tscript.src=\"//developers.kakao.com/sdk/js/kakao.min.js\";\r\n\t\tscript.onload=function(e){\r\n\t\tif(kakaojavascriptkey){\r\n\t\tkakaoinit(kakaojavascriptkey);\r\n\t\tsnsKakaoSend(sns, url, title, desc, img);\r\n\t\t}\r\n\t\t};\r\n\t\tscript.onerror=function(e){};\r\n\r\n\t\tdocument.querySelector(\"head\").appendChild(script);\r\n\t\t}\r\n\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\tif(sns == \"band\") {\r\n\t\tshareBand(url, title);\r\n\t\t}else if(sns == \"telegram\") {\r\n                shareTelegram(url, title);\r\n\t\t}else{\r\n\t\tshareOtherSNS(sns, title, url, img);\r\n\t\t}\r\n\r\n\t\t});\r\n\t});\r\n</script>\n<style>#article-view { --grid-gutter-x: 3.125rem; --grid-width: calc(var(--content-max-width) + var(--grid-side-width) + var(--grid-body-border-width)); --grid-side-width: calc(18.75rem + var(--grid-gutter-x)); --grid-body-width: calc(100% - var(--grid-side-width)); --grid-body-border-wi