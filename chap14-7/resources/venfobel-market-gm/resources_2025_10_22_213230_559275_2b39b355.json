\"\" />\r\n\t\t</article>\r\n\t\t</header>\r\n\r\n\t\t<label for=\"cmtContent\" class=\"show-for-sr\">댓글 내용입력</label>\r\n\t\t<textarea name=\"content\" title=\"댓글 내용입력\" id=\"cmtContent\" class=\"comment-content\" placeholder=\"권리침해, 욕설 및 특정 대상을 비하하는 내용을 게시할 경우 이용약관 및 관련법률에 의해 제재될 수 있습니다. 회원 로그인을 하시면 댓글 작성이 간편합니다.\" ></textarea>\r\n\t\t<div class=\"recaptcha-container\"></div>\r\n\t\t\r\n\t\t<footer class=\"wrt-footer\">\r\n\t\t<span class=\"cur--length\"><strong class=\"comment-text-cur\">0</strong> / 400</span>\r\n\t\t<button type=\"button\" class=\"btn-comment-save\">등록</button>\r\n\t\t</footer>\r\n\t\t</form>\r\n\t</article>\r\n\t<!--// write -->\r\n\r\n\t<!-- list //-->\r\n\t<article id=\"comment-list\">\r\n\t\t<header class=\"list-sort\">\r\n\t\t<div class=\"show-for-sr\">댓글 정렬</div>\r\n\t\t<div class=\"option\">\r\n\t\t<button type=\"button\" data-data=\"I\" class=\"btn-comment-orderby btn-comment-orderby-I\">최신순</button>\r\n\t\t<button type=\"button\" data-data=\"C\" class=\"btn-comment-orderby btn-comment-orderby-C\">추천순</button>\r\n\t\t<button type=\"button\" data-data=\"R\" class=\"btn-comment-orderby btn-comment-orderby-R\">답글순</button>\r\n\t\t</div>\r\n\t\t<div class=\"explain\">\r\n\t\t<div role=\"button\" class=\"explain-btn\" data-toggle=\"guide-panel\"><i class=\"icon-info-o\"></i> BEST댓글</div>\r\n\t\t<div id=\"guide-panel\" class=\"guide\" data-toggler data-animate=\"fade-in fade-out\" data-closable>\r\n\t\t<strong>BEST 댓글</strong>\r\n\t\t답글과 추천수를 합산하여 자동으로 노출됩니다.\r\n\t\t<button class=\"close-button\" data-close><i class=\"icon-close-thin\"><span class=\"show-for-sr\">닫기</span></i></button>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</header>\r\n\r\n\t\t<section class=\"best-content\">\r\n\t\t<!-- BEST 댓글 -->\r\n\t\t</section>\r\n\r\n\t\t<section class=\"normal-content\">\r\n\t\t<!-- 기본 댓글 -->\r\n\t\t</section>\r\n\r\n\t\t<button type=\"button\" class=\"btn-comment-more\"><span>더보기</span></button>\r\n\t</article>\r\n\t<!--// list -->\r\n</article>\r\n<!--// 댓글 -->\r\n\r\n<!-- 댓글삭제 //-->\r\n<form class=\"reveal comment-form\" id=\"comment-reveal-delete\" name=\"commentDeleteForm\" method=\"POST\" data-reveal data-close-on-click=\"false\" data-close-on-esc=\"false\" data-animation-in=\"fade-in\" data-animation-out=\"fade-out\">\r\n\t<input type=\"hidden\"\tclass=\"service-name\"\t\tname=\"service_code\"\t\tvalue=\"news\" />\r\n\t<input type=\"hidden\"\tclass=\"table-name\"\t\tname=\"table_name\"\t\tvalue=\"article_reply\" />\r\n\t<input type=\"hidden\"\tclass=\"parent-idxno\"\t\tname=\"parent_idxno\"\t\tvalue=\"327259\" />\r\n\t<input type=\"hidden\"\tclass=\"mode\"\t\tname=\"mode\"\t\tvalue=\"\" />\r\n\t<input type=\"hidden\"\tclass=\"idxno\"\t\tname=\"idxno\"\t\tvalue=\"\" />\r\n\t<input type=\"hidden\"\tclass=\"reply-parent-idxno\"\t\tname=\"reply_parent_idxno\"\tvalue=\"\" />\r\n\t<input type=\"hidden\"\tclass=\"user-id\"\t\tname=\"user_id\"\t\tvalue=\"\" />\r\n\t\t<input type=\"hidden\" name=\"referer\" value=\"\" /> <!--// 접근 페이지 확인 (v11-fl-v2) -->\r\n\t\r\n\t<header class=\"reveal-header\">\r\n\t\t<div class=\"reveal-title\">댓글삭제</div>\r\n\t\t<button class=\"reveal-close\" data-close aria-label=\"Close modal\" type=\"button\"></button>\r\n\t</header>\r\n\t<section class=\"reveal-container\">\r\n\t\t<div class=\"vstack gap-3\">\r\n\t\t<div class=\"reveal-msg\">\r\n\t\t삭제한 댓글은 다시 복구할 수 없습니다.<br>\r\n\t\t그래도 삭제하시겠습니까?\r\n\t\t</div>\r\n\r\n\t\t<fieldset id=\"delete-password-field\" class=\"row expanded small-collapse medium-uncollapse\">\r\n\t\t<div class=\"medium-3 columns\">\r\n\t\t<label for=\"removePassword\" class=\"medium-middle\"><strong class=\"key-point\">비밀번호</strong></label>\r\n\t\t</div>\r\n\t\t<div class=\"medium-9 columns\">\r\n\t\t<input type=\"password\" name=\"password\" class=\"password\" id=\"removePassword\" title=\"비밀번호\" placeholder=\"비밀번호 입력\" class=\"\">\r\n\t\t</div>\r\n\t\t</fieldset>\r\n\t\t</div>\r\n\t</section>\r\n\t<footer class=\"reveal-footer\">\r\n\t\t<button type=\"button\" class=\"button btn-comment-delete-ok\"><i class=\"icon-trash-o\"></i>&nbsp;삭제</button>\r\n\t</footer>\r\n</form>\r\n<!--// 댓글삭제 -->\r\n\r\n<!-- 댓글수정 //-->\r\n<form class=\"reveal comment-form\" id=\"comment-reveal-modify\" name=\"commentModifyForm\" method=\"POST\" data-reveal data-close-on-click=\"false\" data-close-on-esc=\"false\" data-animation-in=\"fade-in\" data-animation-out=\"fade-out\">\r\n\t<input type=\"hidden\"\tclass=\"service-name\"\t\tname=\"service_code\"\t\tvalue=\"news\" />\r\n\t<input type=\"hidden\"\tclass=\"table-name\"\t\tname=\"table_name\"\t\tvalue=\"article_reply\" />\r\n\t<input type=\"hidden\"\tclass=\"parent-idxno\"\t\tname=\"parent_idxno\"\t\tvalue=\"327259\" />\r\n\t<input type=\"hidden\"\tclass=\"mode\"\t\tname=\"mode\"\t\tvalue=\"\" />\r\n\t<input type=\"hidden\"\tclass=\"idxno\"\t\tname=\"idxno\"\t\tvalue=\"\" />\r\n\t<input type=\"hidden\"\tclass=\"reply-parent-idxno\"\t\tname=\"reply_parent_idxno\"\tvalue=\"\" />\r\n\t<input type=\"hidden\"\tclass=\"user-id\"\t\tname=\"user_id\"\t\tvalue=\"\" />\r\n\t\t<header class=\"reveal-header\">\r\n\t\t<div class=\"reveal-title\">댓글수정</div>\r\n\t\t<button class=\"reveal-close\" data-close aria-label=\"Close modal\" type=\"button\"></button>\r\n\t</header>\r\n\r\n\t<section class=\"reveal-container\">\r\n\t\t<div class=\"vstack gap-3\">\r\n\t\t<div class=\"reveal-msg\">\r\n\t\t댓글 수정은 작성 후 1분내에만 가능합니다.\r\n\t\t</div>\r\n\t\t<!-- 본문 //-->\r\n\t\t<fieldset class=\"row expanded small-collapse medium-uncollapse\">\r\n\t\t<div class=\"medium-3 columns\">\r\n\t\t<label for=\"modiifyContent\" class=\"medium-middle\"><strong class=\"key-point\">본문</strong></label>\r\n\t\t<div class=\"size-12\">\r\n\t\t<span class=\"comment-text-cur\"></span> / 400\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"medium-9 columns\">\r\n\t\t<textarea name=\"modify_content\" class=\"modiify-content\" id=\"modiifyContent\" rows=\"10\"></textarea>\r\n\t\t</div>\r\n\t\t</fieldset>\r\n\t\t<!--// 본문 -->\r\n\r\n\t\t<!-- 비밀번호 //-->\r\n\t\t<fieldset id=\"modify-password-field\" class=\"row expanded small-collapse medium-uncollapse\">\r\n\t\t<div class=\"medium-3 columns\">\r\n\t\t<label for=\"modifyPassword\" class=\"medium-middle\"><strong class=\"key-point\">비밀번호</strong></label>\r\n\t\t</div>\r\n\t\t<div class=\"medium-9 columns\">\r\n\t\t<input type=\"password\" name=\"password\" class=\"password\" id=\"modifyPassword\" title=\"비밀번호\" placeholder=\"비밀번호 입력\" class=\"\">\r\n\t\t</div>\r\n\t\t</fieldset>\r\n\t\t<!--// 비밀번호 -->\r\n\t\t</div>\r\n\t</section>\r\n\t<footer class=\"reveal-footer\">\r\n\t\t<button type=\"button\" class=\"button btn-comment-modify-ok\"><i class=\"icon-trash-o\"></i>&nbsp;수정</button>\r\n\t</footer>\r\n</form>\r\n<!--// 댓글수정 -->\r\n\r\n<!-- 유저댓글모음 //-->\r\n<div class=\"user-comment-info-view\"></div>\r\n<!--// 유저댓글모음 -->\r\n\r\n<!-- 나의 댓글모음 //-->\r\n<div class=\"reveal large pad-0\" id=\"myCommnetView\" data-reveal data-close-on-click=\"false\" data-close-on-esc=\"false\" data-animation-in=\"fade-in\" data-animation-out=\"fade-out\">\r\n\t<article class=\"view-header\">\r\n\t\t<div class=\"titles\">내 댓글 모음</div>\r\n\t\t<button type=\"button\" class=\"close\" data-close><i class=\"icon-close-thin\"><span class=\"show-for-sr\">닫기</span></i></button>\r\n\t</article>\r\n\t<iframe id=\"myIframeBox\" src=\"about:blank\" width=\"100%\" height=\"500\" frameBorder=\"0\"></iframe>\r\n</div><script src=\"https://cdn.medipana.com/comment/comment.js\"></script>\r\n<script>\r\n$comment.service_code\t\t= 'news';\t\t// 현재 이용 서비스 (중요!!)\r\n$comment.parent_idxno\t\t= '327259';\t\t// 댓글 부모 게시물 번호\r\n$comment.member_check\t\t= 'GUEST';\t\t// 회원여부\r\n$comment.member_nd\t\t= '';\t\t// 회원여부\r\n$comment.captcha_view\t\t= 'Y';\t\t// 캡챠 노출 (로그인 및 권한에 따른 노출 상태)\r\n$comment.bbs_table\t\t= undefined;\t\t// 게시판 테이블\r\n$comment.comment_orderby\t= 'I',\t\t// 댓글 정렬\r\n$comment.comment_page\t\t= 1,\t\t// 댓글 페이징\r\n$comment.comment_count\t\t= 0,\t\t// 댓글 총 갯수\r\n$comment.commentConfigSet();\t\t// 댓글 설정 불러오기 (중요!!)\r\n\r\n$(document).ready(function(e){\r\n\r\n\t// 댓글 정렬 변경\r\n\t$('#comment').on('click', '.btn-comment-orderby', function(e){\r\n\t\t$comment.commentList('load', $comment.comment_page, $comment.comment_orderby=$(this).data('data'));\t// 댓글 불러오기\r\n//\t\t$comment.moveScroll($comment.list_container);\t\t// 자동 스크롤 이동\r\n\t});\r\n\r\n\t// 답글 정렬 변경\r\n\t$('#comment').on('click', '.btn-sub-comment-orderby', function(e){\r\n\t\tvar reply_parent_idxno = $(this).data('idxno');\r\n\t\t$('#comment-item-'+reply_parent_idxno+'-sub .comment-sub-orderby').val($(this).data('orderby'));\r\n\t\t$comment.commentSubList(reply_parent_idxno, 'reload');\r\n//\t\t$comment.moveScroll($comment.list_container);\t\t// 자동 스크롤 이동\r\n\t});\r\n\r\n\t// 댓글 더보기\r\n\t$('#comment').on('click', '.btn-comment-more', function(e){\r\n\t\t$comment.moveScroll($(this));\t\t// 자동 스크롤 이동\r\n\t\t$comment.commentList('add', ++$comment.comment_page, $comment.comment_orderby);\t\t// 댓글 추가하기\r\n\t});\r\n\r\n\t// 댓글 쓰기\r\n\t$('#comment').on('click', '.btn-comment-save', function(e){\r\n\t\tif( $comment.textLength($(this).closest('form').find('.comment-content')) ){\t\t// 저장 이벤트 전 글자 수 체크 (스팸 방지)\r\n\t\t$comment.commentWrite($(this).closest('form'));\t\t// 댓글 저장\r\n\t\t}\r\n\t});\r\n\r\n\t// 댓글 쓰기 상단 이동 버튼 처리\r\n\t$('#comment').on('click', '.btn-comment-write', function(e){\r\n\t\t$comment.moveScroll($('.comment-write'), true);\t\t// 자동 스크롤 이동\r\n\t\t$('#comment > .comment-write .comment-content').focus();\r\n\t});\r\n\r\n\t// 댓글 작성 글자수 제한\r\n\t$('#comment').on('change keyup keydown keypress', '.comment-content', function(e){\r\n\t\t$comment.textLength($(this));\r\n\t});\r\n\r\n\t\r\n\t// 댓글 삭제 모달 열기\r\n\t$('#comment').on('click', '.btn-comment-delete', function(e){\r\n\t\tvar cmtItem = $(this).closest('.user-textbox');\r\n\r\n\t\t$comment.reveal_delete.find('.mode').val($(this).data('mode'));\r\n\t\t$comment.reveal_delete.find('.idxno').val(cmtItem.data('idxno'));\r\n\t\t$comment.reveal_delete.find('.reply-parent-idxno').val(cmtItem.data('reply-parent-idxno'));\r\n\t\t$comment.reveal_delete.find('.user-id').val(cmtItem.data('user-id'));\r\n\t\t$comment.reveal_delete.find('.password').val('');\r\n\r\n\t\t$comment.reveal_delete.foundation('open');\r\n\t});\r\n\r\n\t// 댓글 삭제 시 엔터 이벤트\r\n\t$('#comment-reveal-delete .password').keydown(function(e) {\r\n\t\tif (e.keyCode == 13) return false;\r\n\t});\r\n\r\n\t// 댓글 삭제\r\n\t$('#comment-reveal-delete').on('click', '.btn-comment-delete-ok', function(e){\r\n\t\t$comment.commentDelete($(this).closest('form'));\t\t// 댓글 삭제\r\n\t});\r\n\r\n\t// 댓글 답글 보기 / 더보기\r\n\t$('#comment').on('click', '.btn-comment-sub', function(e){\r\n\t\tvar sub_item = $(this).closest('.comment-item'),\r\n\t\treply_parent_idxno = sub_item.data('reply-parent-idxno'),\r\n\t\tsub_mode = $(this).data('sub-mode');\r\n\r\n\t\t$comment.commentSubList(reply_parent_idxno, sub_mode);\t\t// 답글 보기\r\n\t});\r\n\r\n\t// 답글 쓰기 폼 열기\r\n\t$('#comment').on('click', '.btn-comment-sub-write', function(e){\r\n\t\tvar sub_item = $(this).closest('.comment-item'),\r\n\t\tsub_write_form = sub_item.find('form[name=\"commentWriteForm\"]');\r\n\r\n\t\t$(this).hide();\r\n\t\tsub_write_form.show().find('textarea.comment-content').focus();\r\n\r\n\t\t$comment.moveScroll(sub_write_form);\t\t// 자동 스크롤 이동\r\n\t});\r\n\r\n\t// 댓글 추천/반대\r\n\t$('#comment').on('click', '.btn-comment-vote', function(e){\r\n\t\tvar cmtItem = $(this).closest('.user-vote');\r\n\t\t$comment.commentVote($(this), $(this).data('mode'), cmtItem.data('idxno'));\t\t// 댓글 추천/반대\r\n\t});\r\n\r\n\t// 댓글 작성란 비활성 이벤트\r\n\t$('#comment').on('click', '.comment-write .comment-content', function(e){\r\n\t\tif( $(this).prop('readonly') == true ){\r\n\t\tvar login_url = $(this).closest('.comment-write').find('.btn-comment-login').prop('href');\r\n\r\n\t\tif($comment.member_check == 'GUEST') location.href=login_url;\r\n\t\telse alert('댓글 작성 권한이 없습니다. 관리자에게 문의하세요');\r\n\t\t}\r\n\t});\r\n\r\n\t// 댓글 옵션 레이어 토글\r\n\t$('#comment').on('click', '