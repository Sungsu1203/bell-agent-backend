=\\\"link-btn color-blue\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201213660554224\\\" data-log-no=\\\"202510223044754017\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t}\r\n\t\t}\r\n\t\t$(\".abstract-word-box dd:eq(2) .jum-ul\").append(\"<li><a class=\\\"oneline src-list \"+selClass+\"\\\" href=\\\"#\\\" data-word-id=\\\"\"+wordDcId+\"\\\">\"+prefix +\" \" +value.title+\"</a>\"+src+\"</li>\");\r\n\t\t$(\".abstract-word-box dd:eq(3)\").append(\"<div class=\\\"desc-word \"+noneClass+\"\\\" id=\\\"word_\"+wordDcId+\"\\\"><div class=\\\"scrollbox\\\" style=\\\"max-height: 140px;\\\">\"+wordDc+\"</div>\");\r\n\t\t});\r\n\t\t/* if($('#ftDd dd').text() =='PCR'){\r\n\t\t$('#cDd dt span').text('(6)');\r\n\t\tvar newLi1 = `\r\n\t\t    <li class=\"active\" id=\"fView\">\r\n\t\t        <a href=\"javascript:void(0);\" class=\"oneline\">[논문] Real-time PCR과 Colony forming unit법을 이용한 타액 내 2종의 구강미생물 총량분석</a>\r\n\t\t        <a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t    </li>`;\r\n\r\n\t\tvar newLi2 = `\r\n\t\t    <li id=\"sView\">\r\n\t\t        <a href=\"javascript:void(0);\" class=\"oneline\">[논문] 강인성을 개선한 VANET에서의 자율 TDMA</a>\r\n\t\t        <a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t    </li>`;\r\n \r\n\t\t$('#cDd .jum-ul').append(newLi1+newLi2);\r\n\t\t$('#lDd dd').text(\"PCR은 세균 특이성이 있는 primer를 이용하여 적은 수의 세균이 있을지라도 쉽게 검출할 수 있는 유용한 방법이며, 이를 이용하여 구강 내 치면세균막이나 타액에서 직접 세균을 검출할 수 있게 되었다[8].\");\r\n\t\t\r\n\t\t} */\r\n\t\t$(\".abstract-word-box dt:eq(2) span\").text(\" (\"+wordDesList.length+\")\");\r\n\r\n\r\n\r\n\t\tif(scroll){\r\n\t\tvar idx = $(\"#abstractWord .list_wrap .list li a.on\").closest(\"li\").in