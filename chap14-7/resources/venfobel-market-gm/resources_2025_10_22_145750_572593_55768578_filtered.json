;\r\n\t}\r\n\r\n\tfunction searchTag2(keyword, srchType){\r\n\t\t//$('.wrap-loading').removeClass('hidden');\r\n\t\tdocument.searchForm.searchKeyword.value = keyword;\r\n\t\tif(keyword == \"COVID-19 | Coronavirus\"){\r\n\t\tdocument.searchForm.action = \"/srch/selectPORSrchTotal.do?linkYn=Y&useContCd=0008&linkURL=/srch/selectPORSrchTotal.do\";\r\n\t\t}else{\r\n\t\tdocument.searchForm.action = \"/srch/selectPORSrchTotal.do\";\r\n\r\n\t\t}\r\n\t\tinsertBhvrLog({'bhvrNo' : '365','evntNo' : '01', 'param' : keyword ,'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\r\n\t\t// 2024.08.06 추가\r\n\t\tsetSrchCookie3(keyword, srchType);\r\n\r\n\t\tdocument.searchForm.target = keyword;\r\n\t\tdocument.searchForm.submit();\r\n\t\tdocument.searchForm.searchKeyword.value = \"\";\r\n\t}\r\n\r\n\tfunction fn_apigatewayLogout(){\r\n\t\t//TODO API Gateway URL 변경 시 수정 필요\r\n\r\n\t\tvar apigatewayUrl = \"\";\r\n\t\tvar scienceOnUrl = \"\";\r\n\t\t \r\n\r\n\t\t\r\n\t\t//fn_CallURL(apigatewayUrl+\"/api/auth/logoutSO.do\");\r\n\r\n\t\t\r\n\t\tfn_CallURL(scienceOnUrl+\"/api/auth/logoutSO.do\");\r\n\t\t\r\n\t}\r\n\t//로그아웃\r\n\tfunction fn_logout() {\r\n\t\tfn_apigatewayLogout();\r\n\t\t//NDSL로그아웃\r\n// \tvar src='https://www.ndsl.kr/ndsl/ajax/commons/logout.do';\r\n// \t$('#hiddenCookie').attr('src',src);\r\n\r\n// \tvar src2='https://ndsl.kr/ndsl/ajax/commons/logout.do';\r\n// \t$('#hiddenCookie2').attr('src',src2);\r\n\r\n\t\t/*setTimeout(function() {\r\n            window.location.href = \"/auth/logout.do\";\r\n        }, 400);\r\n        */\r\n\r\n\t\t$.ajax({\r\n\t\turl: '/auth/logoutAjax.do',\r\n\t\tdataType: 'html',\r\n\t\ttype: 'post',\r\n\t\tsuccess: function(data){\r\n\t\tif(data == \"success\"){\r\n\t\twindow.location.reload();\r\n\t\t}else{\r\n\t\twindow.location.href = \"/auth/logout.do\";\r\n\t\t}\r\n\t\t},\r\n\t\terror:function(request, status,error){\r\n\t\twindow.location.href = \"/auth/logout.do\";\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\tfunction selectLang(lang){\r\n\t\tconst langBox = document.querySelector('#language-select');\r\n\t\tlangBox.value = lang; // 변경할 언어 적용\r\n\t\tlangBox.dispatchEvent(new Event('change'));\r\n\t}\r\n</script>\r\n<style type=\"text/css\">\r\n\t#header .gnb .active{\r\n\t\tcolor: var(--color-blue);\r\n\t\tfont-weight: var(--font-weight-semibold);\r\n\t}\r\n</style>\r\n<!-- 현url정보 -->\r\n\r\n\r\n<!-- 상담 헤더 { -->\r\n<header id=\"header\" class=\"flex-spacebetween\">\r\n\t<div class=\"header_tit\">\r\n\t\t<div class=\"top-head-left\">\r\n\t\t<button class=\"mnu-on-btn all-mnu-btn\"><i class=\"far fa-bars\"></i></button>\r\n\t\t</div>\r\n\t\t<h1><a href=\"/main/mainForm.do\" id=\"goHome\"><img src=\"/newUI/img/common/logo.svg\" alt=\"ScienceON 로고\"/></a></h1>\r\n\t</div>\r\n\t<nav class=\"gnb\">\r\n\t\t<ul class=\"flex-center\">\r\n\t\t<li>\r\n\t\t<a href=\"/por/lvls/selectGroupSearchInfo.do\" class=\"gnb-1a infra\">지식인프라</a>\r\n\t\t<aside class=\"sub-gnbbox\">\r\n\t\t<div class=\"inner respon flex-spacebetween\">\r\n\t\t<div class=\"gnb-1a-txt flex-start\">\r\n\t\t<span class=\"ico\"><i class=\"fas fa-sitemap\"></i></span>\r\n\t\t<dl class=\"txt-box\">\r\n\t\t<dt>지식인프라</dt>\r\n\t\t<dd>연구 활동에 필요한 과학기술정보·데이터, 슈퍼컴퓨팅 자원, 정보분석 도구 등을 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</div>\r\n\t\t<ul class=\"gnb-2a-mnu\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/por/lvls/selectGroupSearchInfo.do\" class=\"gnb-2a\"><em>지식인프라 전체보기</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>지식인프라 전체보기</dt>\r\n\t\t<dd>연구 활동에 필요한 과학기술 지식인프라를 <br/>데이터 유형, 연구단계, 이용목적별로 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/upki/selectUpkiList.do\" class=\"gnb-2a\"><em>이용목적별 지식인프라</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>이용목적별 지식인프라</dt>\r\n\t\t<dd>이용자의 소속 유형과 활용 목적에 적합한<br/> 과학기술 지식인프라를 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/snar/selectPORSnarList.do\" class=\"gnb-2a\"><em>활용 시나리오</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>활용 시나리오</dt>\r\n\t\t<dd>인프라 기능들 사이에 목적별 워크플로우를 구성하여 과학기술 지식인프라 이용에 도움을 드리려고 합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t<aside class=\"subM-gnbbox\" id=\"infra\">\r\n\t\t<div>\r\n\t\t<ul class=\"flex-center\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/por/lvls/selectGroupSearchInfo.do\" class=\"gnb-2a\" id=\"infra_total\"><em>지식인프라 전체보기</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/upki/selectUpkiList.do\" class=\"gnb-2a\" id=\"infra_purpose\"><em>이용목적별 지식인프라</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/snar/selectPORSnarList.do\" class=\"gnb-2a\" id=\"infra_use\"><em>활용 시나리오</em></a>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/aiq/mlsh3/selectAIQMlshList.do\" class=\"gnb-1a analyze\">지능형 분석</a>\r\n\t\t<aside class=\"sub-gnbbox\">\r\n\t\t<div class=\"inner respon flex-spacebetween\">\r\n\t\t<div class=\"gnb-1a-txt flex-start\">\r\n\t\t<span class=\"ico\"><i class=\"fas fa-chart-bar\"></i></span>\r\n\t\t<dl class=\"txt-box\">\r\n\t\t<dt>지능형 분석</dt>\r\n\t\t<dd>과학기술정보데이터, 슈퍼컴퓨팅활용, 정보분석 등<br/> 연구자들이 언제 어디서나 활용할 수 있도록 지원합니다.</dd>\r\n\t\t</dl>\r\n\t\t</div>\r\n\t\t<ul class=\"gnb-2a-mnu\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/aiq/mlsh3/selectAIQMlshList.do\" class=\"gnb-2a\"><em>논문요약・번역: AI-Helper</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>논문요약・번역: AI-Helper</dt>\r\n\t\t<dd>논문의 문장분류를 기반으로 AI 요약 서비스를<br/> 제공하고 있으며, 딥러닝 AI 모델을 통해 연구주제,<br/> 연구방법, 연구결과에 대한 문장분류 태그를<br/> 자동으로 구축하고 있습니다. </dd>\r\n\t\t<dd>또한, 논문 PDF에서 선택한 텍스트를 요약, 번역,<br/> 용어 설명하는 AI-Helper 서비스를  제공합니다. </dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/aiq/aireview/AIReviewArticle.do\" onclick=\"insertAIReviewLog('1043')\" class=\"gnb-2a\"><em>논문리뷰: AI-Reviewer</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>논문리뷰: AI-Reviewer</dt>\r\n\t\t<dd>\r\n\t\tScienceON에서 검색하거나 이용자가 보유한 논문을 11개 관점별로 비교분석하고\r\n\t\t분석된 결과를 기반으로 질의응답 기능을 제공합니다.\r\n\t\t</dd>\r\n\t\t<dd>\r\n\t\tAI-Reviewer는 논문리뷰 시간을 단축시키고, KISTI가 자체 개발한 언어모델(KONI)을 사용하여\r\n\t\t신뢰성 높은 논문 분석 결과를 제공합니다.\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<!-- <li>\r\n\t\t<a href=\"/aiq/mlls/selectAIQMllsList.do\" class=\"gnb-2a\"><em>논문타임라인</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>논문타임라인</dt>\r\n\t\t<dd>정보데이터 유형별, 연구단계별, 이용 목적별<br/> 워크플로우를 구성하여 과학기술 지식인프라 이용에 도움을 드립니다.</dd>\r\n\t\t</dl>\r\n\t\t</li> -->\r\n\t\t<li>\r\n\t\t<a href=\"/aiq/issue/selectIssueReportList.do\" class=\"gnb-2a\"><em>ScienceON TREND</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>ScienceON TREND</dt>\r\n\t\t<dd>최신 과학기술 트렌드와 토픽에 대한 ScienceON<br/> 연관 콘텐츠 및 내외부 지식인프라 콘텐츠를 한 번에 볼 수 있는 서비스입니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/analytics/cntnt/selectCntntList.do\" class=\"gnb-2a\"><em>ScienceON Analytics</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>ScienceON Analytics</dt>\r\n\t\t<dd>ScienceON 이용통계 기반의 활용도 분석 서비스를 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/lab/answer/selectPORLabContentList.do\" class=\"gnb-2a\"><em>ScienceON LAB</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>ScienceON LAB</dt>\r\n\t\t<dd>ScienceON LAB은 사용자들이 ScienceON의<br/> 새로운 서비스, 기능 등을 이용해보고 피드백을<br/> 남길 수 있는 공간입니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t<aside class=\"subM-gnbbox\" id=\"analyze\">\r\n\t\t<div>\r\n\t\t<ul class=\"flex-center\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/aiq/mlsh3/selectAIQMlshList.do\" class=\"gnb-2a\" id=\"analyze_ai\"><em>논문요약・번역: AI-Helper</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/aiq/aireview/AIReviewArticle.do\" class=\"gnb-2a\" id=\"analyze_aireview\"><em>논문리뷰: AI-Reviewer</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/aiq/issue/selectIssueReportList.do\" class=\"gnb-2a\" id=\"analyze_trend\"><em>ScienceON TREND</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/analytics/cntnt/selectCntntList.do\" class=\"gnb-2a\" id=\"analyze_sanl\"><em>ScienceON Analytics</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/lab/answer/selectPORLabContentList.do\" class=\"gnb-2a\" id=\"analyze_lab\"><em>ScienceON LAB</em></a>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/nots/noticeList.do\" class=\"gnb-1a cs\">고객지원</a>\r\n\t\t<aside class=\"sub-gnbbox\">\r\n\t\t<div class=\"inner respon flex-spacebetween\">\r\n\t\t<div class=\"gnb-1a-txt flex-start\">\r\n\t\t<span class=\"ico\"><i class=\"fas fa-headset\"></i></span>\r\n\t\t<dl class=\"txt-box\">\r\n\t\t<dt>고객지원</dt>\r\n\t\t<dd>이용자의 연구 활동을 돕고 요구사항을 반영하고자<br/> 온오프라인을 통해 적극적으로 고객을 지원합니다.</dd>\r\n\t\t</dl>\r\n\t\t</div>\r\n\t\t<ul class=\"gnb-2a-mnu\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/nots/noticeList.do\" class=\"gnb-2a\"><em>공지사항</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>공지사항</dt>\r\n\t\t<dd>ScienceON, 연구개발, 과학기술 활동과 관련된<br/> 공지 내용을 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/faqs/faqList.do\" class=\"gnb-2a\"><em>FAQ</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>FAQ</dt>\r\n\t\t<dd>ScienceON 이용과 관련한 주요 질문과 답변을<br/> 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/qnas/qnaList.do\" class=\"gnb-2a\"><em>Q&A</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>Q&A</dt>\r\n\t\t<dd>ScienceON 이용 관련 질문, 불편사항,<br/> 개선 요청사항에 대한 게시판입니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/faqs/useMthList.do\" class=\"gnb-2a\"><em>사용설명서</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>사용설명서</dt>\r\n\t\t<dd>ScienceON 사용에 필요한 설명을 제공합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/oapi/openApi.do\" class=\"gnb-2a\"><em>OpenAPI</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>ScienceON API Gateway</dt>\r\n\t\t<dd>KISTI에서 구축한 과학기술정보를 제공하는<br/> 개방형 유통 플랫폼입니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/pubs/pubList.do\" class=\"gnb-2a\"><em>ScienceON 홍보</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>ScienceON 홍보</dt>\r\n\t\t<dd>ScienceON에서 발간한 ScienceON 홍보자료를 확인할 수 있습니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/copyright/copyRightList.do\" class=\"gnb-2a\"><em>저작권 관리 안내</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>저작권 관리 안내</dt>\r\n\t\t<dd>ScienceON에서 제공하는 콘텐츠에 대한 저작권 관리 안내입니다</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t<aside class=\"subM-gnbbox\" id=\"cs\">\r\n\t\t<div>\r\n\t\t<ul class=\"flex-center\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/nots/noticeList.do\" class=\"gnb-2a\" id=\"cs_notice\"><em>공지사항</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/faqs/faqList.do\" class=\"gnb-2a\" id=\"cs_faq\"><em>FAQ</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/qnas/qnaList.do\" class=\"gnb-2a\" id=\"cs_qna\"><em>Q&A</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/faqs/useMthList.do\" class=\"gnb-2a\" id=\"cs_tips\"><em>사용설명서</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/oapi/openApi.do\" class=\"gnb-2a\" id=\"cs_oapi\"><em>OpenAPI</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/pubs/pubList.do\" class=\"gnb-2a\" id=\"cs_pub\"><em>ScienceON 홍보</em></a>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/copyright/copyRightList.do\" class=\"gnb-2a\" id=\"cs_copy\"><em>저작권 관리 안내</em></a>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/intr/selectPORScienceONIntrcn.do?aboutCd=0\" class=\"gnb-1a about\">About</a>\r\n\t\t<aside class=\"sub-gnbbox\">\r\n\t\t<div class=\"inner respon flex-spacebetween\">\r\n\t\t<div class=\"gnb-1a-txt flex-start\">\r\n\t\t<span class=\"ico\"><i class=\"fas fa-chart-network\"></i></span>\r\n\t\t<dl class=\"txt-box\">\r\n\t\t<dt>About</dt>\r\n\t\t<dd>ScienceON 개요, 추진방향, 목표, 기능과<br/> 제공 콘텐츠입니다.</dd>\r\n\t\t</dl>\r\n\t\t</div>\r\n\t\t<ul class=\"gnb-2a-mnu\">\r\n\t\t<li class=\"on\">\r\n\t\t<a href=\"/por/intr/selectPORScienceONIntrcn.do?aboutCd=0\" class=\"gnb-2a\"><em>ScienceON 개요</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>ScienceON 개요</dt>\r\n\t\t<dd>과학기술 지식인프라 ScienceON은 과학기술정보, 연구데이터, 정보분석서비스 및 연구인프라를 연계·융합하여 연구자가 필요로 하는 지식인프라를 한곳에서 제공하는 서비스 입니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/intr/selectPORScienceONIntrcn.do?aboutCd=1\" class=\"gnb-2a\"><em>추진방향</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>추진방향</dt>\r\n\t\t<dd>지식인프라의 통합적 연계·활용 중심에서 인공지능<br/> 큐레이션 서비스로의 진화를 목표로 합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/intr/selectPORScienceONIntrcn.do?aboutCd=2\" class=\"gnb-2a\"><em>서비스 목표</em><span class=\"ico\"><i class=\"fal fa-angle-right\"></i></span></a>\r\n\t\t<dl class=\"comment-box\">\r\n\t\t<dt>서비스 목표</dt>\r\n\t\t<dd>이용자의 접근성과 활용성 강화, R&D의 효율성 향상, 과학기술의 대중화 실현하고자 합니다.</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<a href=\"/por/intr/selectPORScience