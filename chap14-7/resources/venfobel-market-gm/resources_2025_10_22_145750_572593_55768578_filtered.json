\t\tinsertInfraLog('FNCT001408','INFRAPAGE0068', url);\r\n\t}\r\n\r\n\r\n\tfunction fncAbsWordList() {\r\n\t\tvar uniqueWords = [];\r\n\r\n\t\t$(\"span.hdwrd\").each(function(idx, item) {\r\n\t\tvar txt = $(item).text();\r\n\t\tvar wrdId = $(item).attr(\"id\");\r\n\t\t/* \t\t//0번째 값은 PCR로 고정\r\n                        if (false) {\r\n\t\t    if (idx == 0) {\r\n\t\t        var txt = \"PCR\";\r\n\t\t        var wrdId = \"PCR\";\r\n\t\t    }\r\n\t\t}\r\n\t\t */\r\n\r\n\t\t//txt를 새로운 배열에 넣을때 배열안에 값이 존재하면 넣지 않음\r\n\t\tif (!uniqueWords.includes(txt)) {\r\n\t\tuniqueWords.push(txt);\r\n\r\n\t\t//용어보기 클릭시 인덱스 1번째 값으로 표제어~용어설명까지 값을 표출하게 만들어줌\r\n\t\tif (idx == 0) {\r\n\t\tvar sDd = $('#sDd dd').text(txt);\r\n\t\tfncViewWord(wrdId, true, txt);\r\n\t\t}\r\n\r\n\t\tvar btn = $(\"<button></button>\").attr(\"type\", \"button\").attr(\"data-hdwrd-id\", wrdId)\r\n\t\t.attr(\"data-hdwrd-title\", txt).addClass(\"btns side-round tab-btn hdwrdBtn\");\r\n\t\tif (idx == 0) {\r\n\t\t$(btn).addClass(\"active\");\r\n\t\t}\r\n\t\t$(btn).text(txt).appendTo(\".hdwrdLst\");\r\n\t\t$(item).addClass(\"modal-open-close\").attr(\"data-kisti-modal\", \"#abstractWord\");\r\n\t\t$(item).on(\"click\", function() {\r\n\t\t$(\"#abstractWord\").show();\r\n\t\tfncViewWord(wrdId, true, txt);\r\n\t\t});\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t$(\"button.hdwrdBtn\").on(\"click\", function(e) {\r\n\t\tvar dataTxt = $(e.target).attr(\"data-hdwrd-title\");\r\n\t\tvar dataId = $(e.target).attr(\"data-hdwrd-id\");\r\n\t\t$(\".hdwrdBtn\").removeClass(\"active\");\r\n\t\t$(e.target).addClass(\"active\");\r\n\t\tfncViewWord(dataId, true, dataTxt);\r\n\t\t});\r\n\r\n\t\t$(\"#abstractWord\").on(\"click\", \".abstract-word-box dd:eq(2) .jum-ul .src-list\", function(e) {\r\n\t\te.preventDefault();\r\n\t\t$(\".abstract-word-box dd:eq(2) ul a.src-list\").removeClass(\"active\");\r\n\t\t$(this).addClass(\"active\");\r\n\t\tvar wordId = $(this).data(\"word-id\");\r\n\t\t$(\".abstract-word-box dd:eq(3) .desc-word\").addClass(\"none\");\r\n\t\t$(\".abstract-word-box dd:eq(3) .desc-word#word_\" + wordId).removeClass(\"none\");\r\n\t\tinsertBhvrLog($.extend({ 'sourceId': wordId, 'bhvrNo': '220', 'evntNo': '01' }, bhvrLogOption));\r\n\t\t});\r\n\t}\r\n\r\n\tfunction fncViewWord(hdwrdId, scroll, selTitle){\r\n\t\t$(\".hdwrdBtn\").removeClass(\"active\")\r\n\t\t$(\".hdwrdBtn\").filter(function() {\r\n\t\treturn $(this).attr(\"data-hdwrd-id\") == hdwrdId;\r\n\t\t}).addClass(\"active\");\r\n\t\t$.ajax({\r\n\t\turl : \"selectPORSrchArticleWord.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata: \"hdwrdId=\"+hdwrdId,\r\n\t\tsuccess: function(json){\r\n\t\tvar surfaceWordList = json.resultList.surfaceWordList;\r\n\t\tvar wordDesList = json.resultList.wordDesList;\r\n\t\t$(\".abstract-word-box dd:eq(0)\").html(\"\");\r\n\t\t$(\".abstract-word-box dd:eq(1)\").html(\"\");\r\n\t\tvar num = 1;\r\n\t\tvar synonym = \"\";\r\n\t\t$.each( surfaceWordList, function( key, value ){\r\n\t\tif(value.surwrdSeCd == \"ET\"){\r\n\t\t$(\".abstract-word-box dd:eq(0)\").text(value.surwrdNm);\r\n\t\t}else{\r\n\t\tif(num === 1){\r\n\t\tsynonym = value.surwrdNm;\r\n\t\t$(\".abstract-word-box dd:eq(1)\").text(synonym);\r\n\t\t}else{\r\n\t\tsynonym += ', ' + value.surwrdNm;\r\n\t\t$(\".abstract-word-box dd:eq(1)\").text(synonym);\r\n\t\t}\r\n\t\tnum++\r\n\t\t}\r\n\t\t});\r\n\t\t/* \tif(surfaceWordList ==''){\r\n\r\n                        $('#ftDd dd').text(\"PCR\");\r\n                        $('#sDd dd').text(\"Packet Collision Rate\");\r\n\r\n                    } */\r\n\t\t$(\".abstract-word-box dd:eq(2) .jum-ul\").html(\"\");\r\n\t\t$(\".abstract-word-box dd:eq(3)\").html(\"\");\r\n\r\n\t\t$.each( wordDesList, function( key, value ){\r\n\t\tvar prefix = \"[논문]\";\r\n\t\tif(value.wordSrcSeCd == \"W\"){\r\n\t\tprefix = \"[위키피디아]\";\r\n\t\t}\r\n\t\twordDc = value.wordDc.replace(/\\\\n/gi, \"<br/>\");\r\n\t\twordDcId = value.wordDcId.replace(/@/gi, \"\");\r\n\r\n\t\tvar selClass=\"\";\r\n\t\tvar noneClass=\"\";\r\n\t\tvar src=\"\";\r\n\t\tif(key == 0){\r\n\t\tselClass=\"active\";\r\n\t\tnoneClass=\"\";\r\n\t\t}else{\r\n\t\tselClass=\"\";\r\n\t\tnoneClass=\"none\";\r\n\t\t}\r\n\t\tif(value.wordSrcSeCd == \"S\"){\r\n\t\tsrc = \"<a href=?cn=\"+value.cntntsId+\" target=\\\"_blank\\\" class=\\\"link-btn color-blue src\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201431057577184\\\" data-log-no=\\\"202510223044753992\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\" title=\\\"새 창에서 자료보기\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t} else{\r\n\t\tvar koPattern = /[ㄱ-ㅎ가-힣]/; //한글\r\n\t\tif(!koPattern.test(value.title)){\r\n\t\tsrc = \"<a title=\\\"새 창에서 자료보기\\\" href=\\\"https://en.wikipedia.org/wiki/\"+value.title+\"\\\" target=\\\"_blank\\\" class=\\\"link-btn color-blue\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201431057577184\\\" data-log-no=\\\"202510223044753992\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t}else{\r\n\t\tsrc = \"<a title=\\\"새 창에서 자료보기\\\" href=\\\"https://ko.wikipedia.org/wiki/\"+value.title+\"\\\" target=\\\"_blank\\\" class=\\\"link-btn color-blue\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201431057577184\\\" data-log-no=\\\"202510223044753992\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t}\r\n\t\t}\r\n\t\t$(\".abstract-word-box dd:eq(2) .jum-ul\").append(\"<li><a class=\\\"oneline src-list \"+selClass+\"\\\" href=\\\"#\\\" data-word-id=\\\"\"+wordDcId+\"\\\">\"+prefix +\" \" +value.title+\"</a>\"+src+\"</li>\");\r\n\t\t$(\".abstract-word-box dd:eq(3)\").append(\"<div class=\\\"desc-word \"+noneClass+\"\\\" id=\\\"word_\"+wordDcId+\"\\\"><div class=\\\"scrollbox\\\" style=\\\"max-height: 140px;\\\">\"+wordDc+\"</div