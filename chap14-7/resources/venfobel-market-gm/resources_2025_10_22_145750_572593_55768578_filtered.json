\n\r\n\t\tkywdCnt = 0;\r\n\t\thtml = \"\";\r\n\t\tvar soaringRandomItem = [];\r\n\t\tvar value = \"\";\r\n\t\tfor (var i = 0 ; soaringRandomItem.length < 5 ; i++ ){\r\n\t\tvar random = Math.floor(Math.random() * soaringKywdList.length);\r\n\t\tsoaringRandomItem.push(soaringKywdList[random]);\r\n\t\tsoaringKywdList.splice(random,1);\r\n\r\n\t\tvalue = soaringRandomItem[i];\r\n\r\n\t\thtml += '<a href=\"javascript:searchTag2(\\''+value+'\\',\\'S\\');\" title=\"'+value+'\" class=\"oneline\" ';\r\n\t\thtml += 'data-bhvr-no=\"15\"';\r\n\t\thtml += 'data-log-no=\"202510223044754017\"';\r\n\t\thtml += 'data-url-no=\"PG023\"';\r\n\t\thtml += 'data-param=\"'+value+'\"';\r\n\t\thtml += '>#'+value+'</a>';\r\n\t\t}\r\n\t\t$(\"#srchSoaringKywdList\").append(html);\r\n\r\n\t\tkywdCnt = 0;\r\n\t\thtml = \"\";\r\n\t\t$.each( inflwKwrdList, function( key, value ){\r\n\t\tif( (value != \"NULL\" && value != \"*\") && kywdCnt < 5 ){\r\n\t\tkywdCnt++;\r\n\r\n\t\thtml += '<a href=\"javascript:searchTag(\\''+value+'\\')\" title=\"'+value+'\" class=\"oneline\" ';\r\n\t\thtml += 'data-bhvr-no=\"17\"';\r\n\t\thtml += 'data-log-no=\"202510223044754017\"';\r\n\t\thtml += 'data-url-no=\"PG023\"';\r\n\t\thtml += 'data-param=\"'+value+'\"';\r\n\t\thtml += '>#'+value+'</a>';\r\n\t\t}\r\n\t\t});\r\n\t\t$(\"#srchInflwKwrdList\").append(html);\r\n\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t//검색어 자동완성\r\n\t\t$(\".inp_srch\").keyup(function (e) {\r\n\t\t//나의 최근 검색어\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/getSearchKwrdList.do\",\r\n\t\tdataType: 'json',\r\n\t\ttype:'post',\r\n\t\tsuccess: function(data){\r\n\t\tvar result = data.resultList;\r\n\r\n\t\t$(\".auto-search-keyword #his dd ul\").html('');\r\n\t\t$(result).each(function(index, item){\r\n\t\tif(index < 8){\r\n// \t\tvar appendLi = \"<li class=\\\"flex-spacebetween\\\"><button type=\\\"button\\\" class=\\\"key-btn\\\">\"+ item.kwrd +\"</button><button type=\\