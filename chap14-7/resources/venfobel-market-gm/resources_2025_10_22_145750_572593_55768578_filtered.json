-table\").addClass(\"hidden\");\r\n\t\t$(\"#sect_tbim .h3-slide\").removeClass(\"hidden\");\r\n\t\t$(\"#sect_tbim #gallery-list\").removeClass(\"hidden\");\r\n\r\n\t\t});\r\n\r\n\t\t/* [개발업무], 개발일자-2024-08-13, 작업내용 : 과제정보 연계 */\r\n\t\tmakeNtisModal();\r\n\r\n\t\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t\tvar ddc = \"623\";\r\n\t\tif(ddc != \"\"){\r\n\t\tselectPrcuse();\r\n\t\tselectAnalytics(ddc);\r\n\t\t}\r\n\r\n\t\t/* [개발업무], 개발일자-2024-10-21, 작업내용 : profile 시범서비스 */\r\n\t\t//키워드별 프로파일 상세 항목 순위에 따른 순서변경\r\n\t\tvar left = document.getElementById(\"smooth-all\");\r\n\t\tvar leftAbs = document.getElementById(\"link_abs\");\r\n\t\tvar leftLiText = \"\";\r\n\t\tvar leftLi;\r\n\t\tvar sectionDiv = document.getElementById(\"sectionDiv\");\r\n\t\tvar sectionAbs = document.getElementById(\"sect_abs\");\r\n\t\tvar section;\r\n\r\n\t\t\r\n\t});\r\n\r\n\t/* [개발업무], 개발일자-2024-08-13, 작업내용 : 과제정보 연계 */\r\n\tfunction makeNtisModal(){\r\n\t\tif(\"0\" > 0){\r\n\t\tvar pjtIdArr = [];\r\n\t\t\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/ntisPjtInfoList.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata : {'arr' : pjtIdArr},\r\n\t\ttraditional: true,\r\n\t\tsuccess: function(data){\r\n\t\t// 과제 정보 (과제정보 API 활용)\r\n\t\tvar pjtInfoList = data.pjtInfoList;\r\n\r\n\t\tif(pjtInfoList.length > 0){\r\n\r\n\t\t$(pjtInfoList).each(function(idx, item){\r\n\t\tvar addDiv = \"<div class='powerful-con'>\"\r\n\t\t+ \"<div class='inner'>\"\r\n\t\t+ \"<p class='subject'>\"+ item.ProjectTitleKr +\"</p>\"\r\n\t\t+ \"<p>(\"+item.ProjectNumber+\") \"+item.ProjectYear+\" / \"+item.BudgetProject+\" / \"+item.Manager+\" / \"+item.ResearchAgency+\" / \"+item.Ministry+\" / \"+ parseInt(item.TotalFunds).toLocaleString()+\"원 (\"+ parseInt(item.GovernmentFunds).toLocaleString()+\"원)</p>\"\r\n\t\t+ \"<p class='info mgt5px'>\"+ item.AbstractFull +\"</p>\"\r\n\t\t+ \"<div class='item-btn-box flex-start mgt20px'>\"\r\n\t\t+ \"<a href='https://sso1.ntis.go.kr/nls3/saml/saml_login.jsp?UURL=https://www.ntis.go.kr/project/pjtInfo.do?pjtId=\"+item.ProjectNumber+\"' target='_blank' data-bhvr-no='1026' data-evnt-no='01' data-log-no='202510223044754017' data-url-no='PG023' class='flex-start round5px' style='gap: 10px;overflow: hidden;border: 1px solid var(--color-gray-light);padding-right: 10px;'><span class='ico' style='font-size: 0;'><img src='https://scienceon.kisti.re.kr/newUI/img/common/ico_ntis.png' height='30' class='round5px' /></span><em>더보기</em></a>\"\r\n\t\t+ \"</div></div></div>\";\r\n\t\t$(\"#pjtList\").append(addDiv);\r\n\t\t});\r\n\t\t}\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\tvar cachedWidth = $(window).width();\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t$(window).resize(function(){\r\n\t\tvar ddc = \"623\";\r\n\t\tif(ddc != \"\"){\r\n\t\tvar newWindowWidth = $(window).width();\r\n\t\tif (newWindowWidth !== cachedWidth) {\r\n\t\tif(this.resizeTO) clearTimeout(this.resizeTO);\r\n\t\tthis.resizeTO = setTimeout(function() {\r\n\t\tselectPrcuse();\r\n\t\t}, 300);\r\n\r\n\t\t}\r\n\t\tcachedWidth = newWindowWidth;\r\n\t\t}\r\n\t});\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\tfunction selectPrcuse(){\r\n\t\t//활용도 분석정보\r\n\t\tvar cn = \"JAKO201213660554224\";\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/por/analytics/prcuse/selectPrcuseSrchDtlChartDataAjax.do\",\r\n\t\tdataType : 'json',\r\n\t\tdata: {'cn' : cn, \"pageFlag\" : \"artDtl\"},\r\n\t\tcontentType: 'application/x-www-form-urlencoded',\r\n\t\tsuccess : function(data) {\r\n\t\tfn_drawChart(data.resultMap);\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t//Chart 생성\r\n\tfunction fn_drawChart(resultList) {\r\n\t\tvar dvData = new google.visualization.DataTable();\r\n\t\tvar ovData = new google.visualization.DataTable();\r\n\t\tvar saData = new google.visualization.DataTable();\r\n\t\tdvData.addColumn('string', '');\r\n\t\tdvData.addColumn('number', '상세보기');\r\n\t\tdvData.addColumn({type: 'string', role: 'annotation'});\r\n\t\tovData.addColumn('string', '');\r\n\t\tovData.addColumn('number', '다운로드');\r\n\t\tovData.addColumn({type: 'string', role: 'annotation'});\r\n\t\tsaData.addColumn('string', '');\r\n\t\tsaData.addColumn('number', '내보내기');\r\n\t\tsaData.addColumn({type: 'string', role: 'annotation'});\r\n\r\n\t\tvar dvDataArr = [];\r\n\t\tvar ovDataArr = [];\r\n\t\tvar saDataArr = [];\r\n\t\tvar dvCnt = 0;\r\n\t\tvar ovCnt = 0;\r\n\t\tvar saCnt = 0;\r\n\t\tresultList.forEach(function(item, i) {\r\n\t\tdvDataArr.push([ item.logYr, item.dvCnt, item.dvCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tovDataArr.push([ item.logYr, item.ovCnt, item.ovCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tsaDataArr.push([ item.logYr, item.saCnt, item.saCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tdvCnt += item.dvCnt;\r\n\t\tovCnt += item.ovCnt;\r\n\t\tsaCnt += item.saCnt;\r\n\t\t});\r\n\r\n\t\tif(dvCnt+ovCnt+saCnt == 0){\r\n\t\t$(\"#sect_anal\").hide();\r\n\t\t$(\"#link_anal\").hide();\r\n\t\treturn;\r\n\t\t}\r\n\r\n\t\tdvData.addRows(dvDataArr);\r\n\t\tovData.addRows(ovDataArr);\r\n\t\tsaData.addRows(saDataArr);\r\n\r\n\t\t$(\"#dvCnt\").text(dvCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\t\t$(\"#ovCnt\").text(ovCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\t\t$(\"#saCnt\").text(saCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\r\n\t\tvar winWidth = $(window).width();\r\n\t\tvar chartWidth = '100%';\r\n\t\tif(winWidth >= 751 && winWidth <= 1183){\r\n\t\tchartWidth = 468;\r\n\t\t}\r\n\t\tvar options = {\r\n\t\twidth: chartWidth,\r\n\t\theight: 120,\r\n\t\tlegend: 'none',\r\n// \t\tlegend: { position: 'bottom', maxLines: 5, textStyle: {fontSize: 12} },\r\n// \t\tbar: { groupWidth: '50%' },\r\n// \t\tbars: 'horizontal',\r\n// \t\tisStacked: true,\r\n\t\tvAxis: {minValue: 2},\r\n\t\tannotations: {\r\n\t\talwaysOutside: false,\r\n\t\ttextStyle: {\r\n\t\tfontSize: 11,\r\n\t\tcolor: '#000',\r\n\t\tauraColor: 'none'\r\n\t\t}\r\n\t\t},\r\n\t\tchartArea: {\r\n\t\tleft: 50,\r\n\t\tright: 20,\r\n// \t\ttop: 10,\r\n\t\tbackgroundColor: 'white',\r\n\t\twidth: '100%',\r\n\t\theight: '70%'\r\n\t\t},\r\n\t\tseries: {\r\n\t\t0:{color:'#003879'}\r\n\t\t}\r\n\t\t};\r\n\r\n\t\tvar dvChart = new google.visualization.LineChart(document.getElementById('chart_dv'));\r\n\t\tvar ovChart = new google.visualization.LineChart(document.getElementById('chart_ov'));\r\n\t\tvar saChart = new google.visualization.LineChart(document.getElementById('chart_sa'));\r\n\t\tgoogle.visualization.events.addListener(dvChart, 'ready', fn_chartReadyHandler);\r\n\t\tgoogle.visualization.events.addListener(ovChart, 'ready', fn_chartReadyHandler);\r\n\t\tgoogle.visualization.events.addListener(saChart, 'ready', fn_chartReadyHandler);\r\n\r\n\t\tdvChart.draw(dvData, options);\r\n\t\tovChart.draw(ovData, options);\r\n\t\tsaChart.draw(saData, options);\r\n\t}\r\n\tfunction fn_chartReadyHandler() {\r\n\t\tsetTimeout(function(){$(\"#chart_dv table\").prop(\"summary\", \"상세보기 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t\tsetTimeout(function(){$(\"#chart_ov table\").prop(\"summary\", \"다운로드 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t\tsetTimeout(function(){$(\"#chart_sa table\").prop(\"summary\", \"내보내기 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\tfunction selectAnalytics(ddc){\r\n\t\t//활용도 Top5 논문\r\n\t\tvar yyyy = new Date().getFullYear();\r\n\t\t$(\"#minYr\").val(yyyy-1);\r\n\t\t$(\"#maxYr\").val(yyyy);\r\n\r\n\t\tddc = ddc.substr(0,1).padEnd(3,\"0\");\r\n\t\t$(\"#ddcLclas\").val(ddc);\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/por/analytics/prcuse/selectPrcuseArticleListAjax.do\",\r\n\t\tdataType : 'html',\r\n\t\tdata: $(\"#analyticsForm\").serialize(),\r\n\t\tcontentType: 'application/x-www-form-urlencoded',\r\n\t\tbeforeSend: function() {\r\n\t\t$(\"#listAjaxLoding\").removeClass(\"hidden\");\r\n\t\t$(\"#prcuseList\").addClass(\"hidden\");\r\n\t\t},\r\n\t\tsuccess : function(data) {\r\n\t\t$(\"#prcuseList\").html(data);\r\n\t\t},complete: function() {\r\n\t\t$(\"#listAjaxLoding\").addClass(\"hidden\");\r\n\t\t$(\"#prcuseList\").removeClass(\"hidden\");\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t//Analytics 이동\r\n\tfunction fn_goAnalytics(){\r\n\t\t$('#analyticsForm').attr('action',\"/por/analytics/prcuse/selectPrcuseArticleList.do\");\r\n\t\t$(\"#analyticsForm\").submit();\r\n\r\n\t\tinsertBhvrLog(\r\n\t\t{\r\n\t\t'cn': document.querySelector(\"#logForm input[name='cn']\").value\r\n\t\t,'sourceId':''\r\n\t\t,'bhvrNo': '1027'\r\n\t\t,'evntNo': '01'\r\n\t\t,'param' : ''\r\n\t\t,'logNo' : '202510223044754017'\r\n\t\t,'urlNo' : 'PG023'\r\n\t\t}\r\n\t\t);\r\n\t}\r\n\r\n\t//참고문헌, 인용문헌에서  각 아이콘 클릭시 실행\r\n\tfunction fncCiteInfo(citegubun,flag,cn,bibcn,dbt,url,target){\r\n\r\n\t\tif(url.indexOf(\"koix.kisti.re.kr\")>-1 ){\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/ndslOrgDocDownChk.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata : {'cn' : cn, 'dbt':dbt, 'koi':url},\r\n\t\t//async: false,\r\n\t\tsuccess: function(data){\r\n\r\n\t\tvar arr_data = data.result.split(\"*\");\r\n\t\tvar dataArr0 = arr_data[0];\r\n\t\tvar dataArr1 = arr_data[1];\r\n\t\tvar dataArr2 = arr_data[2];\r\n\t\tvar dataArr3 = arr_data[3];\r\n\t\tvar dataArr4 = arr_data[4];\r\n\t\tvar dataArr5 = arr_data[5];\r\n\t\tif (dataArr0 == \"true\") {\r\n\t\tvar url = \"/commons/util/originalView.do\";\r\n\t\turl += \"?cn=\" + dataArr5 + \"&oCn=\" +  cn + \"&dbt=\" + dbt + \"&journal=\" + bibcn;\r\n\r\n// \t\tconsole.log(url)\r\n\t\twindow.open(url, \"newWin\");\r\n\t\tinsertSystemLogInfo(\"linkYn=Y&useContCd=0001&linkURL=\"+ url + \"&cn=\"+cn);\r\n\t\tinsertBhvrLog({'bhvrNo' : '319','evntNo' : '01', 'cn' : cn ,'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\t\t} else {\r\n\t\talert(dataArr1);\r\n\t\t}\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t}else{\r\n\r\n\t\tif(target == '_blank'){\r\n\t\twindow.open(url);\r\n\t\t}else{\r\n\t\tlocation.target = target;\r\n\t\tlocation.href = url;\r\n\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfunction fncXmlView(obj){\r\n\t\tvar temp = obj.split(\"_\");\r\n\t\tvar url = \"\";\r\n\t\tvar urlTmp =\"\";\r\n\r\n\t\tfor(var i=0; i < temp.length -1; i++){\r\n\t\turlTmp += temp[i]+\"/\";\r\n\t\t}\r\n\r\n\t\turl= \"http://kpubs.org/article/viewPubreaderOutside.kpubs?articleANo=\"+obj;\r\n\t\twindow.open(url,\"_blank\");\r\n\r\n\t\tvar _param =\r\n\t\t{\r\n\t\t\"cttCode1\"\t: $(\"#logForm > input[name='cttCode1']\").val(),\r\n\t\t\"cttCode2\"\t: $(\"#logForm > input[name='cttCode2']\").val(),\r\n\t\t\"svcCode1\"\t: \"OV\",\r\n\t\t\"svcCode2\" \t: \"OV2\",\r\n\t\t\"pageCode\" \t: $(\"#logForm > input[name='pageCode']\").val(),\r\n\t\t\"keyword\" \t: $(\"#logForm > input[name='keyword']\").val(),\r\n\t\t\"rUrl\" \t\t: document.location.href\r\n\t\t};\r\n\t\tlogSummton(_param);\r\n\r\n\t\tinsertBhvrLog({'bhvrNo' : '381','evntNo' : '01', 'cn' : document.querySelector(\"#logForm input[name='cn']\").value\r\n\t\t, 'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\r\n\t}\r\n\r\n\t//인용 문헌 목록 가져오기\r\n\tfunction fncCitingList(addNum, isInit){\r\n\r\n\t\tvar len_li = $(\".citingList\").children(\"li\").length;\r\n\t\tvar startNum = len_li + 1;\t\t//from, to 사용안함\r\n\t\tvar endNum = len_li + parseInt(addNum) + 1;\t\t//from, to 사용안함\r\n\r\n\t\tcitingRownum = citingRownum + parseInt(addNum); //Row 제한 Rownum\r\n\r\n\t\tvar obj = new Object();\r\n\t\tobj.cn = \"JAKO201213660554224\";\r\n\t\tobj.startNum = startNum;\r\n\t\tobj.endNum = endNum;\r\n\t\tobj.citingRownum = citingRownum;\r\n\r\n\t\t$.ajax({\r\n\t\ttype\t\t: 'POST',\r\n\t\tcontentType : \"application/json; charset=utf-8\",\r\n\t\tdata\t\t: JSON.stringify(obj),\r\n\t\tdataType\t: 'json',\r\n\t\turl\t\t: \"/srch/citingList.do\",\r\n\t\tasync\t\t: false,\r\n\t\tsuccess \t: function(data){\r\n\t\tvar result = data.result;\r\n\t\t// 2022.03.27 인용문헌 건수 조회 X, 처음 호출되었을 경우 여부\r\n\t\tif(result.citingList.length > 0){\r\n\t\tfncCitingCnt();\r\n\t\t$(\"#sect_citing\").removeClass(\"hidden\");\r\n\t\t$(\"#link_citingList\").removeClass(\"hidden\");\r\n\t\t} else {\r\n\t\t$(\"#sect_citing\").addClass(\"hidden\");\r\n\t\t$(\"#link_citingList\").addClass(\"hidden\");\r\n\t\t}\r\n\r\n\t\t// 기존 목록 초기화\r\n\t\tif(result.citingList.length > 0){\r\n\t\t$(\".citingList\").empty();\r\n\t\t}\r\n\r\n\t\t$.each(result.citingList, function(index, item){\r\n// \t\tconsole.log(item);\r\n\t\tvar cnt = index+1;\r\n\t\tvar AUTHOR01 = nvl(item.AUTHOR01, \"\");\r\n\t\tAUTHOR01.replace(/ ; /gi, \", \");\r\n\t\tvar TITLE = nvl(item.TITLE,\"\");\r\n\t\tif(TITLE != \"\") {\r\n\t\tTITLE = \"\\\"\" + TITLE + \"\\\"\";\r\n\t\t}\r\n\t\tvar KOI = nvl(item.KOI, \"\");\r\n\t\tvar CN = nvl(item.CN, \"\");\r\n\t\tvar str_li = \"<li data-refno=\\\"\"+ cnt +\"\\\" class='\"+(CN == KOI && CN != \"\" ? \" find\":\"\")+\"'>\";\r\n\t\tstr_li += \"<div class='txt'><p>\"+AUTHOR01+\" \"+nvl(item.PUBYEAR,\"\")+\" \"+TITLE+\" \"+nvl(item.JOURNALNAME,\"\")+\", \"+nvl(item.VOL,\"\")+\"(\"+nvl(item.NO,\"\")+\"): \"+nvl(item.PAGE,\"\")+\"</p> <div class='btn-area flex-end'>\";\r\n\t\tif(KOI != '' && CN != ''){\r\n\t\tstr_li += \"<a href='#;' onclick='fncCiteInfo(\\\"citing\\\",\\\"koi\\\",\\\"\"+CN+\"\\\",\\\"\"+item.BIBCN+\"\\\",\\\"JAKO\\\",\\\"http://koix.kisti.re.kr/\"+KOI+\"\\\",\\\"_blank\\\");return false;' class='btns hover-btn-blue-line'>원문보기</a>\";\r\n\t\t}\r\n\t\tif(CN != \"\"){\r\n\t\tstr_li += \"<a href='#;' onclick='windowOpen(\\\"/srch/selectPORSrchArticle.do?cn=\"+CN+\"\\\",\\\"_blank\\\");return false;' class='btns hover-btn-blue-line'  data-bhvr-no='404' data-evnt-no='01' data-log-no='202510223044754017' data-url-no='PG023' data-cn='JAKO201213660554224'>상세보기</a>\";\r\n\t\t}\r\n\t\tstr_li += \"</div></div></li>\";\r\n\t\t$li = $(str_li);\r\n// \t\tconsole.log($li);\r\n\t\t$li.appendTo($(\".citingList\"));\r\n\r\n\t\t});\r\n\r\n\t\t$(\"#citing_list li.none\").removeClass(\"none\");\r\n\r\n\t\tvar height = $(window).height();\r\n\t\tif($('.wrap_inner').height() < height){\r\n\t\t$('.wrap_inner').height($(window).height());\r\n\t\t}else{\r\n\t\t$('.wrap_inner').height($('.wrap_inner').height()+$(\"#contList\").height());\r\n\t\t}\r\n\r\n\t\t// 더보기 버튼  생성 및 제거\r\n\t\t// 결과 List 갯수  = citingRownum 이면 더보기 실행해야 함 (가져올 목록이 더 남아 있음)\r\n\t\tif(result.citingList.length == citingRownum){\r\n// \t\t$(\"#btn_cit_more\").closest(\"div\").show();\r\n\t\t}else{\r\n\t\t//결과 List 갯수 < citingRownum 이면 모든 목록 가져옴  (더보기 버튼 숨기기 및 인용문헌 건수 보여주기)\r\n\t\t$(\"#btn_cit_more\").remove();\r\n// \t\t$(\"#citing_subject\").html(\"이 논문을 인용한 문헌 (\"+result.citingList.length+\")\");\r\n\t\t}\r\n\r\n\t\t//Ajax 종료 , 더보기 실행 가능 상태로 변경함\r\n\t\tm_citingList = false;\r\n\t\t$(\"#btn_cit_more\").attr(\"disabled\", false);\r\n\t\t},\r\n\t\terror \t\t: function(jqXHR, textStatus, errorThrown){\r\n\r\n\t\tm_citingList = false;\r\n\t\t$(\"#btn_cit_more\").attr(\"disabled\", false);\r\n\r\n\t\tif(jqXHR.status == 401){\r\n\t\tconsole.log(jqXHR.status);\r\n\t\t}else{\r\n\t\tconsole.log(\"Error!\", \"Request failed: \" + errorThrown, \"error\");\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t// 인용 문헌 건수\r\n\tfunction fncCitingCnt(){\r\n\r\n\t\tvar obj = new Object();\r\n\t\tobj.cn = \"JAKO201213660554224\";\r\n\r\n\t\t$.ajax({\r\n\t\ttype\t\t: 'post',\r\n\t\tcontentType : \"application/json; charset=utf-8\",\r\n\t\tdata\t\t: JSON.stringify(obj),\r\n\t\tdataType\t: 'json',\r\n\t\turl\t\t: \"/srch/citingCnt.do\",\r\n\t\tsuccess \t: function(data){\r\n\t\tvar result = data.result;\r\n\t\tcitingCnt = parseInt(nvl(result.citingCnt,\"0\"));\r\n\r\n\t\tif(citingCnt > 0){//단순 인용건수만 계산\r\n\t\t$(\"#citingCnt\").html(\"(\"+citingCnt+\")\");\r\n\t\t}\r\n\t\t},\r\n\t\terror \t\t: function(jqXHR, textStatus, errorThrown){\r\n\t\tif(jqXHR.status == 401){\r\n\t\tconsole.log(jqXHR.status);\r\n\t\t}else{\r\n\t\tconsole.log(\"Error!\", \"Request failed: \" + errorThrown, \"error\");\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t});\r\n\t}\r\n\t/*\t표그림 상세\t*/\r\n\tfunction fncTbimDetail(subdoctype, tbimId, cn, idx, bhvrChk){\r\n\t\tvar ele = document.querySelectorAll(\"#gallery-table .galley-con\")[idx];\r\n\r\n\t\tvar li_index =  null;//현재 이미지의 index\r\n\t\tvar li_last_index =  document.querySelectorAll(\"#gallery-table .galley-con\").length-1; //검색 결과 이미지의 last index\r\n\r\n\t\tif(idx != -1){\r\n\t\tif(ele.hasAttribute('data-image-idx')){//이전 | 다음 버튼을 위해 현재 이미지의 index를 submit\r\n\t\tli_index = ele.getAttribute(\"data-image-idx\");\r\n\t\t}\r\n\t\t}else{\r\n\t\tli_index =$(\"#gallery-list .galley-con\").attr(\"data-image-idx\");\r\n\t\t}\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/selectPORSrchImage.do\",\r\n\t\tdataType: 'html',\r\n\t\ttype:'post',\r\n\t\tdata: {\r\n\t\t'tbimId' : tbimId\r\n\t\t,'cn' : cn\r\n\t\t,'subdoctype':subdoctype\r\n\t\t, 'imageIndex' : li_index\r\n\t\t, 'imageLastIndex' : li_last_index\r\n\t\t},\r\n\t\tsuccess: function(html){\r\n\t\t$('#imageDetail').html(html);\r\n\t\t$(\"#tbimDtlBtn\").addClass('hidden');\r\n\t\t$(\"#imgSubj\").addClass('hidden');\r\n\t\t$(\"#imgSubjDtl\").removeClass('hidden');\r\n//\t \t\t//펼치기\r\n\t\tmodalOpen(\"imageDetail\");\r\n\t\t$(\"#imageDetail\").scrollTop(0)\r\n//\t \t\tMathJax.Hub.Queue([\"Typeset\",MathJax.Hub]);//수학 표기법 javascript lib 갱신 \r\n\r\n\t\t// [개발업무], 개발-이태현, 개발일자-2023-08-31, 작업내용 : SO_COM_PAGE_LOG 로그 구현 \r\n\t\tdocument.comPageLogForm.cttCd1.value = \"TP\";\r\n\t\tdocument.comPageLogForm.cttCd2.value = \"TP01\";\r\n\t\tdocument.comPageLogForm.svcCd.value = \"DV\";\r\n\t\tdocument.comPageLogForm.pageUrl.value = \"/srch/selectPORSrchArticle.do\";\r\n\t\tdocument.comPageLogForm.refererUrl.value = document.location.href;\r\n\t\tdocument.comPageLogForm.contentId.va