더보기 버튼 추가 (총 개수가 10개 이상이고, 마지막 페이지가 아닌 경우)\r\n\t\tif(!(referList[0].TOTAL_CNT == referList[referList.length - 1].RN) && referList[0].TOTAL_CNT > 10){\r\n\t\tvar pgNum = parseInt(page) + 1;\r\n\t\t$(\".more_ref button\").off().on(\"click\", function(e) {\r\n\t\tmakeTLReferHtml(pgNum, gubun, pjn, cn);\r\n\t\t});\r\n\t\t$(\".more_ref\").css('display', '');\r\n\t\t} else {\r\n\t\t$(\".more_ref\").css('display', 'none');\r\n\t\t}\r\n\t\t} else {\r\n\t\t$(\"#referCnt\").text('(0)');\r\n\t\t$(\".more_ref\").css('display', 'none');\r\n\t\treferListHtml += \"<li style='list-style:none;'><div class='txt'><p>검색 결과가 없습니다.</p></div></div></li>\";\r\n\t\t$(\".referList\").empty();\r\n\t\t}\r\n\r\n\t\t// 게시물 추가 (2페이지 이상인 경우)\r\n\t\tif(page > 1){\r\n\t\t$(\".referList\").append(referListHtml);\r\n\t\t} else { // 게시물 새로 생성 (1페이지)\r\n\t\t$(\".referList\").html(\"\");\r\n\t\t$(\".referList\").html(referListHtml);\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t},\r\n\t\tcomplete: function(data) {\r\n// \t\tconsole.log(data);\r\n\t\tif(!isCnt) {\r\n\t\t$(\"#section_lvl3_2_2\").removeClass(\"hidden\");\r\n\t\t$(\"#loading_lvl3_2\").addClass(\"hidden\");\r\n\t\t} else {\r\n\t\t$(\"#section_lvl2_2, #section_lvl3_2_1, #section_lvl3_2_2\").removeClass(\"hidden\");\r\n\t\t$(\"#loading_lvl2_2, #loading_lvl3_2, #loading_lvl3_2\").addClass(\"hidden\");\r\n\t\t}\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\treturn ajax;\r\n\t}\r\n\r\n\t// 클래스 수정 함수\r\n\tfunction fn_modify_class(obj, type){\r\n\r\n\t\tvar tabObj = \"\";\r\n\t\tvar opaObj = \"\";\r\n\r\n\t\tif(obj == \"RGOOD\"){\r\n\t\ttabObj = \"goodRstTab\";\r\n\t\topaObj = \"refer\";\r\n\t\t} else if(obj == \"REFER\"){\r\n\t\ttabObj = \"referTab\";\r\n\t\topaObj = \"goodRst\";\r\n\t\t}\r\n\r\n\t\t// 음영처리\r\n\t\t$(\"#goodRstOpacity, #referOpacity\").removeClass(\"ctab_opacity\");\r\n\t\t$(\"#\" + opaObj + \"Opacity\").addClass(\"ctab_opacity\");\r\n\r\n\t\t// 성과물 탭 class 전체 제거\r\n\t\t$(\"#goodRstTab > li\").removeClass();\r\n\t\t$(\"#referTab > li\").removeClass();\r\n\r\n\t\t// 성과물 탭 활성화 관련 class 설정 (active)\r\n\t\tif(type == \"ALL\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(0).addClass(\"active\");\r\n\t\t} else if(type == \"001\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(1).addClass(\"active\");\r\n\t\t} else if(type == \"002\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(2).addClass(\"active\")\r\n\t\t} else if(type == \"003\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(3).addClass(\"active\")\r\n\t\t}\r\n\t}\r\n\r\n\tfunction fn_move_link(obj){\r\n\t\tvar pjn = $(obj).attr(\"data-pjn\");\r\n\t\tvar url = \"https://www.ntis.go.kr/project/pjtInfo.do?pjtId=\" + pjn;\r\n\t\twindow.open(url, \"_blank\");\r\n\r\n\t\tinsertInfraLog('FNCT001408','INFRAPAGE0068', url);\r\n\t}\r\n\r\n\r\n\tfunction fncAbsWordList() {\r\n\t\tvar uniqueWords = [];\r\n\r\n\t\t$(\"span.hdwrd\").each(function(idx, item) {\r\n\t\tvar txt = $(item).text();\r\n\t\tvar wrdId = $(item).attr(\"id\");\r\n\t\t/* \t\t//0번째 값은 PCR로 고정\r\n                        if (false) {\r\n\t\t    if (idx == 0) {\r\n\t\t        var txt = \"PCR\";\r\n\t\t        var wrdId = \"PCR\";\r\n\t\t    }\r\n\t\t}\r\n\t\t */\r\n\r\n\t\t//txt를 새로운 배열에 넣을때 배열안에 값이 존재하면 넣지 않음\r\n\t\tif (!uniqueWords.includes(txt)) {\r\n\t\tuniqueWords.push(txt);\r\n\r\n\t\t//용어보기 클릭시 인덱스 1번째 값으로 표제어~용어설명까지 값을 표출하게 만들어줌\r\n\t\tif (idx == 0) {\r\n\t\tvar sDd = $('#sDd dd').text(txt);\r\n\t\tfncViewWord(wrdId, true, txt);\r\n\t\t}\r\n\r\n\t\tvar btn = $(\"<button></button>\").attr(\"type\", \"button\").attr(\"data-hdwrd-id\", wrdId)\r\n\t\t.attr(\"data-hdwrd-title\", txt).addClass(\"btns side-round tab-btn hdwrdBtn\");\r\n\t\tif (idx == 0) {\r\n\t\t$(btn).addClass(\"active\");\r\n\t\t}\r\n\t\t$(btn).text(txt).appendTo(\".hdwrdLst\");\r\n\t\t$(item).addClass(\"modal-open-close\").attr(\"data-kisti-modal\", \"#abstractWord\");\r\n\t\t$(item).on(\"click\", function() {\r\n\t\t$(\"#abstractWord\").show();\r\n\t\tfncViewWord(wrdId, true, txt);\r\n\t\t});\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t$(\"button.hdwrdBtn\").on(\"click\", function(e) {\r\n\t\tvar dataTxt = $(e.target).attr(\"data-hdwrd-title\");\r\n\t\tvar dataId = $(e.target).attr(\"data-hdwrd-id\");\r\n\t\t$(\".hdwrdBtn\").removeClass(\"active\");\r\n\t\t$(e.target).addClass(\"active\");\r\n\t\tfncViewWord(dataId, true, dataTxt);\r\n\t\t});\r\n\r\n\t\t$(\"#abstractWord\").on(\"click\", \".abstract-word-box dd:eq(2) .jum-ul .src-list\", function(e) {\r\n\t\te.preventDefault();\r\n\t\t$(\".abstract-word-box dd:eq(2) ul a.src-list\").removeClass(\"active\");\r\n\t\t$(this).addClass(\"active\");\r\n\t\tvar wordId = $(this).data(\"word-id\");\r\n\t\t$(\".abstract-word-box dd:eq(3) .desc-word\").addClass(\"none\");\r\n\t\t$(\".abstract-word-box dd:eq(3) .desc-word#word_\" + wordId).removeClass(\"none\");\r\n\t\tinsertBhvrLog($.extend({ 'sourceId': wordId, 'bhvrNo': '220', 'evntNo': '01' }, bhvrLogOption));\r\n\t\t});\r\n\t}\r\n\r\n\tfunction fncViewWord(hdwrdId, scroll, selTitle){\r\n\t\t$(\".hdwrdBtn\").removeClass(\"active\")\r\n\t\t$(\".hdwrdBtn\").filter(function() {\r\n\t\treturn $(this).attr(\"data-hdwrd-id\") == hdwrdId;\r\n\t\t}).addClass(\"active\");\r\n\t\t$.ajax({\r\n\t\turl : \"selectPORSrchArticleWord.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata: \"hdwrdId=\"+hdwrdId,\r\n\t\tsuccess: function(json){\r\n\t\tvar surfaceWordList = json.resultList.surfaceWordList;\r\n\t\tvar wordDesList = json.resultList.wordDesList;\r\n\t\t$(\".abstract-word-box dd:eq(0)\").html(\"\");\r\n\t\t$(\".abstract-word-box dd:eq(1)\").html(\"\");\r\n\t\tvar num = 1;\r\n\t\tvar synonym = \"\";\r\n\t\t$.each( surfaceWordList, function( key, value ){\r\n\t\tif(value.surwrdSeCd == \"ET\"){\r\n\t\t$(\".abstract-word-box dd:eq(0)\").text(value.surwrdNm);\r\n\t\t}else{\r\n\t\tif(num === 1){\r\n\t\tsynonym = value.surwrdNm;\r\n\t\t$(\".abstract-word-box dd:eq(1)\").text(synonym);\r\n\t\t}else{\r\n\t\tsynonym += ', ' + value.surwrdNm;\r\n\t\t$(\".abstract-word-box dd:eq(1