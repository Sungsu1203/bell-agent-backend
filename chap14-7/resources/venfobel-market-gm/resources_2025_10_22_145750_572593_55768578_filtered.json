t<dd>\r\n\t\t<ul>\r\n\t\t</ul>\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t</div>\r\n\t\t<button type=\"submit\" class=\"tsb-btn flex-center\"><span class=\"ico\"><i class=\"far fa-search\"></i></span><em>검색</em></button>\r\n\t\t<a href=\"javascript:;\" onclick=\"fn_srchDetailMove();\" class=\"tsb-detail-btn slide-open-close\">상세검색</a>\r\n\t\t</div>\r\n\t\t</form>\r\n\t\t<!-- } 검색 바 -->\r\n\r\n\t\t<!-- 인기키워드 슬라이드 { -->\r\n\t\t<div class=\"tsb-keyword-slide\" id=\"kywd-slide\">\r\n\t\t<ul class=\"swiper-wrapper\">\r\n\t\t<li class=\"swiper-slide\">\r\n\t\t<dl class=\"flex-start\">\r\n\t\t<dt>인기검색어</dt>\r\n\t\t<dd class=\"flex-start\" id=\"srchKywdList\">\r\n\r\n\t\t\r\n\t\t\r\n\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<!-- \t\tdata-bhvr-no=\"15\" -->\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<!-- \t\t> -->\r\n\t\t\r\n\t\t<!-- \t\t</a> -->\r\n\t\t\r\n\t\t\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t<li class=\"swiper-slide\">\r\n\t\t<dl class=\"flex-start\">\r\n\t\t<dt>급상승검색어</dt>\r\n\t\t<dd class=\"flex-start\" id=\"srchSoaringKywdList\">\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<!-- \t\tdata-bhvr-no=\"16\" -->\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<!-- \t\t> -->\r\n\t\t\r\n\t\t<!-- \t\t</a> -->\r\n\t\t\r\n\t\t\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t</li>\r\n\t\t\r\n\t\t\r\n\t\t</ul>\r\n\t\t<div class=\"slide-control flex-end\">\r\n\t\t<button type=\"button\" class=\"sc-btn swiper-button swiper-prev\" id=\"kywd-swperPrevBtn\"><i class=\"far fa-chevron-up\"></i></button>\r\n\t\t<button type=\"button\" class=\"sc-btn play-pause-btn\" id=\"kywd-pauseBtn\">\r\n\t\t<!--<i class=\"fas fa-play\"></i>-->\r\n\t\t<i class=\"fas fa-pause\"></i>\r\n\t\t</button>\r\n\t\t<button type=\"button\" class=\"sc-btn swiper-button swiper-next\" id=\"kywd-swperNextBtn\"><i class=\"far fa-chevron-down\"></i></button>\r\n\t\t</div>\r\n\r\n\t\t<script>\r\n\t\tvar kywdswiper = new Swiper(\"#kywd-slide\", {\r\n\t\tdirection: \"vertical\",\r\n\t\tloop: true,\r\n\t\tobserver: true,\r\n\t\tobserveParents: true,\r\n\t\tautoplay: {\r\n\t\tdelay: 2500,\r\n\t\tdisableOnInteraction: false,\r\n\t\tpauseOnMouseEnter : true,\r\n\t\t},\r\n\t\tnavigation: {\r\n\t\tnextEl: \"#kywd-slide #kywd-swperNextBtn\",\r\n\t\tprevEl: \"#kywd-slide #kywd-swperPrevBtn\",\r\n\t\t},\r\n\t\t});\r\n\r\n\t\tvar sw = 0;\r\n\t\t$('#kywd-pauseBtn').click(function(){\r\n\r\n\t\tif(sw==0){\r\n\t\t$('#kywd-pauseBtn').html(\"\");\r\n\t\t$('#kywd-pauseBtn').append('<i class=\"fas fa-play\"></i>');\r\n\t\tkywdswiper.autoplay.stop();\r\n\t\tsw = 1;\r\n\t\t}else{\r\n\t\t$('#kywd-pauseBtn').html(\"\");\r\n\t\t$('#kywd-pauseBtn').append('<i class=\"fas fa-pause\"></i>');\r\n\t\tkywdswiper.autoplay.start();\r\n\t\tsw = 0;\r\n\t\t}\r\n\t\t});\r\n\t\t</script>\r\n\t\t</div>\r\n\t\t<!-- } 인기키워드 슬라이드 -->\r\n\t\t<!-- SAI 버튼 { -->\r\n\r\n\t\t<a href=\"/aiq/aisearch/searchMain.do\" class=\"sai_bt_link sai_bt_l_type02\" target=\"_blank\">\r\n\t\t<div class=\"sai_t_box\">\r\n\t\t<div class=\"sai_t01\">Science<span>ON</span></div>\r\n\t\t<div class=\"sai_t02\">AI검색</div>\r\n\t\t</div> \r\n\t\t<div class=\"sai_bt_02\">\r\n\t\t<p>SAI</p>\r\n\t\t</div>\r\n\t\t</a>\r\n\t\t<script>\r\n\t\t$(document).ready(function(){\r\n\t\tvar saiBt01 = document.querySelector('.sai_t01');\r\n\t\tvar saiBt02 = document.querySelector('.sai_t02');\r\n\t\tvar saiBt01Container = document.querySelector('.sai_t_box');\r\n\t\tvar saiBt02Container = document.querySelector('.sai_bt_02');\r\n\t\r\n\t\t// 애니메이션 시간 설정\r\n\t\tvar typingDuration = 5; // 각 줄의 타이핑 시간 (초)\r\n\t\tvar pauseDuration = 0; // 두 타이핑 사이의 대기 시간 (초)\r\n\t\tvar overlayDuration = 10; // 검은 박스 애니메이션 시간 (초)\r\n\t\r\n\t\tvar totalTime = 0;\r\n\t\r\n\t\t// 애니메이션 실행\r\n\t\tfunction startTypingEffect() {\r\n\t\t// 첫 번째 문장 애니메이션\r\n\t\tsetTimeout(function () {\r\n\t\tsaiBt01.style.animation = \"none\";\r\n\t\tvoid saiBt01.offsetWidth; // 리플로우 강제\r\n\t\tsaiBt01.style.animation = \"\";\r\n\t\tsaiBt01.style.animation = \"typing \" + typingDuration + \"s steps(30) 1 forwards running\";\r\n\t\tsaiBt02.style.animation = \"none\";\r\n\t\tvoid saiBt02.offsetWidth;\r\n\t\tsaiBt02.style.animation = \"\";\r\n\t\tsaiBt02.style.animation = \"typing02 \" + typingDuration + \"s steps(30) 1\";\r\n\t\t}, totalTime * 1000);\r\n\t\ttotalTime += typingDuration;\r\n\t\r\n\t\t// 두 번째 문장 애니메이션\r\n// \t\tsetTimeout(function () {\r\n// \t\tsaiBt02.style.animation = \"none\";\r\n// \t\tvoid saiBt02.offsetWidth; // 리플로우 강제\r\n// \t\tsaiBt02.style.animation = \"\";\r\n// \t\tsaiBt02.style.animation = \"typing \" + typingDuration + \"s steps(30)\";\r\n// \t\t}, (totalTime + pauseDuration) * 1000);\r\n// \t\ttotalTime += typingDuration + pauseDuration;\r\n\t\r\n\t\t// 검정 박스 덮기\r\n\t\tsetTimeout(function () {\r\n\t\tsaiBt01.style.width = '0';\r\n\t\tsaiBt02.style.width = '0';\r\n\t\r\n\t\tsaiBt01Container.classList.add('aib_hidden'); // sai_t01 disappears\r\n\t\tsaiBt02Container.classList.add('aib_visible'); // sai_t02 appears\r\n\t\t}, totalTime * 1000);\r\n\t\ttotalTime += overlayDuration;\r\n\t\t\r\n\t\t// 검정 박스 다시 숨기기 (재시작)\r\n\t\tsetTimeout(function () {\r\n\t\tsaiBt01.style.width = '0';\r\n\t\tsaiBt02.style.width = '0';\r\n\t\r\n\t\tsaiBt01Container.classList.remove('aib_hidden'); // sai_t01 disappears\r\n\t\tsaiBt02Container.classList.remove('aib_visible'); // sai_t02 appears\r\n\t\tstartTypingEffect(); // 반복 실행\r\n\t\t}, totalTime * 1000);\r\n\t\t}\r\n\t\r\n\t\tsetInterval(function () {\r\n\t\tstartTypingEffect();\r\n\t\t}, totalTime * 1000);\r\n\t\r\n\t\t// 애니메이션 시작\r\n\t\tstartTypingEffect();\r\n\t\t});\r\n\t\t</script>\r\n\t\t<!-- } SAI 버튼 -->\r\n\t</div>\r\n\r\n\t<button type=\"button\" class=\"flex-center tsb-onoff-btn\"><span class=\"ico\"><i class=\"far fa-search\"></i></span><em>통합검색</em></button>\r\n</aside>\r\n<!-- } 통합 검색 바 -->\r\n\r\n\r\n<form id=\"bhvrLogForm\" name=\"bhvrLogForm\">\r\n\t<input type=\"hidden\" name=\"logNo\" value=\"202510223044754017\">\r\n\t<input type=\"hidden\" name=\"urlNo\" value=\"PG023\">\r\n\t<input type=\"hidden\" name=\"bhvrSaveChk\" value=\"Y\">\r\n</form>\r\n\r\n<!-- 상세검색  str-->\r\n<aside id=\"detailSearchModal\" class=\"modal size-big detail-search-modal\">\r\n\t<script>\r\n\t\t/* 사이드 컨텐츠 ON/OFF */\r\n\t\t$(document).on(\"click\", \".side-open-close\", function(event){\r\n\r\n\t\tvar sidePop = $(this).attr('data-side-target');\r\n\r\n\t\tif ($(sidePop).hasClass('side-open')) {\r\n\t\t$('.side-pop').fadeOut('fast').removeClass('side-open');\r\n\t\t//insertBhvrLog({'bhvrNo' : '483','evntNo' : '01', 'urlNo' : \"PG023\"});\r\n\t\t} else {\r\n\t\t$('.side-pop').fadeOut('fast').removeClass('side-open');\r\n\t\t$(sidePop).fadeIn('fast').addClass('side-open');\r\n\t\t}\r\n\t\t});\r\n\t</script>\r\n</aside>\r\n<!--상세검색  end-->\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/sso_service.css?v=20221206_3\" />\r\n\t<!-- 연합인증 오픈 버튼 { -->\r\n\t<button type=\"button\" class=\"sso-service-btn \" style=\"display:none;\">\r\n\t\t<span class=\"ico\"><img src=\"/images/sso_mark.png\" alt=\"연합인증 아이콘\"/></span>\r\n\t\t<em>한번의 인증절차만으로<br />NTIS, DataON, EDISON,<br />KAFE 등의 서비스 이용이<br />가능합니다.</em>\r\n\t</button>\r\n\t<!-- } 연합인증 오픈 버튼 -->\r\n\t<!-- 연합인증 { -->\r\n\t\r\n\t<div class=\"alliance-wrapper\">\r\n\t\t<div class=\"aw-top\">\r\n\t\t<h1>연합인증</h1>\r\n\t\t<div class=\"arrow-close\">\r\n\t\t<button type=\"button\" class=\"move-btn move-prev\"><img src=\"/images/alliance_ico_arrow_left.png\" alt=\"뒤로\" /></button>\r\n\t\t<button type=\"button\" class=\"move-btn move-next\"><img src=\"/images/alliance_ico_arrow_right.png\" alt=\"앞으로\" /></button>\r\n\t\t<button type=\"button\" class=\"alliance-close-btn\"><img src=\"/images/alliance_ico_close.png\" alt=\"닫기\" /></button>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"choice-alliance\">\r\n\t\t<button type=\"button\" class=\"ca-btn alliance-btn ntis\" onClick=\"fncViewCont('ntis');\"><img src=\"/images/alliance_mark_ntis.png\" alt=\"NTIS\" /></button>\r\n\t\t<button type=\"button\" class=\"ca-btn alliance-btn dataon\" onClick=\"fncViewCont('dataon');\"><img src=\"/images/alliance_mark_dataon.png\" alt=\"지금 바로! Data on\" /></button>\r\n\t\t<button type=\"button\" class=\"ca-btn alliance-btn edison\" onClick=\"fncViewCont('edison');\"><img src=\"/images/alliance_mark_edison.png\" alt=\"EDISON\" /></button>\r\n\t\t<button type=\"button\" class=\"ca-btn alliance-btn kafe\" onClick=\"fncViewCont('kafe');\"><img src=\"/images/alliance_mark_kafe.png\" alt=\"KAFE\" /></button>\r\n\t\t</div>\r\n\t\t<div class=\"alliance-container scrollbox\">\r\n\t\t<!-- 연합인증 가이드 { -->\r\n\t\t<section id=\"startGuide\" class=\"alliance-con start-guide\" data-infra=\"intro\">\r\n\t\t<div class=\"guide-txtbox\">\r\n\t\t연합인증 가입 기관의 연구자들은 소속기관의 인증정보(ID와 암호)를 이용해 다른 대학, 연구기관, 서비스 공급자의 다양한 온라인 자원과 연구 데이터를 이용할 수 있습니다.<br /><br />\r\n\r\n\t\t이는 여행자가 자국에서 발행 받은 여권으로 세계 각국을 자유롭게 여행할 수 있는 것과 같습니다.<br /><br />\r\n\r\n\t\t연합인증으로 이용이 가능한 서비스는 NTIS, DataON, Edison, Kafe, Webinar 등이 있습니다.<br /><br />\r\n\r\n\t\t한번의 인증절차만으로 연합인증 가입 서비스에 추가 로그인 없이 이용이 가능합니다.<br /><br />\r\n\r\n\t\t다만, 연합인증을 위해서는 최초 1회만 인증 절차가 필요합니다. (회원이 아닐 경우 회원 가입이 필요합니다.)<br /><br />\r\n\r\n\t\t연합인증 절차는 다음과 같습니다.<br /><br />\r\n\r\n\t\t최초이용시에는<br />\r\n\t\tScienceON에 로그인 → 연합인증 서비스 접속 → 로그인 (본인 확인 또는 회원가입) → 서비스 이용<br /><br />\r\n\r\n\t\t그 이후에는<br />\r\n\t\tScienceON 로그인 → 연합인증 서비스 접속 → 서비스 이용<br /><br />\r\n\t\t\r\n\t\t연합인증을 활용하시면 KISTI가 제공하는 다양한 서비스를 편리하게 이용하실 수 있습니다.\r\n\t\t</div>\r\n\t\t\r\n\t\t<div class=\"btn-area\">\r\n\t\t<button type=\"button\" class=\"btns scienceon-login-btn alliance-btn\" onClick=\"fncViewCont('login');\">ScienceON 로그인</button>\r\n\t\t<button type=\"button\" class=\"btns ntis-link-btn\" id=\"directBtn\" style=\"display: none\">NTIS 이동</button>\r\n\t\t</div>\r\n\t\t\r\n\t\t</section>\r\n\t\t<!-- } 연합인증 가이드 -->\r\n\t\t\r\n\t\t<!-- 연합인증 로그인 { -->\r\n\t\t<section id=\"allianceLogin\" class=\"alliance-con alliance-login\" style=\"display: none;\" data-infra=\"login\">\r\n\t\t<div class=\"login-area\">\r\n\t\t<p class=\"guide\">로그인시 본인확인과정이 필요할 수 있습니다.</p>\r\n\t\t<form id=\"loginForm\" method=\"post\">\r\n\t\t<input type=\"hidden\" name=\"socialTypeCode\" value=\"0001\">\r\n\t\t<ul>\r\n\t\t<li>\r\n\t\t<input type=\"text\"  maxlength=\"50\" title=\"아이디\" name=\"loginId\" onkeypress=\"javascript:if(event.keyCode == 13){fn_login_idp(); return false;}\" class=\"login-input\" placeholder=\"아이디를 입력해주세요\" tabindex=\"1\"/>\r\n\t\t<div class=\"cant-think\">\r\n\t\t<a href=\"javascript:;\" onclick=\"fn_searchPagePopup('loginId');\">아이디가 기억나지 않으십니까?</a>\r\n\t\t<div class=\"remember-id\">\r\n\t\t<label style=\"padding-bottom: 0;\"><input type=\"checkbox\" id=\"idSaveCheck\" style=\"margin-top: -3px;\">아이디 저장</label>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<input type=\"password\" maxlength=\"80\" title=\"비밀번호\" name=\"pasword\" onkeypress=\"javascript:fn_keyPress(event);\"  class=\"login-input\" placeholder=\"비밀번호를 입력해주세요\" autocomplete=\"off\" tabindex=\"2\"/>\r\n\t\t<div class=\"welcometext\" style=\"display: none;\"><b>CapsLock</b>이 켜져 있습니다.</div>\r\n\t\t<div class=\"cant-think\">\r\n\t\t<a href=\"javascript:;\" onclick=\"fn_searchPagePopup('pw');\">비밀번호가 기억나지 않으십니까?</a>\r\n\t\t</div>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t<button type=\"button\" class=\"btns scienceon-login-btn\" onclick=\"fn_login_idp()\" tabindex=\"3\">ScienceON 로그인</button>\r\n\t\t</form>\r\n\t\t<div class=\"other-login\">\r\n\t\t<a href=\"javascript:socialLoginPop('0002');\"><img src=\"/images/usr/ico_naver.png\" alt=\"네이버로그인\" width=\"44\" height=\"41\" tabindex=\"4\"></a>\r\n\t\t<a href=\"javascript:socialLoginPop('0003');\"><img src=\"/images/usr/ico_kakao.png\" alt=\"카카오로그인\" width=\"44\" height=\"41\" tabindex=\"5\"></a>\r\n\t\t<a href=\"javascript:socialLoginPop('0006');\"><img src=\"/images/usr/ico_kosen.png\" alt=\"KOSEN로그인\" width=\"44\" height=\"41\" tabindex=\"6\"></a>\r\n\t\t<a href=\"javascript:socialLoginPop('0009');\"><img src=\"/images/usr/ico_AccessON.png\" alt=\"AccessON로그인\" width=\"44\" height=\"41\" tabindex=\"7\"></a>\r\n\t\t<a href=\"javascript:socialLoginPop('0007');\"><img src=\"/images/usr/ico_ntis.png\" alt=\"NTIS로그인\" width=\"44\" height=\"41\" tabindex=\"8\"></a>\r\n\t\t<a href=\"javascript:socialLoginPop('0008');\"><img src=\"/images/usr/ico_kafe@2x.png\" alt=\"KAFE 로그인\" width=\"44\" height=\"41\" tabindex=\"9\"></a>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"join-go\">\r\n\t\tScienceON을 처음 이용하시나요?\r\n\t\t<a href=\"/mems/selectEmailAuthRgt.do?linkAllowYn=Y&\" class=\"join-btn\">회원가입</a>\r\n\t\t</div>\r\n\t\t<form name=\"memberVO\" id=\"kafeMemberVO\" method=\"post\" action=\"\">\r\n\t\t<input type=\"hidden\" name=\"socialTypeCode\" value=\"0008\">\r\n\t\t<input type=\"hidden\" name=\"emailAddr\" id=\"spEmail\">\r\n\t\t<input type=\"hidden\" name=\"name\" id=\"spName\">\r\n\t\t<input type=\"hidden\" name=\"socialUrlKey\" id=\"spSocialUrlKey\" >\r\n\t\t<input type=\"hidden\" name=\"insttNm\" id=\"spInsttNm\">\r\n\t\t</form>\t\r\n\t\t</section>\r\n\t\t<!-- } 연합인증 로그인 -->\r\n\t\t\r\n\t\t<!-- 연합인증 NTIS { -->\r\n\t\t<section id=\"allianceNtis\" class=\"alliance-con\" data-infra=\"ntis\">\r\n\t\t<div class=\"login-guide\">\r\n\t\t\r\n\t\t\r\n\t\t<p>다음과 같은 기능을 한번의 로그인으로 사용 할 수 있습니다.</p>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<a href=\"https://www.ntis.go.kr/\" target=\"_blank\">NTIS 바로가기 <span><img src=\"/images/ico_outlink.png\" alt=\"NTIS 바로가기\"></span></a>\r\n\t\t</div>\r\n\t\t<div class=\"fnct-list\">\r\n\t\t</div>\r\n\t\t</section>\r\n\t\t<!-- } 연합인증 NTIS -->\r\n\t\t\r\n\t\t<!-- 연합인증 Data On { -->\r\n\t\t<section id=\"allianceDataon\" class=\"alliance-con\" style=\"display: none;\" data-infra=\"dataon\">\r\n\t\t<div class=\"login-guide\">\r\n\t\t\r\n\t\t\r\n\t\t<p>다음과 같은 기능을 한번의 로그인으로 사용 할 수 있습니다.</p>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<a href=\"https://dataon.kisti.re.kr/\" target=\"_blank\">DataON 바로가기 <span><img src=\"/images/ico_outlink.png\" alt=\"DataON 바로가기\"></span></a>\r\n\t\t</div>\r\n\t\t<div class=\"fnct-list\">\r\n\t\t</div>\r\n\t\t</section>\r\n\t\t<!-- } 연합인증 Data On -->\r\n\t\t\r\n\t\t<!-- 연합인증 EDISON { -->\r\n\t\t<section id=\"allianceEdison\" class=\"alliance-con\" style=\"display: none;\"  data-infra=\"edison\">\r\n\t\t<div class=\"login-guide\">\r\n\t\t\r\n\t\t\r\n\t\t<p>다음과 같은 기능을 한번의 로그인으로 사용 할 수 있습니다.</p>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<a href=\"https://www.edison.re.kr/\" target=\"_blank\">Edison 바로가기 <span><img src=\"/images/ico_outlink.png\" alt=\"Edison 바로가기\"></span></a>\r\n\t\t</div>\r\n\t\t<div class=\"fnct-list\">\r\n\t\t</div>\r\n\t\t</section>\r\n\t\t<!-- } 연합인증 EDISON -->\r\n\t\t\r\n\t\t<!-- 연합인증 KAFE { -->\r\n\t\t<section id=\"allianceKafe\" class=\"alliance-con\" style=\"display: none;\"  data-infra=\"kafe\">\r\n\t\t<div class=\"login-guide\">\r\n\t\t\r\n\t\t\r\n\t\t<p>다음과 같은 기능을 한번의 로그인으로 사용 할 수 있습니다.</p>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<a href=\"https://www.kafe.or.kr/\" target=\"_blank\">Kafe 바로가기 <span><img src=\"/images/ico_outlink.png\" alt=\"Kafe 바로가기\"></span></a>\r\n\t\t</div>\r\n\t\t<div class=\"fnct-list\">\r\n\t\t</div>\r\n\t\t</section>\r\n\t\t<!-- } 연합인증 KAFE -->\r\n\t\t\r\n\t\t<div class=\"today-notview\" style=\"display: none\">\r\n\t\t<label for=\"todayNotView\"><input type=\"checkbox\" id=\"todayNotView\"> 오늘 하루 열지 않기</label>\r\n\t\t<button class=\"alliance-close-btn\">닫기</button>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t\r\n\t\t<div id=\"idpFnctLoading\"></div>\r\n\t</div>\r\n\r\n\t<script>\r\n\t\r\n\tfunction fn_idpFnctList(pageName, pageIndex){\r\n\t\tvar srvcId = \"\";\r\n\t\tvar targetId = \"allianceNtis\";\r\n\t\tif(pageName==\"ntis\"){\r\n\t\tsrvcId = \"SRVC000001\";\r\n\t\ttargetId = \"allianceNtis\";\r\n\t\t}else if(pageName==\"dataon\"){\r\n\t\tsrvcId = \"SRVC000041\";\r\n\t\ttargetId = \"allianceDataon\";\r\n\t\t}else if(pageName==\"edison\"){\r\n\t\tsrvcId = \"SRVC000018\";\r\n\t\ttargetId = \"allianceEdison\";\r\n\t\t}else if(pageName==\"kafe\"){\r\n\t\tsrvcId = \"SRVC000015\";\r\n\t\ttargetId = \"allianceKafe\";\r\n\t\t}\r\n\t\tvar subdoctype = [];\r\n\t\tvar cn = [];\r\n\t\tvar url = [];\r\n\t\t$.ajax({\r\n\t\turl: \"/srch/selectPORSrchFnctListAjax.do\",\r\n\t\tdataType: \"json\",\r\n\t\tdata: \"srvcId=\"+srvcId+\"&pageIndex=\"+pageIndex,\r\n// \t\tasync:false,\r\n\t\tbeforeSend:function(){\r\n\t\t$(\"#idpFnctLoading\").html(\"<div class=\\\"loading\\\"><h4>처리중입니다.</h4><h5>잠시만 기다려주세요.</h5></div>\");\r\n\t\tsetTimeout(function(){\r\n\t\t$(\".alliance-wrapper .loading\").show();\r\n\t\t}, 500);\r\n\t\t},\r\n\t\tcomplete:function(){\r\n\t\t$(\"#idpFnctLoading\").html(\"\")\r\n\t\t},\r\n\t\tsuccess: function(json){\r\n\t\tif(json.numFound > 0){\r\n\t\tvar html = \"<div class=\\\"alliance-list\\\">\";\r\n\t\t$.each(json.searchResult, function(key, val){\r\n\t\tcn.push(val.cn);\r\n\t\tsubdoctype.push(val.subdoctype);\r\n\t\turl.push(val.url);\r\n\t\t\r\n\t\thtml += \"<div class=\\\"alist-con\\\">\";\r\n\t\thtml += \"\t<a href=\\\"javascript:fn_gofnctIpd('\"+val.url+\"','\"+val.fnct_id+\"');\\\" class=\\\"subject\\\">\"+val.title_full+\"</a>\";\r\n\t\thtml += \"\t<p class=\\\"txt\\\">\"+val.fnct_desc+\"</p>\";\r\n\t\t\r\n\t\thtml += \"\t<div class=\\\"sharp-list\\\" id=\\\"idp_function_\"+val.fnct_id+\"\\\">\";\r\n\t\thtml += \"\t</div>\";\r\n\t\thtml += \"\t<div class=\\\"btn-area\\\">\";\r\n\t\thtml += \"\t<a href=\\\"/srch/selectPORSrchFnct.do?cn=\"+val.fnct_id+\"\\\" class=\\\"linkbox\\\" target=\\\"_blank\\\">상세정보</a>\";\r\n\t\t\r\n\t\t\r\n\t\tif(val.login_yn == \"Y\"){\r\n\t\thtml += \"\t<div class=\\\"linkbox need-login\\\">로그인 필요</div>\";\r\n\t\t}\r\n\t\tif(val.login_yn == \"N\" && val.page_login_ty == \"Y\"){\r\n\t\thtml += \"\t<div class=\\\"linkbox need-login\\\">기능 내 로그인 필요</div>\";\r\n\t\t}\r\n\t\t\r\n\t\thtml += \"\t</div>\";\r\n\t\thtml += \"</div>\";\r\n\t\t});\r\n\t\thtml += \"</div>\";\r\n\t\t\r\n\t\t\r\n\t\tvar pageInfo = json.paginationInfo;\r\n\t\tvar currentPageNo = pageInfo.currentPageNo;\r\n\t\tvar totalPageCount = pageInfo.totalPageCount;\r\n\t\tvar lastPageNo = pageInfo.lastPageNo;\r\n\t\tvar pageHtml = \"\";\r\n\t\tif(totalPageCount > 1){\r\n\t\tpageHtml += \"<div class=\\\"alliance-pagenation\\\">\";\r\n\t\tif(currentPageNo > 1){\r\n\t\tpageHtml += \" <button type=\\\"button\\\" class=\\\"p-prev\\\" onclick=\\\"fn_idpFnctList('\"+pageName+\"',\"+(currentPageNo-1)+\")\\\"><img src=\\\"/images/alliance_pagenation_prev.png\\\" alt=\\\"이전 페이지\\\"/></button>\";\r\n\t\t}\r\n\t\tpageHtml += \"\t<div class=\\\"page-info\\\"><b>\"+currentPageNo+\"</b> / \"+totalPageCount+\"</div>\";\r\n\t\tif(currentPageNo < totalPageCount){\r\n\t\tpageHtml += \" <button type=\\\"button\\\" class=\\\"p-next\\\" onclick=\\\"fn_idpFnctList('\"+pageName+\"',\"+(currentPageNo+1)+\")\\\"><img src=\\\"/images/alliance_pagenation_next.png\\\" alt=\\\"다음 페이지\\\"/></button>\";\r\n\t\t}\r\n\t\tpageHtml += \"</div>\";\r\n\t\t}\r\n\t\t\r\n\t\t$(\"#\"+targetId).find(\".fnct-list\").html(html + pageHtml);\r\n\t\tif($(\"#\"+targetId).find(\".total-cnt\").length > 0){\r\n\t\t$(\"#\"+targetId).find(\".total-cnt\").html(\"<span style=\\\"color:#055b8a\\\">\" + json.numFound + \"</span>건의 기능을 사용할 수 있습니다.\");\r\n\t\t}\r\n\t\tsetFnctIdpMoreInfo(targetId, cn, subdoctype, url);\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\tfunction setFnctIdpMoreInfo(targetId, cn, subdoctype, url){\r\n\t\tvar param = \"srchType=function\";\r\n\t\tfor(var i=0; i<cn.length; i++){\r\n\t\tparam += \"&cn=\"+cn[i]+\"&subdoctype=\"+subdoctype[i]+\"&url=\"+url[i];\r\n\t\t}\r\n\t\t\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/searchMoreInfoList.do\",\r\n\t\tdataType: 'json',\r\n\t\ttype:'post',\r\n\t\tasync:false,\r\n\t\tdata: param,\r\n\t\tsuccess: function(data){\r\n\t\tvar resultList = data.resultList;\r\n\t\t$(resultList).each(function(index, item){\r\n\t\thtml = \"\";\r\n\t\tfor(i=0; i<item.fnctArrList.length; i++){\r\n\t\thtml += \"<a href=\\\"javascript:;\\\">#\"+item.fnctArrList[i].largeMenu+\"</a>\";\r\n\t\t}\r\n\t\tif(html != \"\"){\r\n\t\t$(\"#idp_function_\"+item.cn).html(html);\r\n\t\t} \r\n\t\t});\r\n\t\t\r\n\t\t$(\"#\"+targetId).find(\".fnct-list\").show();\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\tfunction fn_gofnctIpd(url,cn){\r\n\t\t//KOSEN URL에 로그인 필요인 항목일 때 연동 로그인 띄우기\r\n\t\tif(url.indexOf(\"kosen\")>-1){\r\n\t\tif($(\"#function_inner_\"+cn).find(\".flag_must\").length>0){\r\n\t\turl = \"/common/moveInfra.do?infra=kosen&url=\"+url;\r\n\t\t}\r\n\t\t}\r\n\t\tinsertSystemLogInfo(\"linkYn=Y&useContCd=0005&linkURL=\"+url+\"&cn=\"+cn);\r\n\t\twindow.open(url,\"_blank\");\r\n\t}\r\n\t\r\n\tfunction setCookieIdp( name, value, expiredays ) {\r\n\t\tvar todayDate = new Date();\r\n\t\ttodayDate.setDate( todayDate.getDate() + expiredays );\r\n\t\tdocument.cookie = name + \"=\" + escape( value ) + \"; path=/; expires=\" + todayDate.toGMTString() + \";\"\r\n\t}\r\n\r\n\tfunction deleteCookieIdp( name ) {\r\n\t\tvar todayDate = new Date();\r\n\t\ttodayDate.setDate( todayDate.getDate()-1 );\r\n\t\tdocument.cookie = name + \"=; path=/; expires=\" + todayDate.toGMTString() + \";\"\r\n\t}\r\n\r\n\tfunction getCookieIdp( name ){\r\n\t\tvar nameOfCookie = name + \"=\";\r\n\t\tvar x = 0;\r\n\t\twhile (x <= document.cookie.length){\r\n\t\tvar y = (x + nameOfCookie.length);\r\n\t\tif(document.cookie.substring(x,y) == nameOfCookie){\r\n\t\tif((endOfCookie = document.cookie.indexOf(\";\", y)) == -1){\r\n\t\tendOfCookie = document.cookie.length;\t\t\r\n\t\t}\r\n\t\treturn unescape(document.cookie.substring(y, endOfCookie));\r\n\t\t}\r\n\t\tx = document.cookie.indexOf(\" \", x) + 1;\r\n\t\tif(x==0)break;\r\n\t\t}\r\n\t\treturn \"\";\r\n\t}\r\n\t\r\n\tfunction fncViewCont(pageName){\r\n\t\tif(pageName != \"intro\" && pageName != \"login\"){\r\n\t\tfn_idpFnctList(pageName, 1);\r\n\t\t}\r\n\t\t\r\n\t\tif(!$('.alliance-wrapper').hasClass('open')) {\r\n\t\t$('.alliance-wrapper').addClass('open');\r\n\t\t}\r\n\t\t\r\n\t\t/*상단 아이콘 영역 활성화*/\r\n\t\t$(\".choice-alliance\").removeClass(\"on\");\r\n\t\t$(\".choice-alliance