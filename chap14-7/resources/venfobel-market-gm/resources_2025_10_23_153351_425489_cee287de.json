 href=\"#sect_citing\" class=\"pagelink\" title=\"이 논문을 인용한 문헌 바로가기\"><span>이 논문을 인용한 문헌</span></a></li>\r\n\t\t\r\n\t\t<li id=\"link_idAuthor\"><a href=\"#sect_idAuthor\" class=\"pagelink\" title=\"저자의 다른 논문 바로가기\"><span>저자의 다른 논문</span></a></li>\r\n\t\t\r\n\t\t\r\n\t\t<li id=\"link_timeline\"><a href=\"#sect_timeline\" class=\"pagelink\" title=\"연구과제 타임라인 바로가기\"><span>연구과제 타임라인</span></a></li>\r\n\t\t\r\n\t\t\r\n\t\t<li id=\"link_anal\"><a href=\"#sect_anal\" class=\"pagelink\" title=\"활용도 분석정보 바로가기\"><span>활용도 분석정보</span></a></li>\r\n\t\t<li id=\"link_top\"><a href=\"#sect_top\" class=\"pagelink\" title=\"활용도 Top5 논문 바로가기\"><span>활용도 Top5 논문</span></a></li>\r\n\t\t\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t<!-- //fullpage nav -->\r\n\t\t<script>\r\n\t\t$(function() {\r\n\t\t$(\"ul.smooth-all li a\").on(\"click\", function(e) {\r\n\t\t$(\"ul.smooth-all li\").removeClass(\"active\");\r\n\t\t$(e.target).closest(\"li\").addClass(\"active\");\r\n\t\tinsertBhvrLog({'bhvrNo' : '963','evntNo' : '01', 'urlNo' : \"PG023\", 'depth1' : $(this).text()});\r\n\t\t});\r\n\t\t});\r\n\t\t</script>\r\n\t\r\n\t\r\n\t\r\n</div>\r\n\r\n<div class=\"all-mnu-shadow\"></div>\r\n\r\n<section class=\"ai-helper-chat mode-side-slide\">\r\n\t<div class=\"ahc-box\">\r\n\t\t<!-- AI Helper // 최상단 제목 { -->\r\n\t\t<h2 class=\"top-guide\">\r\n\t\t<em>AI-Helper</em>\r\n\t\t<span>※ AI-Helper는 <a href=\"#;\" class=\"color-yellow modal-open-close\" data-kisti-modal=\"#openSourceNotice\">오픈소스 모델</a>을 사용합니다.</span>\r\n\t\t<button type=\"button\" class=\"ai-helper-btn\" style=\"top:10px;\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</h2>\r\n\t\t<!-- } AI Helper // 최상단 제목 -->\r\n\r\n\t\t<!-- AI Helper // 상단 옵션 { -->\r\n\t\t<aside class=\"top-option flex-spacebetween\">\r\n\t\t<dl class=\"ai-choice flex-start\" style=\"gap: 10px;\">\r\n\t\t<dt class=\"fsize13\"><span class=\"fsize16\"><i class=\"fal fa-robot\"></i></span></dt>\r\n\t\t<dd>\r\n\t\t<select id=\"sel-model\" class=\"basic-select fsize13\" title=\"AI Helper\">\r\n\t\t<option value=\"IM\" selected>로컬모델(ScienceON)</option>\r\n\t\t<option value=\"OM\">상용모델(ChatGPT)</option>\r\n\t\t</select>\r\n\t\t</dd>\r\n\t\t</dl>\r\n\r\n\t\t<div class=\"right-area flex-end\">\r\n\t\t<!--<button type=\"button\" class=\"btns side-round flex-center openai-key-btn modal-open-close\" data-kisti-modal=\"#openAIKeyModal\"><em>OpenAI Key 관리</em><span class=\"btns side-round size-small btn-gray\">없음</span></button>-->\r\n\t\t<button id=\"btn-openai-key-mgr\" type=\"button\" style=\"display:none;\" class=\"btns side-round flex-center2\" data-kisti-modal=\"#openAIKeyModal\">\r\n\t\t<span id=\"btn-openai-key\" class=\"openai-key-btn modal-open-close\" data-kisti-modal=\"#openAIKeyModal\"><em>OpenAI Key 관리</em></span>\r\n\t\t<span id=\"btn-openai-key-del\" class=\"btns side-round size-small btn-red\" style=\"display:none\">삭제</span>\r\n\t\t<span id=\"msg-openai-key-del\" class=\"btns side-round size-small modal-open-close\" data-kisti-modal=\"#openAIKeyModal\" style=\"display:none;background-color: #999;color:#fff;line-height: 22px;\">없음</span>\r\n\t\t</button>\r\n\t\t<button id=\"msger-reset-btn\" type=\"button\" class=\"btns msger-reset-btn btn-onlyicon hover-btn-blue-line fsize16\"><i class=\"fal fa-broom\"></i><span class=\"tooltip\" style=\"--tooltip-width: 90px;\">대화내용 삭제</span></button>\r\n\t\t<button id=\"msger-store-btn\" type=\"button\" class=\"btns btn-onlyicon hover-btn-blue-line fsize16\"><i class=\"fal fa-download\"></i><span class=\"tooltip\" style=\"--tooltip-width: 70px;\">다운로드</span></button>\r\n\t\t</div>\r\n\t\t</aside>\r\n\t\t<!-- } AI Helper // 상단 옵션 -->\r\n\r\n\t\t<!-- AI Helper // 채팅 폼 { -->\r\n\t\t<article class=\"chat-msg-box in-text-option scrollbox\"> <!-- 선택한 텍스트 옵션이 있을때 in-text-option 클래스 삽입 -->\r\n\t\t<div class=\"msg chat-con left-msg\">\r\n\t\t<div class=\"user-ico\"><em><img src=\"/newUI/img/aihelper/ico_aihelper_m.svg\" alt=\"AI-Helper 아이콘\"/></em></div>\r\n\t\t<div class=\"msg-box\">\r\n\t\t<div class=\"name\">AI-Helper</div>\r\n\t\t<div class=\"comment first\">\r\n\t\t안녕하세요, AI-Helper입니다. 좌측 \"선택된 텍스트\"에서 텍스트를 선택하여 요약, 번역, 용어설명을 실행하세요. <br/>\r\n\t\t<small class=\"color-red\">※ AI-Helper는 부적절한 답변을 할 수 있습니다.</small>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"time\" id=\"div-init-time\"></div>\r\n\t\t</div>\r\n\t\t</article>\r\n\t\t<div id=\"cmd-aihelper-stop\" class=\"text-option-box2 flex-center2\" style=\"display: none;bottom:0px;position:absolute;\">\r\n\t\t<button id=\"btn-req-stop\" type=\"button\" class=\"btns side-round hover-btn-blue-line\"><i class=\"far fa-pause\"></i> 생성중지</button>\r\n\t\t<span class=\"txt-caption\" id=\"txt-msg-stop\" style=\"display:none\">중지 중입니다<span class=\"blink\">...</span></span>\r\n\t\t</div>\r\n\t\t<!-- } AI Helper // 채팅 폼 -->\r\n\t</div>\r\n\r\n\t<!-- 선택된 텍스트 { -->\r\n\t<div class=\"choice-drag-txt\">\r\n\t\t<h3><em>선택된 텍스트</em></h3>\r\n\t\t<div class=\"cdt-box\" id=\"viewerAbstact\"><span id=\"text-abstract\"></span></div>\r\n\t</div>\r\n\t<!-- } 선택된 텍스트 -->\r\n</section>\r\n\r\n\n<!-- 모달팝업 // 오픈소스 모델 { -->\n<aside id=\"openSourceNotice\" class=\"modal size-small open-source-notice\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-head flex-spacebetween\">\n            <h2 class=\"modal-tit\"><b>오픈소스 모델 사용 안내</b></h2>\n            <button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#openSourceNotice\"><i class=\"fal fa-times\"></i></button>\n        </div>\n        <div class=\"modal-content\">\n            <p>\n            AI-Helper는 오픈소스 모델을 사용합니다. 사용하고 있는 오픈소스 모델과 라이센스는 아래에서 확인할 수 있습니다. <br/>\n            AI-Helper uses Open Source Models. You can find the source code of these open source models, along with applicable license information below. (<a href=\"mailto:helpdesk@kisti.re.kr\">helpdesk@kisti.re.kr</a>)</p>\n            <hr />\n            <dl class=\"openai-guide-dl\">\n                    <dt>NLLB(No Language Left Behind) 200</dt>\n                    <dd>\n                        <a href=\"https://huggingface.co/facebook/nllb-200-3.3B\" target=\"_blank\">https://huggingface.co/facebook/nllb-200-3.3B</a><br />\n                        License : cc-by-nc-4.0 (<a href=\"https://creativecommons.org/licenses/by-nc-nd/4.0/deed.ko\" target=\"_blank\">View the license</a>)\n                    </dd>\n                </dl>\n                <dl class=\"openai-guide-dl\">\n                    <dt>SciTLDR</dt>\n                    <dd>\n                        <a href=\"https://github.com/allenai/scitldr\" target=\"_blank\">https://github.com/allenai/scitldr</a><br />\n                        License : Apache-2.0 (<a href=\"https://www.apache.org/licenses/LICENSE-2.0\" target=\"_blank\">View the license</a>)\n                    </dd>\n                </dl>\n                <dl class=\"openai-guide-dl\">\n                    <dt>SOLAR-0-70b-8bit</dt>\n                    <dd>\n                        <a href=\"https://huggingface.co/upstage/SOLAR-0-70b-16bit\" target=\"_blank\">https://huggingface.co/upstage/SOLAR-0-70b-8bit</a><br />\n                        License : cc-by-nc-sa-4.0 (<a href=\"https://creativecommons.org/licenses/by-nc-nd/4.0/deed.ko\" target=\"_blank\">View the license</a>)\n                    </dd>\n                </dl>\n                <dl class=\"openai-guide-dl\">\n                    <dt>Multilingual-E5-large</dt>\n                    <dd>\n                        <a href=\"https://huggingface.co/intfloat/multilingual-e5-large\" target=\"_blank\">https://huggingface.co/intfloat/multilingual-e5-large</a><br />\n                       License : MIT (<a href=\"https://opensource.org/license/mit/\" target=\"_blank\">View the license</a>)\n                    </dd>\n                </dl>\n        </div>\n        <div class=\"modal-foot flex-center\">\n            <button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#openSourceNotice\">닫기</button>\n        </div>\n    </div>\n</aside>\n<!-- } 모달팝업 // 오픈소스 모델 -->\n\n<!-- 모달팝업 // OpenAI Key 관리 { -->\n<aside id=\"openAIKeyModal\" class=\"modal size-small open-source-notice\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-head flex-spacebetween\">\n            <h2 class=\"modal-tit\"><b>OpenAI Key 관리</b></h2>\n            <button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#openAIKeyModal\"><i class=\"fal fa-times\"></i></button>\n        </div>\n        <div class=\"modal-content\">\n            <p>\n                OpenAI의 API Key를 브라우저에 등록하여야 ChatGPT 모델을 사용할 수 있습니다.<br />\n                등록키는 삭제 버튼을 누르거나, PDF 창을 닫으면 삭제됩니다.\n            </p>\n            <dl class=\"openai-guide-dl mgt40px\">\n                <dt>OpenAI의 API Key는 다음 주소에서 발급 받을 수 있습니다.</dt>\n                <dd><a href=\"https://platform.openai.com/account/api-keys\" target=\"_blank\">https://platform.openai.com/account/api-keys</a></dd>\n            </dl>\n            <div class=\"mgt20px\">\n                <input type=\"text\" id='txt-openai-key' name='openai-key' placeholder=\"OpenAI의 API Key를 입력하고 저장 버튼 클릭하세요\" class=\"basic-input w100\" title=\"OpenAI의 API Key\"/>\n            </div>\n        </div>\n        <div class=\"modal-foot flex-center\">\n            <span id=\"openai-key-action-message\" style=\"display:none;\">등록되었습니다.</span>\n            <button type=\"button\" id='btn-save-key' class=\"btns size-big btn-blue-deep hover-btn-blue\">등록</button>\n            <button type=\"button\" id='btn-remove-key' class=\"btns size-big btn-red hover-btn-red\">삭제</button>\n            <button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#openAIKeyModal\">닫기</button>\n        </div>\n    </div>\n</aside>\n<!-- } 모달팝업 // OpenAI Key 관리 -->\n<!-- } 모달팝업 // 다른 논문 용어 설명 -->\n<form id=\"chatContentsForm\" name=\"chatContentsForm\" method=\"post\" action=\"/aiq/aihelper/AIQChatContentsExcelDown.do\">\n\t<input type=\"hidden\" name=\"artId\" value=\"\">\n</form>\n<div id=\"alert-max-length\" class=\"txt-tooltip\" style=\"--txt-tooltip-width: 220px;display: none;top: 600px;left: 200px;\">선택한 글자 수는 <b id=\"current-text-length\" class=\"color-red\"></b>입니다.<br />최대 <b id=\"max-text-length\" class=\"color-red\"></b>글자까지만 선택 가능합니다.</div> \n<div id=\"alert-nokey-chatgpt\" class=\"txt-tooltip\" style=\"--txt-tooltip-width: 240px;display: none;top: 600px;left: 200px;\"><b class=\"color-red\">OpenAI Key를 브라우저에 등록</b>하여야 상용모델(ChatGPT)을 사용할 수 있습니다.</div> \n<div id=\"article-body-command\" class=\"text-option-box flex-center2\" style=\"display:none;z-index:999;\">\n    <div class=\"inactive-box\">\n        <button id=\"ctx-summarizeId\" type=\"button\" class=\"btns side-round hover-btn-blue-line\"><i class=\"far fa-box\"></i> 요약</button>\n        <div id=\"msg-ctx-summarizeId\" class=\"txt-tooltip\" style=\"--txt-tooltip-width: 200px;\">선택한 단어 수는 <b id=\"msg-sel-len-summarize\" class=\"color-red\"></b>입니다.<br />최소 <b id=\"msg-min-len-summarize\" class=\"color-red\"></b> 단어 이상 선택하여야 합니다.</div>\n    </div>\n    <div class=\"inactive-box\">\n        <button id=\"ctx-translateTermId\" type=\"button\" class=\"btns side-round hover-btn-blue-line\"><i class=\"far fa-globe-americas\"></i> 번역</button>\n    </div>\n    <div class=\"inactive-box\">\n        <button id=\"ctx-explainTermsId\" type=\"button\" class=\"btns side-round hover-btn-blue-line\"><i class=\"far fa-globe-americas\"></i> 용어설명</button>\n        <div id=\"msg-ctx-explainTermsId\" class=\"txt-tooltip\" style=\"--txt-tooltip-width: 200px;left:-120px;\">선택한 단어 수는 <b id=\"msg-sel-len-explainTerms\" class=\"color-red\">30</b>입니다.<br />최대 <b id=\"msg-max-len-explainTerms\" class=\"color-red\">10</b> 단어까지만 선택 가능합니다.</div>\n    </div>        \n</div>\n\n\r\n<!-- 퀵 메뉴 { -->\r\n<aside class=\"quickmenu\">\r\n\t<ul class=\"quick-list\">\r\n\t\t\r\n\t\t<li><a href=\"/aiq/myon/selectMyONSearchList.do\" data-bhvr-no=\"964\" data-evnt-no=\"01\" data-log-no=\"202510233050070551\" data-url-