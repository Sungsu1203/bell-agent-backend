\t}\r\n\t\t}\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t// 상세보기 버튼 추가\r\n\t\tif(nullToStr(item.CN, null) != ''){\r\n\t\tvar cnURL = \"\";\r\n\r\n\t\tif(item.GUBUNCODE == \"001\"){\r\n\t\tcnURL = \"/srch/selectPORSrchArticle.do?cn=\";\r\n\t\t} else if(item.GUBUNCODE == \"002\"){\r\n\t\tcnURL = \"/srch/selectPORSrchPatent.do?cn=\";\r\n\t\t} else if(item.GUBUNCODE == \"003\"){\r\n\t\tcnURL = \"/srch/selectPORSrchReport.do?cn=\";\r\n\t\t}\r\n\r\n\t\tif(cnURL != \"\" && item.CN != \"ART002408994\"){\r\n\t\tcontents += '<button type=\"button\" class=\"btns hover-btn-blue-line\" onclick=\"window.open(\\'' + cnURL + item.CN + '\\');\">상세보기</button>';\r\n\t\t}\r\n\t\t}\r\n\t\t$(\"#referCnt\").text(\"(\"+item.TOTAL_CNT+\")\");\r\n\t\treferListHtml += \"<li><div class='txt'><p>\" + autNm + title + \"<div class='btn-area flex-end'>\"+ contents +\"</p></div></div></li>\";\r\n\t\t});\r\n\r\n\t\t// 더보기 버튼 추가 (총 개수가 10개 이상이고, 마지막 페이지가 아닌 경우)\r\n\t\tif(!(referList[0].TOTAL_CNT == referList[referList.length - 1].RN) && referList[0].TOTAL_CNT > 10){\r\n\t\tvar pgNum = parseInt(page) + 1;\r\n\t\t$(\".more_ref button\").off().on(\"click\", function(e) {\r\n\t\tmakeTLReferHtml(pgNum, gubun, pjn, cn);\r\n\t\t});\r\n\t\t$(\".more_ref\").css('display', '');\r\n\t\t} else {\r\n\t\t$(\".more_ref\").css('display', 'none');\r\n\t\t}\r\n\t\t} else {\r\n\t\t$(\"#referCnt\").text('(0)');\r\n\t\t$(\".more_ref\").css('display', 'none');\r\n\t\treferListHtml += \"<li style='list-style:none;'><div class='txt'><p>검색 결과가 없습니다.</p></div></div></li>\";\r\n\t\t$(\".referList\").empty();\r\n\t\t}\r\n\r\n\t\t// 게시물 추가 (2페이지 이상인 경우)\r\n\t\tif(page > 1){\r\n\t\t$(\".referList\").append(referListHtml);\r\n\t\t} else { // 게시물 새로 생성 (1페이지)\r\n\t\t$(\".referList\").html(\"\");\r\n\t\t$(\".referList\").html(referListHtml);\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t},\r\n\t\tcomplete: function(data) {\r\n// \t\tconsole.log(data);\r\n\t\tif(!isCnt) {\r\n\t\t$(\"#section_lvl3_2_2\").removeClass(\"hidden\");\r\n\t\t$(\"#loading_lvl3_2\").addClas