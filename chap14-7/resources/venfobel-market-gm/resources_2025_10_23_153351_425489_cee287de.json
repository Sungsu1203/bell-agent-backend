val(viewIndex);\r\n\t\t$(\".wrap-loading\").removeClass(\"hidden\");\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/selectQAKeywordList.do\",\r\n\t\ttype:'post',\r\n\t\tdataType: 'html',\r\n\t\tdata : $(\"#qaDivForm\").serialize(),\r\n\t\tsuccess: function(data){\r\n// \t\t$(\"#qaDiv\").removeClass(\"none\");\r\n\t\t$(\"#qaKwdList\").html(data);\r\n// \t\t$(\"#qaDiv\").bPopup();\r\n\t\t},\r\n\t\tcomplete: function(jqXhr, textStatus) {\r\n\t\t$(\"#qaKwdList\").html(jqXhr.responseText);\r\n\t\t$(\".wrap-loading\").addClass(\"hidden\");\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t//AccessON 원문보기\r\n\tfunction fncAcOn(cn){\r\n\t\tvar url = \"https://accesson.kisti.re.kr/main/search/articleDetail.do?artiId=\"+cn;\r\n\t\tinsertSystemLogInfo(\"linkYn=Y&useContCd=0005&linkURL=\"+url+\"&cn=\"+\"FNCT000314\");\r\n\r\n\t\tvar opener = window.open(\"about:blank\");\r\n\t\t//opener.location.href = \"https://accesson.kisti.re.kr/OARedirectBridge.do?arti_id=\"+cn;\r\n\t\tinsertBhvrLog({'bhvrNo' : '329','evntNo' : '01', 'cn' : cn ,'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\t\topener.location.href = \"https://accesson.kisti.re.kr/main/search/articleDetail.do?artiId=\"+cn;\r\n\t}\r\n\r\n\t//상세화면 저자의 다른 논문/특허/보고서\r\n\tfunction viewTab(obj,cn,nm,cnt,srchCndt,oCn){\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/selectRsrchmanContList.do\",\r\n\t\tdataType: 'html',\r\n\t\tdata : {'cn' : cn, 'searchCondition': srchCndt, 'oCn': oCn, \"gubun\":\"0001\"},\r\n\t\tsuccess: function(data){\r\n\t\t$(\".reference_list.authorList\").html(data);\r\n\t\t//MathJax.Hub.Queue([\"Typeset\",MathJax.Hub]);\r\n\t\tif(typeof MathJax !== 'undefined') {MathJax.Hub.Queue([\"Typeset\",MathJax.Hub]);}\r\n\t\t},\r\n\t\tbeforeSend:function(){\r\n// \t\t$('.wrap-loading').removeClass(\"hidden\");\r\n\t\t},\r\n\t\tcomplete:function(){\r\n\t\t$('.wrap-loading').addClass(\"hidden\");\r\n\t\t$('.namebtn > a').removeClass('active');\r\n\t\t$('#'+obj).addClass('active');\r\n\t\t$(\"#authorNm\").text(nm);\r\n\t\t$(\"#patCnt\").text('('+cnt+')');\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t//논문/특허/보고서 연구과제 타임라인 로드 함수\r\n\tfunction fn_view_contTimeline(pjn, cn) {\r\n\t\t$(\"#section_lvl1, #section_lvl2_1, #section_lvl2_2\").addClass(\"hidden\");\r\n\t\t$(\"#loading_lvl1, #loading_lvl2_1, #loading_lvl2_2\").removeClass(\"hidden\");\r\n\t\tprjNo = pjn;\r\n\t\tcNo = cn;\r\n\t\t$('.wrap-loading').removeClass(\"hidden\");\r\n\t\tvar ajax1 = makeTLWordCloud(pjn, cn);\r\n\t\tvar ajax2 = makeTLGoodResultHtml(1, 'ALL', prjNo, cn, true);\r\n\t\tvar ajax2 = makeTLGoodResultHtml(1, 'ALL', prjNo, cn, false);\r\n\t\tvar ajax3 = makeTLReferHtml(1, 'ALL', prjNo, cn, true);\r\n\t\tvar ajax4 = makeTLReferHtml(1, 'ALL', prjNo, cn, false);\r\n\r\n\t\t$(\".goodRstBtns button\").removeClass(\"active\");\r\n\t\t$(\".referBtns button\").removeClass(\"active\");\r\n\t\t$(\"#goodRst000\").addClass(\"active\");\r\n\t\t$(\"#refer000\").addClass(\"active\");\r\n\r\n\t\tif(ajax1&&ajax2&&ajax3&&ajax4) {\r\n\t\t$(\"#sect_timeline\").show();\r\n\t\t}\r\n\t\t$('.wrap-loading').addClass(\"hidden\");\r\n\t}\r\n\r\n\t//키워드 워드클라우드 생성 함수\r\n\tfunction makeTLWordCloud(pjn, cn){\r\n\r\n\t\tvar _param = {\r\n\t\tpjn : pjn,\t// 과제고유번호\r\n\t\tcn : cn\t\t// 등록번호\r\n\t\t}\r\n\t\tvar ajax = $.ajax({\r\n\t\ttype: \"POST\",\r\n\t\turl : \"/srch/selectReportTimelineWordCldList.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata : JSON.stringify(_param),\r\n\t\tcontentType: \"application/json\",\r\n\t\tasync : false,\r\n\t\tsuccess: function(data){\r\n\r\n\t\t// 상세 과제 정보 (과제정보 API 활용)\r\n\t\tvar projectInfo = data.projectInfo;\r\n\t\tif(nullToStr(projectInfo, null) != '') {\r\n\t\t$(\"#rsrchTimeline\").empty();\r\n\t\tprjNo = pjn;\r\n\t\t// 과제명\r\n\t\tif(nullToStr(projectInfo.projectTitle, null) != ''){\r\n\t\tvar flex_title = \"<dl class=\\\"flex-start\\\">\"\r\n\t\t+ \"<dt>과제명</dt>\"\r\n\t\t+ \"<dd>\" + projectInfo.projectTitle\r\n\t\t+ \" <a href=\\\"javascript:#\\\" class=\\\"btns size-small side-round\\\"\"\r\n\t\t+ \" onclick=\\\"fn_move_link(this);\\\" data-pjn=\\\"\"+ pjn + \"\\\">\"\r\n\t\t+ \"NTIS 과제연결</a></dd></dl>\";\r\n\r\n\t\t$(\"#rsrchTimeline\").append(flex_title);\r\n\t\t}\r\n\r\n\t\t// 과제기간\r\n\t\tif(nullToStr(projectInfo.timelineYear, null) != ''){\r\n\t\tvar flex_timelineYear = \"<dl class=\\\"flex-start\\\">\"\r\n\t\t+ \"<dt>과제기간</dt>\"\r\n\t\t+ \"<dd>\" + projectInfo.timelineYear + \"</dd></dl>\";\r\n\t\t$(\"#rsrchTimeline\").append(flex_timelineYear);\r\n//\t \t\t$(\"#timelineYear\").text(projectInfo.timelineYear);\r\n\t\t}\r\n\r\n\t\t// 총연구비\r\n\t\tif(nullToStr(projectInfo.expense, null) != ''){\r\n\t\tvar expense = parseInt(projectInfo.expense);\r\n\r\n\t\tif(expense == 0){\r\n//\t \t\t$(\"#expense\").text(\"-\");\r\n\t\texpense = \"-\";\r\n\t\t} else {\r\n\t\texpense = expense.toLocaleString() + \"원\";\r\n//\t \t\t$(\"#expense\").text(expense + \"원\");\r\n\t\t}\r\n\t\tvar flex_expense = \"<dl class='flex-start'>\"\r\n\t\t+ \"<dt>총연구비</dt>\"\r\n\t\t+ \"<dd>\" + expense + \"</dd></dl>\";\r\n\t\t$(\"#rsrchTimeline\").append(flex_expense);\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t// 키워드 워드클라우드 목록\r\n\t\tvar wordCldList = data.wordCldList;\r\n\r\n\t\tif(wordCldList.length > 0){\r\n\r\n\t\t$(\"#wldCldList\").empty();\r\n\r\n\t\tvar initialIdx = 0;\r\n\t\tvar isInitPjn = false;\r\n\r\n\t\t$(wordCldList).each(function(idx, item){\r\n\t\tvar wordCldHtml = \"\";\r\n\t\t// 초기 워드클라우드 설정 (해당 과제의 기준연도로 설정)\r\n\t\tif(pjn == item.pjn || idx == 0){\r\n\t\tprjNo = item.pjn\r\n\t\tinitialIdx = idx;\r\n\t\tisInitPjn = true;\r\n\t\tprojectYear = item.year;\r\n\t\tisFirst = true;\r\n\t\t}\r\n\r\n\t\t// 워드클라우드 태그 추가 (pjn, year, index 설정)\r\n\t\twordCldHtml += '<li data-pjn=\"' + item.pjn + '\" class=\"swiper-slide\">';\r\n\t\twordCldHtml += '\t\t<div class=\"timeline-box\"><h4 class=\"year-box\">' + item.year + '</h4>';\r\n\t\twordCldHtml += '\t\t<div id=\"keywordCloud' + idx + '\" style=\"height: 180px;\" class=\"keyword-cloudbox\">';\r\n\t\twordCldHtml += '\t\t</div></div>';\r\n\t\twordCldHtml += '</li>';\r\n\r\n\t\tvar wdCldKeyword = new Array();\r\n\r\n\t\t// 키워드 목록\r\n\t\t$(item.keyword).each(function(idx, str){\r\n\t\tvar keyword = str.split(/ : | . |;|,/);\r\n\r\n\t\t$(keyword).each(function(idx, item){\r\n\t\tif(item != null && item != \"\"){\r\n\t\twdCldKeyword.push(item.removeHTML(item));\r\n\t\t}\r\n\t\t});\r\n\t\t});\r\n\r\n\t\t$(\"#wldCldList\").append(wordCldHtml);\r\n\r\n\t\t// 워드클라우드 차트 생성\r\n\t\tfn_cloud(\"keywordCloud\" + idx, wdCldKeyword);\r\n\t\t});\r\n\r\n\t\t// 키워드 워드클라우드 값이 1개인 경우 (swiperjs 버튼 hide 처리)\r\n\t\tif(wordCldList.length == 1){\r\n\t\t$(\".swiper-button-prev\").hide();\r\n\t\t$(\".swiper-button-next\").hide();\r\n\t\t}\r\n\r\n\t\t// 초기 과제정보가 아닌 경우 (연도별 성과물, 문헌 변경) \r\n\t\tif(!isInitPjn){\r\n//\t \t\tmakeTLGoodResultHtml(1, 'ALL', wordCldList[0].pjn, cn);\r\n//\t \t\tmakeTLReferHtml(1, 'ALL', wordCldList[0].pjn, cn);\r\n\t\t} else {\r\n\t\t// 초기 워드클라우드 설정\r\n\t\ttimeline_swiper.slideTo(initialIdx, 0, false);\r\n\t\tisFirst = false;\r\n\t\t}\r\n\t\t} else {\t// 키워드가 없는 경우\r\n\t\t$(\"#wordCldView\").hide();\r\n\t\t$(\".head-box\").css(\"border-bottom\", \"0px\");\r\n\t\t}\r\n\t\t},\r\n\t\tcomplete: function() {\r\n\t\t$(\"#section_lvl1, #section_lvl2_1\").removeClass(\"hidden\");\r\n\t\t$(\"#loading_lvl1, #loading_lvl2_1\").addClass(\"hidden\");\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\treturn ajax;\r\n\t}\r\n\r\n\t//워드 클라우드 함수 \r\n\tfunction fn_cloud(wdCldId, wdCldKeyword){\r\n\t\tvar keywords = wdCldKeyword;\r\n\r\n\t\t$('#' + wdCldId +' > svg').remove();\r\n\r\n\t\tif(keywords.length == 0){\r\n\t\t$('#' + wdCldId).attr('style','height:180px;line-height: 180px; border: 2px solid #e2e2e2; background-color:white;  border-radius: 15px; text-align: center;');\r\n\t\t$('#' + wdCldId).text('데이터 없음');\r\n\t\t}else{\r\n\r\n\t\t// 단어 사이즈 설정 (8 ~ 25px 랜덤) \r\n\t\tvar words = keywords.map(function(d) {\r\n\t\treturn {text: d, size: 8 + Math.random() * 16};\r\n\t\t});\r\n\r\n\t\t// 단어 최대, 최소 크기 설정\r\n\t\tmaxSize = d3.max(words, function(d) { return d.size; });\r\n\t\tminSize = d3.min(words, function(d) { return d.size; });\r\n\r\n\t\t// 폰트 스케일 설정 (range -> 폰트 사이즈 범위)\r\n\t\tvar fontScale = d3.scale.linear().domain([minSize, maxSize]).range([8, 16]).clamp(true);\r\n\t\t//var fontScale = d3.scale.linear().domain([minSize, maxSize]).range([8, 32]).clamp(true);\r\n\r\n\t\td3.layout.cloud()\r\n\t\t.size([width, height])\r\n\t\t.words(words)\r\n\t\t.padding(1)\r\n\t\t.rotate(function() { return ~~(Math.random() * 2) * 90; })\r\n\t\t.font(\"Noto Sans KR\")\r\n\t\t.text(function(d) { return d.text; })\r\n\t\t.fontSize(function(d) {\r\n\t\treturn fontScale(d.size);\r\n\t\t})\r\n\t\t.on(\"end\", function(d, i){\r\n\t\tdrawInner(d, wdCldId);\r\n\t\t})\r\n\t\t.start();\r\n\t\t}\r\n\t}\r\n\r\n\t// 워드클라우드 내부 draw 함수\r\n\tfunction drawInner(words, wdCldId) {\r\n\t\tvar fill = d3.scale.category20();\r\n\t\td3.select(\"#\" + wdCldId).append(\"svg\")\r\n\t\t.attr(\"width\", width)\r\n\t\t.attr(\"height\", height)\r\n\t\t.append(\"g\")\r\n\t\t.attr(\"transform\", \"translate(\" + width/2 + \",\" + height/2 + \")\")\r\n\t\t.selectAll(\"text\")\r\n\t\t.data(words)\r\n\t\t.enter().append(\"text\")\r\n\t\t.style(\"font-size\", function(d) { return d.size + \"px\"; })\r\n\t\t.style(\"font-family\", \"Noto Sans KR, sans-serif;\")\r\n\t\t.style(\"fill\", function(d, i) { return fill(i); })\r\n\t\t.style(\"cursor\", \"pointer\")\r\n\t\t.attr(\"text-anchor\", \"middle\")\r\n\t\t.attr(\"transform\", function(d) {\r\n\t\treturn \"translate(\" + [d.x, d.y] + \")rotate(\" + d.rotate + \")\";\r\n\t\t})\r\n\t\t.text(function(d) { return d.text; })\r\n\t\t.on(\"click\", function(d) {\r\n\t\tsearchTag(d.text);\r\n\t\t});\r\n\t}\r\n\r\n\t// 연구과제 성과물 HTML 생성 함수\r\n\tfunction makeTLGoodResultHtml(page, gubun, pjn, cn, isCnt){\r\n\t\tprjNo = pjn;\r\n\t\t// isCnt : 개수를 체크할지 말지 설정\r\n\t\tif(nullToStr(isCnt, null) == ''){\r\n\t\tisCnt = false;\r\n\t\t}\r\n\r\n\t\tvar _param = {\r\n\t\tpage : page,\t\t// 페이지 값 (1, 2, 3, 4 ~)\r\n\t\tgubun : gubun,\t// 구분 (ALL : 전체, 001 : 논문, 002 : 특허, 003 : 보고서)\r\n\t\tpjn : pjn,\t\t// 과제고유번호\r\n\t\tcn : cn,\t\t// 등록번호\r\n\t\tisCnt : isCnt \t\t// 개수 체크\r\n\t\t}\r\n\t\tvar ajax = $.ajax({\r\n\t\ttype: \"POST\",\r\n\t\turl : \"/srch/selectReportTimelineRstList.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata : JSON.stringify(_param),\r\n\t\tcontentType: \"application/json\",\r\n\t\tbeforeSend: function() {\r\n\t\tif(!isCnt) {\r\n\t\t$(\"#section_lvl3_1_2\").addClass(\"hidden\");\r\n\t\t$(\"#loading_lvl3_1\").removeClass(\"hidden\");\r\n\t\t} else {\r\n\t\t$(\"#section_lvl2_2, #section_lvl3_1_1, #section_lvl3_1_2\").addClass(\"hidden\");\r\n\t\t$(\"#loading_lvl2_2, #loading_lvl3_1\").removeClass(\"hidden\");\r\n\t\t}\r\n\t\t},\r\n\t\tsuccess: function(data){\r\n\t\tvar goodRstCnt = data.goodRstCnt;\t// 성과물 갯수\r\n\t\tvar goodRstList = data.goodRstList;\t// 성과물 목록\r\n\t\t// 개수 체크 하는 경우\r\n\t\tif(isCnt){\r\n\t\tvar cntHtml = \"\";\r\n\r\n\t\t// 상단 탭 개수 설정\r\n\t\tif(goodRstCnt != null && goodRstCnt.length > 0){\r\n\t\tvar allCnt = 0;\r\n\r\n\t\t$(goodRstCnt).each(function(idx, item){\r\n\t\tvar rstItemNm = \"\";\r\n\t\tvar gubunParam = \"\";\r\n\r\n\t\tif(item.RST_ITEM_CD == '001') {\r\n\t\trstItemNm = \"논문\";\r\n\t\tgubunParam = \"001\";\r\n\t\t} else if(item.RST_ITEM_CD == '002') {\r\n\t\trstItemNm = \"특허\";\r\n\t\tgubunParam = \"002\";\r\n\t\t} else if(item.RST_ITEM_CD == '003') {\r\n\t\trstItemNm = \"보고서\";\r\n\t\tgubunParam = \"003\";\r\n\t\t}\r\n\r\n\t\t// 카테고리별 개수 HTML 생성\r\n\t\tif(item.CNT > 0){\r\n\t\t$(\"#goodRst\"+gubunParam).text(rstItemNm + \"(\" + item.CNT + \")\")\r\n//\t \t\t    \t.attr(\"oncilck\", \"makeTLGoodResultHtml(1, '\"+gubunParam+\"', '\"+pjn+\"', '\"+cn+\"')\");\r\n\t\t} else {\r\n\t\t$(\"#goodRst\"+gubunParam).text(rstItemNm + \"(\" + item.CNT + \")\")\r\n\t\t.attr(\"oncilck\", \"return false;\");\r\n\t\t}\r\n\r\n\t\tallCnt += item.CNT;\r\n\t\t});\r\n\t\t// 전체 개수 HTML 생성\r\n\t\t$(\"#goodRst000\").text(\"전체(\" + 0 + \")\")\r\n//\t \t\t.attr(\"oncilck\", \"return false;\");\r\n\t\tif(allCnt > 0){\r\n\t\t$(\"#goodRst000\").text(\"전체(\" + allCnt + \")\")\r\n//\t \t\t.attr(\"oncilck\", \"makeTLGoodResultHtml(1, 'ALL', '\"+pjn+\"', '\"+cn+\"')\");\r\n\t\t}\r\n\r\n\t\t} else {\r\n\t\t$(\"#goodRst000\").text(\"전체(\" + 0 + \")\");\r\n//\t \t\t    .attr(\"oncilck\", \"return false;\");\r\n\t\t$(\"#goodRst001\").text(\"논문(\" + 0 + \")\");\r\n//\t \t\t    .attr(\"oncilck\", \"return false;\");\r\n\t\t$(\"#goodRst002\").text(\"특허(\" + 0 + \")\");\r\n//\t \t\t    .attr(\"oncilck\", \"return false;\");\r\n\t\t$(\"#goodRst003\").text(\"보고서(\" + 0 + \")\");\r\n//\t \t\t    .attr(\"oncilck\", \"return false;\");\r\n\t\t}\r\n\r\n\t\t} else {\r\n\r\n\r\n\r\n\t\tvar goodRstHtml = '';\r\n\r\n\t\t// 성과물 목록 HTML 생성\r\n\t\tif(goodRstList.length > 0){\r\n\r\n\t\t// 성과물 제목 추가\r\n\t\t$(\"#goodRstTitle\").html(projectYear + '년 연구과제 성과물  <span class=\"color-red\" id=\"goodRstCnt\"></span>');\r\n\t\t$(\"#goodRstCnt\").text(\"(\"+goodRstList[0].TOTAL_CNT+\")\");\r\n\t\t// 클래스 수정 함수\r\n//\t \t\tfn_modify_class(\"RGOOD\", gubun);\r\n\r\n\t\t$(goodRstList).each(function(idx, item){\r\n\r\n\t\t// 저자\r\n\t\tvar author = nullToStr(item.AUTHOR, null);\r\n\r\n\t\t// 게시물\r\n\t\tvar autNm = author.split(\";\")[0];\t\t// 저자 추가\r\n\t\tvar title = \" \\\"\" + item.RST_NM + \"\\\" \";\t// 내용 추가\r\n\t\tvar contents = \"\";\r\n\r\n\t\t// 원문보기 버튼 생성 (CN이 있는 경우)\r\n\t\tif(nullToStr(item.CN, null) != ''){\r\n\t\tif(item.RST_ITEM_CD == \"001\" && nullToStr(item.PDFVIEW, null) != ''){\r\n\t\tif(item.CN.substr(0, 4) == \"DIKO\") {\r\n\t\tcontents += '<button type=\"button\" class=\"btns hover-btn-blue-line\" onclick=\"fncLogSave(\\''+ item.PDFVIEW + '\\', \\''+ item.CN +'\\')\">원문보기</button>