\t\t},\r\n\t\talphabet: {\r\n\t\ttext: '아니오'\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n\t\t});\r\n\r\n\t\t//연구과제 타임라인 존재시 첫 타임라인 로드\r\n\t\t\r\n\t\tfn_view_contTimeline('1345270648', 'JAKO201719363358641');\r\n\t\t\r\n\r\n\t\t$(\"#allTbimBtn\").on(\"click\", function() {\r\n\t\t$(\"#sect_tbim .h3-slide\").addClass(\"hidden\");\r\n\t\t$(\"#sect_tbim #gallery-list\").addClass(\"hidden\");\r\n\t\t$(\"#sect_tbim .h3-table\").removeClass(\"hidden\");\r\n\t\t$(\"#sect_tbim #gallery-table\").removeClass(\"hidden\");\r\n\t\t});\r\n\t\t$(\"#slideTbimBtn\").on(\"click\", function() {\r\n\t\t$(\"#sect_tbim .h3-table\").addClass(\"hidden\");\r\n\t\t$(\"#sect_tbim #gallery-table\").addClass(\"hidden\");\r\n\t\t$(\"#sect_tbim .h3-slide\").removeClass(\"hidden\");\r\n\t\t$(\"#sect_tbim #gallery-list\").removeClass(\"hidden\");\r\n\r\n\t\t});\r\n\r\n\t\t/* [개발업무], 개발일자-2024-08-13, 작업내용 : 과제정보 연계 */\r\n\t\tmakeNtisModal();\r\n\r\n\t\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t\tvar ddc = \"519\";\r\n\t\tif(ddc != \"\"){\r\n\t\tselectPrcuse();\r\n\t\tselectAnalytics(ddc);\r\n\t\t}\r\n\r\n\t\t/* [개발업무], 개발일자-2024-10-21, 작업내용 : profile 시범서비스 */\r\n\t\t//키워드별 프로파일 상세 항목 순위에 따른 순서변경\r\n\t\tvar left = document.getElementById(\"smooth-all\");\r\n\t\tvar leftAbs = document.getElementById(\"link_abs\");\r\n\t\tvar leftLiText = \"\";\r\n\t\tvar leftLi;\r\n\t\tvar sectionDiv = document.getElementById(\"sectionDiv\");\r\n\t\tvar sectionAbs = document.getElementById(\"sect_abs\");\r\n\t\tvar section;\r\n\r\n\t\t\r\n\t});\r\n\r\n\t/* [개발업무], 개발일자-2024-08-13, 작업내용 : 과제정보 연계 */\r\n\tfunction makeNtisModal(){\r\n\t\tif(\"1\" > 0){\r\n\t\tvar pjtIdArr = [];\r\n\t\t\r\n\t\tpjtIdArr.push(\"1345270648\");\r\n\t\t\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/ntisPjtInfoList.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata : {'arr' : pjtIdArr},\r\n\t\ttraditional: true,\r\n\t\tsuccess: function(data){\r\n\t\t// 과제 정보 (과제정보 API 활용)\r\n\t\tvar pjtInfoList = data.pjtInfoList;\r\n\r\n\t\tif(pjtInfoList.length > 0){\r\n\r\n\t\t$(pjtInfoList).each(function(idx, item){\r\n\t\tvar addDiv = \"<div class='powerful-con'>\"\r\n\t\t+ \"<div class='inner'>\"\r\n\t\t+ \"<p class='subject'>\"+ item.ProjectTitleKr +\"</p>\"\r\n\t\t+ \"<p>(\"+item.ProjectNumber+\") \"+item.ProjectYear+\" / \"+item.BudgetProject+\" / \"+item.Manager+\" / \"+item.ResearchAgency+\" / \"+item.Ministry+\" / \"+ parseInt(item.TotalFunds).toLocaleString()+\"원 (\"+ parseInt(item.GovernmentFunds).toLocaleString()+\"원)</p>\"\r\n\t\t+ \"<p class='info mgt5px'>\"+ item.AbstractFull +\"</p>\"\r\n\t\t+ \"<div class='item-btn-box flex-start mgt20px'>\"\r\n\t\t+ \"<a href='https://sso1.ntis.go.kr/nls3/saml/saml_login.jsp?UURL=https://www.ntis.go.kr/project/pjtInfo.do?pjtId=\"+item.ProjectNumber+\"' target='_blank' data-bhvr-no='1026' data-evnt-no='01' data-log-no='202510233050070551' data-url-no='PG023' class='flex-start round5px' style='gap: 10px;overflow: hidden;border: 1px solid var(--color-gray-light);padding-right: 10px;'><span class='ico' style='font-size: 0;'><img src='https://scienceon.kisti.re.kr/newUI/img/common/ico_ntis.png' height='30' class='round5px' /></span><em>더보기</em></a>\"\r\n\t\t+ \"</div></div></div>\";\r\n\t\t$(\"#pjtList\").append(addDiv);\r\n\t\t});\r\n\t\t}\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\tvar cachedWidth = $(window).width();\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t$(window).resize(function(){\r\n\t\tvar ddc = \"519\";\r\n\t\tif(ddc != \"\"){\r\n\t\tvar newWindowWidth = $(window).width();\r\n\t\tif (newWindowWidth !== cachedWidth) {\r\n\t\tif(this.resizeTO) clearTimeout(this.resizeTO);\r\n\t\tthis.resizeTO = setTimeout(function() {\r\n\t\tselectPrcuse();\r\n\t\t}, 300);\r\n\r\n\t\t}\r\n\t\tcachedWidth = newWindowWidth;\r\n\t\t}\r\n\t});\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\tfunction selectPrcuse(){\r\n\t\t//활용도 분석정보\r\n\t\tvar cn = \"JAKO201719363358641\";\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/por/analytics/prcuse/selectPrcuseSrchDtlChartDataAjax.do\",\r\n\t\tdataType : 'json',\r\n\t\tdata: {'cn' : cn, \"pageFlag\" : \"artDtl\"},\r\n\t\tcontentType: 'application/x-www-form-urlencoded',\r\n\t\tsuccess : function(data) {\r\n\t\tfn_drawChart(data.resultMap);\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t//Chart 생성\r\n\tfunction fn_drawChart(resultList) {\r\n\t\tvar dvData = new google.visualization.DataTable();\r\n\t\tvar ovData = new google.visualization.DataTable();\r\n\t\tvar saData = new google.visualization.DataTable();\r\n\t\tdvData.addColumn('string', '');\r\n\t\tdvData.addColumn('number', '상세보기');\r\n\t\tdvData.addColumn({type: 'string', role: 'annotation'});\r\n\t\tovData.addColumn('string', '');\r\n\t\tovData.addColumn('number', '다운로드');\r\n\t\tovData.addColumn({type: 'string', role: 'annotation'});\r\n\t\tsaData.addColumn('string', '');\r\n\t\tsaData.addColumn('number', '내보내기');\r\n\t\tsaData.addColumn({type: 'string', role: 'annotation'});\r\n\r\n\t\tvar dvDataArr = [];\r\n\t\tvar ovDataArr = [];\r\n\t\tvar saDataArr = [];\r\n\t\tvar dvCnt = 0;\r\n\t\tvar ovCnt = 0;\r\n\t\tvar saCnt = 0;\r\n\t\tresultList.forEach(function(item, i) {\r\n\t\tdvDataArr.push([ item.logYr, item.dvCnt, item.dvCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tovDataArr.push([ item.logYr, item.ovCnt, item.ovCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tsaDataArr.push([ item.logYr, item.saCnt, item.saCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tdvCnt += item.dvCnt;\r\n\t\tovCnt += item.ovCnt;\r\n\t\tsaCnt += item.saCnt;\r\n\t\t});\r\n\r\n\t\tif(dvCnt+ovCnt+saCnt == 0){\r\n\t\t$(\"#sect_anal\").hide();\r\n\t\t$(\"#link_anal\").hide();\r\n\t\treturn;\r\n\t\t}\r\n\r\n\t\tdvData.addRows(dvDataArr);\r\n\t\tovData.addRows(ovDataArr);\r\n\t\tsaData.addRows(saDataArr);\r\n\r\n\t\t$(\"#dvCnt\").text(dvCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\t\t$(\"#ovCnt\").text(ovCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\t\t$(\"#saCnt\").text(saCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\r\n\t\tvar winWidth = $(window).width();\r\n\t\tvar chartWidth = '100%';\r\n\t\tif(winWidth >= 751 && winWidth <= 1183){\r\n\t\tchartWidth = 468;\r\n\t\t}\r\n\t\tvar options = {\r\n\t\twidth: chartWidth,\r\n\t\theight: 120,\r\n\t\tlegend: 'none',\r\n// \t\tlegend: { position: 'bottom', maxLines: 5, textStyle: {fontSize: 12} },\r\n// \t\tbar: { groupWidth: '50%' },\r\n// \t\tbars: 'horizontal',\r\n// \t\tisStacked: true,\r\n\t\tvAxis: {minValue: 2},\r\n\t\tannotations: {\r\n\t\talwaysOutside: false,\r\n\t\ttextStyle: {\r\n\t\tfontSize: 11,\r\n\t\tcolor: '#000',\r\n\t\tauraColor: 'none'\r\n\t\t}\r\n\t\t},\r\n\t\tchartArea: {\r\n\t\tleft: 50,\r\n\t\tright: 20,\r\n// \t\ttop: 10,\r\n\t\tbackgroundColor: 'white',\r\n\t\twidth: '100%',\r\n\t\theight: '70%'\r\n\t\t},\r\n\t\tseries: {\r\n\t\t0:{color:'#003879'}\r\n\t\t}\r\n\t\t};\r\n\r\n\t\tvar dvChart = new google.visualization.LineChart(document.getElementById('chart_dv'));\r\n\t\tvar ovChart = new google.visualization.LineChart(document.getElementById('chart_ov'));\r\n\t\tvar saChart = new google.visualization.LineChart(document.getElementById('chart_sa'));\r\n\t\tgoogle.visualization.events.addListener(dvChart, 'ready', fn_chartReadyHandler);\r\n\t\tgoogle.visualization.events.addListener(ovChart, 'ready', fn_chartReadyHandler);\r\n\t\tgoogle.visualization.events.addListener(saChart, 'ready', fn_chartReadyHandler);\r\n\r\n\t\tdvChart.draw(dvData, options);\r\n\t\tovChart.draw(ovData, options);\r\n\t\tsaChart.draw(saData, options);\r\n\t}\r\n\tfunction fn_chartReadyHandler() {\r\n\t\tsetTimeout(function(){$(\"#chart_dv table\").prop(\"summary\", \"상세보기 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t\tsetTimeout(function(){$(\"#chart_ov table\").prop(\"summary\", \"다운로드 분석 차트 데이터\")