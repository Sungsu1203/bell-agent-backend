"JAKO201225067515805\"><i class=\"fal fa-folder-tree\"></i></button>\r\n\t\t</li>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t</ul>\r\n\t\t</article>\r\n\t\t\r\n\t\t<!-- } 함께 이용한 콘텐츠 -->\r\n\r\n\t\t\r\n\t\t\r\n\r\n\r\n\r\n\r\n<article class=\"fo-con fo-use-case\" id=\"kacademy-swiper\" style=\"display: none\">\r\n    <div class=\"fo-use-case-slide\">\r\n        <ul class=\"swiper-wrapper\">\r\n        </ul>\r\n        <div class=\"slide-control flex-end\">\r\n            <button type=\"button\" class=\"sc-btn swiper-button swiper-prev\"><i class=\"far fa-chevron-left\"></i></button>\r\n            <button type=\"button\" class=\"sc-btn play-pause-btn\">\r\n                <i class=\"fas fa-pause\"></i>\r\n            </button>\r\n            <button type=\"button\" class=\"sc-btn swiper-button swiper-next\"><i class=\"far fa-chevron-right\"></i></button>\r\n        </div>\r\n    </div>\r\n</article>\r\n\r\n<script>\r\n    $(function () {\r\n        fn_ajax_kacademy();\r\n    });\r\n\r\n    function sendKacademySearch(keywords, onSuccess, onError) {\r\n        $.ajax({\r\n            url        : \"/srch/kacademyList.do\",\r\n            dataType   : 'json',\r\n            type       : 'post',\r\n            contentType: \"application/json; charset=utf-8\",\r\n            data       : JSON.stringify({'keywords': keywords}),\r\n            success    : onSuccess,\r\n            error      : onError\r\n        });\r\n    }\r\n\r\n\r\n    function fn_ajax_kacademy() {\r\n        const detail = document.getElementById(\"searchDetail\");\r\n        const keywords = [];\r\n\r\n        if (detail) {\r\n            // detail이 있을 경우 resultVO에서 키워드 생성\r\n            if ('유한요소법 . 오토로테이션 . 하드랜딩 . 스키드기어' && '유한요소법 . 오토로테이션 . 하드랜딩 . 스키드기어'.trim().length > 0) {\r\n                const splitKeywords = '유한요소법 . 오토로테이션 . 하드랜딩 . 스키드기어'.split('.').map(keyword => keyword.trim());\r\n                keywords.push(...splitKeywords);\r\n            }\r\n            keywords.push(\"헬리콥터 오토로테이션시 착륙장치 거동에 관한 연구\", \"A Study on the Behavior of Skid Gear During the Helicopter Autorotation\");\r\n        } else {\r\n            // detail이 없을 경우 searchKeyword만 사용하여 첫 번째 검색 시도\r\n            keywords.push(\"\");\r\n            sendKacademySearch(keywords, handleKacademyData, handleKacademyError);\r\n            return; // 첫 번째 검색 후 종료\r\n        }\r\n        // detail인 경우 바로 검색\r\n        sendKacademySearch(keywords, handleKacademyData, handleKacademyError);\r\n    }\r\n\r\n    let scienceEduListSwiper;\r\n\r\n    function handleKacademyData(data) {\r\n        const infraId = getInfraId();\r\n        if (data.result.documents.length > 0) {\r\n            const swiperHtml = data.result.documents.map(item => makeKacademySwiperSlide(item, infraId)).join('');\r\n            const swiperSlideElements = $('.fo-use-case-slide .swiper-wrapper');\r\n            swiperSlideElements.html(swiperHtml);\r\n\r\n            scienceEduListSwiper = new Swiper('.fo-use-case-slide', {\r\n                autoHeight    : true,\r\n                spaceBetween  : 20,\r\n                observer      : true,\r\n                observeParents: true,\r\n                autoplay      : {\r\n                    delay               : 2500,\r\n                    disableOnInteraction: false\r\n                },\r\n                navigation    : {\r\n                    nextEl: '.fo-use-case-slide .swiper-next',\r\n                    prevEl: '.fo-use-case-slide .swiper-prev'\r\n                }\r\n            });\r\n\r\n            $('#kacademy-swiper').show();\r\n        }\r\n    }\r\n\r\n    document.querySelector('#kacademy-swiper .play-pause-btn').addEventListener('click', function () {\r\n        if (scienceEduListSwiper.autoplay.running) {\r\n            scienceEduListSwiper.autoplay.stop();\r\n            this.innerHTML = '<i class=\"fas fa-play\"></i>';\r\n        } else {\r\n            scienceEduListSwiper.autoplay.start();\r\n            this.innerHTML = '<i class=\"fas fa-pause\"></i>';\r\n        }\r\n    });\r\n\r\n    function handleKacademyError(jqXHR, textStatus, errorThrown) {\r\n        console.log('Initial AJAX request failed: ' + textStatus + ', ' + errorThrown);\r\n    }\r\n\r\n    function handleKacademyListData(data) {\r\n        // reduceKeywords으로 다시 검색하는 로직은 보류\r\n        if (!data || data.result.documents.length === 0) {\r\n            // 검색 결과가 없을 경우 reduceKeywords로 다시 검색\r\n            console.log(\"No results for searchKeyword, retrying with reduceKeywords\");\r\n            const retryKeywords = [];\r\n            \r\n            sendKacademySearch(retryKeywords, handleKacademyData, handleKacademyError);\r\n        } else {\r\n            // 검색 결과가 있으면 처리\r\n            handleKacademyData(data);\r\n        }\r\n    };\r\n\r\n    function getInfraId() {\r\n        const endpoint = window.location.pathname;\r\n        console.log(endpoint);\r\n        if (endpoint === \"/srch/selectPORSrchArticleList.do\") {\r\n            return \"INFRAPAGE0246\"\r\n        } else if (endpoint === \"/srch/selectPORSrchArticle.do\") {\r\n            return \"INFRAPAGE0247\"\r\n        } else if (endpoint === \"/srch/PORSrchPatentList.do\") {\r\n            return \"INFRAPAGE0248\"\r\n        } else if (endpoint === \"/srch/PORSrchReportList.do\") {\r\n            return \"INFRAPAGE0250\"\r\n        } else if (endpoint === \"/srch/selectPORSrchTrendList.do\") {\r\n            return \"INFRAPAGE0252\"\r\n        }\r\n    }\r\n\r\n\r\n</script>\r\n<style>\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state {\r\n        display: flex;\r\n        justify-content: center;\r\n        align-items: stretch;\r\n        border: 1px solid var(--color-gray-light);\r\n        border-radius: 4px;\r\n        font-size: 1.4rem;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dt,\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dd {\r\n        flex-grow: 1;\r\n        line-height: 24px;\r\n        text-align: center;\r\n        border-left: 1px solid var(--color-gray-light);\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dt {\r\n        background-color: var(--table-header-bg);\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dt:first-child {\r\n        border-left: none;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type2 .uc-state {\r\n        display: flex;\r\n        justify-content: flex-start;\r\n        align-items: center;\r\n        gap: 10px;\r\n        font-size: 1.5rem;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con .state-btn {\r\n        margin: 10px 0;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con .period dl {\r\n        display: flex;\r\n        justify-content: flex-start;\r\n        align-items: center;\r\n        gap: 10px;\r\n        font-size: 1.4rem;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con .period dl dt {\r\n        color: var(--color-blue);\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control {\r\n        margin-top: 10px;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .swiper-pagination {\r\n        position: relative;\r\n        top: auto;\r\n        left: auto;\r\n        bottom: auto;\r\n        width: auto;\r\n        margin-right: 10px;\r\n        color: var(--color-gray);\r\n        font-size: 1.4rem;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .swiper-pagination .swiper-pagination-current {\r\n        color: vaR(--color-basic);\r\n        font-weight: var(--font-weight-semibold);\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .sc-btn {\r\n        flex-shrink: 0;\r\n        padding: 2px 4px;\r\n        font-size: 1.3rem;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .sc-btn.play-pause-btn {\r\n        font-size: 1rem;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .sc-btn:hover {\r\n        color: var(--color-blue);\r\n    }\r\n</style>\r\n\t\t</div>\r\n\t\t\r\n\t\t<!-- 과제정보 버튼생성 -->\r\n\t\t\r\n\t\t<!--저작권 관리 안내 버튼 -->\r\n\t\t<a href=\"/por/copyright/copyRightList.do\" target=\"_blank\" class=\"btns hover-btn-blue-line w100 round5px mgt10px\">저작권 관리 안내</a>\r\n\t\t<!--} 저작권 관리 안내 버튼 -->\r\n\t\t</div>\r\n\r\n\r\n\t\r\n\r\n\r\n\t<!-- } 관련 콘텐츠 -->\r\n</div>\r\n<!-- } 서브 페이지 -->\r\n\r\n<!-- 모달팝업 // 인용 { -->\r\n<aside id=\"doiQuotationStyle\" class=\"modal doi-quotation-style\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>DOI 인용 스타일</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#doiQuotationStyle\" data-bhvr-no=\"336\" data-evnt-no=\"01\" data-log-no=\"202510233050070588\" data-url-no=\"PG023\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"p_con\">\r\n\t\t<!-- <iframe id=\"doiPage\" src=\"https://data.doi.or.kr/cite/10.5012/jkcs.2008.52.3.315\" width=\"100%\" height=\"500\" title=\"doiPage\"></iframe>-->\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#doiQuotationStyle\" data-bhvr-no=\"336\" data-evnt-no=\"01\" data-log-no=\"202510233050070588\" data-url-no=\"PG023\">닫기</button>\r\n\t\t</div>\r\n\t</div>\r\n</aside>\r\n<!-- } 모달팝업 // 인용 -->\r\n\r\n<!-- 모달팝업 // 연관자료탐색 { -->\r\n<aside id=\"relatedDataSearch\" class=\"modal related-data-search\">\r\n\r\n</aside>\r\n<!-- } 모달팝업 // 연관자료탐색 -->\r\n\r\n<!-- 모달팝업 // MY ON 담기 { -->\r\n<form name=\"myonVO\" id=\"myonAddVO\" target=\"myonAddPopUp\" method=\"post\" action=\"/aiq/myon/myonPutForm.do\"></form>\r\n<aside id=\"myOnDiv\" class=\"modal my-on-vo modal-open\" style=\"display: hidden;\">\r\n</aside>\r\n<!-- } 모달팝업 // MY ON 담기 -->\r\n\r\n<!-- 모달팝업 // 표/그림 { -->\r\n<aside id=\"imageDetail\" class=\"modal size-small image-detail\">\r\n\r\n</aside>\r\n<!-- } 모달팝업 // 표/그림 -->\r\n\r\n\r\n\r\n\r\n<!-- 내보내기 -->\r\n<aside id=\"exportDiv\" class=\"modal size-small export-div\">\r\n    <div class=\"modal-dialog\">\r\n        <div class=\"modal-head flex-spacebetween\">\r\n            <h2 class=\"modal-tit\"><b>내보내기</b></h2>\r\n            <button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#exportDiv\" data-bhvr-no=\"340\" data-evnt-no=\"01\" data-log-no=\"202510233050070588\" data-url-no=\"PG023\" data-cn=\"\"><i class=\"fal fa-times\"></i></button>\r\n        </div>\r\n        <div class=\"modal-content\">\r\n            <table class=\"basic-write-tbl\" summary=\"내보내기 메뉴\">\r\n                <caption>내보내기 메뉴</caption>\r\n                <colgroup>\r\n                    <col width=\"140\" style=\"width: 140px;\" />\r\n                    <col />\r\n                </colgroup>\r\n                <tbody>\r\n                    <tr>\r\n                        <th>내보내기 구분</th>\r\n                        <td>\r\n                            <ul class=\"checkradio-list flex-start\">\r\n                                <li><input type=\"radio\" id=\"exportType1\" name=\"exportType\" value=\"file\" class=\"basic-radio\" checked /><label for=\"exportType1\"><span></span>파일저장</label></li>\r\n                                <li><input type=\"radio\" id=\"exportType2\" name=\"exportType\" value=\"print\" class=\"basic-radio\" /><label for=\"exportType2\"><span></span>인쇄</label></li>\r\n                                <li><input type=\"radio\" id=\"exportType3\" name=\"exportType\" value=\"mail\" class=\"basic-radio\" /><label for=\"exportType3\"><span></span>메일전송</label></li>\r\n                                \r\n                                \r\n                            </ul>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <th>구성항목</th>\r\n                        <td>\r\n                            <ul class=\"checkradio-list flex-start\">\r\n                                <li><input type=\"radio\" id=\"exptInfo1\" name=\"exptInfo\" value=\"brief\" class=\"basic-radio\" checked /><label for=\"exptInfo1\"><span></span>기본정보</label></li>\r\n                                <li><input type=\"radio\" id=\"exptInfo2\" name=\"exptInfo\" value=\"detail\" class=\"basic-radio\" /><label for=\"exptInfo2\"><span></span>상세정보</label></li>\r\n                            </ul>\r\n                            \r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<p class=\"comment mgt10px\" id=\"exptBrf\">관리번호, 논문명, 저널/프로시딩명, 저자 , 발행년, 권, 호, 시작페이지, 끝페이지, 발행기관</p>\r\n\t\t<p class=\"comment mgt10px hidden\" id=\"exptDtl\">관리번호, 논문명, 대등논문명, 저자 , 저널/프로시딩명, 발행기관, 발행년, 발행언어, 권, 호, 시작페이지, 끝페이지, ISBN, ISSN, 주제분야, 키워드, 초록(한글), 초록(영문), 저자(소속기관) </p>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n                        </td>\r\n                    </tr>\r\n                    <tr id=\"fileType\">\r\n                        <th>저장형식</th>\r\n                        <td>\r\n                            <ul class=\"checkradio-list\">\r\n                                <li><input type=\"radio\" id=\"downType1\" name=\"downType\" value=\"txt\" class=\"basic-radio\" checked /><label for=\"downType1\"><span></span>Text(ASCII format)</label></li>\r\n                                <li><input type=\"radio\" id=\"downType2\" name=\"downType\" value=\"excel\" class=\"basic-radio\" /><label for=\"downType2\"><span></span>Excel format</label></li>\r\n                                \r\n                                <li><input type=\"radio\" id=\"downType3\" name=\"downType\" value=\"ref\" class=\"basic-radio\" /><label for=\"downType3\"><span></span>RefWorks Direct Export</label></li>\r\n                                <li><input type=\"radio\" id=\"downType4\" name=\"downType\" value=\"ris\" class=\"basic-radio\" /><label for=\"downType4\"><span></span>RIS format (for Reference Manager, ProCite, EndNote), Scholar's Aids, Mendeley</label></li>\r\n                                \r\n                                \r\n                            </ul>\r\n                        </td>\r\n                    </tr>\r\n                    <tr id=\"mailType\" class=\"hidden\">\r\n\t\t<th>메일정보</th>\r\n\t\t<td>\r\n\t\t<dl>\r\n\t\t<dt><label for=\"toMailId\">받는사람 (필수)</label></dt>\r\n\t\t<dd>\r\n\t\t<input type=\"text\" id=\"toMailId\" name=\"toMailId\" title=\"보내는사람 이메일 주소 입력\" class=\"basic-input\"> @ \r\n\t\t<input type=\"text\" id=\"toMailDomain\" name=\"toMailDomain\" title=\"보내는사람 이메일 주소 입력\" class=\"basic-input\">\r\n\t\t<select id=\"domainOpt1\" name=\"domainOpt1\" onchange=\"javascript:setEmail('1');\" title=\"이메일 선택\" class=\"basic-select\">\r\n\t\t<option value=\"직접선택\" selected=\"selected\">직접선택</option>\r\n\t\t<option value=\"hanmail.net\">hanmail.net</option>\r\n\t\t<option value=\"naver.com\">naver.com</option>\r\n\t\t<option value=\"korea.com\">korea.com</option>\r\n\t\t<option value=\"nate.com\">nate.com</option>\r\n\t\t<option value=\"hotmail.com\">hotmail.com</option>\r\n\t\t<option value=\"gmail.com\">gmail.com</option>\r\n\t\t</select>\r\n\t\t</dd>\r\n\t\t<dt><label for=\"fromMailId\">보내는사람 (선택)</label></dt>\r\n\t\t<dd>\r\n\t\t<input type=\"text\" id=\"fromMailId\" name=\"fromMailId\" title=\"받는사람 이메일 주소 입력\" class=\"basic-input\"> @\r\n\t\t<input type=\"text\" id=\"fromMailDomain\" name=\"fromMailDomain\" title=\"받는사람 이메일 주소 입력\" class=\"basic-input\">\r\n\t\t<select id=\"domainOpt2\" name=\"domainOpt2\" onchange=\"javascript:setEmail('2');\" title=\"이메일 선택\" class=\"basic-select\">\r\n\t\t<option value=\"직접선택\" selected=\"selected\">직접선택</option>\r\n\t\t<option value=\"hanmail.net\">hanmail.net</option>\r\n\t\t<option value=\"naver.com\">naver.com</option>\r\n\t\t<option value=\"korea.com\">korea.com</option>\r\n\t\t<option value=\"nate.com\">nate.com</option>\r\n\t\t<option value=\"hotmail.com\">hotmail.com</option>\r\n\t\t<option value=\"gmail.com\">gmail.com</option>\r\n\t\t</select>\r\n\t\t</dd>\r\n\t\t<dt><label for=\"mailTitle\">제목</label></dt>\r\n\t\t<dd><input type=\"text\" id=\"mailTitle\" name=\"mailTitle\" title=\"메일제목\" class=\"basic-input w100\" value=\"KISTI 검색결과 이메일  서비스\"/></dd>\r\n\t\t<dt><label for=\"mail04\">내용</label></dt>\r\n\t\t<dd><textarea id=\"mailCont\" name=\"mailCont\" title=\"이메일 내용을 입력합니다.\"  cols=\"50\" rows=\"4\" class=\"basic-textarea w100\">KISTI 검색결과 이메일  서비스</textarea></dd>\r\n\t\t</dl>\r\n\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr id=\"bigFile\" class=\"hidden\">\r\n\t\t<th>안내</th>\r\n\t\t<td>\r\n\t\t<p class=\"comment mgt10px\">총  건의 자료가 검색되었습니다.</p>\r\n\t\t<p class=\"comment mgt10px\">다운받으실 자료의 인덱스를 입력하세요. (1-10,000)</p>\r\n\t\t<p class=\"comment mgt10px\">검색결과의 순서대로 최대 10,000건 까지 다운로드가 가능합니다.</p>\r\n\t\t<p class=\"comment mgt10px\">데이타가 많을 경우 속도가 느려질 수 있습니다.(최대 2~3분 소요)</p>\r\n\t\t<p class=\"comment mgt10px\">다운로드 파일은 UTF-8 형태로 저장됩니다.<br/> 파일의 내용이 제대로 보이지 않을실 때는 웹브라우저 상단의 보기 -> 인코딩 -> 자동선택 여부를 확인하십시오.</p>\r\n\t\t<p class=\"comment mgt10px\">\r\n\t\t<input type=\"text\" id=\"startIndex\" name=\"startIndex\" title=\"출력사이즈 입력\" maxlength=\"5\" class=\"basic-input\">\r\n\t\t~\r\n\t\t<input type=\"text\" id=\"endIndex\" name=\"endIndex\" title=\"출력사이즈 입력\" maxlength=\"5\" class=\"basic-input\">\r\n\t\t</p>\r\n\t\t<ul class=\"checkradio-list\">\r\n                                <li><input type=\"radio\" id=\"downType11\" name=\"downType1\" value=\"txt\" class=\"basic-radio\" checked /><label for=\"downType11\"><span></span>Text(ASCII format)</label></li>\r\n\t\t<li><input type=\"radio\" id=\"downType22\" name=\"downType1\" value=\"excel\" class=\"basic-radio\" /><label for=\"downType22\"><span></span>Excel format</label></li>\r\n                            </ul>\r\n\t\t</td>\r\n\t\t</tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n        <div class=\"modal-foot flex-center\">\r\n            <button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#exportDiv\" data-bhvr-no=\"340\" data-evnt-no=\"01\" data-log-no=\"202510233050070588\" data-url-no=\"PG023\" data-cn=\"\">닫기</button>\r\n            <button type=\"button\" class=\"btns size-big btn-blue-deep\" onclick=\"exportSrchList();\">실행</button>\r\n        </div>\r\n    </div>\r\n</aside>\r\n<!-- 내보내기 end-->\r\n\r\n<form id=\"exportFile\" name=\"exportFile\" method=\"post\">\r\n\t\r\n\t<input type=\"hidden\" name=\"class2\" value=\"국내논문\">\r\n\t\r\n\t<input type=\"hidden\" name=\"searchCondition\" value=\"thesis\">\r\n\t<input type=\"hidden\" name=\"searchKeyword\" value=\"\">\r\n\t<input type=\"hidden\" name=\"startIndex\">\r\n\t<input type=\"hidden\" name=\"endIndex\">\r\n\t<input type=\"hidden\" name=\"gubunCd\">\r\n\t<input type=\"hidden\" name=\"selectFields\" id=\"selectFields\" value=\"\">\r\n\t<div id=\"selectCns\"></div>\r\n</form>\r\n\r\n<script type=\"text/javascript\">\r\n\r\n$('input[name=\"exptInfo\"]').change(function() {\r\n\tif($(this).val() == 'brief'){\r\n\t\t$('#exptBrf').removeClass(\"hidden\");\r\n\t\t$('#exptDtl').addClass(\"hidden\");\r\n\t}else if($(this).val() == 'detail'){\r\n\t\t$('#exptBrf').addClass(\"hidden\");\r\n\t\t$('#exptDtl').removeClass(\"hidden\");\r\n\t}\r\n});\r\n\r\n\r\n$('input[name=\"exportType\"]').change(function() {\r\n\tvar val = $(this).val(); \r\n\tif(val == \"file\"){\r\n\t\t$('#fileType').removeClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"print\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"mail\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').removeClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"bigFile\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').removeClass(\"hidden\");\r\n\t}\r\n});\r\n</script>\n\r\n\r\n\r\n<form style=\"display:none\" name=\"exportRWForm\" method=\"POST\" target=\"RefWorksMain\" action=\"https://www.refworks.com/express/ExpressImport.asp?vendor=ScienceON&filter=RIS%20Format&encoding=65001\">\r\n\t<textarea name=\"ImportData\" rows=\"30\" cols=\"70\" title=\" \"></textarea>\r\n</form>\r\n\r\n<!-- 모달팝업 // 핵심어 질의응답 { -->\r\n\r\n<!-- } 모달팝업 // 핵심어 질의응답 -->\r\n\r\n<!-- 모달팝업 // 초록 용어 설명 { -->\r\n<aside id=\"abstractWord\" class=\"modal abstract-word\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>초록 용어 설명</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#abstractWord\"\r\n\t\tdata-bhvr-no=\"383\" data-evnt-no=\"01\" data-log-no=\"202510233050070588\" data-url-no=\"PG023\">\r\n\t\t<i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"modal-content\">\r\n\t\t<p class=\"comment\">\r\n\t\t초록 내용을 이해하기 어려운 초급자를 위해 전문 용어를 설명하는 서비스<br />\r\n\t\t논문에서 용어와 풀이말을 자동 추출한 결과로, 시범 서비스 중입니다.\r\n\t\t</p>\r\n\t\t<div class=\"contain-term flex-start mgt40px\">\r\n\t\t<h3>초록 포함 용어</h3>\r\n\t\t<div class=\"basic-tabbox ver-blue flex-start hdwrdLst\">\r\n\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<article class=\"abstract-word-box mgt40px\">\r\n\t\t<dl class=\"aw-box flex-start\" id=\"ftDd\">\r\n\t\t<dt>표제어</dt>\r\n\t\t<dd>PCR</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\" id=\"sDd\">\r\n\t\t<dt>동의어</dt>\r\n\t\t<dd>Packet Collision Rate</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\"  id=\"cDd\">\r\n\t\t<dt>용어 설명 출처 목록 <span class=\"color-red\">(6)</span></dt>\r\n\t\t<dd>\r\n\t\t<div class=\"scrollbox\" style=\"max-height: 200px;\">\r\n\t\t<ul class=\"jum-ul\">\r\n\t\t<li class=\"active\" id=\"fView\">\r\n\t\t<a href=\"javascript:void(0);\" class=\"oneline\">[논문] Real-time PCR과 Colony forming unit법을 이용한 타액 내 2종의 구강미생물 총량분석</a>\r\n\t\t<a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t</li>\r\n\t\t<li id=\"sView\">\r\n\t\t<a href=\"javascript:void(0);\" class=\"oneline\">[논문] 강인성을 개선한 VANET에서의 자율 TDMA</a>\r\n\t\t<a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t</li>\r\n\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\" id=\"lDd\">\r\n\t\t<dt>용어 설명</dt>\r\n\t\t<dd>PCR은 세균 특이성이 있는 primer를 이용하여 적은 수의 세균이 있을지라도 쉽게 검출할 수 있는 유용한 방법이며, 이를 이용하여 구강 내 치면세균막이나 타액에서 직접 세균을 검출할 수 있게 되었다[8].</dd>\r\n\t\t</dl>\r\n\t\t</article>\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" onclick=\"insertBhvrLog({'bhvrNo' : '383','evntNo' : '01', 'urlNo' : 'PG023'});\"\r\n\t\tclass=\"btns size-big modal-open-close\" data-kisti-modal=\"#abstractWord\">닫기</button>\r\n\t\t</div>\r\n\t</div>\r\n</aside>\r\n<!-- } 모달팝업 // 초록 용어 설명 -->\r\n\r\n\r\n<!-- 모달팝업 // NTIS 과제정보 { -->\r\n<aside id=\"ntisWorkInfo\" class=\"modal size-small table-modal-box ntis-work-info\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>NTIS 과제정보</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#ntisWorkInfo\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"modal-content\">\r\n\t\t<article class=\"all-powerful-list\" style=\"border-top: none;\" id=\"pjtList\"></article>\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#ntisWorkInfo\">닫기</button>\r\n\t\t</div>\r\n\t</div>\r\n</aside>\r\n<!-- } 모달팝업 // NTIS 과제정보 -->\r\n\r\n<!-- 24.08.21 AI 리뷰 담기 모달 추가-->\r\n\r\n<form id=\"logForm\">\r\n\t\r\n\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\r\n\t<input type=\"hidden\" name=\"cn\" value=\"JAKO201213660554224\"/>\r\n\t<input type=\"hidden\" name=\"svcCode1\" valu