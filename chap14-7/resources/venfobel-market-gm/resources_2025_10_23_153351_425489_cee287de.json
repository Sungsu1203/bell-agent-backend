() < 1200) {\r\n\t\t$.alert({\r\n\t\ttitle: '알림',\r\n\t\tcontent: '브라우저 가로 크기가 1,200px 이상인 화면에서 이용 가능합니다.',\r\n\t\tbuttons: {\r\n\t\talphabet: {\r\n\t\ttext: '확인'\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\tfunction searchTag(keyword){\r\n\t\t//$('.wrap-loading').removeClass('hidden');\r\n\t\tdocument.searchForm.searchKeyword.value = keyword;\r\n\t\tif(keyword == \"COVID-19 | Coronavirus\"){\r\n\t\tdocument.searchForm.action = \"/srch/selectPORSrchTotal.do?linkYn=Y&useContCd=0008&linkURL=/srch/selectPORSrchTotal.do\";\r\n\t\t}else{\r\n\t\tdocument.searchForm.action = \"/srch/selectPORSrchTotal.do\";\r\n\r\n\t\t}\r\n\t\tinsertBhvrLog({'bhvrNo' : '365','evntNo' : '01', 'param' : keyword ,'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n// \tdocument.searchForm.target = keyword;\r\n\t\tdocument.searchForm.submit();\r\n\t\tdocument.searchForm.searchKeyword.value = \"\";\r\n\t}\r\n\r\n\tfunction searchTag2(keyword, srchType){\r\n\t\t//$('.wrap-loading').removeClass('hidden');\r\n\t\tdocument.searchForm.searchKeyword.value = keyword;\r\n\t\tif(keyword == \"COVID-19 | Coronavirus\"){\r\n\t\tdocument.searchForm.action = \"/srch/selectPORSrchTotal.do?linkYn=Y&useContCd=0008&linkURL=/srch/selectPORSrchTotal.do\";\r\n\t\t}else{\r\n\t\tdocument.searchForm.action = \"/srch/selectPORSrchTotal.do\";\r\n\r\n\t\t}\r\n\t\tinsertBhvrLog({'bhvrNo' : '365','evntNo' : '01', 'param' : keyword ,'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\r\n\t\t// 2024.08.06 추가\r\n\t\tsetSrchCookie3(keyword, srchType);\r\n\r\n\t\tdocument.searchForm.target = keyword;\r\n\t\tdocument.searchForm.submit();\r\n\t\tdocument.searchForm.searchKeyword.value = \"\";\r\n\t}\r\n\r\n\tfunction fn_apigatewayLogout(){\r\n\t\t//TODO API Gateway URL 변경 시 수정 필요\r\n\r\n\t\tvar apigatewayUrl = \"\";\r\n\t\tvar scienceOnUrl = \"\";\r\n\t\t \r\n\r\n\t\t\r\n\t\t//fn_CallURL(apigatewayUrl+\"/api/auth/logoutSO.do\");\r\n\r\n\t\t\r\n\t\tfn_CallURL(