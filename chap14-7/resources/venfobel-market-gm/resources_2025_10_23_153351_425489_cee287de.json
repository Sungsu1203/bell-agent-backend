lue=\"\">\r\n\t<div id=\"selectCns\"></div>\r\n</form>\r\n\r\n<script type=\"text/javascript\">\r\n\r\n$('input[name=\"exptInfo\"]').change(function() {\r\n\tif($(this).val() == 'brief'){\r\n\t\t$('#exptBrf').removeClass(\"hidden\");\r\n\t\t$('#exptDtl').addClass(\"hidden\");\r\n\t}else if($(this).val() == 'detail'){\r\n\t\t$('#exptBrf').addClass(\"hidden\");\r\n\t\t$('#exptDtl').removeClass(\"hidden\");\r\n\t}\r\n});\r\n\r\n\r\n$('input[name=\"exportType\"]').change(function() {\r\n\tvar val = $(this).val(); \r\n\tif(val == \"file\"){\r\n\t\t$('#fileType').removeClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"print\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"mail\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').removeClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"bigFile\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').removeClass(\"hidden\");\r\n\t}\r\n});\r\n</script>\n\r\n\r\n\r\n<form style=\"display:none\" name=\"exportRWForm\" method=\"POST\" target=\"RefWorksMain\" action=\"https://www.refworks.com/express/ExpressImport.asp?vendor=ScienceON&filter=RIS%20Format&encoding=65001\">\r\n\t<textarea name=\"ImportData\" rows=\"30\" cols=\"70\" title=\" \"></textarea>\r\n</form>\r\n\r\n<!-- 모달팝업 // 핵심어 질의응답 { -->\r\n\r\n\t<form id=\"qaDivForm\" method=\"post\">\r\n\t\t<input type=\"hidden\" name=\"pageIndex\" id=\"qa_pageIndex\">\r\n\t\t<input type=\"hidden\" name=\"pageUnit\" value=\"30\">\r\n\t\t<input type=\"hidden\" name=\"artId\" id=\"qa_artId\">\r\n\t\t<input type=\"hidden\" name=\"kwrdCn\" id=\"qa_kwrdCn\">\r\n\t\t<input type=\"hidden\" name=\"qaId\" id=\"qa_qaId\">\r\n\t\t<input type=\"hidden\" name=\"viewIndex\" id=\"viewIndex\">\r\n\t</form>\r\n\t<aside id=\"qaDiv\" class=\"modal qa-div\">\r\n\t\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\" id=\"qa_title\"><b>\"\"</b> 핵심어 질의 응답</h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#qaDiv\" onclick=\"insertBhvrLog({'bhvrNo' : '409', 'evntNo': '01', 'urlNo': 'PG023'});\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"modal-content\" id=\"qaKwdList\">\r\n\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#qaDiv\" onclick=\"insertBhvrLog({'bhvrNo' : '409', 'evntNo': '01', 'urlNo': 'PG023'});\">닫기</button>\r\n\t\t</div>\r\n\t\t</div>\r\n\t</aside>\r\n\r\n<!-- } 모달팝업 // 핵심어 질의응답 -->\r\n\r\n<!-- 모달팝업 // 초록 용어 설명 { -->\r\n<aside id=\"abstractWord\" class=\"modal abstract-word\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>초록 용어 설명</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#abstractWord\"\r\n\t\tdata-bhvr-no=\"383\" data-evnt-no=\"01\" data-log-no=\"202510233050070551\" data-url-no=\"PG023\">\r\n\t\t<i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"modal-content\">\r\n\t\t<p class=\"comment\">\r\n\t\t초록 내용을 이해하기 어려운 초급자를 위해 전문 용어를 설명하는 서비스<br />\r\n\t\t논문에서 용어와 풀이말을 자동 추출한 결과로, 시범 서비스 중입니다.\r\n\t\t</p>\r\n\t\t<div class=\"contain-term flex-start mgt40px\">\r\n\t\t<h3>초록 포함 용어</h3>\r\n\t\t<div class=\"basic-tabbox ver-blue flex-start hdwrdLst\">\r\n\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<article class=\"abstract-word-box mgt40px\">\r\n\t\t<dl class=\"aw-box flex-start\" id=\"ftDd\">\r\n\t\t<dt>표제어</dt>\r\n\t\t<dd>PCR</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\" id=\"sDd\">\r\n\t\t<dt>동의어</dt>\r\n\t\t<dd>Packet Collision Rate</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\"  id=\"cDd\">\r\n\t\t<dt>용어 설명 출처 목록 <span class=\"color-red\">(6)</span></dt>\r\n\t\t<dd>\r\n\t\t<div class=\"scrollbox\" style=\"max-height: 200px;\">\r\n\t\t<ul class=\"jum-ul\">\r\n\t\t<li class=\"active\" id=\"fView\">\r\n\t\t<a href=\"javascript:void(0);\" class=\"oneline\">[논문] Real-time PCR과 Colony forming unit법을 이용한 타액 내 2종의 구강미생물 총량분석</a>\r\n\t\t<a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t</li>\r\n\t\t<li id=\"sView\">\r\n\t\t<a href=\"javascript:void(0);\" class=\"oneline\">[논문] 강인성을 개선한 VANET에서의 자율 TDMA</a>\r\n\t\t<a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t</li>\r\n\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\" id=\"lDd\">\r\n\t\t<dt>용어 설명</dt>\r\n\t\t<dd>PCR은 세균 특이성이 있는 primer를 이용하여 적은 수의 세균이 있을지라도 쉽게 검출할 수 있는 유용한 방법이며, 이를 이용하여 구강 내 치면세균막이나 타액에서 직접 세균을 검출할 수 있게 되었다[8].</dd>\r\n\t\t</dl>\r\n\t\t</article>\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" onclick=\"insertBhvrLog({'bhvrNo' : '383','evntNo' : '01', 'urlNo' : 'PG023'});\"\r\n\t\tclass=\"btns size-big modal-open-close\" data-kisti-modal=\"#abstractWord\">닫기</button>\r\n\t\t</div>\r\n\t</div>\r\n</aside>\r\n<!-- } 모달팝업 // 초록 용어 설명 -->\r\n\r\n\r\n<!-- 모달팝업 // NTIS 과제정보 { -->\r\n<aside id=\"ntisWorkInfo\" class=\"modal size-small table-modal-box ntis-work-info\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>NTIS 과제정보</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#ntisWorkInfo\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"modal-content\">\r\n\t\t<article class=\"all-powerful-list\" style=\"border-top: no