\n\t\t// 문헌 제목 생성\r\n\t\t$(\"#referTitle\").html(projectYear + '년 참여연구원의 다른 문헌 <span class=\"color-red\" id=\"referCnt\"></span>');\r\n\t\t$(\"#referCnt\").text('('+allCnt+')');\r\n\t\t// 상단 전체 탭 HTML 생성\r\n\t\t$(\"#refer000\").text(\"전체(\" + allCnt + \")\")\r\n//\t \t\t.on(\"click\", function() {return false;});\r\n\t\tif(allCnt > 0){\r\n\t\t$(\"#refer000\").text(\"전체(\" + allCnt + \")\")\r\n//\t \t\t.attr(\"oncilck\", \"makeTLReferResultHtml(1, 'ALL', '\"+pjn+\"', '\"+cn+\"')\");\r\n\t\t}\r\n//\t \t\t    \tmakeTLReferHtml(1, gubun, pjn, cn);\r\n\t\t} else {\r\n\t\t// 문헌 제목 생성\r\n\t\t$(\"#referTitle\").html(projectYear + '년 참여연구원의 다른 문헌 <span class=\"color-red\" id=\"referCnt\"></span>');\r\n\t\t$(\"#referCnt\").text('('+0+')');\r\n\r\n\t\t$(\"#refer000\").text(\"전체(\" + 0 + \")\");\r\n//\t \t\t.attr(\"oncilck\", \"return false;\");\r\n\t\t$(\"#refer001\").text(\"논문(\" + 0 + \")\");\r\n//\t \t\t.attr(\"oncilck\", \"return false;\");\r\n\t\t$(\"#refer002\").text(\"특허(\" + 0 + \")\");\r\n//\t \t\t.attr(\"oncilck\", \"return false;\");\r\n\t\t$(\"#refer003\").text(\"보고서(\" + 0 + \")\");\r\n//\t \t\t.attr(\"oncilck\", \"return false;\");\r\n\t\t}\r\n\t\t} else {\t// 개수 체크 하지 않는 경우 (문헌 목록 HTML 생성 O)\r\n\t\tvar referListHtml = \"\";\r\n\r\n\t\tif(referList.length > 0){\r\n\r\n\t\t// 클래스 수정 함수\r\n//\t \t\tfn_modify_class(\"REFER\", gubun);\r\n\r\n\t\t// 문헌 목록 HTML 생성 \r\n\t\t$(referList).each(function(idx, item){\r\n\r\n\t\t// 저자\r\n\t\tvar author = nullToStr(item.AUTHOR, null);\r\n\r\n\t\t// 게시물\r\n\t\tvar autNm = author.split(\";\")[0];\t\t// 저자 추가\r\n\t\tvar title = \" \\\"\" + item.TITLE + \"\\\" \"; \t// 제목 추가\r\n\t\tvar contents = \"\";\r\n\r\n\t\t// 원문보기 버튼 추가\r\n\t\tif(nullToStr(item.CN, null) != ''){\r\n\t\tif(item.GUBUNCODE == \"001\" && nullToStr(item.PDFVIEW, null) != ''){\r\n\t\tif(item.CN.substr(0, 4) == \"DIKO\") {\r\n\t\tcontents += '<button type=\"button\" class=\"btns hover-btn-blue-line\" onclick=\"fncLogSave(\\''+ item.PDFVIEW + '\\', \\''+ item.CN +'\