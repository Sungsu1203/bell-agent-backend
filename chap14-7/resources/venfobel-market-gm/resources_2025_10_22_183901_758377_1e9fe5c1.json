[
  {
    "title": "Mfds 식품의약품안전처 의약품통합정보시스템 의약품제품정보 상세보기",
    "url": "https://nedrug.mfds.go.kr/pbp/CCBBB01/getItemDetail?itemSeq=202007638",
    "content": "총량 : 1정(680 밀리그램) 중- | 성분명 : 벤포티아민 | 분량 : 300.0 | 단위 : 밀리그램 | 규격 : KP | 성분정보 : | 비고 : · 총량 : 1정(680 밀리그램) 중- | 성분명 : 피리독신염산염 | 분량 : 100.0 | 단위 : 밀리그램 | 규격 : KP | 성분정보",
    "raw_content": "<!doctype html>\r\n<html\r\n        lang=\"ko\"\r\n>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\r\n    <!-- Cache 사용안하도록 설정 -->\r\n<!--    <meta http-equiv=\"Expires\" content=\"-1\">-->\r\n<!--    <meta http-equiv=\"Pragma\" content=\"no-Cache\">-->\r\n<!--    <meta http-equiv=\"Cache-Control\" content=\"No-Cache\">-->\r\n    <!-- Cache 사용안하도록 설정 -->\r\n    <!--<title th:text=\"|식품의약품안전처 의약품통합정보시스템 의약품제품정보 상세보기|\"></title> SR202206080010-의약품등 정보 페이지 인쇄 시 짤림 현상 -->\r\n    <title>식품의약품안전처 의약품통합정보시스템 의약품제품정보 상세보기-벤포칸정</title>\r\n    <link rel=\"stylesheet\" href=\"/resources/css/import.css\">\r\n    <!--    <link rel=\"stylesheet\" th:href=\"@{/resources/css/druginfo.css}\" >-->\r\n    <link rel=\"stylesheet\" href=\"/static/lib/jquery/jquery.bxslider.css\">\r\n    <script type=\"text/javascript\" src=\"/static/lib/jquery/jquery-1.12.4.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"/resources/js/front_script.js\"></script>\r\n    <script type=\"text/javascript\" src=\"/resources/js/common-pbp.js\"></script>\r\n    <script type=\"text/javascript\" src=\"/resources/js/jquery.bxslider.js\"></script>\r\n    <script type=\"text/javascript\" src=\"/static/lib/bootstrap-3.3.7/js/bootstrap.js\"></script>\r\n    <script type=\"text/javascript\" src=\"/static/lib/bootbox.js\"></script>\r\n    <script type=\"text/javascript\" src=\"/resources/js/qrcode.js/qrcode.min.js\"></script>\r\n    <script>\r\n        /*<![CDATA[*/\r\n        var pkInfoView = false;\r\n        \r\n        $(window).scroll(function() {\r\n            if($(window).scrollTop() >= $('body').position().top  ){\r\n                $('.scroll_menu ul li').removeClass('on')\r\n            }\r\n            \r\n            for (var i = 0; i < 12; i++) {\r\n                var srId = i+1;\r\n                srId = (srId < 10) ? '0'+srId : srId;\r\n                \r\n                if (0 < $('.scroll_' + srId).length) {\r\n                    if($(window).scrollTop() >= $('.scroll_' + srId).position().top -10 ){\r\n                        $('.scroll_menu ul li').removeClass('on')\r\n                        $('.scroll_menu ul li:eq('+i+')').addClass('on')\r\n                    }\r\n                }\r\n            }\r\n            \r\n        });\r\n        \r\n        $(document).ready(function () {\r\n            checkId();\r\n            $(\".scroll_menu ul li\").each(function(){\r\n                var friend_tab_scroll = $(this).attr(\"id\");\r\n                if(friend_tab_scroll != undefined && $(friend_tab_scroll).position() != undefined ){\r\n                    friend_tab_top = $(friend_tab_scroll).position().top;\r\n                    $(friend_tab_scroll).data(\"top\", friend_tab_top);\r\n                }\r\n            })\r\n            $(\".scroll_menu ul li\").click(function(){\r\n                var friend_tab_top = $($(this).attr(\"id\")).position().top;\r\n                $(\"html, body\").stop().animate({scrollTop:friend_tab_top}, 500)\r\n            })\r\n            \r\n            setFrText();\r\n            \r\n            getDrWarnList();\r\n            \r\n            if (0 < $(\"#tblChf\").length) {\r\n                $('#tblChf').hide();\r\n            }\r\n            \r\n            $('.bxslider').bxSlider({\r\n                mode: 'horizontal',\r\n                moveSlides: 1,\r\n                slideMargin: 40,\r\n                infiniteLoop: true,\r\n                slideWidth: 1023,\r\n                minSlides: 1,\r\n                maxSlides: 1,\r\n                speed: 800,\r\n            });\r\n            \r\n            $(\".s-acc-con > h2 > button\").click(function () {\r\n                $(\".s-acc-con\").not($(this).parent().next(\".ac-con\").parent().toggleClass(\"on\")).removeClass(\"on\");\r\n            });\r\n            $(\".s-acc > h2 > button\").click(function () {\r\n                $(this).parent().parent().toggleClass(\"on\");\r\n            });\r\n            $(\".sec_top .btn_area .btn_folding\").click(function () {\r\n                var div = $(this).parent().parent(); \r\n                div.toggleClass(\"fr-on\");\r\n                if ($(div).hasClass('_preview_nb')) {\r\n                    if ($(div).hasClass('fr-on')) {\r\n                        $('#btnTct').show();\r\n                    } else {\r\n                        $('#btnTct').hide();\r\n                    }\r\n                    \r\n                    setFrText();\r\n                }\r\n            });\r\n            $(\".btn_folding\").click(function () {\r\n                var div = $(this).parent().parent();\r\n                div.toggleClass(\"fr-on\");\r\n                if ($(div).hasClass('_preview_nb')) {\r\n                    if ($(div).hasClass('fr-on')) {\r\n                        $('#btnTct').show();\r\n                    } else {\r\n                        $('#btnTct').hide();\r\n                    }\r\n                    setFrText();\r\n                }\r\n            });\r\n            $(\".btn_folding\").click(function () {\r\n                $(\".mediWrap\").toggleClass(\"left-close\");\r\n                \r\n                if ($(this).attr('id') == 'btnChf') {\r\n                    var div = $(this).parent().parent();\r\n                    \r\n                    if ($(div).hasClass('fr-on')) {\r\n                        $('#tblChf').show();\r\n                    } else {\r\n                        $('#tblChf').hide();\r\n                    }\r\n                }\r\n            });\r\n            //탭\r\n            $(\".ltab > ul > li > a\").click(function () {\r\n                $(\".ltab > ul > li\").removeClass(\"on\");\r\n                $(this).parent().addClass(\"on\");\r\n                $(\".l_sec_md\").toggleClass(\"t-on\");\r\n                return false\r\n            });\r\n            $(\".btn_ham\").click(function () {\r\n                $(\".drug_allmenu\").addClass(\"on\");\r\n            });\r\n            $(\".btn_hamx\").click(function () {\r\n                $(\".drug_allmenu\").removeClass(\"on\");\r\n            });\r\n            $(\".en-tab > a:first\").click(function () {\r\n                $(\".en-tab > a\").removeClass(\"on\");\r\n                $(this).addClass(\"on\");\r\n                $(\"#en-tab-con2\").removeClass(\"on\");\r\n                $(\"#en-tab-con1\").addClass(\"on\");\r\n                return false\r\n            });\r\n            $(\".en-tab > a:last\").click(function () {\r\n                $(\".en-tab > a\").removeClass(\"on\");\r\n                $(this).addClass(\"on\");\r\n                $(\"#en-tab-con1\").removeClass(\"on\");\r\n                $(\"#en-tab-con2\").addClass(\"on\");\r\n                return false\r\n            });\r\n            $(\".menulist > ul > li > a\").click(function(){\r\n                $(\".drug_allmenu\").removeClass(\"on\");\r\n            });\r\n            $(\".menulist > ul > li > ul > li > a\").click(function(){\r\n                $(\".drug_allmenu\").removeClass(\"on\");\r\n            });\r\n            \r\n            var eeTitles = $('#_ee_doc p.title');\r\n            eeTitles.addClass('subj nock');\r\n\r\n            var eeIndents = $('#_ee_doc > div > p');\r\n            eeIndents.addClass('note');\r\n\r\n            var udTitles = $('#_ud_doc p.title');\r\n            udTitles.addClass('subj nock');\r\n\r\n            var udIndents = $('#_ud_doc > div > p');\r\n            udIndents.addClass('note');\r\n\r\n            var cls = 'on';\r\n            var nbTitles = $('#_nb_doc p.title');\r\n            nbTitles.addClass('subj nock');\r\n            nbTitles.each(function(i,e) {\r\n                var title = $(e);\r\n                // title.append('<a href=\"#none\" title=\"'+title.text()+' 접기\"></a>');\r\n                title.append('<a href=\"#none\" title=\"'+title.text()+' 접기\" style=\"text-indent: -9999px\">' + title.text() +' 접기</a>');\r\n            });\r\n            \r\n            nbTitles.on('click',function(){\r\n                var title = $(this);\r\n\r\n                var div = title.next();\r\n                var divTag = div.prop('tagName').toLowerCase();\r\n                console.log (\"aa\"  + title.attr('title') )\r\n\r\n                var titleLength = title.children().attr('title').length\r\n                var titleText = title.children().attr('title')\r\n                if (title.hasClass('on')) {\r\n                    title.find('a').attr('title', titleText.substr(0, titleLength-4) + ' 접기');\r\n                    title.find('a').text(titleText.substr(0, titleLength-4) + ' 접기');\r\n                } else {\r\n                    title.find('a').attr('title', titleText.substr(0, titleLength-3)  + ' 펼치기');\r\n                    title.find('a').text(titleText.substr(0, titleLength-3) + ' 펼치기');\r\n                }\r\n\r\n                if(div){\r\n                    title.toggleClass(cls);\r\n                }\r\n                if('div' == divTag) {\r\n                    div.toggleClass(cls);\r\n                }\r\n            });\r\n            \r\n            var nbHeader = $('.scroll_05');\r\n            if (0 < nbTitles.length) {\r\n                nbHeader.append('<a href=\"#none\" id=\"btnTct\" class=\"xi-minus-circle xi-plus-circle\" title=\"주의사항 펼치기\" style=\"text-indent: -9999px\">주의사항 펼치기</a>');\r\n            }\r\n            $('.scroll_05 > a').on('click',function () {\r\n                var hi = $(this);\r\n                hi.toggleClass('xi-minus-circle');\r\n\r\n                if (hi.hasClass('xi-minus-circle')) {\r\n                    hi.attr('title', '주의사항 접기');\r\n                    hi.text('주의사항 접기');\r\n\r\n                } else {\r\n                    hi.attr('title', '주의사항 펼치기');\r\n                    hi.text('주의사항 펼치기');\r\n\r\n                }\r\n                if(hi.hasClass('xi-plus-circle')){\r\n                    nbTitles.each(function (i, e) {\r\n                        var title = $(e);\r\n\r\n                        if (hi.hasClass('xi-minus-circle')) {\r\n                            title.find('a').attr('title', title.text() + ' 접기');\r\n                            title.find('a').removeClass('xi-minus-circle');\r\n                            title.removeClass(cls);\r\n                            var div = title.next();\r\n                            var divTag = div.prop('tagName').toLowerCase();\r\n                            if (div) {\r\n                                title.removeClass(cls);\r\n                            }\r\n                            if('div'==divTag){\r\n                                div.removeClass(cls);\r\n                            }\r\n\r\n                        } else {\r\n                            title.find('a').attr('title', title.text() + ' 펼치기');\r\n                            title.find('a').removeClass('xi-minus-circle');\r\n                            title.addClass(cls);\r\n                            var div = title.next();\r\n                            var divTag = div.prop('tagName').toLowerCase();\r\n                            if (div) {\r\n                                title.addClass(cls);\r\n                            }\r\n                            if('div'==divTag){\r\n                                div.addClass(cls);\r\n                            }\r\n\r\n                        }\r\n                    });\r\n                }\r\n            });\r\n            \r\n            var nbIndents = $('#_nb_doc > div > p');\r\n            nbIndents.addClass('note');\r\n            \r\n            $('#drugInfoLastMenu').on('keypress keydown', function(event) {\r\n                var keyCode = '';\r\n                var key = event.key;\r\n                \r\n                if (window.event) {\r\n                    keyCode = event.keyCode;\r\n                } else {\r\n                    keyCode = event.which;\r\n                }\r\n                \r\n                if (9 == keyCode) {\r\n                    $('.btn_hamx').focus();\r\n                }\r\n            });\r\n            \r\n            // 강제로 3종 문서 img에 alt=\"\" 넣어주기\r\n            var eeImgs = $('#_ee_doc').find('img');\r\n            var udImgs = $('#_ud_doc').find('img');\r\n            var nbImgs = $('#_nb_doc').find('img');\r\n            \r\n            setImgsAlt(eeImgs);\r\n            setImgsAlt(udImgs);\r\n            setImgsAlt(nbImgs);\r\n            \r\n            //화면 최초 진입시 pkInfo 정보에 따라 생동성이 우선인지 아이템 정보가 우선인지\r\n            setPkInfoView(pkInfoView);\r\n            if (!pkInfoView) {\r\n                               //생동성 시험정보 없으면 출력 부분 추가하여 버튼 비활성화 기능 제거- 2021.01.29 cdsy\r\n                //$('#btnPkInfo').attr('disabled', true);\r\n            }\r\n            \r\n            $(\"._up\").click(function(){\r\n                //$(\".scroll_menu ul li.on\").prev().click() 2024.06.17 SR202406170014\r\n                var posTop = $(\"html, body\").scrollTop();\t//현재 스크롤 위치값\r\n                $(\"html, body\").stop().animate({scrollTop:parseInt(posTop-500)}, 300)\r\n            })\r\n\r\n            $(\"._down\").click(function(){\r\n                /*if($(\".scroll_menu ul li\").hasClass(\"on\")){ 2024.06.17 SR202406170014\r\n                    $(\".scroll_menu ul li.on\").next().click()\r\n                }else{\r\n                    $(\".scroll_menu ul li:eq(0)\").click()\r\n                }*/\r\n                var posTop = $(\"html, body\").scrollTop();\t//현재 스크롤 위치값\r\n                $(\"html, body\").stop().animate({scrollTop:parseInt(posTop+500)}, 300)\r\n            })\r\n\r\n            $(\"._scroll_top\").click(function(){\r\n                $(\"html, body\").stop().animate({scrollTop:0},300)\r\n                return false;\r\n            })\r\n        });\r\n        $(document).ready(function() {\r\n            var h = $('#ezdrug-url-code').height();\r\n            var codeValue = 'https://nedrug.mfds.go.kr/pbp/ezdrug?itemSeq=202007638';\r\n            new QRCode('ezdrug-url-code', {\r\n                text: codeValue,\r\n                width: h,\r\n                height: h\r\n            });\r\n            setTimeout(function() {\r\n            $('#ezdrug-url-code img').attr('alt', '품목제조사 및 유통(사용기한) 정보 QR코드')\r\n                $('#ezdrug-url-code img').attr('title', '클릭 시 크게 볼 수 있습니다')\r\n                .css({'cursor': 'pointer'});\r\n            }, 100);\r\n            $('#ezdrug-url-code').click(function(e) {\r\n                e.preventDefault();\r\n                $('#_tmp_qrcode').remove();\r\n                $('body').append('<div id=\"_tmp_qrcode\" style=\"display: none;\"></div>');\r\n                var q = new QRCode('_tmp_qrcode', {\r\n                    text: codeValue,\r\n                    width: 512,\r\n                    height: 512\r\n                });\r\n                function openQrcodePopup() {\r\n/*\r\n                    if (!q._oDrawing._bIsPainted) {\r\n                        setTimeout(openQrcodePopup, 100);\r\n                        return;\r\n                    }\r\n*/\r\n                    var canvas = document.createElement('canvas');\r\n                    var margin = 32;\r\n                    var w = 512 + margin, h = w;\r\n                    canvas.width = w;\r\n                    canvas.height = h;\r\n                    $('#_tmp_qrcode').append(canvas);\r\n                    var ctx = canvas.getContext('2d');\r\n                    ctx.fillStyle = 'white';\r\n                    ctx.fillRect(0, 0, w, h);\r\n                    var imgEle = new Image();\r\n                    imgEle.onload = function() {\r\n                        ctx.drawImage(imgEle, margin / 2, margin / 2);\r\n                        if (window.navigator.msSaveOrOpenBlob) {\r\n                            var src = canvas.toDataURL('image/png');\r\n                            var bc = atob(src.substr('data:image/png;base64,'.length));\r\n                            var bas = [];\r\n                            for (var offset = 0; offset < bc.length; offset += 512) {\r\n                                var slice = bc.slice(offset, offset + 512);\r\n                                var ba = new Array(slice.length);\r\n                                for (var i = 0; i < slice.length; i++) {\r\n                                    ba[i] = slice.charCodeAt(i);\r\n                                }\r\n                                bas.push(new Uint8Array(ba));\r\n                            }\r\n                            window.navigator.msSaveOrOpenBlob(new Blob(bas, {type:'image/png'}), '202007638.png');\r\n                        } else {\r\n                            canvas.toBlob(function(blob) {\r\n                                window.open(URL.createObjectURL(blob), '_blank');\r\n                            }, 'image/png');\r\n                        }\r\n                    }\r\n                    imgEle.src = $('#_tmp_qrcode canvas:eq(0)')[0].toDataURL('image/png');\r\n                }\r\n                setTimeout(openQrcodePopup, 100);\r\n            });\r\n        });\r\n        \r\n        function setImgsAlt(array) {\r\n            if (0 < array.length) {\r\n                array.each(function(i,e) {\r\n                    var img = $(e);\r\n                    img.attr('alt', '');\r\n                });\r\n            }\r\n        }\r\n\r\n        function getDrWarnList(){\r\n            var chk = $('.dr_warn_list').find('li').length;\r\n            if(chk < 1){\r\n                $('.dr_warn_list').addClass('none_li');\r\n            }\r\n        }\r\n        \r\n        function setFrText() {\r\n            var frDivs = $('div.div_fr');\r\n            frDivs.each(function(i,e) {\r\n                var frDiv = $(e);\r\n                var frText = frDiv.find('h3').text();\r\n                \r\n                if (frDiv.hasClass('fr-on')) {\r\n                    frDiv.find('.btn_folding').attr('title', frText + ' 접기');\r\n                } else {\r\n                    frDiv.find('.btn_folding').attr('title', frText + ' 펼치기');\r\n                }\r\n            });\r\n        }\r\n        \r\n        function getDurDetailClick(durSeq,divId){\r\n            param = {};\r\n            param.durSeq = durSeq;\r\n            param.divId = divId;\r\n            \r\n            $.get(\"/pbp/CCBBB01/getDurDetailClick\", param, function (result) {\r\n                $('#'+divId).replaceWith(result);\r\n            });\r\n        } \r\n        \r\n        function getDurDetailAClick(usjntSeq){\r\n            param = {};\r\n            param.usjntSeq = usjntSeq;\r\n            \r\n            $.get(\"/pbp/CCBBB01/getDurDetailAClick\", param, function (result) {\r\n                $('#druA').replaceWith(result);\r\n            });\r\n        } \r\n        \r\n        function getDurDetailGClick(effectSeq){\r\n            param = {};\r\n            param.effectSeq = effectSeq;\r\n            \r\n            $.get(\"/pbp/CCBBB01/getDurDetailGClick\", param, function (result) {\r\n                $('#durG').replaceWith(result);\r\n            });\r\n        } \r\n        \r\n        function getPatentDetailClick(itemSeq,patentNo){\r\n            param = {};\r\n            param.itemSeq = itemSeq;\r\n            param.patentNo = patentNo;\r\n            \r\n            $.get(\"/pbp/CCBBB01/getPatentDetailClick\", param, function (result) {\r\n                $('#patentDetail').replaceWith(result);\r\n            });\r\n        }\r\n        \r\n        function closeDrugInfoPopup() {\r\n            window.close();\r\n        }\r\n        \r\n        function downExcelFile(item_seq, division) {\r\n            $('<form class=\"hidden\" id=\"excelForm\" action=\"/pbp/CCBBB01/getExcel\" method=\"post\"></form>').appendTo('body');\r\n            $('<input type=\"hidden\" name=\"itemSeq\" value=\"'+item_seq+'\" />').appendTo($('#excelForm'));\r\n            $('<input type=\"hidden\" name=\"division\" value=\"'+division+'\" />').appendTo($('#excelForm'));\r\n            $('#excelForm').submit().remove();\r\n        }\r\n        \r\n        function setPkInfoView(boolean) {\r\n            if (boolean) {\r\n                $('.main_title').text('생동성시험정보');\r\n               // $('#btnPkInfo').removeClass('btn_line').addClass('btn_base');  웹접근성 주석처리 차후 수정 가능\r\n               // $('#btnItemDetail').removeClass('btn_base').addClass('btn_line');\r\n                $('.notPkInfo').css('display', 'none');\r\n                $('.pkInfo').css('display', 'block');\r\n                $('.pkInfo').css('margin-top', '250px');\r\n                $('.drug_content').css('margin-bottom', '350px');\r\n                $('.pkInfo').addClass('ht140');\r\n            } else {\r\n                $('.main_title').text('의약품상세정보');\r\n               // $('#btnPkInfo').removeClass('btn_base').addClass('btn_line'); 웹접근성 주석처리 차후 수정 가능\r\n               // $('#btnItemDetail').removeClass('btn_line').addClass('btn_base');\r\n                $('.notPkInfo').css('display', 'block');\r\n                $('.pkInfo').css('display', 'none');\r\n                $('.pkInfo').css('margin-top', '0px');\r\n                $('.pkInfo').removeClass('ht140');\r\n                $('.drug_content').css('margin-bottom', '0px');\r\n            }\r\n        }\r\n\r\n        function  checkId() {\r\n            var chk;\r\n            var chk2;\r\n            var listChk1 =$(\"#listChk\").has(\"li\").length;\r\n            \r\n            chk2 =document.getElementById(\"withdrawal2\");\r\n            chk = document.getElementById(\"withdrawal\");\r\n            \r\n            if(listChk1 == false){\r\n                $('.drug_header').removeClass('drug_list_down').addClass('drug_list_up');\r\n                $('.drug_content').addClass(\"drug_list\");\r\n            }\r\n            if(chk == null && chk2 == null){\r\n                $('.drug_header').removeClass('drug_header-down').addClass('drug_header-up');\r\n                $('.drug_info_top').addClass('not_button');\r\n            }\r\n        }\r\n        \r\n        function goWindowToUrl(url){\r\n            window.open(url,'_blank');\r\n        }\r\n        \r\n        function decomposeFontSize($container) {\r\n            var fontSize = $container.css('fontSize');\r\n            return /([0-9.]+)([a-zA-Z]+)/g.exec(fontSize);\r\n        }\r\n\r\n\r\n        var scaleLevel = 3;\r\n\r\n        function toggleFontSelector() {\r\n            var $ele = $('.fontsize-selector');\r\n            if ($ele.is(':visible')) {\r\n                $ele.hide();\r\n            } else {\r\n                $ele.show();\r\n            }\r\n        }\r\n\r\n        function scaleFontSizeOf(ele, selector, level) {\r\n            var $ele = $(ele);\r\n            $('.fontsize-selector a').removeClass('font-select');\r\n            $ele.addClass('font-select');\r\n\r\n            var scale = 1;\r\n            if (level === 3) {\r\n                var $container = $(selector);\r\n                $container.find('*').each(function () {\r\n                    $(this).css({fontSize: '', lineHeight: ''});\r\n                });\r\n                $('.fontsize-selector').hide();\r\n                return;\r\n            }\r\n            if (scaleLevel > level) {\r\n                scale = scaleLevel - level;\r\n                reduceFontSizeOf(selector, scale);\r\n            } else if (scaleLevel < level) {\r\n                scale = level - scaleLevel;\r\n                enlargeFontSizeOf(selector, scale);\r\n            }\r\n            scaleLevel = level;\r\n            $('.fontsize-selector').hide();\r\n\r\n        }\r\n\r\n        function enlargeFontSizeOf(selector, scale) {\r\n            var $container = $(selector);\r\n            $container.find('*').each(function () {\r\n                var fs = decomposeFontSize($(this));\r\n                if (fs[1] < 1) {\r\n                    return;\r\n                }\r\n                var sizeNum = Number(fs[1]) + scale * 2;\r\n                $(this).css({fontSize: sizeNum + fs[2], lineHeight: sizeNum * 1.4 + fs[2]});\r\n            });\r\n        }\r\n\r\n        function reduceFontSizeOf(selector, scale) {\r\n            var $container = $(selector);\r\n            $container.find('*').each(function () {\r\n                var fs = decomposeFontSize($(this));\r\n                if (fs[1] < 1) {\r\n                    return;\r\n                }\r\n                var sizeNum = Number(fs[1]) - scale * 2;\r\n                $(this).css({fontSize: sizeNum + fs[2], lineHeight: sizeNum * 1.4 + fs[2]});\r\n            });\r\n        }\r\n\r\n        // 3종 문서 변경이력 팝업 호출\r\n        function getDocChangeDateList (itemSeq, docType, count) {\r\n            var popupTitle = '';\r\n\r\n            // if (count < 1) {\r\n            //     this.alert(\"변경이력이 없습니다.\");\r\n            // } else {\r\n                if (docType == 'EE') popuptitle = '효능효과 변경이력'\r\n                if (docType == 'UD') popuptitle = '용법용량 변경이력'\r\n                if (docType == 'NB') popuptitle = '사용상의주의사항 변경이력'\r\n                pbpPopup('/pbp/CCBBB01/getItemChangeHistInfo?itemSeq='+itemSeq+'&docType='+docType, popupTitle, 1000, 1250, 0, 0)\r\n            // }\r\n        }\r\n    </script>\r\n    <style>\r\n        body, html {\r\n            min-width: 0;\r\n        }\r\n\r\n        .nav-down .main_title {\r\n            display: none;\r\n        }\r\n\r\n        .nav-down .drug_header-pics {\r\n            display: none;\r\n        }\r\n\r\n        /*#ezdrug-url-code-wrap {display: none;}*/\r\n    </style>\r\n</head>\r\n\r\n<body class=\"nav-up\">\r\n<!-- drug_wrap -->\r\n<div class=\"drug_wrap\">\r\n    <!-- drugHeader -->\r\n    <div class=\"drug_header\" id=\"gnb\">\r\n        <div class=\"inner\">\r\n            <h2 class=\"s-hh main_title\">의약(외)품