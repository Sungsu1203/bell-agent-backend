ive');\r\n\t\t$('#about_function').removeClass('active');\r\n\t\t$('#about_contents').removeClass('active');\r\n\t\t$('#about_introduce').removeClass('active');\r\n\t\t$('#about_outline').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'about_promo') {\r\n\t\t$('#about_outline').removeClass('active');\r\n\t\t$('#about_service').removeClass('active');\r\n\t\t$('#about_function').removeClass('active');\r\n\t\t$('#about_contents').removeClass('active');\r\n\t\t$('#about_introduce').removeClass('active');\r\n\t\t$('#about_promo').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'about_service') {\r\n\t\t$('#about_outline').removeClass('active');\r\n\t\t$('#about_promo').removeClass('active');\r\n\t\t$('#about_function').removeClass('active');\r\n\t\t$('#about_contents').removeClass('active');\r\n\t\t$('#about_introduce').removeClass('active');\r\n\t\t$('#about_service').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'about_function') {\r\n\t\t$('#about_outline').removeClass('active');\r\n\t\t$('#about_promo').removeClass('active');\r\n\t\t$('#about_service').removeClass('active');\r\n\t\t$('#about_contents').removeClass('active');\r\n\t\t$('#about_introduce').removeClass('active');\r\n\t\t$('#about_function').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'about_contents') {\r\n\t\t$('#about_outline').removeClass('active');\r\n\t\t$('#about_promo').removeClass('active');\r\n\t\t$('#about_service').removeClass('active');\r\n\t\t$('#about_function').removeClass('active');\r\n\t\t$('#about_introduce').removeClass('active');\r\n\t\t$('#about_contents').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'about_introduce') {\r\n\t\t$('#about_outline').removeClass('active');\r\n\t\t$('#about_promo').removeClass('active');\r\n\t\t$('#about_service').removeClass('active');\r\n\t\t$('#about_function').removeClass('active');\r\n\t\t$('#about_contents').removeClass('active');\r\n\t\t$('#about_introduce').addClass('