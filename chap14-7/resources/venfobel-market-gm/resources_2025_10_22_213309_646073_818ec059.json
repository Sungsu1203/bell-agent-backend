('display', 'none');\r\n\t\t}\r\n\t\t} else {\r\n\t\t$(\"#referCnt\").text('(0)');\r\n\t\t$(\".more_ref\").css('display', 'none');\r\n\t\treferListHtml += \"<li style='list-style:none;'><div class='txt'><p>검색 결과가 없습니다.</p></div></div></li>\";\r\n\t\t$(\".referList\").empty();\r\n\t\t}\r\n\r\n\t\t// 게시물 추가 (2페이지 이상인 경우)\r\n\t\tif(page > 1){\r\n\t\t$(\".referList\").append(referListHtml);\r\n\t\t} else { // 게시물 새로 생성 (1페이지)\r\n\t\t$(\".referList\").html(\"\");\r\n\t\t$(\".referList\").html(referListHtml);\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t},\r\n\t\tcomplete: function(data) {\r\n// \t\tconsole.log(data);\r\n\t\tif(!isCnt) {\r\n\t\t$(\"#section_lvl3_2_2\").removeClass(\"hidden\");\r\n\t\t$(\"#loading_lvl3_2\").addClass(\"hidden\");\r\n\t\t} else {\r\n\t\t$(\"#section_lvl2_2, #section_lvl3_2_1, #section_lvl3_2_2\").removeClass(\"hidden\");\r\n\t\t$(\"#loading_lvl2_2, #loading_lvl3_2, #loading_lvl3_2\").addClass(\"hidden\");\r\n\t\t}\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\treturn ajax;\r\n\t}\r\n\r\n\t// 클래스 수정 함수\r\n\tfunction fn_modify_class(obj, type){\r\n\r\n\t\tvar tabObj = \"\";\r\n\t\tvar opaObj = \"\";\r\n\r\n\t\tif(obj == \"RGOOD\"){\r\n\t\ttabObj = \"goodRstTab\";\r\n\t\topaObj = \"refer\";\r\n\t\t} else if(obj == \"REFER\"){\r\n\t\ttabObj = \"referTab\";\r\n\t\topaObj = \"goodRst\";\r\n\t\t}\r\n\r\n\t\t// 음영처리\r\n\t\t$(\"#goodRstOpacity, #referOpacity\").removeClass(\"ctab_opacity\");\r\n\t\t$(\"#\" + opaObj + \"Opacity\").addClass(\"ctab_opacity\");\r\n\r\n\t\t// 성과물 탭 class 전체 제거\r\n\t\t$(\"#goodRstTab > li\").removeClass();\r\n\t\t$(\"#referTab > li\").removeClass();\r\n\r\n\t\t// 성과물 탭 활성화 관련 class 설정 (active)\r\n\t\tif(type == \"ALL\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(0).addClass(\"active\");\r\n\t\t} else if(type == \"001\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(1).addClass(\"active\");\r\n\t\t} else if(type == \"002\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(2).addClass(\"active\")\r\n\t\t} else if(type == \"003\"){\r\n\t\t$(\"#\" + tabObj + \" > li\").eq(3).addClass(\"active\")\r\n\t\t}\r\n\t}\r\n\r\n\tfunction fn_move_link(obj){\r\n\t\tvar pjn = $(obj).attr(\"data-pjn\");\r\n\t\tvar url = \"https://www.ntis.go.kr/project/pjtInfo.do?pjtId=\" + pjn;\r\n\t\twindow.open(url, \"_blank\");\r\n\r\n\t\tinsertInfraLog('FNCT001408','INFRAPAGE0068', url);\r\n\t}\r\n\r\n\r\n\tfunction fncAbsWordList() {\r\n\t\tvar uniqueWords = [];\r\n\r\n\t\t$(\"span.hdwrd\").each(function(idx, item) {\r\n\t\tvar txt = $(item).text();\r\n\t\tvar wrdId = $(item).attr(\"id\");\r\n\t\t/* \t\t//0번째 값은 PCR로 고정\r\n                        if (false) {\r\n\t\t    if (idx == 0) {\r\n\t\t        var txt = \"PCR\";\r\n\t\t        var wrdId = \"PCR\";\r\n\t\t    }\r\n\t\t}\r\n\t\t */\r\n\r\n\t\t//txt를 새로운 배열에 넣을때 배열안에 값이 존재하면 넣지 않음\r\n\t\tif (!uniqueWords.includes(txt)) {\r\n\t\tuniqueWords.push(txt);\r\n\r\n\t\t//용어보기 클릭시 인덱스 1번째 값으로 표제어~용어설명까지 값을 표출하게 만들어줌\r\n\t\tif (idx == 0) {\r\n\t\tvar sDd = $('#sDd dd').text(txt);\r\n\t\tfncViewWord(wrdId, true, txt);\r\n\t\t}\r\n\r\n\t\tvar btn = $(\"<button></button>\").attr(\"type\", \"button\").attr(\"data-hdwrd-id\", wrdId)\r\n\t\t.attr(\"data-hdwrd-title\", txt).addClass(\"btns side-round tab-btn hdwrdBtn\");\r\n\t\tif (idx == 0) {\r\n\t\t$(btn).addClass(\"active\");\r\n\t\t}\r\n\t\t$(btn).text(txt).appendTo(\".hdwrdLst\");\r\n\t\t$(item).addClass(\"modal-open-close\").attr(\"data-kisti-modal\", \"#abstractWord\");\r\n\t\t$(item).on(\"click\", function() {\r\n\t\t$(\"#abstractWord\").show();\r\n\t\tfncViewWord(wrdId, true, txt);\r\n\t\t});\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t$(\"button.hdwrdBtn\").on(\"click\", function(e) {\r\n\t\tvar dataTxt = $(e.target).attr(\"data-hdwrd-title\");\r\n\t\tvar dataId = $(e.target).attr(\"data-hdwrd-id\");\r\n\t\t$(\".hdwrdBtn\").removeClass(\"active\");\r\n\t\t$(e.target).addClass(\"active\");\r\n\t\tfncViewWord(dataId, true, dataTxt);\r\n\t\t});\r\n\r\n\t\t$(\"#abstractWord\").on(\"click\", \".abstract-word-box dd:eq(2) .jum-ul .src-list\", function(e) {\r\n\t\te.preventDefault();\r\n\t\t$(\".abstract-word-box dd:eq(2) ul a.src-list\").removeClass(\"active\");\r\n\t\t$(this).addClass(\"active\");\r\n\t\tvar wordId = $(this).data(\"word-id\");\r\n\t\t$(\".abstract-word-box dd:eq(3) .desc-word\").addClass(\"none\");\r\n\t\t$(\".abstract-word-box dd:eq(3) .desc-word#word_\" + wordId).removeClass(\"none\");\r\n\t\tinsertBhvrLog($.extend({ 'sourceId': wordId, 'bhvrNo': '220', 'evntNo': '01' }, bhvrLogOption));\r\n\t\t});\r\n\t}\r\n\r\n\tfunction fncViewWord(hdwrdId, scroll, selTitle){\r\n\t\t$(\".hdwrdBtn\").removeClass(\"active\")\r\n\t\t$(\".hdwrdBtn\").filter(function() {\r\n\t\treturn $(this).attr(\"data-hdwrd-id\") == hdwrdId;\r\n\t\t}).addClass(\"active\");\r\n\t\t$.ajax({\r\n\t\turl : \"selectPORSrchArticleWord.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata: \"hdwrdId=\"+hdwrdId,\r\n\t\tsuccess: function(json){\r\n\t\tvar surfaceWordList = json.resultList.surfaceWordList;\r\n\t\tvar wordDesList = json.resultList.wordDesList;\r\n\t\t$(\".abstract-word-box dd:eq(0)\").html(\"\");\r\n\t\t$(\".abstract-word-box dd:eq(1)\").html(\"\");\r\n\t\tvar num = 1;\r\n\t\tvar synonym = \"\";\r\n\t\t$.each( surfaceWordList, function( key, value ){\r\n\t\tif(value.surwrdSeCd == \"ET\"){\r\n\t\t$(\".abstract-word-box dd:eq(0)\").text(value.surwrdNm);\r\n\t\t}else{\r\n\t\tif(num === 1){\r\n\t\tsynonym = value.surwrdNm;\r\n\t\t$(\".abstract-word-box dd:eq(1)\").text(synonym);\r\n\t\t}else{\r\n\t\tsynonym += ', ' + value.surwrdNm;\r\n\t\t$(\".abstract-word-box dd:eq(1)\").text(synonym);\r\n\t\t}\r\n\t\tnum++\r\n\t\t}\r\n\t\t});\r\n\t\t/* \tif(surfaceWordList ==''){\r\n\r\n                        $('#ftDd dd').text(\"PCR\");\r\n                        $('#sDd dd').text(\"Packet Collision Rate\");\r\n\r\n                    } */\r\n\t\t$(\".abstract-word-box dd:eq(2) .jum-ul\").html(\"\");\r\n\t\t$(\".abstract-word-box dd:eq(3)\").html(\"\");\r\n\r\n\t\t$.each( wordDesList, function( key, value ){\r\n\t\tvar prefix = \"[논문]\";\r\n\t\tif(value.wordSrcSeCd == \"W\"){\r\n\t\tprefix = \"[위키피디아]\";\r\n\t\t}\r\n\t\twordDc = value.wordDc.replace(/\\\\n/gi, \"<br/>\");\r\n\t\twordDcId = value.wordDcId.replace(/@/gi, \"\");\r\n\r\n\t\tvar selClass=\"\";\r\n\t\tvar noneClass=\"\";\r\n\t\tvar src=\"\";\r\n\t\tif(key == 0){\r\n\t\tselClass=\"active\";\r\n\t\tnoneClass=\"\";\r\n\t\t}else{\r\n\t\tselClass=\"\";\r\n\t\tnoneClass=\"none\";\r\n\t\t}\r\n\t\tif(value.wordSrcSeCd == \"S\"){\r\n\t\tsrc = \"<a href=?cn=\"+value.cntntsId+\" target=\\\"_blank\\\" class=\\\"link-btn color-blue src\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201431057577184\\\" data-log-no=\\\"202510223046199074\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\" title=\\\"새 창에서 자료보기\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t} else{\r\n\t\tvar koPattern = /[ㄱ-ㅎ가-힣]/; //한글\r\n\t\tif(!koPattern.test(value.title)){\r\n\t\tsrc = \"<a title=\\\"새 창에서 자료보기\\\" href=\\\"https://en.wikipedia.org/wiki/\"+value.title+\"\\\" target=\\\"_blank\\\" class=\\\"link-btn color-blue\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201431057577184\\\" data-log-no=\\\"202510223046199074\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t}else{\r\n\t\tsrc = \"<a title=\\\"새 창에서 자료보기\\\" href=\\\"https://ko.wikipedia.org/wiki/\"+value.title+\"\\\" target=\\\"_blank\\\" class=\\\"link-btn color-blue\\\" data-bhvr-no=\\\"221\\\" data-evnt-no=\\\"01\\\" data-cn=\\\"JAKO201431057577184\\\" data-log-no=\\\"202510223046199074\\\" data-url-no=\\\"PG023\\\" data-source-id=\\\"\"+wordDcId+\"\\\"><i class=\\\"far fa-link\\\"></i><span class=\\\"hidden\\\">새 창에서 링크보기</span></a>\";\r\n\t\t}\r\n\t\t}\r\n\t\t$(\".abstract-word-box dd:eq(2) .jum-ul\").append(\"<li><a class=\\\"oneline src-list \"+selClass+\"\\\" href=\\\"#\\\" data-word-id=\\\"\"+wordDcId+\"\\\">\"+prefix +\" \" +value.title+\"</a>\"+src+\"</li>\");\r\n\t\t$(\".abstract-word-box dd:eq(3)\").append(\"<div class=\\\"desc-word \"+noneClass+\"\\\" id=\\\"word_\"+wordDcId+\"\\\"><div class=\\\"scrollbox\\\" style=\\\"max-height: 140px;\\\">\"+wordDc+\"</div>\");\r\n\t\t});\r\n\t\t/* if($('#ftDd dd').text() =='PCR'){\r\n\t\t$('#cDd dt span').text('(6)');\r\n\t\tvar newLi1 = `\r\n\t\t    <li class=\"active\" id=\"fView\">\r\n\t\t        <a href=\"javascript:void(0);\" class=\"oneline\">[논문] Real-time PCR과 Colony forming unit법을 이용한 타액 내 2종의 구강미생물 총량분석</a>\r\n\t\t        <a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t    </li>`;\r\n\r\n\t\tvar newLi2 = `\r\n\t\t    <li id=\"sView\">\r\n\t\t        <a href=\"javascript:void(0);\" class=\"oneline\">[논문] 강인성을 개선한 VANET에서의 자율 TDMA</a>\r\n\t\t        <a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t    </li>`;\r\n \r\n\t\t$('#cDd .jum-ul').append(newLi1+newLi2);\r\n\t\t$('#lDd dd').text(\"PCR은 세균 특이성이 있는 primer를 이용하여 적은 수의 세균이 있을지라도 쉽게 검출할 수 있는 유용한 방법이며, 이를 이용하여 구강 내 치면세균막이나 타액에서 직접 세균을 검출할 수 있게 되었다[8].\");\r\n\t\t\r\n\t\t} */\r\n\t\t$(\".abstract-word-box dt:eq(2) span\").text(\" (\"+wordDesList.length+\")\");\r\n\r\n\r\n\r\n\t\tif(scroll){\r\n\t\tvar idx = $(\"#abstractWord .list_wrap .list li a.on\").closest(\"li\").index();\r\n\t\t$(\"#abstractWord .list_wrap .list\").scrollTop(idx * 24)\r\n\t\t}\r\n\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\tinsertBhvrLog($.extend({'sourceId': hdwrdId,'bhvrNo': '218', 'param' : selTitle, 'evntNo': '01'},bhvrLogOption));\r\n\t}\r\n\r\n\t// \tfunction transArticle(cn){\r\n\t//2020-05-25 