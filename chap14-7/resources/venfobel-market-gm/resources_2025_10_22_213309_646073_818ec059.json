\"hidden\");\r\n\t\t$('#exptDtl').addClass(\"hidden\");\r\n\t}else if($(this).val() == 'detail'){\r\n\t\t$('#exptBrf').addClass(\"hidden\");\r\n\t\t$('#exptDtl').removeClass(\"hidden\");\r\n\t}\r\n});\r\n\r\n\r\n$('input[name=\"exportType\"]').change(function() {\r\n\tvar val = $(this).val(); \r\n\tif(val == \"file\"){\r\n\t\t$('#fileType').removeClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"print\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"mail\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').removeClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"bigFile\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').removeClass(\"hidden\");\r\n\t}\r\n});\r\n</script>\n\r\n\r\n\r\n<form style=\"display:none\" name=\"exportRWForm\" method=\"POST\" target=\"RefWorksMain\" action=\"https://www.refworks.com/express/ExpressImport.asp?vendor=ScienceON&filter=RIS%20Format&encoding=65001\">\r\n\t<textarea name=\"ImportData\" rows=\"30\" cols=\"70\" title=\" \"></textarea>\r\n</form>\r\n\r\n<!-- 모달팝업 // 핵심어 질의응답 { -->\r\n\r\n\t<form id=\"qaDivForm\" method=\"post\">\r\n\t\t<input type=\"hidden\" name=\"pageIndex\" id=\"qa_pageIndex\">\r\n\t\t<input type=\"hidden\" name=\"pageUnit\" value=\"30\">\r\n\t\t<input type=\"hidden\" name=\"artId\" id=\"qa_artId\">\r\n\t\t<input type=\"hidden\" name=\"kwrdCn\" id=\"qa_kwrdCn\">\r\n\t\t<input type=\"hidden\" name=\"qaId\" id=\"qa_qaId\">\r\n\t\t<input type=\"hidden\" name=\"viewIndex\" id=\"viewIndex\">\r\n\t</form>\r\n\t<aside id=\"qaDiv\" class=\"modal qa-div\">\r\n\t\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\" id=\"qa_title\"><b>\"\"</b> 핵심어 질의 응답</h2>\r\n\t\t<butto