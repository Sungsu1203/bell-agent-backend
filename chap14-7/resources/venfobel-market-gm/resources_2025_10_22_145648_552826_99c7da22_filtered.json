isualization.DataTable();\r\n\t\tvar ovData = new google.visualization.DataTable();\r\n\t\tvar saData = new google.visualization.DataTable();\r\n\t\tdvData.addColumn('string', '');\r\n\t\tdvData.addColumn('number', '상세보기');\r\n\t\tdvData.addColumn({type: 'string', role: 'annotation'});\r\n\t\tovData.addColumn('string', '');\r\n\t\tovData.addColumn('number', '다운로드');\r\n\t\tovData.addColumn({type: 'string', role: 'annotation'});\r\n\t\tsaData.addColumn('string', '');\r\n\t\tsaData.addColumn('number', '내보내기');\r\n\t\tsaData.addColumn({type: 'string', role: 'annotation'});\r\n\r\n\t\tvar dvDataArr = [];\r\n\t\tvar ovDataArr = [];\r\n\t\tvar saDataArr = [];\r\n\t\tvar dvCnt = 0;\r\n\t\tvar ovCnt = 0;\r\n\t\tvar saCnt = 0;\r\n\t\tresultList.forEach(function(item, i) {\r\n\t\tdvDataArr.push([ item.logYr, item.dvCnt, item.dvCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tovDataArr.push([ item.logYr, item.ovCnt, item.ovCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tsaDataArr.push([ item.logYr, item.saCnt, item.saCnt.toLocaleString('ko-KR')+\"건\"]);\r\n\t\tdvCnt += item.dvCnt;\r\n\t\tovCnt += item.ovCnt;\r\n\t\tsaCnt += item.saCnt;\r\n\t\t});\r\n\r\n\t\tif(dvCnt+ovCnt+saCnt == 0){\r\n\t\t$(\"#sect_anal\").hide();\r\n\t\t$(\"#link_anal\").hide();\r\n\t\treturn;\r\n\t\t}\r\n\r\n\t\tdvData.addRows(dvDataArr);\r\n\t\tovData.addRows(ovDataArr);\r\n\t\tsaData.addRows(saDataArr);\r\n\r\n\t\t$(\"#dvCnt\").text(dvCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\t\t$(\"#ovCnt\").text(ovCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\t\t$(\"#saCnt\").text(saCnt.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\"));\r\n\r\n\t\tvar winWidth = $(window).width();\r\n\t\tvar chartWidth = '100%';\r\n\t\tif(winWidth >= 751 && winWidth <= 1183){\r\n\t\tchartWidth = 468;\r\n\t\t}\r\n\t\tvar options = {\r\n\t\twidth: chartWidth,\r\n\t\theight: 120,\r\n\t\tlegend: 'none',\r\n// \t\tlegend: { position: 'bottom', maxLines: 5, textStyle: {fontSize: 12} },\r\n// \t\tbar: { groupWidth: '50%' },\r\n// \t\tbars: 'horizontal',\r\n// \t\tisStacked: true,\r\n\t\tvAxis: {minValue: 2},\r\n\t\tannotations: {\r\n\t\talwaysOutside: false,\r\n\t\ttextStyle: {\r\n\t\tfontSize: 11,\r\n\t\tcolor: '#000',\r\n\t\tauraColor: 'none'\r\n\t\t}\r\n\t\t},\r\n\t\tchartArea: {\r\n\t\tleft: 50,\r\n\t\tright: 20,\r\n// \t\ttop: 10,\r\n\t\tbackgroundColor: 'white',\r\n\t\twidth: '100%',\r\n\t\theight: '70%'\r\n\t\t},\r\n\t\tseries: {\r\n\t\t0:{color:'#003879'}\r\n\t\t}\r\n\t\t};\r\n\r\n\t\tvar dvChart = new google.visualization.LineChart(document.getElementById('chart_dv'));\r\n\t\tvar ovChart = new google.visualization.LineChart(document.getElementById('chart_ov'));\r\n\t\tvar saChart = new google.visualization.LineChart(document.getElementById('chart_sa'));\r\n\t\tgoogle.visualization.events.addListener(dvChart, 'ready', fn_chartReadyHandler);\r\n\t\tgoogle.visualization.events.addListener(ovChart, 'ready', fn_chartReadyHandler);\r\n\t\tgoogle.visualization.events.addListener(saChart, 'ready', fn_chartReadyHandler);\r\n\r\n\t\tdvChart.draw(dvData, options);\r\n\t\tovChart.draw(ovData, options);\r\n\t\tsaChart.draw(saData, options);\r\n\t}\r\n\tfunction fn_chartReadyHandler() {\r\n\t\tsetTimeout(function(){$(\"#chart_dv table\").prop(\"summary\", \"상세보기 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t\tsetTimeout(function(){$(\"#chart_ov table\").prop(\"summary\", \"다운로드 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t\tsetTimeout(function(){$(\"#chart_sa table\").prop(\"summary\", \"내보내기 분석 차트 데이터\").append(\"<caption></caption>\")}, 0);\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\tfunction selectAnalytics(ddc){\r\n\t\t//활용도 Top5 논문\r\n\t\tvar yyyy = new Date().getFullYear();\r\n\t\t$(\"#minYr\").val(yyyy-1);\r\n\t\t$(\"#maxYr\").val(yyyy);\r\n\r\n\t\tddc = ddc.substr(0,1).padEnd(3,\"0\");\r\n\t\t$(\"#ddcLclas\").val(ddc);\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/por/analytics/prcuse/selectPrcuseArticleListAjax.do\",\r\n\t\tdataType : 'html',\r\n\t\tdata: $(\"#analyticsForm\").serialize(),\r\n\t\tcontentType: 'application/x-www-form-urlencoded',\r\n\t\tbeforeSend: function() {\r\n\t\t$(\"#listAjaxLoding\").removeClass(\"hidden\");\r\n\t\t$(\"#prcuseList\").addClass(\"hidden\");\r\n\t\t},\r\n\t\tsuccess : function(data) {\r\n\t\t$(\"#prcuseList\").html(data);\r\n\t\t},complete: function() {\r\n\t\t$(\"#listAjaxLoding\").addClass(\"hidden\");\r\n\t\t$(\"#prcuseList\").removeClass(\"hidden\");\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t/* [개발업무], 개발일자-2024-08-26, 작업내용 : Analytics 활용도분석 연계 */\r\n\t//Analytics 이동\r\n\tfunction fn_goAnalytics(){\r\n\t\t$('#analyticsForm').attr('action',\"/por/analytics/prcuse/selectPrcuseArticleList.do;jsessionid=15FB120FBB5AF3AC8B0EF19991788528.scienceon_right\");\r\n\t\t$(\"#analyticsForm\").submit();\r\n\r\n\t\tinsertBhvrLog(\r\n\t\t{\r\n\t\t'cn': document.querySelector(\"#logForm input[name='cn']\").value\r\n\t\t,'sourceId':''\r\n\t\t,'bhvrNo': '1027'\r\n\t\t,'evntNo': '01'\r\n\t\t,'param' : ''\r\n\t\t,'logNo' : '202510223044750792'\r\n\t\t,'urlNo' : 'PG023'\r\n\t\t}\r\n\t\t);\r\n\t}\r\n\r\n\t//참고문헌, 인용문헌에서  각 아이콘 클릭시 실행\r\n\tfunction fncCiteInfo(citegubun,flag,cn,bibcn,dbt,url,target){\r\n\r\n\t\tif(url.indexOf(\"koix.kisti.re.kr\")>-1 ){\r\n\r\n\t\t$.ajax({\r\n\t\turl : \"/srch/ndslOrgDocDownChk.do\",\r\n\t\tdataType: 'json',\r\n\t\tdata : {'cn' : cn, 'dbt':dbt, 'koi':url},\r\n\t\t//async: false,\r\n\t\tsuccess: function(data){\r\n\r\n\t\tvar arr_data = data.result.split(\"*\");\r\n\t\tvar dataArr0 = arr_data[0];\r\n\t\tvar dataArr1 = arr_data[1];\r\n\t\tvar dataArr2 = arr_data[2];\r\n\t\tvar dataArr3 = arr_data[3];\r\n\t\tvar dataArr4 = arr_data[4];\r\n\t\tvar dataArr5 = arr_data[5];\r\n\t\tif (dataArr0 == \"true\") {\r\n\t\tvar url = \"/commons/util/originalView.do\";\r\n\t\turl += \"?cn=\" + dataArr5 + \"&oCn=\" +  cn + \"&dbt=\" + dbt + \"&journal=\" + bibcn;\r\n\r\n// \t\tconsole.log(url)\r\n\t\twindow.open(url, \"newWin\");\r\n\t\tinsertSystemLogInfo(\"linkYn=Y&useContCd=0001&linkURL=\"+ url + \"&cn=\"+cn);\r\n\t\tinsertBhvrLog({'bhvrNo' : '319','evntNo' : '01', 'cn' : cn ,'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\t\t} else {\r\n\t\talert(dataArr1);\r\n\t\t}\r\n\t\t},\r\n\t\terror: function( jqXhr, textStatus, errorThrown ){\r\n\t\tconsole.log( errorThrown );\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t}else{\r\n\r\n\t\tif(target == '_blank'){\r\n\t\twindow.open(url);\r\n\t\t}else{\r\n\t\tlocation.target = target;\r\n\t\tlocation.href = url;\r\n\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfunction fncXmlView(obj){\r\n\t\tvar temp = obj.split(\"_\");\r\n\t\tvar url = \"\";\r\n\t\tvar urlTmp =\"\";\r\n\r\n\t\tfor(var i=0; i < temp.length -1; i++){\r\n\t\turlTmp += temp[i]+\"/\";\r\n\t\t}\r\n\r\n\t\turl= \"http://kpubs.org/article/viewPubreaderOutside.kpubs?articleANo=\"+obj;\r\n\t\twindow.open(url,\"_blank\");\r\n\r\n\t\tvar _param =\r\n\t\t{\r\n\t\t\"cttCode1\"\t: $(\"#logForm > input[name='cttCode1']\").val(),\r\n\t\t\"cttCode2\"\t: $(\"#logForm > input[name='cttCode2']\").val(),\r\n\t\t\"svcCode1\"\t: \"OV\",\r\n\t\t\"svcCode2\" \t: \"OV2\",\r\n\t\t\"pageCode\" \t: $(\"#logForm > input[name='pageCode']\").val(),\r\n\t\t\"keyword\" \t: $(\"#logForm > input[name='keyword']\").val(),\r\n\t\t\"rUrl\" \t\t: document.location.href\r\n\t\t};\r\n\t\tlogSummton(_param);\r\n\r\n\t\tinsertBhvrLog({'bhvrNo' : '381','evntNo' : '01', 'cn' : document.querySelector(\"#logForm input[name='cn']\").value\r\n\t\t, 'urlNo' : document.querySelector(\"#bhvrLogForm input[name='urlNo']\").value});\r\n\r\n\t}\r\n\r\n\t//인용 문헌 목록 가져오기\r\n\tfunction fncCitingList(addNum, isInit){\r\n\r\n\t\tvar len_li = $(\".citingList\").children(\"li\").length;\r\n\t\tvar startNum = len_li + 1;\t\t//from, to 사용안함\r\n\t\tvar endNum = len_li + parseInt(addNum) + 1;\t\t//from, to 사용안함\r\n\r\n\t\tcitingRownum = citingRownum + parseInt(addNum); //Row 제한 Rownum\r\n\r\n\t\tvar obj = new Object();\r\n\t\tobj.cn = \"NPAP08155200\";\r\n\t\tobj.startNum = startNum;\r\n\t\tobj.endNum = endNum;\r\n\t\tobj.citingRownum = citingRownum;\r\n\r\n\t\t$.ajax({\r\n\t\ttype\t\t: 'POST',\r\n\t\tcontentType : \"application/json; charset=utf-8\",\r\n\t\tdata\t\t: JSON.stringify(obj),\r\n\t\tdataType\t: 'json',\r\n\t\turl\t\t: \"/srch/citingList.do;jsessionid=15FB120FBB5AF3AC8B0EF19991788528.scienceon_right\",\r\n\t\tasync\t\t: false,\r\n\t\tsuccess \t: function(data){\r\n\t\tvar result = data.result;\r\n\t\t// 2022.03.27 인용문헌 건수 조회 X, 처음 호출되었을 경우 여부\r\n\t\tif(result.citingList.length > 0){\r\n\t\tfncCitingCnt();\r\n\t\t$(\"#sect_citing\").removeClass(\"hidden\");\r\n\t\t$(\"#link_citingList\").removeClass(\"hidden\");\r\n\t\t} else {\r\n\t\t$(\"#sect_citing\").addClass(\"hidden\");\r\n\t\t$(\"#link_citingList\").addClass(\"hidden\");\r\n\t\t}\r\n\r\n\t\t// 기존 목록 초기화\r\n\t\tif(result.citingList.length > 0){\r\n\t\t$(\".citingList\").empty();\r\n\t\t}\r\n\r\n\t\t$.each(result.citingList, function(index, item){\r\n// \t\tconsole.log(item);\r\n\t\tvar cnt = index+1;\r\n\t\tvar AUTHOR01 = nvl(item.AUTHOR01, \"\");\r\n\t\tAUTHOR01.replace(/ ; /gi, \", \");\r\n\t\tvar TITLE = nvl(item.TITLE,\"\");\r\n\t\tif(TITLE != \"\") {\r\n\t\tTITLE = \"\\\"\" + TITLE + \"\\\"\";\r\n\t\t}\r\n\t\tvar KOI = nvl(item.KOI, \"\");\r\n\t\tvar CN = nvl(item.CN, \"\");\r\n\t\tvar str_li = \"<li data-refno=\\\"\"+ cnt +\"\\\" class='\"+(CN == KOI && CN != \"\" ? \" find\":\"\")+\"'>\";\r\n\t\tstr_li += \"<div class='txt'><p>\"+AUTHOR01+\" \"+nvl(item.PUBYEAR,\"\")+\" \"+TITLE+\" \"+nvl(item.JOURNALNAME,\"\")+\", \"+nvl(item.VOL,\"\")+\"(\"+nvl(item.NO,\"\")+\"): \"+nvl(item.PAGE,\"\")+\"</p> <div class='btn-area flex-end'>\";\r\n\t\tif(KOI != '' && CN != ''){\r\n\t\tstr_li += \"<a href='#;' onclick='fncCiteInfo(\\\"citing\\\",\\\"koi\\\",\\\"\"+CN+\"\\\",\\\"\"+item.BIBCN+\"\\\",\\\"JAKO\\\",\\\"http://koix.kisti.re.kr/\"+KOI+\"\\\",\\\"_blank\\\");return false;' class='btns hover-btn-blue-line'>원문보기</a>\";\r\n\t\t}\r\n\t\tif(CN != \"\"){\r\n\t\tst