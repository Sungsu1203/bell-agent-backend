">\r\n\t\t<select id=\"domainOpt2\" name=\"domainOpt2\" onchange=\"javascript:setEmail('2');\" title=\"이메일 선택\" class=\"basic-select\">\r\n\t\t<option value=\"직접선택\" selected=\"selected\">직접선택</option>\r\n\t\t<option value=\"hanmail.net\">hanmail.net</option>\r\n\t\t<option value=\"naver.com\">naver.com</option>\r\n\t\t<option value=\"korea.com\">korea.com</option>\r\n\t\t<option value=\"nate.com\">nate.com</option>\r\n\t\t<option value=\"hotmail.com\">hotmail.com</option>\r\n\t\t<option value=\"gmail.com\">gmail.com</option>\r\n\t\t</select>\r\n\t\t</dd>\r\n\t\t<dt><label for=\"mailTitle\">제목</label></dt>\r\n\t\t<dd><input type=\"text\" id=\"mailTitle\" name=\"mailTitle\" title=\"메일제목\" class=\"basic-input w100\" value=\"KISTI 검색결과 이메일  서비스\"/></dd>\r\n\t\t<dt><label for=\"mail04\">내용</label></dt>\r\n\t\t<dd><textarea id=\"mailCont\" name=\"mailCont\" title=\"이메일 내용을 입력합니다.\"  cols=\"50\" rows=\"4\" class=\"basic-textarea w100\">KISTI 검색결과 이메일  서비스</textarea></dd>\r\n\t\t</dl>\r\n\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr id=\"bigFile\" class=\"hidden\">\r\n\t\t<th>안내</th>\r\n\t\t<td>\r\n\t\t<p class=\"comment mgt10px\">총  건의 자료가 검색되었습니다.</p>\r\n\t\t<p class=\"comment mgt10px\">다운받으실 자료의 인덱스를 입력하세요. (1-10,000)</p>\r\n\t\t<p class=\"comment mgt10px\">검색결과의 순서대로 최대 10,000건 까지 다운로드가 가능합니다.</p>\r\n\t\t<p class=\"comment mgt10px\">데이타가 많을 경우 속도가 느려질 수 있습니다.(최대 2~3분 소요)</p>\r\n\t\t<p class=\"comment mgt10px\">다운로드 파일은 UTF-8 형태로 저장됩니다.<br/> 파일의 내용이 제대로 보이지 않을실 때는 웹브라우저 상단의 보기 -> 인코딩 -> 자동선택 여부를 확인하십시오.</p>\r\n\t\t<p class=\"comment mgt10px\">\r\n\t\t<input type=\"text\" id=\"startIndex\" name=\"startIndex\" title=\"출력사이즈 입력\" maxlength=\"5\" class=\"basic-input\">\r\n\t\t~\r\n\t\t<input type=\"text\" id=\"endIndex\" name=\"endIndex\" title=\"출력사이즈 입력\" maxlength=\"5\" class=\"basic-input\">\r\n\t\t</p>\r\n\t\t<ul class=\"checkradio-list\">\r\n                                <li><input type=\"radio\" id=\"downType11\" name=\"downType1\" value=\"txt\" class=\"basic-radio\" checked /><label for=\"downType11\"><span></span>Text(ASCII format)</label></li>\r\n\t\t<li><input type=\"radio\" id=\"downType22\" name=\"downType1\" value=\"excel\" class=\"basic-radio\" /><label for=\"downType22\"><span></span>Excel format</label></li>\r\n                            </ul>\r\n\t\t</td>\r\n\t\t</tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n        <div class=\"modal-foot flex-center\">\r\n            <button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#exportDiv\" data-bhvr-no=\"340\" data-evnt-no=\"01\" data-log-no=\"202510223044750792\" data-url-no=\"PG023\" data-cn=\"\">닫기</button>\r\n            <button type=\"button\" class=\"btns size-big btn-blue-deep\" onclick=\"exportSrchList();\">실행</button>\r\n        </div>\r\n    </div>\r\n</aside>\r\n<!-- 내보내기 end-->\r\n\r\n<form id=\"exportFile\" name=\"exportFile\" method=\"post\">\r\n\t\r\n\t<input type=\"hidden\" name=\"class2\" value=\"국내논문\">\r\n\t\r\n\t<input type=\"hidden\" name=\"searchCondition\" value=\"thesis\">\r\n\t<input type=\"hidden\" name=\"searchKeyword\" value=\"\">\r\n\t<input type=\"hidden\" name=\"startIndex\">\r\n\t<input type=\"hidden\" name=\"endIndex\">\r\n\t<input type=\"hidden\" name=\"gubunCd\">\r\n\t<input type=\"hidden\" name=\"selectFields\" id=\"selectFields\" value=\"\">\r\n\t<div id=\"selectCns\"></div>\r\n</form>\r\n\r\n<script type=\"text/javascript\">\r\n\r\n$('input[name=\"exptInfo\"]').change(function() {\r\n\tif($(this).val() == 'brief'){\r\n\t\t$('#exptBrf').removeClass(\"hidden\");\r\n\t\t$('#exptDtl').addClass(\"hidden\");\r\n\t}else if($(this).val() == 'detail'){\r\n\t\t$('#exptBrf').addClass(\"hidden\");\r\n\t\t$('#exptDtl').removeClass(\"hidden\");\r\n\t}\r\n});\r\n\r\n\r\n$('input[name=\"exportType\"]').change(function() {\r\n\tvar val = $(this).val(); \r\n\tif(val == \"file\"){\r\n\t\t$('#fileType').removeClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"print\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"mail\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').removeClass(\"hidden\");\r\n\t\t$('#bigFile').addClass(\"hidden\");\r\n\t}else if(val == \"bigFile\"){\r\n\t\t$('#fileType').addClass(\"hidden\");\r\n\t\t$('#mailType').addClass(\"hidden\");\r\n\t\t$('#bigFile').removeClass(\"hidden\");\r\n\t}\r\n});\r\n</script>\n\r\n\r\n\r\n<form style=\"display:none\" name=\"exportRWForm\" method=\"POST\" target=\"RefWorksMain\" action=\"https://www.refworks.com/express/ExpressImport.asp?vendor=ScienceON&filter=RIS%20Format&encoding=65001\">\r\n\t<textarea name=\"ImportData\" rows=\"30\" cols=\"70\" title=\" \"></textarea>\r\n</form>\r\n\r\n<!-- 모달팝업 // 핵심어 질의응답 { -->\r\n\r\n<!-- } 모달팝업 // 핵심어 질의응답 -->\r\n\r\n<!-- 모달팝업 // 초록 용어 설명 { -->\r\n<aside id=\"abstractWord\" class=\"modal abstract-word\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>초록 용어 설명</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#abstractWord\"\r\n\t\tdata-bhvr-no=\"383\" data-evnt-no=\"01\" data-log-no=\"202510223044750792\" data-url-no=\"PG023\">\r\n\t\t<i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"modal-content\">\r\n\t\t<p class=\"comment\">\r\n\t\t초록 내용을 이해하기 어려운 초급자를 위해 전문 용어를 설명하는 서비스<br />\r\n\t\t논문에서 용어와 풀이말을 자동 추출한 결과로, 시범 서비스 중입니다.\r\n\t\t</p>\r\n\t\t<div class=\"contain-term flex-start mgt40px\">\r\n\t\t<h3>초록 포함 용어</h3>\r\n\t\t<div class=\"basic-tabbox ver-blue flex-start hdwrdLst\">\r\n\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<article class=\"abstract-word-box mgt40px\">\r\n\t\t<dl class=\"aw-box flex-start\" id=\"ftDd\">\r\n\t\t<dt>표제어</dt>\r\n\t\t<dd>PCR</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\" id=\"sDd\">\r\n\t\t<dt>동의어</dt>\r\n\t\t<dd>Packet Collision Rate</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\"  id=\"cDd\">\r\n\t\t<dt>용어 설명 출처 목록 <span class=\"color-red\">(6)</span></dt>\r\n\t\t<dd>\r\n\t\t<div class=\"scrollbox\" style=\"max-height: 200px;\">\r\n\t\t<ul class=\"jum-ul\">\r\n\t\t<li class=\"active\" id=\"fView\">\r\n\t\t<a href=\"javascript:void(0);\" class=\"oneline\">[논문] Real-time PCR과 Colony forming unit법을 이용한 타액 내 2종의 구강미생물 총량분석</a>\r\n\t\t<a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t</li>\r\n\t\t<li id=\"sView\">\r\n\t\t<a href=\"javascript:void(0);\" class=\"oneline\">[논문] 강인성을 개선한 VANET에서의 자율 TDMA</a>\r\n\t\t<a href=\"javascript:void(0);\" class=\"link-btn color-blue\" title=\"새창에서 논문보기\"><i class=\"far fa-link\"></i><span class=\"hidden\">새 창에서 링크보기</span></a>\r\n\t\t</li>\r\n\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</dd>\r\n\t\t</dl>\r\n\t\t<dl class=\"aw-box flex-start\" id=\"lDd\">\r\n\t\t<dt>용어 설명</dt>\r\n\t\t<dd>PCR은 세균 특이성이 있는 primer를 이용하여 적은 수의 세균이 있을지라도 쉽게 검출할 수 있는 유용한 방법이며, 이를 이용하여 구강 내 치면세균막이나 타액에서 직접 세균을 검출할 수 있게 되었다[8].</dd>\r\n\t\t</dl>\r\n\t\t</article>\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" onclick=\"insertBhvrLog({'bhvrNo' : '383','evntNo' : '01', 'urlNo' : 'PG023'});\"\r\n\t\tclass=\"btns size-big modal-open-close\" data-kisti-modal=\"#abstractWord\">닫기</button>\r\n\t\t</div>\r\n\t</div>\r\n</aside>\r\n<!-- } 모달팝업 // 초록 용어 설명 -->\r\n\r\n\r\n<!-- 모달팝업 // NTIS 과제정보 { -->\r\n<aside id=\"ntisWorkInfo\" class=\"modal size-small table-modal-box ntis-work-info\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>NTIS 과제정보</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#ntisWorkInfo\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div cla