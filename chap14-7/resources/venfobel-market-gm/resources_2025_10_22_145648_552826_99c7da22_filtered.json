.com/optimize.js?id=OPT-5NRK6C8\"></script>\r\n\r\n\t<script type=\"text/javascript\">\r\n\r\n\t\tsetTimeout(function() {\r\n\t\tvar ntime = performance.timing;\r\n\r\n\t\tvar total = ntime.loadEventEnd - ntime.navigationStart; //전체 소요시간\r\n\t\tvar redirect = ntime.redirectEnd - ntime.redirectStart; // 동일 origin에서의 redirect 시간\r\n\t\tvar cache = ntime.domainLookupStart - ntime.fetchStart; // cache 시간\r\n\t\tvar dnslookup = ntime.domainLookupEnd - ntime.domainLookupStart; //DNS Lookup 시간\r\n\t\tvar connect = ntime.connectEnd - ntime.connectStart; // 웹서버 연결 시간\r\n\t\tvar request = ntime.responseStart - ntime.requestStart; // 요청 소요 시간\r\n\t\tvar response = ntime.responseEnd - ntime.responseStart; // 응답 데이터를 모두 받은 시간\r\n\t\tvar dom = ntime.domComplete - ntime.domLoading; // DOM객체 생성 시간 *******************\r\n\t\tvar load = ntime.loadEventEnd - ntime.loadEventStart; // 브라우저의 Load 이벤트 실행시간\r\n\t\tvar pageEnd = ntime.loadEventEnd - ntime.responseEnd; //  서버에서 페이지를 받고 페이지를 로드하는데 걸린 시간\r\n\t\tvar networkDelay = ntime.responseEnd - ntime.fetchStart; //  네트워크 지연 시간\r\n\r\n\t\tconsole.log(\"total : \" + total + \"ms  >>>>>>>  전체 소요시간\");\r\n\t\tconsole.log(\"redirect : \" + redirect + \"ms  >>>>>>>   동일 origin에서의 redirect 시간\");\r\n\t\tconsole.log(\"cache : \" + cache + \"ms   >>>>>>>  cache 시간\");\r\n\t\tconsole.log(\"dnslookup : \" + dnslookup + \"ms  >>>>>>>  DNS Lookup 시간\");\r\n\t\tconsole.log(\"connect : \" + connect + \"ms  >>>>>>>  웹서버 연결 시간\");\r\n\t\tconsole.log(\"request : \" + request + \"ms  >>>>>>>  요청 소요 시간\");\r\n\t\tconsole.log(\"response : \" + response + \"ms  >>>>>>>  첫 응답으로 부터 응답 데이터를 모두 받은 시간\");\r\n\t\tconsole.log(\"dom : \" + dom + \"ms  >>>>>>>  DOM객체 로드 완료 시간\");\r\n\t\tconsole.log(\"load : \" + load + \"ms  >>>>>>>  브라우저의 Load 이벤트 실행시간\");\r\n\t\tconsole.log(\"pageEnd : \" + pageEnd + \"ms  >>>>>>>  서버에서 페이지를 받고 페이지를 로드하는데 걸린 시간\");\r\n\r\n\t\t}, 2000); //5초 뒤 수행\r\n\r\n\t\t$(document).ready(function(){\r\n\r\n\t\tvar getCookie = getCookieArr(\"checkLog\");\r\n\r\n\t\t$('.fnAddMyon').each(function(index, item){\r\n\t\tvar infraNo = $(this).data(\"infrano\");\r\n\t\tfor ( var i in getCookie) {\r\n\t\tif (infraNo == getCookie[i]) $(this).attr('checked', true);\r\n\t\t}\r\n\r\n\t\t});\r\n\r\n\t\t// 쿠키에 저장된 체크값이 전체일 경우\r\n\t\tif ($('input[name=scrapChkBox]:checked').length == $('input[name=scrapChkBox]').length) { $('.checkAll').attr('checked', true); }\r\n\r\n\t\tvar checkLog = [];\r\n\t\t//체크박스 전체 클릭 시, 해당 cn값 쿠키 저장\r\n\t\t$(\".checkAll\").click(function() {\r\n\r\n\t\tvar chkLength = $('input[name=scrapChkBox]:checked').length;\r\n\t\t// 전체가 체크된 경우\r\n\t\tif (chkLength == $('input[name=scrapChkBox]').length) {\r\n\r\n\t\tcheckLog = [];\r\n\t\t$('input[name=scrapChkBox]:checked').each(function(index, item){\r\n\t\tvar temp = $(this).val().split(\"@@\");\r\n\t\tcheckLog.push(temp[0]);\r\n\t\t});\r\n\t\t// 체크박스 쿠키 저장\r\n\t\tvar str = '';\r\n\t\tfor ( var key in checkLog) {\r\n\t\tif (str != '') str += '@';\r\n\t\tstr += key+':'+checkLog[key];\r\n\t\t}\r\n\t\tsetCookie(\"checkLog\", str, 1);\r\n\t\t} else if (chkLength == 0) {\r\n\t\tdeleteCookie(\"checkLog\");\r\n\t\t}\r\n\r\n\t\t});\r\n\r\n\t\t// 체크박스 단일 클릭 시, 해당 cn값 쿠키 저장\r\n\t\t$('input:checkbox[name=\"scrapChkBox\"]').click(function() {\r\n\r\n\t\tvar temp = $(this).val().split(\"@@\");\r\n\t\tif($(this).is(\":checked\") == true) {\r\n\t\tcheckLog.push(temp[0]);\r\n\t\t} else {\r\n\t\t// check > unCheck일 경우\r\n\t\tcheckLog = [];\r\n\t\t$('input[name=scrapChkBox]:checked').each(function(index, item){\r\n\t\tvar temp = $(this).val().split(\"@@\");\r\n\t\tcheckLog.push(temp[0]);\r\n\t\t});\r\n\t\t}\r\n\r\n\t\t// 체크박스 쿠키 저장\r\n\t\tvar str = '';\r\n\t\tfor ( var key in checkLog) {\r\n\t\tif (str != '') str += '@';\r\n\t\tstr += key+':'+checkLog[key];\r\n\t\t}\r\n\t\tsetCookie(\"checkLog\", str, 1);\r\n\r\n\t\t});\r\n\r\n\t\tfunction getCookieArr( name ) {\r\n\t\tvar str = this.getCookie(name);\r\n\t\tvar reData = {};\r\n\t\tif(str && str != \"\"){\r\n\t\tvar temp1 = str.split('@');\r\n\t\tfor ( var i in temp1) {\r\n\t\tvar temp2 = temp1[i].split(':');\r\n\t\treData[temp2[0]]=temp2[1];\r\n\t\t}\r\n\t\t}\r\n\t\treturn reData;\r\n\t\t}\r\n\r\n\t\t// \t// 로그인 이후 내보내기/즐겨찾기/MyON담기 클릭 시 쿠키 삭제\r\n\t\t// \t$('.exchange, .bookmark, .myonput').click(function() {\r\n\t\t// \t\tif('' != '') deleteCookie(\"checkLog\");\r\n\t\t// \t});\r\n\r\n\t\t});\r\n\r\n\t</script>\r\n\r\n\t<script type=\"text/x-mathjax-config\">\r\n\t\tMathJax.Hub.Config({\r\n          tex2jax: {inlineMath: [['$','$'], ['\\\\(','\\\\)']]}\r\n          , messageStyle: \"none\"\r\n        });\r\n\t</script>\r\n\t<!-- <script src=\"https://cdn.mathjax.org/mathjax/latest/MathJax.js?config=TeX-AMS-MML_HTMLorMML\"></script> -->\r\n\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/MathJax.js?config=TeX-AMS-MML_HTMLorMML\"></script>\r\n\r\n</head>\r\n<body>\r\n<span style=\"display: none;\">$\\require{mediawiki-texvc}$</span>\r\n<div id=\"wrapper\">\r\n\t<!-- 메인 탑 배너 {  -->\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- 접근성 용 -->\r\n<aside id=\"accessibility\">\r\n   \r\n   \r\n   \r\n      <a href=\"#container\" class=\"none\">본문 바로가기</a>\r\n   \r\n   <script>\r\n      $(function() {\r\n         $(\"#accessibility a\").on(\"keydown\", function(e) {\r\n            if(e.keyCode == 13) {\r\n               window.location.href = $(e.target).attr(\"href\");\r\n               $(e.target).blur();\r\n            }\r\n         });\r\n      });\r\n   </script>\r\n</aside>\r\n<!-- 메인 탑 배너 { -->\r\n<aside class=\"main-top-banner\" style=\"background-color: #001a3d;\">\r\n\t\r\n\t\r\n\t<input type=\"hidden\" id=\"profileFg\" value=\"N\"/>\r\n\r\n\t\r\n\t\t\r\n\t\t<div class=\"mtb-slide\">\r\n\t\t<ul class=\"swiper-wrapper\" id=\"swiper-wrapper-banner\">\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t<div class=\"banner-ch-wrap\"><input type=\"checkbox\" id=\"no-show\"><label for=\"no-show\">오늘 하루 열지 않기</label></div>\r\n\t\t<button type=\"button\" class=\"close-btn\"><i class=\"fal fa-times\"></i></button>\r\n\t\t<div class=\"slide-control flex-end\">\r\n\t\t<button type=\"button\" class=\"sc-btn swiper-button swiper-prev\" id=\"main-top-swperPrevBtn\"><i class=\"far fa-chevron-up\"></i></button>\r\n\t\t<button type=\"button\" class=\"sc-btn play-pause-btn\" id=\"main-top-pauseBtn\">\r\n\t\t<!--<i class=\"fas fa-play\"></i>-->\r\n\t\t<i class=\"fas fa-pause\"></i>\r\n\t\t</button>\r\n\t\t<button type=\"button\" class=\"sc-btn swiper-button swiper-next\" id=\"main-top-swperNextBtn\"><i class=\"far fa-chevron-down\"></i></button>\r\n\t\t</div>\r\n\t\r\n<!-- \t/* [개발업무], 개발일자-2024-10-21, 작업내용 : profile 시범서비스 */ -->\r\n\t\r\n\t<script>\r\n\r\n      $(document).ready(function () {\r\n\t\t\r\n    \t$('#profileOnOff').change(function () {\r\n  \t\tif ($(this).is(':checked')) {\r\n  \t\t$('.text_off').css('display', 'none'); \r\n  \t\t$('.text_on').css('display', 'block');\r\n  \t\t} else {\r\n  \t\t$('.text_off').css('display', 'block');  \r\n  \t\t$('.text_on').css('display', 'none'); \r\n  \t\t}\r\n  \t\t$.ajax({\r\n  \t\turl: '/main/profileOnOff.do',\r\n  \t\tdata: {'profileOnOff' : $(this).is(':checked') ? 'Y' : 'N'},\r\n  \t\t});\r\n  \t\t\r\n  \t\t// 행동로그 적재\r\n\t\tvar checkboxParam ={\r\n\t\t\"evntNo\" : \"01\"\r\n\t\t,\"bhvrNo\" : \"1075\"\r\n\t\t,\"urlNo\" : \"PG023\"\r\n\t\t,\"depth1\" : $(this).is(':checked')\r\n\t\t};\r\n\t\tlogCheckboxBhvr(checkboxParam);\r\n  \t\t});\r\n    \t  \r\n  \t    $.ajax({\r\n  \t        type: \"GET\",\r\n  \t        url: \"/main/userBannerTop.do\",\r\n  \t        dataType: \"json\",\r\n  \t        success: function (data) {\r\n  \t        \tvar bannerList = data.extractedBannerList;\r\n  \t            var html = '';\r\n  \t            \r\n  \t            for (var i = 0; i < bannerList.length; i++) {\r\n  \t                var banner = bannerList[i];\r\n  \t                html += '<li class=\"swiper-slide\"><a href=\"' + banner.siteLink + '\" target=\"_blank\" class=\"mtb-btn\">';\r\n  \t                html += '<span class=\"ico\"><img src=\"data:image/jpg;base64,' + banner.filePath + '\" alt=\"' + banner.siteTitle + '\" title=\"' + banner.siteTitle + '\" /></span>';\r\n  \t                html += '<em class=\"oneline\">' + banner.siteTitle + '</em></a></li>';\r\n  \t            }\r\n  \t            \r\n  \t            if(bannerList.length == 0){\r\n  \t            \tif(\"N\" == \"Y\"){\r\n  \t            \t\t$('body').addClass('in-top-banner');\r\n  \t            \t}else{\r\n  \t            \t\t$('body').removeClass('in-top-banner');\r\n  \t            \t}\r\n  \t            \t\r\n  \t            } else {\r\n  \t            \tif(getCookie(\"banner-no-show\") !=\"Y\"){\r\n  \t                  $('body').addClass('in-top-banner');\r\n  \t              \t} \r\n  \t            }\r\n  \t            \r\n  \t            $(\"#swiper-wrapper-banner\").append(html);\r\n  \t            \r\n  \t            if (bannerList.length > 1 && \"N\" != \"Y\") {\r\n\t  \t          var mtbswiper = new Swiper(\".mtb-slide\", {\r\n\t  \t              direction: \"vertical\",\r\n\t  \t              loop: true,\r\n\t  \t              observer: true,\r\n\t  \t              observeParents: true,\r\n\t  \t              autoplay: {\r\n\t  \t                 delay: 4000,\r\n\t  \t                 disableOnInteraction: false,\r\n\t  \t   \t\t     pauseOnMouseEnter : true,\r\n\t  \t              },\r\n\t  \t              navigation: {\r\n\t  \t                  nextEl: \".main-top-banner #main-top-swperNextBtn\",\r\n\t  \t                  prevEl: \".main-top-banner #main-top-swperPrevBtn\",\r\n\t  \t              },\r\n\t\t  \t          on: {\r\n\t\t  \t              init: function () {\r\n\t\t  \t                  // 슬라이드 개수가 1개인 경우에만 재생/정지 버튼 표시\r\n\t\t  \t                  if (this.slides.length <= 1) {\r\n\t\t  \t                      $(\"#main-top-pauseBtn\").hide();\r\n\t\t  \t                  }\r\n\t\t  \t              },\r\n\t\t  \t          },\r\n\t  \t          });\r\n  \t           } else {\r\n  \t        \t $(\"#main-top-pauseBtn\").hide();\r\n  \t        \t $(\"#main-top-swperNextBtn\").hide();\r\n  \t        \t $(\"#main-top-swperPrevBtn\").hide();\r\n  \t           }\r\n  \t        },\r\n  \t        error: function (error) {\r\n  \t            // 오류 처리\r\n  \t            //console.error(\"배너리스트 오류 원인: \" + error.responseText);\r\n  \t        }\r\n  \t  });\r\n  \t  \r\n  \t  $('.main-top-banner .close-btn').click(function() {\r\n          if($(\"input:checkbox[id='no-show']\").is(\":checked\") == true){\r\n             //1일간 안보이게 쿠키 처리 예정 (로그인 전 화면 신규 개발 후 배너 공유해서 같이 사용할 때 작업함)   \r\n             setCookie('banner-no-show', 'Y' , 1 );\r\n          }\r\n          \r\n          $('body').removeClass('in-top-banner');\r\n      });\r\n  \t\r\n  \t/* [개발업무], 개발일자-2024-10-21, 작업내용 : profile 시범서비스 */\r\n  \t$('.main-top-banner #profileClose').click(function() {\r\n        $('body').removeClass('in-top-banner');\r\n        \r\n        $.ajax({\r\n\t\turl: '/main/profileEnd.do',\r\n\t\tsuccess: function(data) {\r\n\t\tif(window.location.pathname == \"/main/profileMainForm.do\"){\r\n\t\twindow.location.href = \"/main/mainForm.do\";\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n    });\r\n  \t\r\n  \t  \r\n  \t  var sw = 0;\r\n  \t  \r\n  \t  $('#main-top-pauseBtn').click(function(){\r\n  \t\t  if(sw==0){\r\n  \t\t  $('#main-top-pauseBtn').html(\"\");\r\n  \t\t  $('#main-top-pauseBtn').append('<i class=\"fas fa-play\"></i>');\r\n  \t\t  mtbswiper.autoplay.stop();\r\n  \t\t  sw = 1;\r\n  \t\t  } else{\r\n  \t\t  $('#main-top-pauseBtn').html(\"\");\r\n  \t\t  $('#main-top-pauseBtn').append('<i class=\"fas fa-pause\"></i>');\r\n  \t\t  mtbswiper.autoplay.start();\r\n  \t\t  sw = 0;\r\n  \t\t  }\r\n  \t  });\r\n  \t});\r\n      \r\n      $(\"#eventBtn\").click(function(e){\r\n         \r\n            \r\n               fn_login_alert();\r\n            \r\n            \r\n         \r\n      });\r\n         \r\n      function fn_login_alert(){\r\n         $.alert({\r\n            title: '알림',\r\n            content: '로그인이 필요한 서비스 입니다.<br>로그인하시겠습니까?',\r\n            buttons: {\r\n            specialKey : {\r\n               text: '확인',\r\n               action: function(){\r\n                  location.href = '/logn/PORLonForm.do?returnUrl=/event/selectPOREventSubmit.do';\r\n               }      \r\n            },\r\n            alphabet: {\r\n               text: '취소'\r\n            }\r\n            }\r\n         });\r\n      }\r\n      \r\n      //쿠키 불러오기\r\n      function getCookie(name) { \r\n         var obj = name + \"=\"; \r\n         var x = 0; \r\n         while ( x <= document.cookie.length ){ \r\n            var y = (x+obj.length); \r\n            if ( document.cookie.substring( x, y ) == obj ){ \r\n               if ((endOfCookie=document.cookie.indexOf( \";\", y )) == -1 ) endOfCookie = document.cookie.length;\r\n               return unescape( document.cookie.substring( y, endOfCookie ) ); \r\n            } \r\n            x = document.cookie.indexOf( \" \", x ) + 1; \r\n            \r\n            if ( x == 0 ) break; \r\n         } \r\n         return \"\"; \r\n      }\r\n   </script>\r\n</aside>\r\n\r\n<!-- } 메인 탑 배너 -->\r\n\t<!-- 트렌드 생성 체트(완료 후 알람띄음) -->\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\n<!-- 24.08.21 AI 리뷰 담기 모달 추가-->\n<aside id=\"aiReviewGet\" class=\"modal size-small table-modal-box ai-review-get\" style=\"display: none;\">\n    <form id=\"aiReviewArticleForm\" enctype=\"multipart/form-data\">\n        <input name=\"artiId\" type=\"hidden\">\n        <input id=\"unitSeq\" name=\"unitSeq\" type=\"hidden\">\n        <input type=\"hidden\" id=\"articleIdList\" name=\"articleIdList[]\" value=\"\">\n        <div class=\"modal-dialog aireview-wrap\">\n            <div class=\"modal-head flex-spacebetween\">\n                <h2 class=\"modal-tit\"><b>리뷰 대상 논문</b></h2>\n                <button type=\"button\" onclick=\"closeAIReviewModal()\" class=\"modal-close-btn\">\n                    <i class=\"fal fa-times\"></i>\n                </button>\n            </div>\n            <div class=\"modal-content\">\n                <section class=\"thesis-list pdt15px\">\n                    <div>\n                        <ul>\n                            <li>ScienceON 논문 검색 후 <a class=\"no-hover btn-versatile ai-review-add\" >\n                                <span class=\"ico\"><img src=\"/newUI/img/aihelper/ico_aireviewer_s2.png\" alt=\"AI Reviewer Icon\" /></span>\n                                AI-Reviewer</a>\n                                로 논문을 선택하거나, PDF 논문을 직접 업로드(최대 10MB)하여 리뷰 대상 논문을 최대 30건까지 추가할 수 있습니다.\n                            </li>\n                            <li>최소 2건에서 최대 10건까지 논문을 선택하여 리뷰를 실행합니다.</li>\n                        </ul>\n                    </div>\n                    <h3 class=\"aireview-h2\">\n                        <em>논문 목록 <span class=\"color-red\">(<span id=\"articleSize\"></span> 건)</span><span id=\"basketMsg\"></span></em>\n                        <div class=\"right-area flex-end\">\n                            <button type=\"button\" onclick=\"deleteArticleBasket()\" class=\"btns side-round btn-red-line\">\n                                <i class=\"fal fa-trash-alt\"></i> 선택삭제\n                            </button>\n                            <label for=\"pdfFile\">\n                                <div class=\"btns side-round btn-blue-line\">PDF 업로드</div>\n                            </label>\n                            <input type=\"file\" name=\"pdfFile\" id=\"pdfFile\" multiple style=\"display: none;\" onchange=\"uploadPDF(this)\" accept=\".pdf\">\n                        </div>\n                    </h3>\n                    <!-- (수정) 전체선택 및 정렬 셀렉트박스 추가 -->\n                    <article class=\"all-powerful-list mgt20px\">\n                        <aside class=\"list-top-info flex-spacebetween\">\n                            <ul class=\"left-con flex-start\">\n                                <li><input type=\"checkbox\" class=\"basic-check checkAll-review-article\" id=\"checkAll\"><label for=\"checkAll\"><span></span>전체선택</label></li>\n                            </ul>\n                        </aside>\n                        <div style=\"height: 400px;overflow: auto;border-bottom:1px solid #ddd;\">\n                            <table id=\"basketList\" class=\"review-tbl\" style=\"border-collapse:unset;\">\n                                <colgroup>\n                                    <col>\n                                    <col>\n                                    <col>\n                                    <col>\n                                </colgroup>\n                                <thead class=\"tb-flex\">\n                                <tr>\n                                    <th>\n                                        <input type=\"checkbox\" id=\"choiceCheckAll\" name=\"choiceCheckAll\" class=\"basic-check notxt checkAll-review-article\"><label for=\"choiceCheckAll\"><span></span></label>\n                                    </th>\n                                    <th class=\"clickable\">논문 제목 (파일명) <i class=\"fal\"></i></th>\n                                    <th class=\"clickable\">구분 <i class=\"fal\"></i></th>\n                                    <th class=\"clickable desc\">등록일 <i class=\"fal fa-arrow-down\"></i></th>\n                                </tr>\n                                </thead>\n                                <tbody id=\"articleList\">\n\n                                </tbody>\n                            </table>\n                        </div>\n                    </article>\n                </section>\n            </div>\n            <div class=\"modal-foot flex-center\">\n                <button type=\"button\" class=\"btns size-big btn-blue-deep\" onclick=\"analysisReview();\" id=\"btn-run-review\">리뷰실행</button>\n            </div>\n        </div>\n    </form>\n</aside>\n\n<div class=\"wrap-upload-progress hidden\">\n    <span><i class=\"fad fa-spinner fa-spin\"></i></span>\n    <em id=\"progress-message\">처리 중</em>\n</div>\n\n<div id=\"analysisProcessModal\" class=\"thesis-analysis-process\"  style=\"display: none;\">\n    <div class=\"tap-dialog\">\n        <div class=\"process-list\">\n            <div id=\"analysisProcess\" class=\"process-con select\">\n                <div class=\"txt\"><b>논문 분석</b><span><i class=\"fad fa-spinner fa-spin\"></i></span></div>\n                <div class=\"progress-bar\"><span class=\"p-guage\" style=\"width: 0%\"></span></div>\n            </div>\n            <span class=\"analysis-step arrow-ico on\"><i class=\"fas fa-arrow-alt-down\"></i></span>\n            <div id=\"reviewProcess\" class=\"process-con\">\n                <div class=\"txt\"><b>리뷰 생성</b><span><i class=\"fad fa-spinner fa-spin\"></i></span></div>\n                <div class=\"progress-bar\"><span class=\"p-guage\" style=\"width: 0%\"></span></div>\n            </div>\n            <span class=\"review-step arrow-ico\"><i class=\"fas fa-arrow-alt-down\"></i></span>\n            <div id=\"questionProcess\" class=\"process-con\">\n                <div class=\"txt\"><b>질문 생성</b><span><i class=\"fad fa-spinner fa-spin\"></i></span></div>\n                <div class=\"progress-bar\"><span class=\"p-guage\" style=\"width: 0%\"></span></div>\n            </div>\n            <span class=\"question-step arrow-ico\"><i class=\"fas fa-arrow-alt-down\"></i></span>\n            <div id=\"lastProcess\" class=\"process-con last\">\n                <div class=\"txt review-success\"><b>완료</b></div>\n                <div class=\"txt review-fail\" style=\"display:none;color: red\"><b>실패</b></div>\n                <p class=\"review-success\">(성공적으로 완료되었습니다)</p>\n                <p class=\"review-fail\" style=\"display:none;color: red;\">(분석중 오류가 발생했습니다)</p>\n            </div>\n        </div>\n        <div class=\"flex-center btn-area mgt40px\" >\n            <a id=\"viewReviewLink\" onclick=\"openAIReviewAnalysisPage();\" style=\"display: none;\" href=\"#;\" class=\"btns btn-blue-deep size-semibig hover-btn-blue-deep-line\">논문리뷰 보기</a>\n            <a id=\"closeModalBtn\" onclick=\"closeAIReviewModalAndProgress()\" style=\"display: none;margin-left: 10px;\" href=\"#;\" class=\"btns btn-gray-light size-semibig hover-btn-blue-deep-line\" >닫기</a>\n        </div>\n    </div>\n</div>\n\r\n\t<!-- Header -->\r\n\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- 메뉴활성화 -->\r\n<script type=\"text/javascript\">\r\nvar windowWidth;\r\n$( window ).resize(function() {\r\n\twindowWidth = $( window ).width();\r\n\tif (windowWidth < 981) {\r\n\t\tmenuActive('', '');\r\n\t} else {\r\n\t\tmenuRemove();\r\n\t}\r\n\t\r\n});\r\n\r\n$(document).ready(function(){\r\n\tif ($( window ).width() < 981) {\r\n\t\tmenuActive('', '');\r\n\t} else {\r\n\t\tmenuRemove();\r\n\t}\r\n\t\r\n});\r\n\r\nfunction menuActive(menu, subMenu) {\r\n\t\r\n\tvar paramMenu = menu;\r\n\tvar paramSubMenu = menu+\"_\"+subMenu;\r\n\t\r\n\tif (paramMenu == 'infra') {\r\n\t\t$('.analyze').removeClass('active');\r\n\t\t$('.cs').removeClass('active');\r\n\t\t$('.about').removeClass('active');\r\n\t\t$('.infra').addClass('active');\r\n\t\t$('#infra').show();\r\n\t\t\r\n\t\t if (paramSubMenu == 'infra_total') {\r\n\t\t$('#infra_purpose').removeClass('active');\r\n\t\t$('#infra_use').removeClass('active');\r\n\t\t$('#infra_total').addClass('active');\r\n\t\t\r\n\t\t } else if (paramSubMenu == 'infra_purpose') {\r\n\t\t$('#infra_total').removeClass('active');\r\n\t\t$('#infra_use').removeClass('active');\r\n\t\t$('#infra_purpose').addClass('active');\r\n\t\t\r\n\t\t } else if (paramSubMenu == 'infra_use') {\r\n\t\t$('#infra_total').removeClass('active');\r\n\t\t$('#infra_purpose').removeClass('active');\r\n\t\t$('#infra_use').addClass('active');\r\n\t\t }\r\n\t\t \r\n\t\t $('#wrapper').removeClass('none_submenu');\r\n\t} else if (paramMenu == 'analyze') {\r\n\t\t$('.infra').removeClass('active');\r\n\t\t$('.cs').removeClass('active');\r\n\t\t$('.about').removeClass('active');\r\n\t\t$('.analyze').addClass('active');\r\n\t\t$('#analyze').show();\r\n\t\t\r\n\t\tif (paramSubMenu == 'analyze_ai') {\r\n\t\t/* \t$('#analyze_timeline').removeClass('active'); */\r\n            $('#analyze_aireview').removeClass('active');\r\n\t\t$('#analyze_trend').removeClass('active');\r\n\t\t$('#analyze_sanl').removeClass('active');\r\n\t\t$('#analyze_lab').removeClass('active');\r\n\t\t$('#analyze_ai').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'analyze_aireview') {\r\n\t\t$('#analyze_ai').removeClass('active');\r\n            $('#analyze_aireview').addClass('active');\r\n\t\t$('#analyze_trend').removeClass('active');\r\n\t\t$('#analyze_sanl').removeClass('active');\r\n\t\t$('#analyze_lab').removeClass('active');\r\n\t\t$('#analyze_timeline').removeClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'analyze_trend') {\r\n\t\t$('#analyze_ai').removeClass('active');\r\n\t\t/* $('#analyze_timeline').removeClass('active'); */\r\n            $('#analyze_aireview').removeClass('active');\r\n\t\t$('#analyze_sanl').removeClass('active');\r\n\t\t$('#analyze_lab').removeClass('active');\r\n\t\t$('#analyze_trend').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'analyze_sanl') {\r\n\t\t$('#analyze_ai').removeClass('active');\r\n            $('#analyze_aireview').removeClass('active');\r\n\t\t$('#analyze_lab').removeClass('active');\r\n\t\t$('#analyze_trend').removeClass('active');\r\n\t\t$('#analyze_sanl').addClass('active');\r\n\t\t\r\n\t\t} else if (paramSubMenu == 'analyze_lab') {\r\n\t\t$('#analyze_ai').removeClass('active');\r\n            $('#analyze_aireview').removeClass('active');\r\n\t\t$('#analyze_sanl').removeClass('active');\r\n\t\t$('#analyze_trend').removeClass('active');\r\n\t\t$('#analyze_lab').addClass('active');\r\n\t\t}\r\n\t\t$('#wrapper').removeClass('none_submenu');\r