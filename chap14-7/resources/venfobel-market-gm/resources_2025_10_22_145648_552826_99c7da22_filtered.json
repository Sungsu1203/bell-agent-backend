ata-cn=\"JAKO202109960883508\"><i class=\"fal fa-folder-tree\"></i></button>\r\n\t\t</li>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<li class=\"flex-spacebetween\">\r\n\t\t<a href=\"/srch/selectPORSrchArticle.do?cn=JAKO201225067515805&dbt=NART\" class=\"oneline\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"[논문] 착륙장치 내추락 설계 및 시험평가\">[논문] 착륙장치 내추락 설계 및 시험평가</a>\r\n\t\t<button type=\"button\" class=\"related-btn modal-open-close\" onclick=\"fn_relevant('0001','JAKO201225067515805','0')\" title=\"함께 이용한 콘텐츠\" data-bhvr-no=\"208\" data-evnt-no=\"01\" data-log-no=\"202510223044750795\" data-url-no=\"PG023\" data-cn=\"JAKO201225067515805\"><i class=\"fal fa-folder-tree\"></i></button>\r\n\t\t</li>\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t</ul>\r\n\t\t</article>\r\n\t\t\r\n\t\t<!-- } 함께 이용한 콘텐츠 -->\r\n\r\n\t\t\r\n\t\t\r\n\r\n\r\n\r\n\r\n<article class=\"fo-con fo-use-case\" id=\"kacademy-swiper\" style=\"display: none\">\r\n    <div class=\"fo-use-case-slide\">\r\n        <ul class=\"swiper-wrapper\">\r\n        </ul>\r\n        <div class=\"slide-control flex-end\">\r\n            <button type=\"button\" class=\"sc-btn swiper-button swiper-prev\"><i class=\"far fa-chevron-left\"></i></button>\r\n            <button type=\"button\" class=\"sc-btn play-pause-btn\">\r\n                <i class=\"fas fa-pause\"></i>\r\n            </button>\r\n            <button type=\"button\" class=\"sc-btn swiper-button swiper-next\"><i class=\"far fa-chevron-right\"></i></button>\r\n        </div>\r\n    </div>\r\n</article>\r\n\r\n<script>\r\n    $(function () {\r\n        fn_ajax_kacademy();\r\n    });\r\n\r\n    function sendKacademySearch(keywords, onSuccess, onError) {\r\n        $.ajax({\r\n            url        : \"/srch/kacademyList.do\",\r\n            dataType   : 'json',\r\n            type       : 'post',\r\n            contentType: \"application/json; charset=utf-8\",\r\n            data       : JSON.stringify({'keywords': keywords}),\r\n            success    : onSuccess,\r\n            error      : onError\r\n        });\r\n    }\r\n\r\n\r\n    function fn_ajax_kacademy() {\r\n        const detail = document.getElementById(\"searchDetail\");\r\n        const keywords = [];\r\n\r\n        if (detail) {\r\n            // detail이 있을 경우 resultVO에서 키워드 생성\r\n            if ('유한요소법 . 오토로테이션 . 하드랜딩 . 스키드기어' && '유한요소법 . 오토로테이션 . 하드랜딩 . 스키드기어'.trim().length > 0) {\r\n                const splitKeywords = '유한요소법 . 오토로테이션 . 하드랜딩 . 스키드기어'.split('.').map(keyword => keyword.trim());\r\n                keywords.push(...splitKeywords);\r\n            }\r\n            keywords.push(\"헬리콥터 오토로테이션시 착륙장치 거동에 관한 연구\", \"A Study on the Behavior of Skid Gear During the Helicopter Autorotation\");\r\n        } else {\r\n            // detail이 없을 경우 searchKeyword만 사용하여 첫 번째 검색 시도\r\n            keywords.push(\"\");\r\n            sendKacademySearch(keywords, handleKacademyData, handleKacademyError);\r\n            return; // 첫 번째 검색 후 종료\r\n        }\r\n        // detail인 경우 바로 검색\r\n        sendKacademySearch(keywords, handleKacademyData, handleKacademyError);\r\n    }\r\n\r\n    let scienceEduListSwiper;\r\n\r\n    function handleKacademyData(data) {\r\n        const infraId = getInfraId();\r\n        if (data.result.documents.length > 0) {\r\n            const swiperHtml = data.result.documents.map(item => makeKacademySwiperSlide(item, infraId)).join('');\r\n            const swiperSlideElements = $('.fo-use-case-slide .swiper-wrapper');\r\n            swiperSlideElements.html(swiperHtml);\r\n\r\n            scienceEduListSwiper = new Swiper('.fo-use-case-slide', {\r\n                autoHeight    : true,\r\n                spaceBetween  : 20,\r\n                observer      : true,\r\n                observeParents: true,\r\n                autoplay      : {\r\n                    delay               : 2500,\r\n                    disableOnInteraction: false\r\n                },\r\n                navigation    : {\r\n                    nextEl: '.fo-use-case-slide .swiper-next',\r\n                    prevEl: '.fo-use-case-slide .swiper-prev'\r\n                }\r\n            });\r\n\r\n            $('#kacademy-swiper').show();\r\n        }\r\n    }\r\n\r\n    document.querySelector('#kacademy-swiper .play-pause-btn').addEventListener('click', function () {\r\n        if (scienceEduListSwiper.autoplay.running) {\r\n            scienceEduListSwiper.autoplay.stop();\r\n            this.innerHTML = '<i class=\"fas fa-play\"></i>';\r\n        } else {\r\n            scienceEduListSwiper.autoplay.start();\r\n            this.innerHTML = '<i class=\"fas fa-pause\"></i>';\r\n        }\r\n    });\r\n\r\n    function handleKacademyError(jqXHR, textStatus, errorThrown) {\r\n        console.log('Initial AJAX request failed: ' + textStatus + ', ' + errorThrown);\r\n    }\r\n\r\n    function handleKacademyListData(data) {\r\n        // reduceKeywords으로 다시 검색하는 로직은 보류\r\n        if (!data || data.result.documents.length === 0) {\r\n            // 검색 결과가 없을 경우 reduceKeywords로 다시 검색\r\n            console.log(\"No results for searchKeyword, retrying with reduceKeywords\");\r\n            const retryKeywords = [];\r\n            \r\n            sendKacademySearch(retryKeywords, handleKacademyData, handleKacademyError);\r\n        } else {\r\n            // 검색 결과가 있으면 처리\r\n            handleKacademyData(data);\r\n        }\r\n    };\r\n\r\n    function getInfraId() {\r\n        const endpoint = window.location.pathname;\r\n        console.log(endpoint);\r\n        if (endpoint === \"/srch/selectPORSrchArticleList.do\") {\r\n            return \"INFRAPAGE0246\"\r\n        } else if (endpoint === \"/srch/selectPORSrchArticle.do\") {\r\n            return \"INFRAPAGE0247\"\r\n        } else if (endpoint === \"/srch/PORSrchPatentList.do\") {\r\n            return \"INFRAPAGE0248\"\r\n        } else if (endpoint === \"/srch/PORSrchReportList.do\") {\r\n            return \"INFRAPAGE0250\"\r\n        } else if (endpoint === \"/srch/selectPORSrchTrendList.do\") {\r\n            return \"INFRAPAGE0252\"\r\n        }\r\n    }\r\n\r\n\r\n</script>\r\n<style>\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state {\r\n        display: flex;\r\n        justify-content: center;\r\n        align-items: stretch;\r\n        border: 1px solid var(--color-gray-light);\r\n        border-radius: 4px;\r\n        font-size: 1.4rem;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dt,\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dd {\r\n        flex-grow: 1;\r\n        line-height: 24px;\r\n        text-align: center;\r\n        border-left: 1px solid var(--color-gray-light);\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dt {\r\n        background-color: var(--table-header-bg);\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type1 .uc-state dt:first-child {\r\n        border-left: none;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con.use-case-type2 .uc-state {\r\n        display: flex;\r\n        justify-content: flex-start;\r\n        align-items: center;\r\n        gap: 10px;\r\n        font-size: 1.5rem;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con .state-btn {\r\n        margin: 10px 0;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con .period dl {\r\n        display: flex;\r\n        justify-content: flex-start;\r\n        align-items: center;\r\n        gap: 10px;\r\n        font-size: 1.4rem;\r\n    }\r\n\r\n    .fo-use-case-slide .use-case-con .period dl dt {\r\n        color: var(--color-blue);\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control {\r\n        margin-top: 10px;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .swiper-pagination {\r\n        position: relative;\r\n        top: auto;\r\n        left: auto;\r\n        bottom: auto;\r\n        width: auto;\r\n        margin-right: 10px;\r\n        color: var(--color-gray);\r\n        font-size: 1.4rem;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .swiper-pagination .swiper-pagination-current {\r\n        color: vaR(--color-basic);\r\n        font-weight: var(--font-weight-semibold);\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .sc-btn {\r\n        flex-shrink: 0;\r\n        padding: 2px 4px;\r\n        font-size: 1.3rem;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .sc-btn.play-pause-btn {\r\n        font-size: 1rem;\r\n    }\r\n\r\n    .fo-use-case-slide .slide-control .sc-btn:hover {\r\n        color: var(--color-blue);\r\n    }\r\n</style>\r\n\t\t</div>\r\n\t\t\r\n\t\t<!-- 과제정보 버튼생성 -->\r\n\t\t\r\n\t\t<!--저작권 관리 안내 버튼 -->\r\n\t\t<a href=\"/por/copyright/copyRightList.do\" target=\"_blank\" class=\"btns hover-btn-blue-line w100 round5px mgt10px\">저작권 관리 안내</a>\r\n\t\t<!--} 저작권 관리 안내 버튼 -->\r\n\t\t</div>\r\n\r\n\r\n\t\r\n\r\n\r\n\t<!-- } 관련 콘텐츠 -->\r\n</div>\r\n<!-- } 서브 페이지 -->\r\n\r\n<!-- 모달팝업 // 인용 { -->\r\n<aside id=\"doiQuotationStyle\" class=\"modal doi-quotation-style\">\r\n\t<div class=\"modal-dialog\">\r\n\t\t<div class=\"modal-head flex-spacebetween\">\r\n\t\t<h2 class=\"modal-tit\"><b>DOI 인용 스타일</b></h2>\r\n\t\t<button type=\"button\" class=\"modal-open-close modal-close-btn\" data-kisti-modal=\"#doiQuotationStyle\" data-bhvr-no=\"336\" data-evnt-no=\"01\" data-log-no=\"202510223044750795\" data-url-no=\"PG023\"><i class=\"fal fa-times\"></i></button>\r\n\t\t</div>\r\n\t\t<div class=\"p_con\">\r\n\t\t<!-- <iframe id=\"doiPage\" src=\"https://data.doi.or.kr/cite/10.5012/jkcs.2008.52.3.315\" width=\"100%\" height=\"500\" title=\"doiPage\"></iframe>-->\r\n\t\t</div>\r\n\t\t<div class=\"modal-foot flex-center\">\r\n\t\t<button type=\"button\" class=\"btns size-big modal-open-close\" data-kisti-modal=\"#doiQuotationStyle\" data-bhvr-no=\"336\" data-evnt-no=\"01\" data-log-no=\"202510223044750795\" data-url-no=\"PG023\">닫기</button>\r\n\t\t</div>\r\n\t</div>\r\n</aside>\r\n<!-- } 모달팝업 // 인용 -->\r\n\r\n<!-- 모달팝업 // 연