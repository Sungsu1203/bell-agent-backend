st(\"/*/brd/docviewer.do\",{brd_id:brd_id, seq:seq, data_tp:data_tp, file_seq:file_seq}\r\n\t\t,function(result){\r\n\t\tif(result.outputValue == 0){\r\n\t\twindow.open(\"/viewer/skin/doc.html?fn=\"+result.filename+\"&rs=/viewer/result/\"+month,'_blank');\r\n\t\tconsole.log(result);\r\n\t\twin.focus();\r\n\t\t}else {\r\n\t\tconsole.log(result);\r\n\t\talert(\"Document file conversion failed\");\r\n\t\t}\r\n\t\t});\r\n\t}\r\n//]]>\r\n</script>\r\n<style type=\"text/css\">\r\n.file_down>a {\r\n\t\tmargin-bottom: 5px\r\n\t}\r\n.ajax_hide {display:none;}\r\n#ajax_loading_bg {position:fixed; overflow:hidden; top:0; left:0; height:100%; width:100%; background:#000000; opacity:0.7; /* IE 8 */ -ms-filter:\"progid:DXImageTransform.Microsoft.Alpha(Opacity=70)\"; /* IE 5-7 */ filter:alpha(opacity=70); /* Netscape */ -moz-opacity:0.7; /* Safari 1.x */ -khtml-opacity:0.7; z-index:1000000001;}\r\n#ajax_loading_center {width:100px; height:100px; position:absolute; left:50%; top:50%;  margin-left:-50px; margin-top:-50px; z-index:1000000002;}\r\n</style>\r\n<div class=\"board_detail\">\r\n\t<div class=\"bo_head\">\r\n\t\t<h2>\r\n\t\t\r\n\t\tGovernor Abbott Champions Texas-South Korea Economic Partnership In Seoul\r\n\t\t</h2>\r\n\t\t<dl>\r\n\t\t\r\n\t\t<dt scope=\"row\">DATE</dt>\r\n\t\t<dd>2024-07-09</dd><!-- 작성일 -->\r\n\t\t</dl>\r\n\t</div>\r\n\t\r\n\t<div class=\"bo_con\">\r\n\t\t<div class=\"se-contents\" style=\"box-sizing: content-box; font-family: &quot;Open sans&quot;, &quot;Noto sans&quot;, &quot;sans-serif&quot;, &quot;맑은 고딕&quot;; font-size: 12pt; line-height: 1.4; letter-spacing: 0px;\"><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>@</span><span>Office of the Texas Governor&nbsp;</span><br/><br/><span>Governor Greg Abbott today delivered remarks at the U.S. Embassy in the Republic of Korea while in Seoul on the second day of a three-nation economic development mission to Taiwan, South Korea, and Japan. The special Texas evening reception was hosted by the U.S. Embassy at the Ambassador’s residence in Seoul and attended by invited dignitaries and business leaders from South Korea.</span><span class=\"se-zws-run\"><br/></span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>“Texas and South Korea have plenty in common, with knowledge-based economies that will continue to grow and thrive well into the next generation,” said Governor Abbott. “We are both economic powerhouses set to dominate the technologically advanced future. And with our strong trade and exports, Texas and South Korea are critical economic partners in the growing economies of the 21st century. I looked forward to working closely with the leaders of South Korea to further link our economies and ensure our two peoples lead the way into the economy of the future.”</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><a style=\"box-sizing: border-box; background-color: transparent; cursor: pointer; text-decoration: underline; color: rgb(2, 46, 146);\" data-href=\"https://www.dropbox.com/scl/fo/qab7m771voth089rngplg/AHoo13KbTjXt59cxqgpbJjc/South%20Korea/7.8.24?dl=0&amp;rlkey=ch0zx1lseuo9yyuew9z00qlb2&amp;subfolder_nav_tracking=1\" data-hyperlink-id=\"se_78f94b91-c988-44fb-8b82-749fcbf45f07\" target=\"_blank\" href=\"https://www.dropbox.com/scl/fo/qab7m771voth089rngplg/AHoo13KbTjXt59cxqgpbJjc/South%20Korea/7.8.24?dl=0&amp;rlkey=ch0zx1lseuo9yyuew9z00qlb2&amp;subfolder_nav_tracking=1\"><span>Photos and video of Governor Abbott and the Texas delegation’s visit to South Korea are available here. Pool report from Dallas Morning News’ Gromer Jeffers is also included.</span></a></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>Kicking off the day, Governor Abbott met with the Minister of Foreign Affairs for the Republic of Korea Cho Tae-yul to discuss deepening the mutually beneficial economic and trade relationship between Texas and South Korea. The Governor and the Minister shared their focus on fostering innovation in critical, emerging industries that are leading the way for the global economy, including AI and semiconductor manufacturing. South Korea is a global leader in semiconductor manufacturing, and Texas has led the U.S. in semiconductor exports for 13 years.&nbsp;</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>In the afternoon, Governor Abbott was hosted by the Korea International Trade Association (KITA) at a luncheon that included businesses leaders from across South Korea. KITA recently opened an office in Dallas to help expand trade cooperation between Texas and South Korea. At the luncheon, the Governor highlighted how Texas is the United States’ top exporting state, now for 22 years in a row, and talked about opportunities for South Korea and Texas to further deepen their trade relationship.&nbsp;</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>Governor Abbott also met with SK Americas Vice Chairman and CEO Jeong Joon (JJ) Yu, SK Signet President and CEO Jung Ho Shin, SK SUPEX Council Executive Vice President Jeongil Kim, and SK Signet Group Leader Jinsoo Kim to thank the company for its recent expansion in Plano, Texas with a new facility that will manufacture electric vehicle charging stations.</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>The Governor was joined at the second day of meetings by First Lady Cecilia Abbott, Secretary of State Jane Nelson, the Governor’s Economic Development &amp; Tourism Office Executive Director Adriana Cruz, Texas Economic Development Corporation Board Secretary Adrian Cannady, Texas Economic Development Corporation President &amp; CEO Aaron Demerson, and the Texas delegation.The goal of the trip is to deepen the already-strong economic and cultural partnerships with Texas, encourage expanded trade in critical industries, and attract new business investments to Texas.</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>The following events are scheduled for the third day of the economic development mission in Seoul, South Korea:</span></p><ul class=\"se-list\" style=\"box-sizing: border-box; list-style-position: outside; list-style-type: disc; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px 20px; word-spacing: 0px; white-space: normal;\"><li class=\"se-list-item\" style=\"box-sizing: border-box; font-size: inherit; list-style: none; padding: 0px; margin: 0px 0px 8px -3.3125px;\" data-format=\"bullet\" data-level=\"0\" data-level-margin-left=\"0px\" data-list-position=\"outside\" data-margin-left=\"0px\" data-multi=\"false\" data-startval=\"1\" data-text=\"●\"><p style=\"margin: 0px;\"><span class=\"se-list-type\" style=\"pointer-events: none; left: -10px; font-family: Arial; display: inline-block; position: relative; text-indent: -9.6875px;\">●</span><span>Meet with Samsung Executives at Pyeongtaek Semiconductor Facility</span></p></li><li class=\"se-list-item\" style=\"box-sizing: border-box; font-size: inherit; list-style: none; padding: 0px; margin: 0px 0px 8px -3.3125px;\" data-format=\"bullet\" data-level=\"0\" data-level-margin-left=\"0px\" data-list-position=\"outside\" data-margin-left=\"0px\" data-multi=\"false\" data-startval=\"1\" data-text=\"●\"><p style=\"margin: 0px;\"><span class=\"se-list-type\" style=\"pointer-events: none; left: -10px; font-family: Arial; display: inline-block; position: relative; text-indent: -9.6875px;\">●</span><span>Project announcement for Texas</span></p></li></ul><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>&nbsp;</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span style=\"font-weight: bold;\">South Korea</span><span style=\"font-weight: bold;\">&nbsp;</span><span>leads all nations for foreign direct investment by amount of total capital investment in Texas over the last decade. Over the past 10 full years through 2023, companies from South Korea have invested $20.59 billion in 38 projects creating more than 7,000 jobs in Texas. In the first five months of 2024, South Korean companies have invested $27.52 billion in nine additional projects expected to create more than 4,800 new jobs in Texas. Texas trade with South Korea totaled $32 billion in 2023, making South Korea the fourth-largest total trade partner with Texas. &nbsp; &nbsp;</span></p><p style=\"box-sizing: border-box; text-rendering: optimizelegibility; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-transform: none; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; font-family: &quot;Libre Franklin&quot;, &quot;Helvetica Neue&quot;, Helvetica, Roboto, Arial, &quot;sans-serif&quot;; font-size: 20px; color: rgb(68, 69, 69); background-color: rgb(255, 255, 255); line-height: 1.4; text-indent: 0px; padding: 0px; margin: 0px 0px 16px; word-spacing: 0px; white-space: normal;\"><span>The trip is sponsored and paid for by the</span><span>&nbsp;</span><a style=\"box-sizing: border-box; background-color: transparent; cursor: pointer; text-decoration: underline; color: rgb(2, 46, 146);\" data-href=\"https://businessintexas.com/\" data-hyperlink-id=\"se_0c0fb283-5347-49f3-8ad3-eabefefa8260\" target=\"_blank\" href=\"https://businessintexas.com/\"><span>Texas Economic Development Corporation</span></a><span>, an independently funded and operated 501(c)(3) nonprofit organization responsible for marketing and promoting Texas as a premier business location. Along with the</span><span>&nbsp;</span><a style=\"box-sizing: border-box; background-color: transparent; cursor: pointer; text-decoration: underline; color: rgb(2, 46, 146);\" data-href=\"https://gov.texas.gov/business\" data-hyperlink-id=\"se_b2c9148c-2fad-4c41-9bcf-f9e13ca84bd0\" target=\"_blank\" href=\"https://gov.texas.gov/business\"><span>Governor’s Economic Development &amp; Tourism Office</span></a><span>, these two organizations are the cornerstone of Governor Abbott’s economic development agenda to build a bigger, better Texas.</span></p></div>\r\n\t</div>\r\n\t\r\n\t<ul class=\"bo_util\">\r\n     \r\n     \r\n  </ul>\r\n   \r\n   <div class=\"bo_btn\">\r\n     <a href=\"./list.do?page=1&amp;srchFr=&amp;srchTo=&amp;srchWord=&amp;srchTp=&amp;multi_itm_seq=0&amp;itm_seq_1=0&amp;itm_seq_2=0&amp;company_cd=&amp;company_nm=\" class=\"blue\">List</a>\r\n   </div>\r\n   <nav class=\"bo_pagination\">\r\n\t\t<a href=\"#\" class=\"prev\"><b>Prev</b>\r\n\t\t<span>\r\n\t\t Opening Remarks for the 3rd Summit for Democracy Leader&#039;s Plenary\r\n\t\t<!-- 이전글 없을 경우 -->\r\n\t\t\r\n\t\t</span>\r\n\t\t</a>\r\n\t\t<a href=\"#\" class=\"next\"><b>Next</b>\r\n\t\t<span>\r\n\t\t [Former] Congratulatory Remarks by H.E. Cho Tae-yul Minister of Foreign Affairs of the Republic of Korea at the 9th KF-C…\r\n\t\t<!-- 다음글 없을 경우 -->\r\n\t\t\r\n\t\t</span>\r\n\t\t</a>\r\n\t\t</nav>\r\n</div>\r\n\r\n<div id=\"ajax_loading_bg\" class=\"ajax_hide\" >\r\n\t<div id=\"ajax_loading_center\"><img id=\"ajax_loading_img\" src=\"/images/egovframework/cms/loading/ajax-loader.gif\" alt=\"loading\"/></div>\r\n</div>\r\n<iframe id=\"_h_blank\" name=\"_h_blank\" frameborder=\"0\" height=\"0\" width=\"0\" title=\"NoContent\"></iframe> \r\n\t</div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\n\t$(document).ready(function(){\r\n\t\tgetOpenAbroadList($('#cntten').val());\r\n\t\t$(\"#cntten\").append(\"<option value=''>Select a Continent</option>\");\r\n\t\t$(\"#emblgbd\").append(\"<option value=''>Select a Country</option>\");\r\n\r\n\t\t\r\n\t});\r\n\t\r\n\t//대륙코드선택 selectBox\r\n\tfunction getOpenAbroadList(_cntt){\r\n\t\t//재외공관영문명바로가기 abroadEn\r\n\t\tif(_cntt != \"\")\r\n\t\t$.post(\"/cmmn/abroadEnSelectBox.do\",{cntten : _cntt},setOpenAbroadList, \"json\");\r\n\t}\r\n\t\r\n\t//공관선택 selectBox\r\n\tfunction setOpenAbroadList(data, status){\r\n\t\tif ( 'success' != status || null == data ) { alert(\"조회하지 못하였습니다.\"); return; }\r\n\t\tvar obj = $('select[name=\"emblgbd\"]');\r\n\t\tobj.children().remove();\r\n\t\t$(\"#emblgbd\").append(\"<option value=''>Select a Country</option>\");\r\n\t\tif(data.vo.length == 9){\r\n\t\tfor(var i =0; i < data.vo.length; i++){\r\n\t\t$(\"#cntten\").append(\"<option value=\"+data.vo[i].code+\">\"+data.vo[i].description+\"</option>\");\r\n\t\t}\r\n\t\t}else {\r\n\t\tfor(var i =0; i < data.vo.length; i++){\r\n\t\t$(\"#emblgbd\").append(\"<option value=\"+data.vo[i].deptNm+\">\"+data.vo[i].description+\"</option>\");\r\n\t\t}\r\n\t\t}\r\n\t\t   \t\r\n\t}\r\n\t//공관링크바로가기\r\n\tfunction goabroad(url){\r\n\t\tvar chkurl=\"\";\r\n\t\tif(url != chkurl){window.open(url);\treturn;}\r\n\t}\r\n//]]> \r\n\t</script>\r\n\t\r\n\t\t</div>\r\n\t</div>\r\n\t\r\n\t<!-- 푸터 -->\r\n    <div class=\"footer\">\r\n      <div class=\"addr en\">\r\n        <div class=\"container\">\r\n          <dl>\r\n            <dt>Consulate General of the Republic of Korea in Houston</dt>\r\n\t\t<dd class=\"add\">Address : 1990 Post Oak Blvd #1250, Houston, TX77056</dd>\r\n\t\t<dd>Tel : +1-713-961-0186 | Hours of Operation : 09:00 - 17:00 | Civil Service : 09:00-12:00, 13:00-16:30\n</dd>\r\n          </dl>\r\n          <nav class=\"fnb\">\r\n\t          \r\n<form name=\"form2\" >\r\n\t<div class=\"link\">\r\n    \t<div class=\"select\">\r\n\t      <select title=\"재외공관링크:대륙선택\" id=\"cntten\" name=\"cntten\" onchange=\"javascript:getOpenAbroadList(this.value)\"></select>\r\n    \t</div>\r\n\t    <div class=\"select\">\r\n\t      <select id=\"emblgbd\" name=\"emblgbd\" onchange=\"javascript:goabroad(this.value)\"></select>\r\n\t    </div>\r\n  </div>\r\n</form>\r\n\r\n\t          <ul>\r\n            \t\r\n\t<li><a href=\"http://www.mofa.go.kr/eng/wpge/m_5802/contents.do\" target=\"_blank\" title=\"new window\">Privacy Guidelines</a></li>\r\n            \t<li><a href=\"mailto:Con-hu@mofa.go.kr\" title=\"send mail\">Contact Us</a></li>\r\n            </ul>\r\n \r\n          </nav>\r\n          \r\n\t<div class=\"copy\">\r\n\t  <span>Copyright © Ministry of Foreign Affairs. All Rights Reserved.</span>\r\n\t  <ol>\r\n\t  \t<li><a href=\"http://www.facebook.com/mofakr.eng\" target=\"_blank\" title=\"new window\"><img src=\"/common-embd/images/common/icon_facebook.png\" alt=\"facebook\" /></a></li>\r\n\t\t<li><a href=\"https://www.instagram.com/mofa_eng/\" target=\"_blank\" title=\"new window\"><img src=\"/common-embd/images/common/icon_insta.png\" alt=\"instagram\"></a></li>\r\n\t    <li><a href=\"https://www.youtube.com/user/MOFAKorea\" target=\"_blank\" title=\"new window\"><img src=\"/common-embd/images/common/icon_youtube.png\" alt=\"youtube\"></a></li>\r\n\t  \t<li><a href=\"https://twitter.com/mofakr_eng\" target=\"_blank\" title=\"new window\"><img src=\"/common-embd/images/common/icon_twitter.png\" alt=\"twitter\" /></a></li>\r\n\t  </ol>\r\n\t</div>\r\n\t\r\n<!--facebook - insta - youtube - twitter - vk - weibo - Linkedin - telegram  순서로 리스트업 한다.\t-->\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n    <!-- //푸터 -->\r\n\t\r\n\t<!-- 팝업존 -->\r\n\t\r\n\r\n<div class=\"modal_wrap\">\r\n  <div class=\"modal_pop\">\r\n<!--     <h2>팝업존</h2> -->\r\n    <div class=\"pop_banner\">\r\n      <div class=\"slide\"></div>\r\n      <div class=\"control\">\r\n        <div class=\"pagination_num\"></div>\r\n        <button class=\"prev\">이전</button>\r\n        <button class=\"pause\">자동재생 정지</button>\r\n        <button class=\"next\">다음</button>\r\n      </div>\r\n    </div>\r\n    <div class=\"modal_close\">\r\n     \t\r\n     \t\t\r\n\t\t\r\n\t\t<button type=\"button\" onclick=\"return closeWin('us-houston-en')\">Close this window for a Week</button>\r\n\t\t      <button type=\"button\" class=\"loop\">Close popup</button>\r\n\t\t\r\n     \t\r\n\r\n    </div>\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"btn_quick\" style=\"display:none\">\r\n  <button type=\"button\" class=\"modal_open_close\"><span class=\"hide\">팝업버튼 닫기</span></button>\r\n  <button type=\"button\" class=\"modal_open\">POPUP</button>\r\n  <button type=\"button\" class=\"scroll_top\"><img src=\"/common-embd/images/common/arrow_scrollup.png\" alt=\"상단으로\"></button>\r\n</div>\r\n\r\n<link rel=\"stylesheet\" href=\"/common-embd/css/jquery-ui.min.css\" />\r\n<script src=\"/common-embd/js/jquery-ui.min.js\"></script>\r\n<script src=\"/common-embd/js/datepicker-ko.js\"></script>\r\n\r\n<script type=\"text/javascri