 String.fromCharCode((c & 63) | 128);\r\n\t            }\r\n\t        }\r\n\t        return utftext;\r\n\t    },\r\n\t\t_utf8_decode : function (utftext) {\r\n\t\t   var string = \"\";\r\n\t\t   var i = 0;\r\n\t\t   var c = c1 = c2 = 0;\r\n\t\r\n\t\t   while ( i < utftext.length ) {\r\n\t\r\n\t\t   c = utftext.charCodeAt(i);\r\n\t\r\n\t\t   if (c < 128) {\r\n\t\t   string += String.fromCharCode(c);\r\n\t\t   i++;\r\n\t\t   }\r\n\t\t   else if((c > 191) && (c < 224)) {\r\n\t\t   c2 = utftext.charCodeAt(i+1);\r\n\t\t   string += String.fromCharCode(((c & 31) << 6) | (c2 & 63));\r\n\t\t   i += 2;\r\n\t\t   }\r\n\t\t   else {\r\n\t\t   c2 = utftext.charCodeAt(i+1);\r\n\t\t   c3 = utftext.charCodeAt(i+2);\r\n\t\t   string += String.fromCharCode(((c & 15) << 12) | ((c2 & 63) << 6) | (c3 & 63));\r\n\t\t   i += 3;\r\n\t\t   }\r\n\t\t   }\r\n\t\t   return string;\r\n\t   },\r\n\t   URLEncode : function (string) {\r\n\t\treturn escape(this._utf8_encode(string));\r\n\t   },\r\n\t\t// public method for url decoding\r\n\t   URLDecode : function (string) {\r\n\t\treturn this._utf8_decode(unescape(string));\r\n\t\t}\r\n\t}\r\n\r\n\t/*********************************************************************************************************/\r\n\t/**                \t\t     \t           공    통\t \t\t  \t    \t\t**/\r\n\t/*********************************************************************************************************/\r\n\r\n\t/*\r\n\t* 회원 및 비회원 다수티켓 예매 선택창\r\n\t* key = '티켓키'\r\n\t* 회원 -> cf_LoginManyticket();\r\n\t* 비회원 -> 회원/비회원 선택창 호출\r\n\t*/\r\n\tfunction cf_Manyticketview_show(obj, key) {\r\n\t\tconsole.log(\"12\");\r\n\t\tconsole.log(key);\r\n\t\tif(viewType == 'app'){\r\n\t\tshowTcDialog(key);\r\n\t\t}else{\r\n\t\tif(\"\" == null || \"\" == ''){\r\n\t\tshowDialog(obj, '', 'layerPopMemType');\r\n\t\t}else {\r\n\t\tcf_LoginManyticket(key);\r\n\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// PC & Mobile 레이아웃 세팅\r\n\tfunction pf_setlayout(){\r\n\t\tconsole.log(\"13\");\r\n\t\tif(isDeviceType == \"\"){//모바일이 아닐경우\r\n\t\tconsole.log(\"\");\r\n\t\tcf_setP_layout();\r\n\t\t}else if(isDeviceType == \"1\"){//모바일일경우\r\n\t\tconsole.log(1);\r\n\t\tcf_setM_layout();\r\n\t\t}\r\n\t}\r\n\r\n\t//PC 티켓뷰어 조정\r\n\tfunction cf_display_setting(){\r\n\t\tconsole.log(\"14\");\r\n\t\tvar wi = 0;\r\n\t\tif($(window).width() > 960){\r\n\t\twi = ($(window).width() - 960) / 2;\r\n\t\t}\r\n\t\t$('#ticket_box').css(\"display\",\"block\");\r\n\t}\r\n\r\n\t//티켓모듈 호출\r\n\tfunction pf_ticketOpen(data, type, obj) {\r\n\t\tconsole.log(\"15\");\r\n\t\tif(type == 2) {  //비회원\r\n\t\tkeyurl = \"https://tkfront.acc.go.kr/mypage/tickets/list\";\r\n\t\t}else {\r\n\t\tkeyurl = \"https://tkfront.acc.go.kr/mypage/tickets/list\" + \"?langCd=ko&\" + data;\r\n\t\t}\r\n\r\n\t\tconsole.log(\"이곳으로 와\");\r\n\t\t/*새창으로 호출*/\r\n\t\tif(type == 1 && isDeviceType == \"1\" ){ //모바일일경우\r\n\t\tkeyurl = \"https://tkmfront.acc.go.kr/mypage/tickets/list\" + \"?langCd=ko&\" + data;\r\n\t\twindow.open(keyurl, '', 'width=1050, height=700, location=no, scrollbars=yes');\r\n\t\treturn;\r\n\t\t}\r\n\t\t/*레이어팝업*/\r\n\t\tif(type != 2) {\r\n\t\t$(\"#ticket_frame\").attr(\"src\", keyurl);\r\n\t\tshowDialog(obj, '', 'layerPop06');\r\n\t\treturn;\r\n\t\t}\r\n\t}\r\n\r\n\t//티켓모듈 호출 ACCF\r\n\tfunction pf_ticketOpenAccf(data, type, obj) {\r\n\t\tconsole.log(\"15\");\r\n\t\tif(type == 2) {  //비회원\r\n\t\tkeyurl = \"https://tkfront.accf.or.kr/mypage/tickets/list\";\r\n\t\t}else {\r\n\t\tkeyurl = \"https://tkfront.accf.or.kr/mypage/tickets/list\" + \"?langCd=ko&\" + data;\r\n\t\t}\r\n\r\n\t\tconsole.log(\"이곳으로 와\");\r\n\t\t/*새창으로 호출*/\r\n\t\tif(type == 1 && isDeviceType == \"1\" ){ //모바일일경우\r\n\t\tkeyurl = \"https://tkmfront.accf.or.kr/mypage/tickets/list\" + \"?langCd=ko&\" + data;\r\n\t\twindow.open(keyurl, '', 'width=1050, height=700, location=no, scrollbars=yes');\r\n\t\treturn;\r\n\t\t}\r\n\t\t/*레이어팝업*/\r\n\t\tif(type != 2) {\r\n\t\t$(\"#ticket_frame\").attr(\"src\", keyurl);\r\n\t\tshowDialog(obj, '', 'layerPop06');\r\n\t