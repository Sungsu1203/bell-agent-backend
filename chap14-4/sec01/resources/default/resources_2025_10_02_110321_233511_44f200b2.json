ooking/abooking.jsp\";\r\n\t\tticketCode = ticketKey; \r\n\t\tcf_NoLogin_pop_Manylecture();   \r\n\t} \r\n\t\r\n\t//다수예매 비회원예매\r\n\tfunction cf_NoLoginManylecture_open(ticketKey, lecture){ \r\n\t\tL_url \t\t= \"https://ticket.acc.go.kr/FrontMArte/booking/abooking.jsp\";\r\n\t\tticketCode = ticketKey; \r\n\t\tcf_NoLogin_pop_Manylecture_open(lecture);   \r\n\t} \r\n\t\r\n\tfunction cf_NoLogin_pop_Manylecture_open(lecture){\r\n\t\tvar data = '<div class=\"pop-container\"><div class=\"pop-conts\">';      \r\n\t\tdata += '<div><div class=\"ticket_account_title\">비 회원 강좌신청</div>';\r\n\t\tdata += '<a href=\"javascript:;\" class=\"ticket_cbtn\"><img src=\"/resources/asia/common/images/btn_close_gray.png\" alt=\"닫기\"></a></div> ';\r\n\t\tdata += '<div class=\"fl-account\">이름</div><div class=\"fr-account\"><input tabindex=\"1\" type=\"text\" class=\"full-input input-kr\" id=\"LC_name\" maxlength=\"50\" /></div>';\r\n\t\tdata += '<div class=\"fl-account\">이메일</div><div class=\"fr-account\"><input tabindex=\"3\" type=\"text\" class=\"full-input input-en\" id=\"LC_email\" maxlength=\"100\" /></div>';\r\n\t\tdata += '<div class=\"fl-account\">연락처</div><div class=\"fr-account\"><input tabindex=\"5\" type=\"tel\" class=\"input_3 input_tel\" id=\"LC_tel_1\" maxlength=\"3\" onKeyDown=\"return cf_only_Num(event);\"/>';\r\n\t\tdata += ' - <input tabindex=\"6\" type=\"tel\" class=\"input_4 input_tel\" id=\"LC_tel_2\" maxlength=\"4\" onKeyDown=\"return cf_only_Num(event);\"/> - ';\r\n\t\tdata += '<input tabindex=\"7\" type=\"tel\" class=\"input_4 input_tel\" id=\"LC_tel_3\" maxlength=\"4\" onKeyDown=\"return cf_only_Num(event);\"/></div>';\r\n\t\tdata += '<div tabindex=\"8\" class=\"fu-account\" onclick=\"cf_NoLogin_MainlectureAction_open(\\'' + lecture + '\\')\"><h3>신청하기</h3></div>';\r\n\t\tdata += '</div></div>';   \r\n\t\t \r\n\t\t$(\"#lecture_account_box\").fadeIn(\"slow\");  \r\n\t\t$(\"#lecture_account_box\").html(data);  \r\n\t\t\r\n\t\t\r\n\t\tvar temp = $(\"#lecture_account_box\");\r\n\t\t\r\n\t\t// 화면의 중앙에 레이어를 띄운다.\r\n\t\tif (temp.outerHeight() < $(document).height() ) temp.css('margin-top', '-'+temp.outerHeight()/2+'px');\r\n\t\telse temp.css('top', '0px');\r\n\t\tif (temp.outerWidth() < $(document).width() ) temp.css('margin-left', '-'+temp.outerWidth()/2+'px');\r\n\t\telse temp.css('left', '0px');\r\n\t\t\r\n\t\ttemp.find('a.ticket_cbtn').click(function(e){\r\n\t\t$(\"#lecture_account_box\").fadeOut();  \r\n\t\t});  \r\n\t\tpf_autoNextInput(); //전화번호 입력폼 자동으로 넘기기\r\n\t}\r\n\t\r\n\t\r\n\t\r\n\t//다수예매 비회원 팝업 화면 \r\n\tfunction cf_NoLogin_pop_Manylecture(){\r\n\t\tvar data = '<div class=\"pop-container\"><div class=\"pop-conts\">';      \r\n\t\tdata += '<div><div class=\"ticket_account_title\">비 회원 강좌신청</div>';\r\n\t\tdata += '<a href=\"javascript:;\" class=\"ticket_cbtn\"><img src=\"/resources/asia/common/images/btn_close_gray.png\" alt=\"닫기\"></a></div> ';\r\n\t\tdata += '<div class=\"fl-account\">이름</div><div class=\"fr-account\"><input tabindex=\"1\" type=\"text\" class=\"full-input input-kr\" id=\"LC_name\" maxlength=\"50\" /></div>';\r\n\t\tdata += '<div class=\"fl-account fl-date\">생년월일<br><span> 860101</span></div><div class=\"fr-account\"><input tabindex=\"2\" type=\"text\" class=\"full-input\" id=\"LC_birth\" maxlength=\"6\" onKeyDown=\"return cf_only_Num(event);\"/></div>';\r\n\t\tdata += '<div class=\"fl-account\">이메일</div><div class=\"fr-account\"><input tabindex=\"3\" type=\"text\" class=\"full-input input-en\" id=\"LC_email\" maxlength=\"100\" /></div>';\r\n\t\tdata += '<div class=\"fl-account\">성별</div><div class=\"fr-account\"><select tabindex=\"4\" class=\"full-select\" id=\"LC_gender\"><option value=\"M\">남성</option><option value=\"F\">여성</option></select></div>';\r\n\t\tdata += '<div class=\"fl-account\">연락처</div><div class=\"fr-account\"><input tabindex=\"5\" type=\"tel\" class=\"input_3 input_tel\" id=\"LC_tel_1\" maxlength=\"3\" onKeyDown=\"return cf_only_Num(event);\"/>';\r\n\t\tdata += ' - <input tabindex=\"6\" type=\"tel\" class=\"input_4 input_tel\" id=\"LC_tel_2\" maxlength=\"4\" onKeyDown=\"return cf_only_Num(event);\"/> - ';\r\n\t\tdata += '<input tabindex=\"7\" type=\"tel\" class=\"input_4 input_tel\" id=\"LC_tel_3\" maxlength=\"4\" onKeyDown=\"return cf_only_Num(event);\"/></div>';\r\n\t\tdata += '<div tabindex=\"8\" class=\"fu-account\" onclick=\"cf_NoLogin_MainlectureAction()\"><h3>신청하기</h3></div>';\r\n\t\tdata += '</div></div>';   \r\n\t\t \r\n\t\t$(\"#lecture_account_box\").fadeIn(\"slow\");  \r\n\t\t$(\"#lecture_account_box\").html(data);  \r\n\t\t\r\n\t\t\r\n\t\tvar temp = $(\"#lecture_account_box\");\r\n\t\t\r\n\t\t// 화면의 중앙에 레이어를 띄운다.\r\n\t\tif (temp.outerHeight() < $(document).height() ) temp.css('margin-top', '-'+temp.outerHeight()/2+'px');\r\n\t\telse temp.css('top', '0px');\r\n\t\tif (temp.outerWidth() < $(document).width() ) temp.css('margin-left', '-'+temp.outerWidth()/2+'px');\r\n\t\telse temp.css('left', '0px');\r\n\t\t\r\n\t\ttemp.find('a.ticket_cbtn').click(function(e){\r\n\t\t$(\"#lecture_account_box\").fadeOut();  \r\n\t\t});  \r\n\t\tpf_autoNextInput(); //전화번호 입력폼 자동으로 넘기기\r\n\t}\r\n  \r\n\t//다수티켓 비회원 예매 모듈 시작\r\n\tfunction cf_NoLogin_MainlectureAction(){\r\n\t\tif(pf_lecture_account_check()){\r\n\t\t\r\n\t\t$(\"#lecture_account_box\").fadeOut();\r\n\t\t\r\n\t\tvar key = ticketCode;\r\n\t\tticketCode = \"\";\r\n\t\tvar type = \"1\";\r\n\t\tvar name = $(\"#LC_name\").val();\r\n\t\tvar birth = $(\"#LC_birth\").val();\r\n\t\tvar email = $(\"#LC_email\").val();\r\n\t\tvar gender = $(\"#LC_gender\").val();\r\n\t\tvar tel = $(\"#LC_tel_1\").val() + $(\"#LC_tel_2\").val() + $(\"#LC_tel_3\").val();\r\n\t\tvar id = birth + gender + tel;\r\n\t\trlist = \"\";   // Y=예매확인, 값없이 넘김=예매하기\r\n\t\t \r\n\t\t/** 회원 세션정보 취득 **/\r\n\t\tuser_member_info1 = id + \"|\" + name + \"|\" + email + \"|\";\r\n\t\tuser_member_info1 = Base64.encode(user_member_info1); \r\n\t\t\r\n\t\tuser_member_info2 = Base64.encode(id + \"|\" + birth + \"|\" + tel +\"|000001||\");\r\n\t\t// user_member_info2 = Base64.encode(\"0|\" + birth + \"|\" + tel +\"|000001||\");\r\n\t\t$(\"html\").css(\"overflow-y\",\"hidden\");\t \r\n\t\tpf_ManylectureRequest(key, type);\r\n\t\t\r\n\t\t}else{\r\n\t\treturn false;\r\n\t\t}\r\n\t}\r\n\t\r\n\tfunction cf_NoLogin_MainlectureAction_open(lecture){\r\n\t\tif(pf_lecture_account_check_open()){\r\n\t\t\r\n\t\t$(\"#lecture_account_box\").fadeOut();\r\n\t\t\r\n\t\tvar key = ticketCode;\r\n\t\tticketCode = \"\";\r\n\t\tvar name = $(\"#LC_name\").val();\r\n\t\tvar email = $(\"#LC_email\").val();\r\n\t\tvar tel = $(\"#LC_tel_1\").val()+ \"-\" + $(\"#LC_tel_2\").val()+ \"-\"  + $(\"#LC_tel_3\").val();\r\n\t\t\r\n\t\t$(\"html\").css(\"overflow-y\",\"hidden\");\t \r\n\t\t$.ajax({\r\n\t\t    \ttype   : \"post\",   \r\n\t\t    \tdata   : \"OLM_NAME=\"+name+\"&OLM_EMAIL=\"+email+\"&OLM_PHONE=\"+tel+\"&OLM_LECTURE=\"+lecture, \r\n\t\t    url    : \"/Openlecture/insert\"\r\n\t\t}).done(function(result) {\r\n\t\tif(result == \"\"){\r\n\t\talert(\"오픈강좌 신청이 완료되었습니다.\");\r\n\t\t}else{\r\n\t\talert(\"다시 한번 신청해주세요\");\r\n\t\t}\r\n\t\t});\r\n\t\t}else{\r\n\t\treturn false;\r\n\t\t}\r\n\t}\r\n\t\r\n\t\r\n\t// 티켓 예매&발권 프로그램 호출\r\n\tfunction pf_ManylectureRequest(key, type){\r\n\t\t\r\n\t\t/** 데이터 **/\r\n\t\tvar data = \"ccode=\" + ccode + \"&locale=\" + locale + \"&rlist=\" + rlist \r\n\t\t+ \"&memberid=\" + memberid + \"&user_member_info1=\" + user_member_info1 + \"&user_member_info2=\" + user_member_info2 \r\n\t\t+ \"&wext=\" + wext + \"&wurl=\" + wurl + \"&pac=\" + pac +\"&app=1\";\r\n\t\t\r\n\t  \t\r\n\t  \tdata += \"&ticketcode=\" + key; //result;  \r\n\t  \tL_url = L_use_url + \"?\" + data;\r\n\t  \tkeyurl = L_url;\r\n// \t\talert(Base64.decode(user_member_info1));\r\n// \t\talert(Base64.decode(user_member_info2));\r\n\t  \tif(\"\" == \"1\"){\r\n\t  \t\twindow.open(L_url);\r\n\t  \t}else{\r\n\t\tprocedure(keyurl);\r\n\t  \t}\r\n\t}\r\n\t\r\n\tfunction pf_lecture_account_check_open(){\r\n\t\tif($(\"#LC_name\").val() == ''){\r\n\t\talert(\"이름을 입력하세요.\");    \r\n\t\treturn false;\r\n\t\t}\r\n\t\tif($(\"#LC_email\").val() == ''){\r\n\t\talert(\"이메일을 입력하세요.\");\r\n\t\treturn false;\r\n\t\t}\r\n\t\tvar re_mail = /^([\\w\\.-]+)@([a-z\\d\\.-]+)\\.([a-z\\.]{2,6})$/; // 이메일 검사\r\n\t\tif( re_mail.test($(\"#LC_email\").val()) == false ){\r\n\t\talert(\"잘못된 이메일 형식입니다.\");\r\n\t\treturn false;  \r\n\t\t} \r\n\t\tif($(\"#LC_tel_1\").val() == '' || $(\"#LC_tel_2\").val() == '' || $(\"#LC_tel_3\").val() == ''){\r\n\t\talert(\"연락처를 입력하세요.\");\r\n\t\treturn false;\r\n\t\t}  \r\n\t\treturn true;\r\n\t}\r\n\t\r\n\t\r\n\tfunction pf_lecture_account_check(){\r\n\t\tif($(\"#LC_name\").val() == ''){\r\n\t\talert(\"이름을 입력하세요.\");    \r\n\t\treturn false;\r\n\t\t}\r\n\t\tif($(\"#LC_birth\").val() == ''){\r\n\t\talert(\"생년월일을 입력하세요.\");\r\n\t\treturn false;\r\n\t\t}   \r\n\t\tif($(\"#LC_birth\").val().length < 6 ){\r\n\t\talert(\"생년월일을 6자리 숫자로 입력해주세요.\");\r\n\t\treturn false;\r\n\t\t} \r\n\t\tif($(\"#LC_email\").val() == ''){\r\n\t\talert(\"이메일을 입력하세요.\");\r\n\t\treturn false;\r\n\t\t}\r\n\t\tvar re_mail = /^([\\w\\.-]+)@([a-z\\d\\.-]+)\\.([a-z\\.]{2,6})$/; // 이메일 검사\r\n\t\tif( re_mail.test($(\"#LC_email\").val()) == false ){\r\n\t\talert(\"잘못된 이메일 형식입니다.\");\r\n\t\treturn false;  \r\n\t\t} \r\n\t\tif($(\"#LC_tel_1\").val() == '' || $(\"#LC_tel_2\").val() == '' || $(\"#LC_tel_3\").val() == ''){\r\n\t\talert(\"연락처를 입력하세요.\");\r\n\t\treturn false;\r\n\t\t}  \r\n\t\treturn true;\r\n\t}\r\n\t\r\n\t/*\r\n\t* 회원 및 비회원 다수티켓 예매 선택창  \r\n\t* key = '티켓키' \r\n\t*/\r\n\tfunction cf_Manylectureview_show(key) {  \r\n\t\tif(\"\" == null || \"\" == ''){\r\n\t\tif(confirm(\"로그인이 필요합니다. 확인 버튼을 누르시면 로그인페이지로 이동합니다.\" ) ){\r\n\t\tcf_LoginManylecture(key);\r\n\t\treturn;\r\n\t\t}else{  \r\n\t\treturn;\t\r\n\t\t} \r\n// \t\tvar data = '<div class=\"pop-container\"><div class=\"pop-conts\"> ';\r\n// \t\tdata += '<a href=\"javascript:;\" class=\"ticket_cbtn\"><img src=\"/resources/asia/common/images/btn_close_gray.png\" alt=\"\"></a></div> ';\r\n// \t\tdata += '<div class=\"ticket_wrap\"><div class=\"ticket_text\">원하시는 신청 방식을 선택하세요.</div><div class=\"ticket_box\">';  \r\n// \t\tdata += '<div class=\"ticket_login ticket_select\"><a href=\"javascript:;\" onclick=\"cf_LoginManylecture(\\'' + key + '\\')\">회원신청</a></div>';\r\n// \t\tdata += '<div class=\"ticket_nologin ticket_select\"><a href=\"javascript:;\" onclick=\"cf_NoLoginManylecture(\\'' + key + '\\')\">비회원신청</a></div>';\r\n// \t\tdata += '</div></div></div>'; \r\n\t\t  \r\n// \t\t$(\"#lecture_account_box\").fadeIn(\"slow\");    \r\n// \t\t$(\"#lecture_account_box\").html(data);      \r\n\t\t\r\n// \t\tvar temp = $(\"#lecture_account_box\");\r\n\t\t \r\n// \t\t// 화면의 중앙에 레이어를 띄운다.\r\n// \t\tif (temp.outerHeight() < $(document).height() ) temp.css('margin-top', '-'+temp.outerHeight()/2+'px');\r\n// \t\telse temp.css('top', '0px');\r\n// \t\tif (temp.outerWidth() < $(document).width() ) temp.css('margin-left', '-'+temp.outerWidth()/2+'px');\r\n// \t\telse temp.css('left', '0px');\r\n\t\t\r\n// \t\ttemp.find('a.ticket_cbtn').click(function(e){\r\n// \t\t$(\"#lecture_account_box\").fadeOut();  \r\n// \t\t}); \r\n\t\t\r\n// \t\t$(\".ticket_select\").on(\"click\", function(){\r\n// \t\t$(\"#lecture_account_box\").fadeOut(\"fast\");  \r\n// \t\t});\r\n\t\t}else {\r\n\t\tcf_LoginManylecture(key);   \r\n\t\t}\r\n\t} \r\n\t\r\n\t\r\n\tfunction cf_Manylectureview_show_open(key, lecture) {  \r\n\t\tif(\"\" == null || \"\" == ''){\r\n\t\tvar data = '<div class=\"pop-container\"><div class=\"pop-conts\"> ';\r\n\t\tdata += '<a href=\"javascript:;\" class=\"ticket_cbtn\"><img src=\"/resources/asia/common/images/btn_close_gray.png\" alt=\"닫기\"></a></div> ';\r\n\t\tdata += '<div class=\"ticket_wrap\"><div class=\"ticket_text\">원하시는 신청 방식을 선택하세요.</div><div class=\"ticket_box\">';  \r\n\t\tdata += '<div class=\"ticket_login ticket_select\"><a href=\"javascript:;\" onclick=\"cf_LoginManylecture(\\'' + key + '\\')\">회원신청</a></div>';\r\n\t\tdata += '<div class=\"ticket_nologin ticket_select\"><a href=\"javascript:;\" onclick=\"cf_NoLoginManylecture_open(\\'' + key + '\\', \\'' + lecture + '\\')\">비회원신청</a></div>';\r\n\t\tdata += '</div></div></div>'; \r\n\t\t  \r\n\t\t$(\"#lecture_account_box\").fadeIn(\"slow\");    \r\n\t\t$(\"#lecture_account_box\").html(data);      \r\n\t\t\r\n\t\tvar temp = $(\"#lecture_account_box\");\r\n\t\t \r\n\t\t// 화면의 중앙에 레이어를 띄운다.\r\n\t\tif (temp.outerHeight() < $(document).height() ) temp.css('margin-top', '-'+temp.outerHeight()/2+'px');\r\n\t\telse temp.css('top', '0px');\r\n\t\tif (temp.outerWidth() < $(document).width() ) temp.css('margin-left', '-'+temp.outerWidth()/2+'px');\r\n\t\telse temp.css('left', '0px');\r\n\t\t\r\n\t\ttemp.find('a.ticket_cbtn').click(function(e){\r\n\t\t$(\"#lecture_account_box\").fadeOut();  \r\n\t\t}); \r\n\t\t\r\n\t\t$(\".ticket_select\").on(\"click\", function(){\r\n\t\t$(\"#lecture_account_box\").fadeOut(\"fast\");  \r\n\t\t});\r\n\t\t}else {\r\n\t\tcf_LoginManylecture(key);   \r\n\t\t}\r\n\t} \r\n\t\r\n\t\r\n\tfunction call_cf_Login_ManylectureAction(ticketKey){\r\n\t\t$(\"#ticket_mobile_appcheckbox\").fadeOut();  \r\n\t\tif(\"\" == null || \"\" == ''){\r\n\t\tlocation.href=\"/main/login.do?PID=9902\";\t \r\n\t\treturn false; \r\n\t\t}else{  \r\n\t\tcf_LoginManylectureAction(ticketKey);\r\n\t\t}\r\n\t} \r\n\t\r\n \t//PC 티켓뷰어 조정\r\n\tfunction cf_display_setting_lecture(){\r\n\t\tvar wi = 0;\r\n\t  \tif($(window).width() > 960){\r\n\t  \t\twi = ($(window).width() - 960) / 2; \r\n\t  \t}\r\n\t  \t$('#lecture_box').css(\"display\",\"block\"); \r\n\t}\r\n\t\r\n\t//강좌 화면 제거\r\n\tfunction cf_LectureExit(){  \r\n\t\t$(\"html\").css(\"overflow-y\",\"\"); \r\n\t\t$('#lecture_box').css(\"display\",\"none\"); \r\n\t\t$(\"#lecture_frame\").attr(\"src\",\"\");\r\n\t}\r\n\t\r\n\tfunction cf_setM_layout_lecture(){\r\n\t\t$('#lecture_box').css(\"width\",\"100%\");\r\n\t\t$('#lecture_box').css(\"height\",\"100%\");\r\n\t\t$('#lecture_box').css(\"margin-left\",\"0\");\r\n\t\t$('#lecture_box').css(\"margin-top\",\"0\");\r\n\t\t$('#lecture_box').css(\"min-width\",\"100%\");\r\n\t\t$('#lecture_box').css(\"min-height\",\"100%\");\r\n\t\t$('#lecture_box').css(\"top\",\"0px\");\r\n\t\t$('#lecture_box').css(\"left\",\"0px\");\r\n\t\t$('#lecture_frame').css(\"margin\",\"0\");\r\n\t\t$('#lecture_frame').css(\"top\",\"50px\"); \r\n\t\t$('#lecture_frame').css(\"left\",\"0px\");\r\n\t\t$('#lecture_frame').css(\"width\",\"100%\");\r\n\t\t$('#lecture_frame').css(\"height\",\"100%\");\r\n\t\t$(\"html\").css(\"overflow-y\",\"scroll\"); \r\n\t}\r\n\t\r\n</script>  \r\n\r\n<!--\r\n<div id=\"lecture_box\"> \r\n\t<a href=\"javascript:;\" onclick=\"cf_LectureExit()\">Exit</a> \r\n\t<div>\r\n\t</div>\r\n\t<iframe name=\"fls_iframe_lecture\" id=\"lecture_frame\" style=\"border:none;\"  title=\"예매모듈\"></iframe>\r\n</div> \r\n<div id=\"lecture_account_box\" >\r\n</div>\r\n-->\r\n<div class=\"quickNav\">\r\n\t\t<ul>\r\n\t\t<li class=\"q1\"><a href=\"/en/search.do?PID=9008\">Search</a></li>\r\n\t\t<li class=\"q3\"><a href=\"/en/contents.do?PID=09010101\">Locations</a></li>\r\n\t\t<li class=\"q2\"><a href=\"/en/contents.do?PID=090201\">ACC Tours</a></li>\r\n\t\t<li class=\"q5\"><a href=\"/en/contents.do?PID=090301\">Booking</a></li>\r\n\t\t<li class=\"q6\"><a href=\"/en/contents.do?PID=090202\">Opening Hours</a></li>\r\n\t\t<li class=\"q7\"><button type=\"button\" class=\"btnTop\"><span>TOP</span></button></li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</div><!-- main -->\r\n\r\n\t\t<footer id=\"footer\">\r\n\t\t<!-- <div class=\"footerItems\">\r\n                    <div class=\"itemWrap\">\r\n                        <div class=\"accContactus\">\r\n                            <div class=\"left\">\r\n                                <p class=\"tit\">Call Center <a href=\"tel:1899-5566\">+82-1899-5566 (UTC+9 09:00~18:00)</a></p>\r\n                                <p class=\"tit2\">Closed on Mondays</p>\r\n                            </div>\r\n                            <div class=\"right\">\r\n                                <p class=\"cont\">평일 업무시간 09:00 ~ 18:00</p>\r\n                                <p class=\"cont\">예매 업무시간 09:00 ~ 17:00</p>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"accSns\">\r\n                            <p class=\"itemTit\">ACC SNS<span>바로가기</span></p>\r\n                            <ul>\r\n                                <li><a href=\"https://www.facebook.com/asiaculturecenter/\" target=\"_blank\"><img src=\"/include/main/images/common/icon_social_facebook.png\" alt=\"페이스북\"></a></li>\r\n                                <li><a href=\"https://twitter.com/WeloveACC\" target=\"_blank\"><img src=\"/include/main/images/common/icon_social_twitter.png\" alt=\"트위터\"></a></li>\r\n                                <li><a href=\"https://www.youtube.com/channel/UCdSyGG-j_ORzUBS_VuUU4zQ\" target=\"_blank\"><img src=\"/include/main/images/common/icon_social_youtube.png\" alt=\"유튜브\"></a></li>\r\n                                <li><a href=\"https://blog.naver.com/asiaculturecenter\" target=\"_blank\"><img src=\"/include/main/images/common/icon_social_blog.png\" alt=\"네이버블로그\"></a></li>\r\n                                <li><a href=\"https://www.instagram.com/asiaculturecenter/\" target=\"_blank\"><img src=\"/include/main/images/common/icon_social_instagram.png\" alt=\"인스타그램\"></a></li>\r\n                            </ul>\r\n                        </div>\r\n                        <div class=\"accQr\">\r\n                            <p class=\"itemTit\">ACC 안내앱<span>다운로드</span></p>\r\n                            <p class=\"img\"><img src=\"/include/main/images/common/img_acc_qr.jpg\" alt=\"ACC 안내앱 QR코드\"></p>\r\n                        </div>\r\n                        <p class=\"btnFtTop\"><a href=\"javascript:;\" title=\"상단으로 이동\"><img src=\"/include/main/images/common/icon_top.png\" alt=\"TOP\"></a></p>\r\n                    </div>\r\n                </div> -->\r\n\t\t<div class=\"footerWrap clearfix\">\r\n\t\t<p class=\"ftLogo\"><a href=\"/en/index.do\"><img src=\"/include/en/images/main/logo_footer.png\" alt=\"Ministry of Culture, Sports and Tourism. Asia Culture Center\"></a></p>\r\n                    <div class=\"ftInfo\">\r\n                        <p>Copyright(C) National Asian Culture Center. All rights reserved</p>\r\n                        <address>38 Munhwajeondang-ro, Dong-gu, Gwangju 61485, Republic of Korea</address>\r\n                    </div>\r\n\t\t</div>\r\n\t\t</footer>\r\n\t\t<div class=\"overlayBg\"></div>\r\n\t\t</div>\r\n\r\n\t<!--웹진구독-->\r\n\t\t<div id=\"webzineLayer\" class=\"webzineLayer\" tabindex=\"-1\" >\r\n\t\t<div class=\"layerWrap\">\r\n\t\t<div class=\"layerBox\">\r\n\t\t<div class=\"webzineCon\">\r\n\t\t<div class=\"topTxt\">\r\n\t\t<p class=\"tit\"><img src=\"/include/main/images/common/img_webzine_tit.png\" alt=\"ACC WEBZINE\"></p>\r\n\t\t<p class=\"stit\">웹진 구독하기</p>\r\n\t\t</div>\r\n\t\t<form onsubmit=\"return fn_registNewsletter(this)\">\r\n\t\t<div class=\"webzineTxt\">\r\n\t\t<p>개인정보 수집 및 활용 동의가 필요합니다.</p>\r\n\t\t<p class=\"tit\">수집내용</p>\r\n\t\t<ol>\r\n\t\t<li><span class=\"num\">1.</span> 수집이용목적: ‘웹진ACC’ 발송</li>\r\n\t\t<li><span class=\"num\">2.</span> 수집항목: 이메일 주소</li>\r\n\t\t<li><span class=\"num\">3.</span> 보유(이용)기간: 2년</li>\r\n\t\t<li><span class=\"num\">4.</span> 동의거부에 따른 불이익:<br />\r\n\t\t개인정보 수집 동의를 거부하실 수 있습니다. 다만,<br />\r\n\t\t동의하지 않을 경우 ‘웹진ACC’를 받아보실 수 없습니다.<br />\r\n\t\t개인정보는 위 수집·이용 목적 이외의 다른 목적으로 \r\n\t\t사용하지 않습니다.</li>\r\n\t\t</ol>\r\n\t\t<p class=\"guide\">웹진을 포함한 국립아시아문화전당(ACC) DM발송은 ACC홈페이지 \r\n\t\t회원가입을 통해 받아보실 수 있습니다.</p>\r\n\t\t<div class=\"inputBox\">\r\n\t\t<input type=\"checkbox\" id=\"lblwebzineAgreeCheck\" name=\"webzineAgreeCheck\" class=\"checkBox\" />\r\n\t\t<label for=\"lblwebzineAgreeCheck\">개인정보 수집에 동의하십니까?</label>\r\n\t\t<input type=\"text\" class=\"text\" name=\"webzineEmail\" placeholder=\"acc웹진을 받아보실 이메일을 입력해 주세요.\" title=\"이메일 입력\" />\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<p class=\"btnApply\"><button type=\"submit\">구독신청</button></p>\r\n\t\t</form>\r\n\t\t</div>\r\n\t\t<p class=\"layerClose\"><button type=\"button\" onclick=\"hideDialog(this, 'webzineLayer');\"><span>닫기</span></button></p>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<!--//웹진구독-->\r\n\r\n\t\t<!--웹진구독-->\r\n\t\t<div id=\"bunchLayer\" class=\"webzineLayer\" tabindex=\"-1\" >\r\n\t\t<div class=\"layerWrap\">\r\n\t\t<div class=\"layerBox\">\r\n\t\t<div class=\"webzineCon\">\r\n\t\t<div class=\"topTxt\">\r\n\t\t<p class=\"tit\"></p>\r\n\t\t<p class=\"stit\">ACC 집콕꾸러미 온라인 이벤트</p>\r\n\t\t</div>\r\n\t\t<form onsubmit=\"return fn_replyCmtCheckAp(this)\">\r\n\t\t<div class=\"webzineTxt\">\r\n\t\t<p>확인된 정보가 일치하는지 확인하여 주시고 참여해주시기 바랍니다.</p>\r\n\t\t<p class=\"tit\">정보확인</p>\r\n\t\t<ol>\r\n\t\t<li>이름: [미등록]</li>\r\n\t\t<li>연락처: [미등록]</li>\r\n\t\t<li>주소: [미등록]</li>\r\n\t\t</ol>\r\n\t\t<div class=\"inputBox\">\r\n\t\t<input type=\"checkbox\" id=\"lblbunchAgreeCheck\" name=\"bunchAgreeCheck\" class=\"checkBox\" />\r\n\t\t<label for=\"lblbunchAgreeCheck\">개인정보 수집에 동의하십니까?</label>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<p class=\"btnApply2\">\r\n\t\t<button type=\"submit\">이벤트참여</button>\r\n\t\t<button type=\"button\" class=\"revb\" onclick=\"return fn_replyCmtCheckUs()\">정보수정하기</button>\r\n\t\t</p>\r\n\t\t</form>\r\n\t\t</div>\r\n\t\t<p class=\"layerClose\"><button type=\"button\" onclick=\"hideDialog(this, 'bunchLayer');\"><span>닫기</span></button></p>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<!--//웹진구독-->\r\n\r\n\t\t<script type=\"text/javascript\">\r\n\t\t//<![CDATA[\r\n\t\t//이메일 유효성 검사\r\n\t\tfunction pf_emailCheck(email) {\r\n\t\tvar re = /([\\w-\\.]+)@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.)|(([\\w-]+\\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\\]?)$/;\r\n\t\tif(re.test(email)){\r\n\t\treturn true;\r\n\t\t}else{\r\n\t\treturn false;\r\n\t\t}\r\n\t\t}\r\n\t\tfunction fn_registNewsletter(frm){\r\n\t\tif(frm.webzineAgreeCheck.checked == false){\r\n\t\talert(\"개인정보 수집에 동의해 주시기 바랍니다.\");\r\n\t\tfrm.webzineAgreeCheck.focus();\r\n\t\treturn false;\r\n\t\t}\r\n\t\tif(frm.webzineEmail.value.trim() == \"\"){\r\n\t\tfrm.webzineEmail.value = frm.webzineEmail.value.trim();\r\n\t\talert(\"이메일을 입력해 주시기 바랍니다.\");\r\n\t\tfrm.webzineEmail.focus();\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\tif(!pf_emailCheck(frm.webzineEmail.value)){\r\n\t\talert(\"잘못된 형식의 이메일입니다.\");\r\n\t\tfrm.webzineEmail.focus();\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\t$.ajax({\r\n\t\ttype : \"POST\",\r\n\t\tdata: \"webzineEmail=\" + frm.webzineEmail.value,   \r\n\t\turl : \"/otherService/newsletter/action.do\",\r\n\t\tsuccess : function(data) { \r\n\t\tif (data == '0000') {\r\n\t\thideDialog('', 'webzineLayer');\r\n\t\talert(\"웹진신청이 완료되었습니다.\");\r\n\t\t} else if (data == 'LT01') {\r\n\t\talert(\"이미 등록된 이메일 입니다.\");\r\n\t\t} else {\r\n\t\talert(\"등록중 오류가 발생했습니다.\");\r\n\t\t}\r\n\t\t}  \r\n\t\t});\r\n\t\treturn false;\r\n\t\t}\r\n\t\t//]]>\r\n\t\t</script>\r\n\r\n\t\t<script>\r\n\t\tfunction fn_replyCmtCheck(){\r\n\t\tif(\"\" == null || \"\" == ''){\r\n\t\talert(\"로그인이 필요합니다.\");\r\n\t\tif(lang == 'ko'){\r\n\t\tdocument.location.href = \"/api/sso/goLogin.do\";\r\n\t\t}else{\r\n\t\tdocument.location.href = \"/\" + lang + \"/login.do?PID=9901\";\r\n\t\t}\r\n\t\treturn false;\r\n\t\t}\r\n\t\tshowDialog($(\".link_btngo\"), 'block', 'bunchLayer');\r\n\t\treturn false;\r\n\t\t}\r\n\t\tfunction fn_replyCmtCheckUs(){\r\n\t\tif(lang == 'ko'){\r\n\t\tdocument.location.href=\"/main/memberInfo.do?PID=9801\";\r\n\t\t}else{\r\n\t\tdocument.location.href=\"/\"+lang+\"/memberInfo.do?PID=9801\";\r\n\t\t}\r\n\t\t}\r\n\t\tfunction fn_replyCmtCheckAp(frm){\r\n\t\tif(frm.bunchAgreeCheck.checked == false){\r\n\t\talert(\"개인정보 수집에 동의해 주시기 바랍니다.\");\r\n\t\tfrm.bunchAgreeCheck.focus();\r\n\t\treturn false;\r\n\t\t}\r\n\t\t$.ajax({\r\n\t\t    url: \"/otherService/replyCmt/write.do\",\r\n\t\t    type: \"POST\",\r\n\t\tdata : {\r\n\t\trmKeyno:\"RM_0000000001\"\r\n\t\t},\r\n\t\tsuccess : function(rtn){ \r\n\t\talert(rtn.message);\r\n\t\treturn false;\r\n\t\t}\r\n\t\t});\r\n\t\thideDialog($(\".link_btngo\"), 'bunchLayer');\r\n\t\treturn false;\r\n\t\t}\r\n\t\t</script>\r\n</div>\r\n\r\n\t<script type=\"text/javascript\">\r\n\t$(document).ready(function(){\r\n\t\r\n\r\n\t});\r\n\t\r\n// 공연 목록 조회\r\nfunction fn_exhibitionList(){\r\n\t$.ajax({\r\n\t\turl: 'performance.json',\r\n\t\ttype: \"POST\",\r\n\t\tdataType: \"json\",\r\n\t\tdata: $(\"#performanceForm\").serialize(),\r\n\t\tsuccess: function(data){\r\n\t\t\r\n\t\t}\r\n\t});\r\n}\r\n\r\n//페이징\r\nfunction fnLinkPage(pageIndex){\r\n\t$('#performanceForm').children('input[name=action]').prop('value', 'List');\r\n\t$(\"#performanceForm input[name=pageIndex]\").val(pageIndex);\r\n\t$(\"#performanceForm\").submit();\r\n\treturn false;\r\n}\r\n\r\n//티켓 key 확인\r\nfunction fn_memberTicket(){\r\n\tvar ticketkey = $(\".botBtn>.reserv\").find(\"button\").attr(\"data-ticket\");\r\n\tcf_LoginManyticket(ticketkey);\r\n}\r\nfunction fn_anonyTicket(){\r\n\t\r\n}\r\n\r\nvar alertMsgLogin;\r\nif(lang == 'ko'){\r\n\talertMsgLogin = \"로그인 페이지로 이동하시겠습니까?\";\r\n}else if(lang == 'en'){\r\n\talertMsgLogin = \"Do you want to proceed to the log-in page?\";\r\n}else  if(lang == 'jp'){\r\n\talertMsgLogin = \"ログインページに移動しますか\";\r\n}else  if(lang == 'zh'){\r\n\talertMsgLogin = \"确认前往登录页面吗？\";\r\n}else  if(lang == 'ru'){\r\n\talertMsgLogin = \"Вы хотите перейти на страницу входа в систему?\";\r\n}else {\r\n\talertMsgLogin = \"هل تريد الانتقال إلى صفحة تسجيل الدخول؟\";\r\n}\r\n\r\n// 내 목록 담기\r\n$(document).on(\"click\", \".botBtn>.myBasket>button\", function(){\r\n\t$.ajax({\r\n\t\ttype : \"POST\",\r\n\t\tdata: {\"em_keyno\": $(this).attr(\"data\"), \"lang\": lang },\r\n\t\turl : \"/otherService/myEvent/action.do\",\r\n\t\tsuccess : function(data) {\r\n\t\tswitch(data.resCode){\r\n\t\tcase \"NEED_LOGIN\":\r\n\t    \t\tvar qYN = confirm(data.resMSG+\"\\n\"+alertMsgLogin);\r\n\t    \t\tif ( qYN ){\r\n\t    \t\tlocation.href = \"/\"+loginSiteCode(lang)+ \"/login.do?PID=9901\";\r\n\t    \t\t}\r\n\t\tbreak;\r\n\t\tdefault:\r\n\t\talert(data.resMSG);\r\n\t\tbreak;\r\n\t\t}\r\n\t\t}\r\n\t});\r\n});\r\n\r\nvar alertMsgBtnNo, alertMsgBtnStd, alertMsgBtnSold, alertMsgBtnClose, alertMsgBtnLink;\r\nif(lang == 'en'){\r\n\talertMsgBtnNo = \"To book tickets, please select the date, time, and price.\";\r\n\talertMsgBtnStd = \"Tickets for this program are not available for booking at the moment. Thank you.\";\r\n\talertMsgBtnSold = \"Tickets for this program are sold out. Thank you for your interest.\";\r\n\talertMsgBtnClose = \"Booking for this program has ended. Thank you.\";\r\n\talertMsgBtnLink = \"Visit the booking website.\";\r\n}else  if(lang == 'jp'){\r\n\talertMsgBtnNo = \"ご予約の日付/時間/金額を選択してください。\";\r\n\talertMsgBtnStd = \"当該予約は待機中です。ありがとうございました。\";\r\n\talertMsgBtnSold = \"当該予約は売り切れました。ご関心をお寄せいただき、ありがとうございました。\";\r\n\talertMsgBtnClose = \"当該予約は終了しました。ありがとうございました。\";\r\n\talertMsgBtnLink = \"ご予約サイトへ\";\r\n}else  if(lang == 'zh'){\r\n\talertMsgBtnNo = \"请选择预购日期/时间/金额。\";\r\n\talertMsgBtnStd = \"暂不支持预购，谢谢。\";\r\n\talertMsgBtnSold = \"预购已售罄，谢谢关注。\";\r\n\talertMsgBtnClose = \"预购已结束，谢谢。\";\r\n\talertMsgBtnLink = \"前往预购网站。\";\r\n}else  if(lang == 'ru'){\r\n\talertMsgBtnNo = \"Выберите дату/время/стоимость бронирования билета.\";\r\n\talertMsgBtnStd = \"Заявка на бронирование в процессе обработки. Спасибо.\";\r\n\talertMsgBtnSold = \"Все билеты распроданы. Благодарим за оказанный интерес.\";\r\n\talertMsgBtnClose = \"Период бронирования истек. Благодарим за внимание.\";\r\n\talertMsgBtnLink = \"Осуществляется переход на страницу бронирования.\";\r\n}else  if(lang == 'ar'){\r\n\talertMsgBtnNo = \"يرجى تحديد التاريخ / الموعد / السعر للحجز.\";\r\n\talertMsgBtnStd = \"سيبدأ الحجز الح قا. شكرا لك م.\";\r\n\talertMsgBtnSold = \"تم بيع كل التذاكر. شكرا لكم على اهتمام اتكم.\";\r\n\talertMsgBtnClose = \"تم انتهاء هذا الحجز. شكرا لكم.\";\r\n\talertMsgBtnLink = \"سيتم االنتقال إلى موقع الحجز.\";\r\n}else {\r\n\talertMsgBtnNo = \"예매 날짜/시간/금액을 선택하세요.\";\r\n\talertMsgBtnStd = \"해당 예매는 대기중입니다. 감사합니다.\";\r\n\talertMsgBtnSold = \"해당 예매는 매진되었습니다. 많은 관심 감사합니다.\";\r\n\talertMsgBtnClose = \"해당 예매는 종료되었습니다. 감사합니다.\";\r\n\talertMsgBtnLink = \"예매 사이트로 이동합니다.\";\r\n}\r\n\r\n// 내 목록 보기\r\n$(document).on(\"click\", \".botBtn>.myView>button\", function(){\r\n\tdocument.location.href = \"/\"+loginSiteCode(lang)+ \"/memberReservation.do?PID=9803\";\r\n});\r\n\r\n//미선택시 안내\r\n$(document).on(\"click\", \".botBtn>.chooseNo>button\", function(){\r\n\talert(alertMsgBtnNo);\r\n});\r\n//취소된 공연 안내\r\n$(document).on(\"click\", \".botBtn>.chooseCancel>button\", function(){\r\n\t//alert(alertMsgBtnCancel);\r\n});\r\n//대기 : A\r\n$(document).on(\"click\", \".botBtn>.chooseStd>button\", function(){\r\n\talert(alertMsgBtnStd);\r\n});\r\n//시작 : B\r\n$(document).on(\"click\", \".botBtn>.chooseBook>button\", function(){\r\n\tvar tickettype = $(\".botBtn>.reserv\").find(\"button\").attr(\"data-type\");\r\n\tvar ticketkey = $(\".botBtn>.reserv\").find(\"button\").attr(\"data-ticket\");\r\n\tticketCode = ticketkey;\r\n\r\n\tswitch(tickettype){\r\n\tcase \"cf_Manyticketview_show\":\r\n\t\tcf_Manyticketview_show($(this), ticketkey);\r\n\t\tbreak;\r\n\tcase \"pf_group_receipt\":\r\n\t\tpf_group_receipt(this);\r\n\t\tbreak;\r\n\tcase \"cf_LoginManylecture\":\r\n\t\tcf_LoginManylecture(ticketkey, '');\r\n\t\tbreak;\r\n\tdefault:\r\n\t\tbreak;\r\n\t}\r\n});\r\n//시작 : B\r\n$(document).on(\"click\", \".botBtn>.chooseBook2>button\", function(){\r\n\tvar ticketstr = $(\".botBtn>.reserv\").find(\"button\").attr(\"data-str\");\r\n\tvar tickettype = $(\".botBtn>.reserv\").find(\"button\").attr(\"data-type\");\r\n\tvar ticketkey = $(\".botBtn>.reserv\").find(\"button\").attr(\"data-ticket\");\r\n\tif(ticketstr != \"\"){\r\n\t\talert(ticketstr);\r\n\t}\r\n});\r\n//매진 : C\r\n$(document).on(\"click\", \".botBtn>.chooseSold>button\", function(){\r\n\talert(alertMsgBtnSold);\r\n});\r\n//종료 : D\r\n$(document).on(\"click\", \".botBtn>.chooseClose>button\", function(){\r\n\talert(alertMsgBtnClose);\r\n});\r\n//링크\r\n$(document).on(\"click\", \".botBtn>.chooseLink>button\", function(){\r\n\tif($(\".reservChoice\").find(\"span:eq(1)\").attr(\"data\") == \"chooseLink\"){\r\n\t\tvar linkSite = $(\".reservChoice\").find(\"span:eq(1)\").attr(\"data-link\");\r\n\t\tif(confirm(alertMsgBtnLink + \"\\n\" + linkSite)){\r\n\t\twindow.open(linkSite);\r\n\t\t}\r\n\t}\r\n});\r\n\r\n\t// 로그인 상태 확인\r\n\tvar loginStatus = \"false\";\r\n\t</script>\r\n\r\n\t<!-- SNS 공유용 -->\r\n\t<input type=\"hidden\" id=\"lblSnsImage\" value=\"\" />\r\n\t<input type=\"hidden\" id=\"lblSnsDesc\" value=\"\" />\r\n\t<div id=\"kakaoLinkBtn\"></div>\r\n\r\n\t<script src=\"/include/main/js/kakao.min.js\"></script>\r\n\t<script type=\"text/javascript\">\r\n\tvar snsUrl = document.URL;\r\n\tvar snsDesc = $(\"#lblSnsDesc\").val();\r\n\tvar snsImage = $(\"#lblSnsImage\").val();\r\n\tif(snsDesc == \"\"){\r\n\t\tsnsDesc = $(document).attr(\"title\");\r\n\t}\r\n\twindow.onload=function(){\r\n\t\tKakao.init('ad39f96ab5a2f393088ed7c42106e2be');\r\n\t\tKakao.Link.createTalkLinkButton({\r\n\t\tcontainer: '#kakaoLinkBtn',\r\n\t\tlabel: snsDesc,\r\n\t\timage: {\r\n\t\tsrc: snsImage,\r\n\t\twidth: '300',\r\n\t\theight: '200'\r\n\t\t},\r\n\t\twebButton: {\r\n\t\ttext: '링크 바로가기',\r\n\t\turl: snsUrl\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t</script>\r\n\r\n</body>\r\n</html>",
