i><a href=\"/en/contents.do?PID=0702\">President's Message</a>\n</li>\n<li><a href=\"/en/contents.do?PID=0703\">History</a>\n</li>\n<li><a href=\"/en/contents.do?PID=0704\">About the Facilities</a>\n</li>\n<li><a href=\"/en/contents.do?PID=0705\">ACC Wordmark</a>\n</li>\n<li><a href=\"/en/contents.do?PID=0706\">ACC Logo Song</a>\n</li>\n</ul>\n</div>\n</div>\n</li>\n</ul></nav>\n<div class=\"btnSiteMap\"><a href=\"/en/siteMap.do?PID=9003\">Site Map</a></div>\r\n\t\t</header>\r\n\t\t<div id=\"main\">\r\n\t\t<div class=\"locationWrap\">\r\n\t\t<nav class=\"siteLocation\">\r\n\t\t<p class=\"home\"><a href=\"/en/index.do\">HOME</a></p>\r\n\t\t<ul>\r\n\t\t<li class=\"lkList death1\">\r\n\t\t<h2><button type=\"button\"><span>Schedule</span></button></h2>\r\n\t\t<div><ul><li><a href=\"/en/contents.do?PID=0101\"><span>About</span></a></li><li class='active'><a href=\"/en/performance.do?PID=0102\"><span>Schedule</span></a></li></ul></div></li>\r\n\t\t</ul>\r\n\t\t</nav>\r\n\t\t</div>\r\n\t\t<article id=\"content\">\r\n\r\n<div class=\"scheduleView\">\r\n\t<div class=\"scheduleViewTop\">\r\n\t\t<div class=\"topTxt\">\r\n\t\t<h4>[ACC June Brunch Concert]<br>\r\nMayTree, Summer\r\n</h4>\r\n\t\t<p class=\"addTxt\">2024 ACC Brunch Concert, “The Fifth Story,” in June<br>\r\nMayTree, Korea’s top a cappella group, is the Korean Wave of a cappella music!\r\n</p>\r\n\t\t</div>\r\n\t\t<div class=\"poster\">\r\n\t\t<img src=\"/resources/upload/1771/20240516134332_900857312.jpg\" alt=\"[ACC June Brunch Concert]&lt;br&gt;\r\nMayTree, Summer\r\n\">\r\n\t\t</div>\r\n\t\t<div class=\"detailTxt\">\r\n\t\t<ul class=\"txtList\">\r\n\t\t<li><em>Date</em><span>Jun. 26, 2024 (WED)</span></li>\r\n\t\t<li><em>Time</em><span>11:00–12:20 (Approx.80min) </span></li>\r\n\t\t<li><em>Place</em><span>Theater 2</span></li>\r\n\t\t<li><em>Age Limit</em><span>Entry allowed for those ages 7 or older ※ Born in 2017 or earlier</span></li>\r\n\t\t<li><em>Seating</em><span>466 seats</span></li>\r\n\t\t<li>\r\n\t\t<em>Price</em>\r\n\t\t<span>\r\n\t\tR seat KRW 30,000 / S seat KRW 20,000<!--\r\n\t\t<button type=\"button\" class=\"moreDiscout\" onclick=\"showDialog(this, '', 'layerPopDiscount2'); return false;\" role=\"button\">Discount Benefits +</button>-->\r\n\t\t</span>\r\n\t\t</li>\r\n\t\t<li><em>Ticket</em><span>Foundation Website / Call Center / Ticket Booth </span></li>\r\n\t\t<li><em>Contact</em><span>+82-1899-5566</span></li>\r\n\t\t<li><em>Information</em><span>Tickets are available on the Foundation’s website at 10:00 on Apr. 30, 2024 (TUE)<br>\r\n<span style='color:#df094c;'>※ Guest bookings for foundation-sponsored shows can only be made and canceled through the foundation’s website</span></span></li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t<div class=\"scheduleBtn\">\r\n\t\t<div class=\"reservList\">\r\n\t\t<p class=\"reservBtn\"><button type=\"button\">To book tickets, please select the date, time, and price.</button></p>\r\n\t\t<ul class=\"reservList1\">\r\n\t\t<li><a href=\"#\"><!-- 티켓 키 값 ftRow.ECF_TC1 -->\r\n\t\t<span class=\"txt\">\r\n\t\t 2024-06-26 (WED) 11:00  </span>\r\n\t\t<span data=\"chooseClose\" data-str=\"end\"></span>\r\n\t\t<span class=\"state end\">end</span>\r\n\t\t</a></li>\r\n\t\t</ul>\r\n\t\t<div class=\"reservChoice\" style=\"background: #f8f8f8;\"></div>\r\n\t\t</div>\r\n\t\t<ul class=\"botBtn\">\r\n\t\t<li class=\"reserv chooseNo\"><button type=\"button\"><i></i>Get tickets</button></li>\r\n\t\t<li class=\"myBasket\"><button type=\"button\" data=\"EM_0000007314\"><i></i>Add to my list</button></li>\r\n\t\t<li class=\"myView\"><button type=\"button\"><i></i>My List</button></li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t</div>\r\n\t<script>\r\n\t$(window).on('load',function() {\r\n\t//$(document).ready(function() {\r\n\t\tvar reBtn, reList, reHtml\r\n\t\t$('.reservBtn>button').on('click', function() {\r\n\t\treBtn = $(this).parent();\r\n\t\treList = reBtn.next('ul');\r\n\t\tif(reBtn.hasClass('on')) {\r\n\t\treBtn.removeClass('on');\r\n\t\treList.hide();\r\n\t\t} else {\r\n\t\treBtn.addClass('on');\r\n\t\treList.show();\r\n\t\t}\r\n\t\t});\r\n\t\t$('.reservList ul a').on('click', function() {\r\n\t\treHtml = $(this).children().clone();\r\n\t\t$('.reservChoice').html(reHtml).show();\r\n\t\t$('.reservChoice').find(\"span:eq(2)\").remove();\r\n\r\n\t\t// classes search\r\n\t\tvar dataStr = $(this).find(\"span:eq(1)\").attr(\"data-str\");\r\n\t\tdataStr = fn_button_strClear(dataStr);\r\n\t\tif(dataStr != \"\") {\r\n\t\t$(\".botBtn>.reserv\").removeClass().addClass(\"reserv\").addClass($(this).find(\"span:eq(1)\").attr(\"data\"));\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-str\", dataStr);\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-type\", $(this).find(\"span:eq(1)\").attr(\"data-type\"));\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-ticket\", $(this).find(\"span:eq(1)\").attr(\"data-ticket\"));\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-link\", $(this).find(\"span:eq(1)\").attr(\"data-link\"));\r\n\t\t$(\".botBtn>.reserv button\").html(\"<i></i>\" + dataStr);\r\n\t\t} else {\r\n\t\tif($(this).find(\"span:eq(1)\").attr(\"data-type\") == \"\" && $(this).find(\"span:eq(1)\").attr(\"data-ticket\") == \"\" && $(this).find(\"span:eq(1)\").attr(\"data-link\") == \"\"){\r\n\t\t$(\".reservList .reservBtn:eq(1)\").hide();\r\n\t\t$(\".botBtn>.reserv\").removeClass().addClass(\"reserv\").addClass(\"chooseCancel\");\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-type\", \"\");\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-ticket\", \"\");\r\n\t\t$(\".botBtn>.reserv button\").attr(\"data-link\", \"\");\r\n\t\t$(\"#prodSeq\").val(\"0\");\r\n\t\t}\r\n\t\t}\r\n\t\treBtn.removeClass('on');\r\n\t\treList.hide();\r\n\t\t$(this).closest('.reservList').find('button').focus(); // 접근성 초점 위치 조정\r\n\t\treturn false;\r\n\t\t});\r\n\t\t$(document).find(\":focusable\").focus(function (e) {\r\n\t\tif ($('.reservList ul').has(e.target).length === 0) {\r\n\t\t$('.reservBtn').removeClass('on');\r\n\t\t$('.reservBtn').next('ul