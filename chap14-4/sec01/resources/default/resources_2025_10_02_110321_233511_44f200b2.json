st dd span {padding-left:10px; font-size:0.9em; color:#735f5f}\r\n\r\n  @media screen and (max-width:700px){\r\n    .basic_table05 tbody tr td {padding:5px 1px;}\r\n    .b_title01 {font-size:1.4em;}\r\n  }\r\n\r\n\r\n  @font-face {\r\n    font-family: 'LotteMartHappy';\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    src: url('//cdn.jsdelivr.net/korean-webfonts/1/corps/lottemart/LotteMartHappy/LotteMartHappyMedium.woff2') format('woff2'), url('//cdn.jsdelivr.net/korean-webfonts/1/corps/lottemart/LotteMartHappy/LotteMartHappyMedium.woff') format('woff');\r\n  }\r\n</style>\r\n<div class=\"img_title t_center\"><img alt=\"브런치콘서트\" src=\"/resources/upload/1740/82npvd4c0096319.png\" /></div>\r\n\r\n<div class=\"b_title01 MAT30\">MayTree, Summer</div>\r\n\r\n<div class=\"MAT50 t_center\">MayTree, Korea&rsquo;s top a cappella group, is the Korean Wave of a cappella music!<br />\r\nIn June 2024, MayTree&rsquo;s summer is coming!</div>\r\n\r\n<div class=\"MAT30 t_center\">&ldquo;MayTree, Summer&rdquo; is a comprehensive concert experience, showcasing not only the signature &ldquo;Sound Effects&rdquo; that propelled the group to global acclaim with their covers of game and movie music<br />\r\nbut also a blend of jazz standards and original compositions. This event promises the audience an unparalleled opportunity to experience the extraordinary talent and versatility of MayTree.</div>\r\n</div>\r\n\t\t</div>\r\n\t\t<div id=\"scheduleList04\" class=\"inner\" style=\"display:block;\">\r\n\t\t<h5>Program</h5>\r\n\t\t<div class=\"scheduleViewConInfo\"><style type=\"text/css\">.con_basicTable {width:100%;border-collapse:collapse; color:#0082a9; font-size:1.0em;}\r\n  .con_basicTable thead tr th {border-top:2px solid #26bae5;border-bottom:1px solid #26bae5;border-left:1px solid #26bae5;padding:10px 0px; }\r\n  .con_basicTable tbody tr td {border-bottom:1px solid #26bae5;border-left:1px solid #26bae5;padding:10px 20px;vertical-align:middle; text-align:center;border-top:1px solid #26bae5; }\r\n  .con_basicTable thead tr th:first-of-type {border-left:none !important;}\r\n  .con_basicTable tbody tr td:first-of-type {border-left:none !important; }\r\n  .con_basicTable tbody tr td:nth-of-type(3) {text-align:left;}\r\n</style>\r\n<div class=\"bg_superBox03\">\r\n<div class=\"mobile_table\">\r\n<table class=\"con_basicTable\">\r\n\t<caption>프로그램\r\n\t<p>No, 곡명, 작곡가로 나열된 표</p>\r\n\t</caption>\r\n\t<colgroup>\r\n\t\t<col style=\"width:20%;\" />\r\n\t\t<col style=\"width:auto;\" />\r\n\t</colgroup>\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t<th scope=\"col\">No.</th>\r\n\t\t<th scope=\"col\">Title</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t<td>1</td>\r\n\t\t<td>Squid Game</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>2</td>\r\n\t\t<td>K-drama OST</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>3</td>\r\n\t\t<td>Airplane</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>4</td>\r\n\t\t<td>Sunset Glow</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>5</td>\r\n\t\t<td>Butterfly</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>6</td>\r\n\t\t<td>You to Me Again</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>7</td>\r\n\t\t<td>Sound Effect Talk</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>8</td>\r\n\t\t<td>More Than Love</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>9</td>\r\n\t\t<td>Dreamlike Days</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>10</td>\r\n\t\t<td>MOM</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>11</td>\r\n\t\t<td>Water in the World</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>12</td>\r\n\t\t<td>Autumn Leaves</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>13</td>\r\n\t\t<td>Star Wars Medley</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<td>14</td>\r\n\t\t<td>Turn the Beat Around</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n</div>\r\n\r\n<ul class=\"list_style01 MAT30\">\r\n\t<li><i>※</i><span>Programs are subject to change per circumstances.</span></li>\r\n</ul>\r\n</div>\r\n</div>\r\n\t\t</div>\r\n\t\t<div id=\"scheduleList05\" class=\"inner\" style=\"display:block;\">\r\n\t\t<h5>Performers</h5>\r\n\t\t<div class=\"scheduleViewConInfo\"><style type=\"text/css\">.news_list {padding:0px 8%; text-align:center;}\r\n  .news_list dt {font-style:italic; color:#d3bea8; font-weight:500;font-size:1.1em;}\r\n  .news_list dd {font-style:italic; color:#d3bea8}\r\n  .bg_superBox02 {background:#f0f5e9 url(/resources/upload/1689/1d914b95dk311wq.png) center top repeat-y; padding:8%; color:#c3c0bc; box-sizing:border-box;  }\r\n  .con_imgListBox {display:flex; flex-wrap: wrap}\r\n  .con_imgListBox dt {width:250px;}\r\n  .con_imgListBox dd {width:calc(100% - 250px); }\r\n  .brunch_pointText01 {font-size:1.3em; ; font-family:'LotteMartHappy', ''}\r\n  .brunch_pointText02 {font-size:1.4em; ; font-weight:700; color:#0082a9; }\r\n  .list_style01 li {line-height:160%;  }\r\n  .list_style01 li i {float:left; margin-right:5px; }\r\n  .list_style01 li span {display:block; overflow:hidden;}\r\n  .list_style02 li {line-height:160%; margin-bottom:7px;; }\r\n  .list_style02 li i {float:left; margin-right:5px; min-width:150px; font-weight:700; }\r\n  .list_style02 li span {display:block; overflow:hidden;}\r\n  \r\n  .con_brunchList {display:grid;  grid-template-columns: repeat(5, 1fr);  grid-gap: 20px;}\r\n  .con_brunchList li {text-align:center;}\r\n  .con_brunchList img {padding-bottom:15px;}\r\n  \r\n  .name_brunch01 {font-weight:700;color:#3c6112}\r\n\r\n  @media screen and (max-width:700px){\r\n    .super_bgBox {padding:5%;}\r\n    .news_list {padding:0px 10%; text-align:center;}\r\n    .con_imgListBox dt {width:150px;}\r\n    .con_imgListBox dd {width:calc(100% - 150px); }\r\n     .con_brunchList { grid-template-columns: repeat(2, 1fr);  }\r\n  }\r\n</style>\r\n<div class=\"bg_superBox03\">\r\n<div class=\"brunch_pointText02\">MayTree</div>\r\n\r\n<div class=\"MAT30 con_imgBox\"><img alt=\"\" src=\"/resources/upload/1740/noc0m24zz0n0n18.jpg\" /></div>\r\n\r\n<div class=\"MAT30\">Founded in the spring of 2000, MayTree stands as Korea&rsquo;s premier mixed a cappella ensemble, dedicated to crafting captivating music that transcends age and walks of life by seamlessly blending various genres using only the human voice. As the name &ldquo;MayTree&rdquo; suggests, which symbolizes vitality akin to that of a May tree, the group&rsquo;s ethos is rooted in delivering performances brimming with freshness and eco-conscious spirit. Since the ensemble&rsquo;s professional debut in 2006, MayTree has amassed a wealth of accolades, including notable placements in esteemed competitions worldwide. Among their achievements are a 3rd place finish in the 2009 Taiwan International Contemporary A Cappella Festival, followed by a 2nd place win in the 2010 Seoul International A Cappella Festival. In 2011, they clinched 1st place in the Popular Music Category at the Busan International Choral Festival &amp; Competition, as well as the Gold Medal and Audience Award in the Jazz &amp; Pop Category at the International A Cappella Competition in Graz, Austria.<br />\r\nTheir success continued with triumphs as they also won 1st place at the 2013 Yeosu International Choir Competition &amp; Festival in the Pop &amp; Jazz Category, gold medals in the Jazz and Popular Choral Category at the World Choir Games 2014 in Latvia, and 2nd place at the Moscow Spring A Cappella Festival in 2018. In this concert, MayTree promises to enchant audiences with their vibrant harmonies and dynamic energy, captivating both ears and hearts alike.</div>\r\n</div>\r\n<!--\r\n<ul class=\"list_style01 MAT30\">\r\n\t<li><i>※</i><span>Detailed program will be announced later upon request by the performers. </span></li>\r\n</ul>--></div>\r\n\t\t</div>\r\n\t\t<div id=\"scheduleList06\" class=\"inner\" style=\"display:block;\">\r\n\t\t<h5>Schedule</h5>\r\n\t\t<div class=\"scheduleViewConInfo\"><style type=\"text/css\">.con_bgBrunch {background: url(/resources/upload/1687/695rc98b8icuw16.png) center top no-repeat, url(/resources/upload/1687/62k5480sx099875.png) center bottom no-repeat;; padding:5% 6% 200px 6%; box-sizing:border-box; color:#f6e8fc; background-size:contain; background-color:#5a2a6d}\r\n  .con_bgBrunch05 {background:url(/resources/upload/1688/qe7mvj2n1lpz668.png) center top repeat-y;padding:5% 10%; box-sizing:border-box;  }\r\n  .con_bgBrunch06 {border:1px solid #e9b783; border-top:20px solid #f69679;;  box-sizing:border-box;  }\r\n\r\n  .border_top {border-top:1px solid #fce5de; padding-top:40px;}\r\n  .border_top02 {border-top:2px solid #fce5de; padding-top:50px;}\r\n  .brunch_text01 { color:#eb8262; font-size:1.2em;position:relative; font-weight:700;  }\r\n  .brunch_text01 span {color:#fff; background-color:#f98765; border-radius:30px; /*position:absolute; left:0px;*/ padding:3px 10px; font-size:0.9em; font-weight:500;}\r\n  .brunch_text02 {font-weight:700; color:#dc0072;}\r\n  .brunch_text03 {font-weight:500;   font-size:1.0em;}\r\n  .img_box03 {width:100%; box-sizing:border-box}\r\n  .img_box03 img {width:100%;}\r\n\r\n  .imgtext_style02 {box-sizing:border-box; width:100%; overflow:hidden;}\r\n  .imgtext_style02::after {content:'';/* display:block;*/ clear:both;}\r\n  .box_con03 {float:right; width:180px; overflow:hidden; box-sizing:border-box;/*background-color: #f69679; border-radius: 50%;*/}\r\n  .box_con03 img {width:100%;border-radius:50%;/* filter: grayscale(1);*/  }\r\n  /*.box_con03 img.shadow_style01 {filter: drop-shadow(7px 0px 0px #f69679); margin-left:7px;}\r\n  .box_con03 img.shadow_style02 {filter: drop-shadow(7px 0px 0px #f69679); margin-left:-10px;}\r\n  .box_con03 img.shadow_style03 {filter: drop-shadow(7px 0px 0px #f69679); margin-top:5px;}*/\r\n  .box_con04 {float:right; width:calc(100% - 180px); overflow:hidden; box-sizing:border-box; padding:0px 20px;}\r\n  .btm_point {color:#9e7a9e;font-weight:600; font-size:0.9em}\r\n  .t_right {text-align:right;}\r\n\r\n\r\n  /* 포인트 */\r\n  .under {    position: relative;    color: #333;}\r\n  .under>span {    position: relative;    z-index: 10;}\r\n  .under.important:after {    background:  rgba(210,229,207,0.4);}\r\n  .under:after {    display: block;    content: \"\";    width: 100%;    height: 60%;    padding: 0 5px;    background:#ffede7;    position: absolute;    left: -5px;    bottom: 0;}\r\n\r\n  @media screen and (max-width:700px){\r\n    .box_con03 {width:100% !important; clear:both !important;box-sizing:border-box;text-align:center; background-color:#fff;}\r\n    .box_con03 img {  width:50%;}\r\n    .box_con04 {width:100% !important ; clear:both !important;  box-sizing:border-box; padding:15px !important;}\r\n    .box_con04 ul {width:90%; box-sizing:border-box; }\r\n    /*.list_style02 li i {width:100%; display:inline-block;}\r\n    .list_style02 li span {width:100%; display:inline-block;}*/\r\n    .con_bgBrunch {padding:10% 6% 150px 6%}\r\n    .con_bgBrunch05 {padding:5%; background-size:contain;}\r\n  }\r\n</style>\r\n<div class=\"con_bgBrunch06\">\r\n<div class=\"t_center con_imgBox\"><img alt=\"ACC 브런치콘서트 Brunch Conceert 2024. FEB-DEC 국립아시아문화전당 예술극장 극장2\" src=\"/resources/upload/1689/s2ne4kk34shjd76.png\" /></div>\r\n\r\n<div class=\"con_bgBrunch05\"><!--<div class=\"con_imgBox t_center\"><img alt=\"ACC 브런치 콘서트 Brunch Concert\" src=\"/resources/upload/1688/wr24raa2zh9058h.png\" /></div>\r\n\r\n<div class=\"MAT50 t_center\"><img alt=\"\" src=\"/resources/upload/1688/4i47g2wy4v7stuq.png\" /></div>-->\r\n<div class=\"t_center\">ACC Brunch Concert is a representative special concert brand by the National Asian Culture Center<br />\r\ndesigned and presented to provide viewers with restful enjoyment of art and artists&rsquo; opportunities to connect with the audience through music.<br />\r\n<br />\r\nIn 2024, the concert series will come to you with classical, folk, a cappella, world music, musical, and more<br />\r\nto deliver beautiful music and unique stories of lives.<br />\r\n<br />\r\nEnjoy brunch with your loved ones after the performance in a special place at ACC.</div>\r\n\r\n<div class=\"imgtext_style02 bg_style02 MAT70 border_top02\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style02\" src=\"/resources/upload/1688/po1i790sgs476i4.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Feb. 28 (WED)</span> Film Music Concert</div>\r\n\r\n<div class=\"MAT15\">A feast of film scores in classical concert by Millennium Symphonic Orchestra</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Feb. 6 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style03\" src=\"/resources/upload/1689/p4ehcs98518m536.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Mar. 27 (WED)</span> Secret Garden with Yoon Hyeong-ju and Kim Se-hwan</div>\r\n\r\n<div class=\"MAT15\">A musical journey with the youth from the age of folk music</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Feb. 14 (WED)</span></span></div>\r\n※ Program details may vary because of changes in regular closure dates during the Lunar New Year holiday.</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top bg_style01\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style01\" src=\"/resources/upload/1688/k9su0246i58gz4v.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Apr. 24 (WED)</span> Scores in films</div>\r\n\r\n<div class=\"MAT15\">Scores in films with brass ensemble of Brass Market</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Feb. 27 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style02\" src=\"/resources/upload/1688/2v7u2g875w09xi1.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>May 29 (WED)</span> John Noh &amp; Park Hyeon-soo Perfume</div>\r\n\r\n<div class=\"brunch_text03 MAT15\">&nbsp;</div>\r\n\r\n<div class=\"MAT15\">Tenor John Noh, with artist Park Hyeon-soo, presenting a special Korean song collection, &ldquo;Poetic Songs, Singing Poetry&rdquo;</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Mar. 26 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top bg_style02\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style01\" src=\"/resources/upload/1688/072z00v50g1c9t7.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Jun. 26 (WED)</span> Maytree, Summer</div>\r\n\r\n<div class=\"MAT15\">Korea&rsquo;s iconic A Cappella group that took the world by storm: Maytree&rsquo;s special performance</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Apr. 30 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" src=\"/resources/upload/1688/go3ocr63kv72bt2.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Jul. 31 (WED)</span> Kingston Rudieska Concert</div>\r\n\r\n<div class=\"MAT15\">A concert by Kingston Rudieska, an eight-manned band, delivering a musical experience of Jamaican Ska music tailored for Korean tastes</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on May 28 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top bg_style02\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style03\" src=\"/resources/upload/1688/2h8i98p21671ve0.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Aug. 21 (WED)</span> Joseon pop-star, the soaring of Seodo Band</div>\r\n\r\n<div class=\"MAT15\">Iconic stories, rhythms, and melodies of traditional music mashed up with pop music</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Jun. 25 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" src=\"/resources/upload/1688/786w11512g0yppp.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Sept. 25 (WED)</span> Dream Walker by Lee Dong-kyu</div>\r\n\r\n<div class=\"MAT15\">Recital by counter-tenor Lee Dong-kyu, who is called the &ldquo;reincarnation of Farinelli&rdquo;</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Jul. 30 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" src=\"/resources/upload/1688/4a04rmcq9v7nd20.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Oct. 30 (WED)</span> All Moments of Love for Brahms, a commentary by Ahn In-mo</div>\r\n\r\n<div class=\"MAT10\">Romantic music with commentary by Ahn In-mo, the best classical music researcher and pianist</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Aug. 27 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style02\" src=\"/resources/upload/1688/5u309gw57q531h9.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Nov. 27 (WED)</span> Empathy and Consensus by Tour Sketch</div>\r\n\r\n<div class=\"MAT15\">An interactive performance by Tour Sketch, sharing their works in &ldquo;Talk and Music&rdquo; style</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Sept. 24 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"imgtext_style02 MAT30 border_top\">\r\n<div class=\"box_con03\"><img alt=\"\" class=\"shadow_style02\" src=\"/resources/upload/1688/28916fn3lmht700.png\" /></div>\r\n\r\n<div class=\"box_con04\">\r\n<div class=\"brunch_text01\"><span>Dec. 18 (WED)</span> Musical Gala Concert</div>\r\n\r\n<div class=\"MAT10\">The final stage of the 2024 Brunch Concert, celebrated with musical numbers by Cha Ji-yeon and Lee Se-jun!</div>\r\n\r\n<div class=\"brunch_text03 MAT20\"><span class=\"under\"><span>Tickets to be released on Oct. 29 (TUE)</span></span></div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<ul class=\"list_style01 MAT20 PAL10\">\r\n\t<li><i>※</i> <span>The above program is subject to change.</span></li>\r\n\t<li><i>※</i> <span>A simple brunch will be provided after the performance.</span></li>\r\n</ul>\r\n</div>\r\n\t\t</div>\r\n\t\t<script>\r\n\t\tvar $siteVideo = $('#infoVideo');\r\n\t\tvar controlTxt = $('.movieControl');\r\n\t\tvar captionTxt = $('.controlIcon button');\r\n\t\t$siteVideo.click(function() {\r\n\t\tif(this.paused) {\r\n\t\tcontrolTxt.hide();\r\n\t\tcaptionTxt.text('stop').hide();\r\n\t\tthis.play();\r\n\t\t} else {\r\n\t\tcontrolTxt.show();\r\n\t\tcaptionTxt.text('play').show();\r\n\t\tthis.pause();\r\n\t\t}\r\n\t\t});\r\n\t\tcontrolTxt.click(function() {\r\n\t\t$siteVideo.click();\r\n\t\t});\r\n\t\t</script>\r\n\t</div>\r\n\t<div id=\"space\" class=\"spaceInfo\">\r\n\t\t<h5>Place Info.</h5>\r\n\t\t<p class=\"addr\">\r\n\t\tACC Theater, Theater 2</p>\r\n\t\t<div class=\"map01\"><img src=\"/resources/upload/1428/20221212155534_256597024.jpg\" alt=\"\"></div>\r\n\t\t<div class=\"map02\">\r\n\t\t<picture>\r\n\t\t<source media=\"(max-width:640px)\" srcset=\"/resources/upload/1042/20200206104157_1059813536.jpg\">\r\n\t\t<img src=\"/resources/upload/1042/20200206104157_319922240.jpg\" alt=\"\">\r\n\t\t</picture>\r\n\t\t</div>\r\n\t</div>\r\n\t<div class=\"boardBtn\"><p><a href=\"performance.do?PID=0102\" class=\"btnList\"><span>list</span></a></p></div>