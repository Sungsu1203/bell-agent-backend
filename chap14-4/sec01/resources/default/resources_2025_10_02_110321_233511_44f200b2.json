us();\r\n\t\treturn false;\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t//비회원 티켓예매 - 입력값 체크\r\n\tfunction pf_ticket_account_check(){\r\n\t\tvar rtnTxt1 = \"이름을 입력하세요.\";\r\n\t\tvar rtnTxt2 = \"생년월일을 입력하세요.\";\r\n\t\tvar rtnTxt3 = \"생년월일을 6자리 숫자로 입력해주세요.\";\r\n\t\tvar rtnTxt4 = \"이메일을 입력하세요.\";\r\n\t\tvar rtnTxt5 = \"잘못된 이메일 형식입니다.\";\r\n\t\tvar rtnTxt6 = \"연락처를 입력하세요.\";\r\n\t\tvar rtnTxt7 = \"성별을 입력하세요.\";\r\n\t\tvar rtnTxt8 = \"이용약관과 개인정보 수집 및 이용에 대한 안내 모두 동의해주세요.\";\r\n\r\n\r\n\t\tif(lang == 'en'){\r\n\t\trtnTxt1 = \"Input Name\";\r\n\t\trtnTxt2 = \"Input Date of birth.\";\r\n\t\trtnTxt3 = \"Please enter your date of birth in six digits\";\r\n\t\trtnTxt4 = \"Input Email.\";\r\n\t\trtnTxt5 = \"Invalid email format.\";\r\n\t\trtnTxt6 = \"Input Phone.\";\r\n\t\trtnTxt7 = \"Please enter your gender\";\r\n\t\trtnTxt8 = \"Please accept all terms and conditions and privacy guidance on the collection and use.\";\r\n\t\t}else if(lang == 'zh'){\r\n\t\trtnTxt1 = \"输入名称\";\r\n\t\trtnTxt2 = \"出生日期输入。\";\r\n\t\trtnTxt3 = \"请六位数字输入你的出生日期。\";\r\n\t\trtnTxt4 = \"鄂麦输入。\";\r\n\t\trtnTxt5 = \"I无效的电子邮件格式。\";\r\n\t\trtnTxt6 = \"输入电话。\";\r\n\t\trtnTxt7 = \"请输入您的性别。\";\r\n\t\trtnTxt8 = \"请接受对收集和使用的所有条款和隐私指导。\";\r\n\t\t}else if(lang == 'jp'){\r\n\t\trtnTxt1 = \"入力された名前\";\r\n\t\trtnTxt2 = \"出産の入力日.\";\r\n\t\trtnTxt3 = \"6桁で生年月日を入力してください\";\r\n\t\trtnTxt4 = \"入力メール.\";\r\n\t\trtnTxt5 = \"無効なメール形式.\";\r\n\t\trtnTxt6 = \"入力電話.\";\r\n\t\trtnTxt7 = \"性別を入力してください。\";\r\n\t\trtnTxt8 = \"収集および使用上のすべての条件とプライバシーの指導を受け入れてください。 \";\r\n\t\t}else if(lang == 'ru'){\r\n\t\trtnTxt1 = \"Введите имя\";\r\n\t\trtnTxt2 = \"Ввод Дата рождения.\";\r\n\t\trtnTxt3 = \"Пожалуйста, введите дату рождения в шести цифр\";\r\n\t\trtnTxt4 = \"Ввод E-mail.\";\r\n\t\trtnTxt5 = \"Неправильный формат электронной почты.\";\r\n\t\trtnTxt6 = \"Входной телефон.\";\r\n\t\trtnTxt7 = \"Пожалуйста, введите свой пол.\";\r\n\t\trtnTxt8 = \"Пожалуйста, примите все условия и указания о конфиденциальности, касающихся сбора и использования.\";\r