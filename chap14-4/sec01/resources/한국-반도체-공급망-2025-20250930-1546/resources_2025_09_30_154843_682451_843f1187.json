    "raw_content": "<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n\t<meta charset=\"utf-8\">\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\r\n<meta name=\"viewport\" content=\"width=device-width\">\r\n<meta name=\"format-detection\" content=\"telephone=no\">\r\n<meta name=\"theme-color\" content=\"#001e5b\">\r\n<meta name=\"language\" content=\"kr\">\r\n\r\n<!-- TODO -->\r\n<meta name=\"copyright\" content=\"KIET 산업연구원\">\r\n<meta name=\"keywords\" content=\"KIET 산업연구원\">\r\n<meta name=\"publisher\" content=\"KIET 산업연구원\">\r\n<link rel=\"canonical\" href=\"https://www.kiet.re.kr\">\r\n\r\n<meta name=\"title\" content=\"KIET 산업연구원 - 메인\">\r\n \t<meta name=\"description\" content=\"산업연구원은 국내외의 산업·기술과 관련된 실물경제의 동향과 정보를 신속히 수집 조사하고 연구\">\r\n\t<meta property=\"og:type\" content=\"website\">\r\n<meta property=\"og:image\" content=\"/Kiet/dev_img/KIET_OG2.jpg\">\r\n<meta property=\"og:title\" content=\"KIET 산업연구원 - 메인\">\r\n \t<meta property=\"og:description\" content=\"산업연구원은 국내외의 산업·기술과 관련된 실물경제의 동향과 정보를 신속히 수집 조사하고 연구\">\r\n\t<meta property=\"og:url\" content=\"https://www.kiet.re.kr\">\r\n<script type=\"application/ld+json\">\r\n  {\r\n    \"@context\": \"http://schema.org\",\r\n    \"@type\": \"Organization\",\r\n    \"name\": \"KIET 산업연구원\",\r\n    \"url\": \"https://www.kiet.re.kr\",\r\n    \"sameAs\": [\r\n      \"https://www.facebook.com/WorldKIET\",\r\n      \"https://blog.naver.com/worldkiet\",\r\n      \"https://www.youtube.com/channel/UC7K8pIy-NLwUOukLaXV5wnA\",\r\n      \"https://www.instagram.com/worldkiet\"\r\n    ]\r\n  }\r\n</script>\r\n<link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"/Kiet/img/favicon.ico\">\r\n<link rel=\"apple-touch-icon-precomposed\" sizes=\"100x100\" href=\"/Kiet/img/favicon.png\">\r\n<link rel=\"stylesheet\" href=\"/Kiet/font/font.css\">\r\n<link rel=\"stylesheet\" href=\"/Kiet/css/style.css\">\r\n<script src=\"/Kiet/lib/jQuery.v2.2.4.js\"></script>\r\n<script src=\"/Kiet/lib/jQuery.easing.js\"></script>\r\n<script src=\"/Kiet/lib/jQuery.slick.js\"></script>\r\n<script src=\"/Kiet/js/kiet_main.js\"></script>\r\n<script src=\"/Kiet/js/kiet_full.js\"></script>\r\n<script src=\"/Kiet/js/kiet_contents.js\"></script>\r\n<script src=\"/Kiet/dev_js/common.js\"></script>\r\n<script src=\"/Kiet/dev_js/cookie.js\"></script>\r\n<!-- <script src=\"https://developers.kakao.com/sdk/js/kakao.min.js\"></script> -->\r\n<script src=\"https://t1.kakaocdn.net/kakao_js_sdk/2.0.0/kakao.min.js\" integrity=\"sha384-PFHeU/4gvSH8kpvhrigAPfZGBDPs372JceJq3jAXce11bVA6rMvGWzvP4fMQuBGL\" crossorigin=\"anonymous\"></script>\r\n<script>\r\n$(function(){\r\n\t$(\"meta[property='og\\\\:url']\").attr(\"content\", location.href);\r\n});\r\n\r\n//kakao init\r\nKakao.init('ceb7aace70742cf85b52a180264b74fc');\r\n\r\n//google\r\n// (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\r\n//   (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\r\n//   m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\r\n//   })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');\r\n\r\n//   ga('create', 'UA-73815579-1', 'auto');\r\n//   ga('send', 'pageview');\r\n\r\n\r\n//google\r\n</script>\r\n\r\n\r\n<!-- Google tag (gtag.js) -->\r\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-J48L1TFDST\"></script>\r\n<!-- Naver -->\r\n<script>\r\n  window.dataLayer = window.dataLayer || [];\r\n  // google\r\n  function gtag(){dataLayer.push(arguments);}\r\n  gtag('js', new Date());\r\n\r\n  gtag('config', 'G-J48L1TFDST');\r\n  \r\n  // naver\r\n  // if(!wcs_add) var wcs_add = {};\r\n  // wcs_add[\"wa\"] = \"142bac9680a4190\";\r\n  // if(window.wcs) {\r\n  // \twcs_do();\r\n  // }\r\n</script><title>KIET 산업연구원 - 메인</title>\r\n\t<script>\r\n\t\t$(function(){\r\n\t\tgetMainNtcAjax();\r\n\t\tgetMainNtcHireAjax();\r\n\t\tgetPopWordMain();\r\n\t\t//탑 배너\r\n\t\t  if(getCookie(\"closeTop\") != \"Y\"){\r\n\t\t$(\"#bnnrWrap\").addClass(\"open\");\r\n// \t\t$(\"#bnnrWrap\").css(\"background-color\", \"#424040\");\r\n\t\t}\r\n\r\n\t\tlet live_banner_no = \"\";\r\n\r\n\t\tif(live_banner_no != '' && live_banner_no !== undefined){\r\n\t\tlet pop_yn = \"\";\r\n\t\tlet use_yn = \"\";\r\n\r\n\t\tif(pop_yn == \"Y\" && use_yn == \"Y\"){\r\n\t\tif(getCookie(\"closeLive\") == \"Y\"){\r\n\t\treturn false;\r\n\t\t}\r\n\t\tlivePop(\"\");\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n\r\n\t\twindow.addEventListener('load', function() {\r\n\t\t$(\".flytag\").css(\"display\", \"none\");\r\n\t\t});\r\n\r\n\t\tfunction closeTop() {\r\n\t\tsetCookie(\"closeTop\", \"Y\", 1);\r\n\t\tkietfn.bnnrEnd();\r\n\t\t}\r\n\r\n\t\tfunction closeLive() {\r\n\t\tsetCookie(\"closeLive\", \"Y\", 1);\r\n\t\tkietfn.slideTopClose('.onair_popup');\r\n\t\t}\r\n\r\n\t\tfunction livePop(banner_no) {\r\n\t\tif(banner_no == \"\"){\r\n\t\treturn false;\r\n\t\t}\r\n\r\n// \t\tif(getCookie(\"closeLive\") == \"Y\"){\r\n// \t\treturn false;\r\n// \t\t}\r\n\r\n\t\tlet param = {\"banner_no\" : banner_no};\r\n\r\n\t\t$.ajax({\r\n\t\t  type     : 'POST'\r\n\t\t, url      : './getLiveBanner'\r\n\t\t, data     : param\r\n\t\t, dataType : 'json'\r\n\t\t, success  : function(data) {\r\n// \t\tconsole.log(data);\r\n\t\tif(!data.result){\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\tlet thisEtt = data.thisEtt;\r\n\t\t$(\"#ttl_txt\").text(thisEtt.TTL);\r\n\t\t$(\"#media_nm_txt\").text(thisEtt.MEDIA_NM);\r\n\t\t$(\"#vdo_url_txt\").append(thisEtt.VDO_URL);\r\n\t\t$(\"#vdo_more_url_txt\").attr(\"href\", thisEtt.VDO_MORE_URL);\r\n\t\t$(\"#vdo_more_url_txt\").attr(\"target\", \"_blank\");\r\n\t\t$(\"#vdo_show_url_txt\").attr(\"onclick\", \"window.open('\"+thisEtt.VDO_SHOW_URL+\"')\");\r\n\t\t$(\"#main_agent_txt\").text(\"주관 : \" + thisEtt.MAIN_AGENT);\r\n\r\n\t\tif(thisEtt.VDO_MORE_URL === undefined) $(\"#vdo_more_url_txt\").css(\"display\", \"none\");\r\n\t\tif(thisEtt.VDO_SHOW_URL === undefined) $(\"#vdo_show_url_txt\").css(\"display\", \"none\");\r\n\t\t\r\n\t\tkietfn.slideTopOpen('.onair_popup');\r\n\t\t}\r\n\t\t, error    : function( request, status, error ) {\r\n\t\tconsole.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error);\r\n// \t\talert(\"일시적인 오류가 발생했습니다.\\n다시 시도해주세요.\");\r\n\t\treturn false;\r\n\t\t}\r\n\t\t});\r\n\t\t}\r\n\r\n\t\tfunction getMainNtcAjax(gubun) {\r\n\t\tlet param = {\"gubun\" : gubun};\r\n\r\n\t\t$.ajax({\r\n\t\t  type     : 'POST'\r\n\t\t, url      : './getMainNtcAjax'\r\n\t\t, data     : param\r\n\t\t, dataType : 'json'\r\n\t\t, success  : function(data) {\r\n// \t\tconsole.log(data);\r\n\t\tif(!data.result){\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\t$(\"#noti_list\").empty();\r\n\r\n\t\tlet list = data.thisList;\r\n\r\n\t\tlet html = \"\";\r\n\r\n\t\tfor(let i=0; i < list.length; i++){\r\n\t\tlet row = list[i];\r\n\r\n\t\tlet ntc_gubun = row.NTC_GUBUN;\r\n\r\n\t\tlet ntc_gubun_str = \"\";\r\n\t\tif(ntc_gubun == \"A\") {\r\n\t\tntc_gubun_str = \"입찰\";\r\n\t\t}\r\n\t\telse if(ntc_gubun == \"B\") {\r\n\t\tntc_gubun_str = \"채용\";\r\n\t\t}\r\n\t\telse {\r\n\t\tntc_gubun_str = \"기타\";\r\n\t\t}\r\n\r\n\t\tlet new_yn = row.NEW_YN;\r\n\t\tlet new_str = \"\";\r\n\t\tif(new_yn == \"Y\") new_str = \"new\";\r\n\t\t\r\n\t\thtml += \"<li>\";\r\n\t\thtml += \"\t<a href='/communicate/ntcView?ntc_no=\"+row.NTC_NO+\"' target='_blank' >\";\r\n\t\thtml += \"\t\t<strong>\"+ntc_gubun_str+\"</strong><p class='\"+new_str+\"'>\"+row.TTL+\"</p><span>\"+row.REG_DT_STR+\"</span>\";\r\n\t\thtml += \"\t</a>\";\r\n\t\thtml += \"</li>\";\r\n\t\t}\r\n\r\n\t\t$(\"#noti_list\").append(html);\r\n\t\t}\r\n\t\t, error    : function( request, status, error ) {\r\n\t\tconsole.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error);\r\n// \t\talert(\"일시적인 오류가 발생했습니다.\\n다시 시도해주세요.\");\r\n\t\treturn false;\r\n\t\t}\r\n\t\t});\r\n\t\t}\r\n\r\n\t\tfunction getMainNtcHireAjax() {\r\n\t\t\r\n\t\tlet param = {\"gubun\" : \"B\"};\r\n\r\n\t\t$.ajax({\r\n\t\t  type     : 'POST'\r\n\t\t, url      : './getMainNtcAjax'\r\n\t\t, data     : param\r\n\t\t, dataType : 'json'\r\n\t\t, success  : function(data) {\r\n// \t\tconsole.log(data);\r\n\t\tif(!data.result){\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\t$(\"#noti_list_hire\").empty();\r\n\r\n\t\tlet list = data.thisList;\r\n\r\n\t\tlet html = \"\";\r\n\r\n\t\tfor(let i=0; i < list.length; i++){\r\n\t\tlet row = list[i];\r\n\r\n\t\tlet ntc_gubun = row.NTC_GUBUN;\r\n\r\n\t\tlet ntc_gubun_str = \"\";\r\n\t\tif(ntc_gubun == \"A\") {\r\n\t\tntc_gubun_str = \"입찰\";\r\n\t\t}\r\n\t\telse if(ntc_gubun == \"B\") {\r\n\t\tntc_gubun_str = \"채용\";\r\n\t\t}\r\n\t\telse {\r\n\t\tntc_gubun_str = \"기타\";\r\n\t\t}\r\n\r\n\t\tlet new_yn = row.NEW_YN;\r\n\t\tlet new_str = \"\";\r\n\t\tif(new_yn == \"Y\") new_str = \"new\";\r\n\t\t\r\n\t\thtml += \"<li>\";\r\n\t\thtml += \"\t<a href='/communicate/ntcView?ntc_no=\"+row.NTC_NO+\"' target='_blank' >\";\r\n\t\thtml += \"\t\t<strong>\"+ntc_gubun_str+\" \"+row.NTC_STATUS+\"</strong><p class='\"+new_str+\"'>\"+row.TTL+\"</p><span>\"+row.REG_DT_STR+\"</span>\";\r\n\t\thtml += \"\t</a>\";\r\n\t\thtml += \"</li>\";\r\n\t\t}\r\n\r\n\t\t$(\"#noti_list_hire\").append(html);\r\n\t\t}\r\n\t\t, error    : function( request, status, error ) {\r\n\t\tconsole.log(\"code:\"+request.status+\"\\n\"+\"message:\"+request.responseText+\"\\n\"+\"error:\"+error);\r\n// \t\talert(\"일시적인 오류가 발생했습니다.\\n다시 시도해주세요.\");\r\n\t\treturn false;\r\n\t\t}\r\n\t\t});\r\n\t\t}\r\n\r\n\t\tfunction goLetter() {\r\n\t\tlet email = $(\"#email\").val();\r\n\r\n\t\tvar re = /^[A-Za-z0-9_\\.\\-]+@[A-Za-z0-9\\-]+\\.[A-Za-z0-9\\-]+/;\r\n\t\t\r\n\t\tif( !re.test(email) ){\r\n\t\talert('올바른 이메일 주소를 입력해주세요.');\r\n\t\t$(\"#email\").focus();\r\n\t\treturn false;\r\n\t\t}\r\n\r\n\t\tlocation.href = \"/apply/newsApply?email=\"+email;\r\n\t\t}\r\n\r\n\t\tfunction getPopWordMain(){\r\n\t\tlet param = {\r\n\t\t \"target\" : \"popword\"\r\n\t\t,