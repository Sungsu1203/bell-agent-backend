LOCAL_RAG_MAX_TEXT_CHARS=200000
LOCAL_RAG_MAX_FILE_MB=50

# ===== Chroma / topic (옵션) =====
CLEAR_CHROMA_ON_START=1
CHROMA_MAX_BATCH=64
CHROMA_DISABLE_TELEMETRY=1
TOKENIZERS_PARALLELISM=false
ALLOW_GLOBAL_CLEAR=0

CHROMA_QUARANTINE_DIR=        # 비워두면 자동으로 <persist_dir>\quarantine 사용

INCLUDE_FINDINGS_IN_REPORT=1

