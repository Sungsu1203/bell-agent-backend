# 책 vs 보고서
DOC_MODE=report                 # report | book
WRITER_AGENT=section_writer

# RAG
RAG_TOP_K=8                     # 검색결과 상위 8개
SKIP_WEB_SEARCH=0
ALLOW_LOCAL_SUMMARY=0           # vector_search가 로컬 문서만으로 1문단 요약 생성, 빠른 내부 질의 응답을 바로 반환.
AUTO_WRITE_DURING_RESEARCH=0

# ===== Writer behavior =====
AUTO_WRITE_AFTER_RAG=1           # 1=벡터검색 뒤 자동 집필, 연구모드가 아닐 때 writer 예약 0=수동(벡터 검색만 함)
AUTO_FOOTNOTE=1                  # 자동각주/출처 라벨링 시도 ON, 0이면 OFF
AUTO_FOOTNOTE_INLINE=1
AUTO_FOOTNOTE_MODE=quant         # footer | domain | quant
AUTO_FOOTNOTE_MAX=12             # default=12

RAG_CHUNK_CHARS=2400
RAG_CHUNK_OVERLAP=200
RAG_EMBED_BATCH=32
RAG_TOKEN_BUDGET_PER_REQ=150000
RAG_EMBEDDING_MODEL=text-embedding-3-small  # 비용/속도 신경쓰면 small, 정확도는 large
WEB_SEARCH_RAW_FETCH_TOP=5  # WEB_SEARCH_RAW_FETCH_TOP=0 원문로딩 지연 줄임
WEB_FETCH_TIMEOUT_CONNECT=5
WEB_FETCH_TIMEOUT_READ=12
WEB_FETCH_BUDGET_SECONDS=45

# 연구 루프
BLOCKAGI_AGENT_ROLE=research analyst
ITERATION_COUNT=3
BLOCKAGI_OBJECTIVE_1=시장규모 성장 전망
BLOCKAGI_OBJECTIVE_2=경쟁사 광고 마케팅 현황
BLOCKAGI_OBJECTIVE_3=소비자 인식/행동/태도
# RESEARCH_TOPIC= 한국 피로회복 비타민제 시장 / 종근당 벤포벨
BLOCKAGI_LANG=ko

RESEARCH_HALT_THRESHOLD=1       # 이 값 이하이면 '무신규'로 간주
RESEARCH_MIN_ROUNDS=1            # 최소 라운드 수
RESEARCH_MAX_NO_NEW_ROUNDS=1     # '무신규' 라운드 연속 허용치
RESEARCH_PLANNER_ANNOUNCE=0      # 1이면 플래너 계획을 바로 커뮤니케이터가 요약 출력


# 대시보드/로깅
SHOW_DASHBOARD=1                # Supervisor가 라우팅/상태를 대시보드 형식으로 로그 출력
LOG_DASHBOARD=1                 # Communicator에서 “최근 대시보드 로그가 찍혔으면 간단 메시지로 축약”
DASH_RATE_SEC=6                 # 최근 dash_last_ts로부터 이 시간 내면 간단 모드
DASH_WRAP=88                    # 문자열 줄폭, 기본 88

# 콘솔 에코
ECHO_OUTLINE=1                  # Communicator가 목차 원문을 콘솔에 예쁘게 에코
ECHO_SECTIONS=1                 # Section Writer가 저장된 섹션 원문을 콘솔에 에코
ECHO_CHAPTERS=1                 # Chapter Writer가 저장된 챕터 원문을 콘솔에 에코


# ─────────────── Log ───────────────
LOG_LEVEL=DEBUG                 # 개발 중: DEBUG, 테스트/CI: WARNING, 운영: INFO + LOG_FILE
LOG_FMT="%(asctime)s %(levelname)s [%(name)s] %(message)s"
LOG_DATEFMT="%Y-%m-%d %H:%M:%S"
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3
LOG_JSON=1

# ===== Gatekeeping for sources (옵션) =====
GATE_KEEP_SOURCES=0              # 게이트 끄기 0
ALLOWED_DOMAINS=naver.com, news.naver.com
ALLOW_SUBDOMAINS=0

