# §academic-1 academic sample topic — EN
# Consumer behavior in influencer marketing (peer-reviewed lit review)

MODE=academic
EXPECTED_LANG=auto

TOPIC_TITLE=Consumer Behavior in Influencer Marketing — Peer-reviewed Lit Review
TOPIC_KEYWORDS=influencer marketing,consumer behavior,parasocial,trust,purchase intention
TOPIC_SLUG=academic-influencer-marketing-consumer-behavior
TOPIC_QUERY=consumer behavior in influencer marketing

BLOCKAGI_OBJECTIVE_1=Survey peer-reviewed (2018-2025) literature on consumer behavior in influencer marketing — parasocial interaction, source credibility, perceived authenticity, and purchase intention pathways across platforms (Instagram / YouTube / TikTok).
BLOCKAGI_OBJECTIVE_2=Identify dominant theoretical frames (e.g., Source Credibility Model, Parasocial Interaction Theory, Elaboration Likelihood Model) and the empirical moderators (follower-count tier, product category, disclosure compliance) reported across the literature.
BLOCKAGI_OBJECTIVE_3=Synthesize gaps where current ad-agency planning practice diverges from peer-reviewed evidence (e.g., over-reliance on follower count vs. engagement-rate / nano-influencer effectiveness) and propose evidence-aligned planning hooks.

ALLOWED_DOMAINS_EXTRA=academic.oup.com,ama.org,arxiv.org,dbpia.co.kr,doaj.org,emerald.com,journals.sagepub.com,jstor.org,kadpr.or.kr,kci.go.kr,kiss.kstudy.com,link.springer.com,mmaglobal.com,msi.org,onlinelibrary.wiley.com,openalex.org,papers.ssrn.com,plos.org,pmc.ncbi.nlm.nih.gov,pubsonline.informs.org,riss.kr,sagepub.com,science.org,semanticscholar.org,springer.com,ssrn.com,tandfonline.com,warc.com,wiley.com

GATE_KEEP_SOURCES=1
SKIP_VERTEX_SEARCH=false
