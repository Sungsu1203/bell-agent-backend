# §academic trademark topic — EN/KO mixed
# Consumer-perceived trademark similarity vs. judicial likelihood-of-confusion

MODE=academic
EXPECTED_LANG=auto

TOPIC_TITLE=Operationalizing Trademark Similarity through Consumer Perception — A Measurement Model and Its Alignment with Judicial Likelihood-of-Confusion Determinations
TOPIC_KEYWORDS=trademark similarity,likelihood of confusion,consumer perception,confusion survey,Eveready,Squirt,source confusion,brand similarity
TOPIC_SLUG=academic-trademark-similarity-consumer
TOPIC_QUERY=consumer perception of trademark similarity and likelihood of confusion

BLOCKAGI_OBJECTIVE_1=Survey the legal doctrine and peer-reviewed/empirical literature on trademark similarity and likelihood of confusion — the tripartite test of appearance, sound (phonetic), and meaning (conceptual) under Korean Supreme Court precedent, the source-confusion standard, and the U.S. consumer-survey tradition (Eveready and Squirt/lineup formats). Establish how "ordinary consumer perception" functions as the legal criterion yet is applied normatively by judges rather than measured empirically.

BLOCKAGI_OBJECTIVE_2=Propose a measurement model that operationalizes consumer-perceived similarity along the three legal axes (appearance / phonetic / conceptual) via consumer rating scales, supplemented on the conceptual axis by multilingual embedding-based semantic similarity (cosine), combined into a weighted composite similarity score, with a Squirt-style source-confusion item as the validation variable. Review measurement-validity considerations (convergent validity between human ratings and machine measures, reliability).

BLOCKAGI_OBJECTIVE_3=Design a validation study testing whether the composite similarity score and confusion measure predict courts' similar/not-similar determinations on a balanced sample of adjudicated Korean trademark disputes (logistic regression, predictive performance / AUC, axis-weight estimation), and analyze divergence cases where consumer perception departs from judicial judgment — synthesizing implications for using consumer survey evidence as a supplementary basis in trademark adjudication.

ALLOWED_DOMAINS_EXTRA=academic.naver.com,academic.oup.com,arxiv.org,casenote.kr,dbpia.co.kr,doaj.org,emerald.com,glaw.scourt.go.kr,heinonline.org,inta.org,journals.sagepub.com,jstor.org,kci.go.kr,kiss.kstudy.com,klri.re.kr,kipo.go.kr,law.go.kr,lawnb.com,link.springer.com,mdpi.com,onlinelibrary.wiley.com,openalex.org,papers.ssrn.com,pmc.ncbi.nlm.nih.gov,riss.kr,sagepub.com,scholar.google.com,scourt.go.kr,sciencedirect.com,semanticscholar.org,springer.com,ssrn.com,tandfonline.com,wiley.com

GATE_KEEP_SOURCES=1
SKIP_VERTEX_SEARCH=false