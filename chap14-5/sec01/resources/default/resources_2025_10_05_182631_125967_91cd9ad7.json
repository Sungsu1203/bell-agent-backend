    "raw_content": "<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n\t<meta charset=\"utf-8\">\r\n\t<meta http-equiv=\"Pragma\" content=\"no-cache\"/>\r\n\t<meta http-equiv=\"Cache-Control\" content=\"no-cache\"/>\r\n\t<meta http-equiv=\"expires\" content=\"0\"/>\r\n\t<meta http-equiv=\"content-language\" content=\"ko\"/>\r\n\t<meta http-equiv=\"imagetoolbar\" content=\"no\"/>\r\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"/>\r\n\t<meta name=\"format-detection\" content=\"telephone=no,email=no,address=no\"/>\r\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\r\n\t<meta name=\"author\" content=\"한국에너지기술연구원\"/>\r\n\t<meta name=\"Keywords\" content=\"한국에너지기술연구원, KIER, 기술정책플랫폼\"/>\r\n\t<meta name=\"description\" content=\"한국에너지기술연구원 기술정책플랫폼\"/>\r\n\t<meta name=\"copyright\" content=\"COPYRIGHT (C) 2020 KOREA INSTITUTE OF ENERGY RESEARCH. ALL RIGHT RESERVED..\"/>\r\n\t<meta property=\"og:type\" content=\"website\"/>\r\n\t<meta property=\"og:site_name\" content=\"한국에너지기술연구원 기술정책플랫폼\"/>\r\n\t<meta property=\"og:title\" content=\"Below 1.5°C-KIER TPP\"/>\r\n\t<meta property=\"og:description\" content=\"이차전지 산업·기술 동향\" />\r\n\t<meta property=\"og:url\" content=\"https://www.kier.re.kr/tpp/energy/A/view/232?contentsName=below4_5&menuId=MENU00963\"/>\r\n\r\n\t<meta property=\"og:image\" content=\"https://www.kier.re.kr/fileDownload?fileGubun=tpp&menuId=energy&userFileName=이차전지 산업·기술 동향.jpg&systemFileName=17019285859210.jpg\"/>\r\n\t<link rel=\"shortcut icon\" href=\"/resources/images/tpp/layout/favicon.png\">\r\n\r\n\t<title>\r\n\t\tBelow 1.5°C-KIER TPP</title>\r\n\r\n\t<!-- Global site tag (gtag.js) - Google Analytics -->\r\n\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-171685299-1\"></script>\r\n<!-- \t<script src=\"https://www.googletagmanager.com/gtag/js?id=UA-171685299-1\" integrity=\"sha384-r+b9Q/8Q1YAfcOiFwltR2nuzHpVooCwIJDSKQ/rLy00SCunBYFIuQApb4H9lO979\" crossorigin=\"anonymous\"></scr