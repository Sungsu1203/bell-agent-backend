/div>\n\t\t<span href=\"#\" class=\"document-name\">\n\t\tSDG 8 EGM Summary\n\t\t</span>\n\t\t</div>\n\t\t</button>\n\t\t<div id=\"document-3\" class=\"dropwdown-collapse collapse\" aria-labelledby=\"document-3-collapse\" style=\"\">\n\t\t<div class=\"document-group\">\n\t\t<div><p><a href=\"/documents/summary-sdg-8-egm-58016\">Summary</a></p></div>\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t</section>\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t<div id=\"documentation\" role=\"tabpanel\" aria-labelledby=\"documentation-tab\" class=\"tab-pane fade \">\n\t\t<h3>\n\t\t</h3>\n\t\t<div>\n\t\t<strong>\n\t\t\n\t\t</strong>\n\t\t</div>\n\t\t<div>\n\t\t<div class=\"views-element-container\"><div class=\"view view-events view-id-events view-display-id-events_documents_block js-view-dom-id-eefe09137007259565ca6517f3af2fe3cb63151aed1fac35f1eccf21e8ec11ed\">\n\t\n\t\t\n\t\t\n\t\t<div class=\"view-content row\">\n\t\t    <div><span><div class=\"view view-documents view-id-documents view-display-id-documents_list_block js-view-dom-id-350d18a48c5a5a014276b3bae88fc7a646e827e2204236bfbe751cae77279f66\">\n\t\n\t\t\n\t\t\n\t\t<div class=\"view-content row\">\n\t\t<div class=\"item-list progs-docs\">\n      <h3>Concept Note</h3>\n  \n  <ul>\n\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-02/Concept%20Programme%20Briefing%20EGMs%2027%20Feb%202025%20_0.pdf\">Briefing on the outcomes of the Expert Group Meetings 27 February 2025</a></span></div></li>\n    \n  </ul>\n\n</div>\n<div class=\"item-list progs-docs\">\n      <h3>Presentations</h3>\n  \n  <ul>\n\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-03/Astra%20Bonini%20Briefing%20EGM%20HLPF%2027%20Feb2025.pdf\">Cross Cutting Messages</a></span></div></li>\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-03/Remarks%20for%20Lotta%20Tahtinen%20Briefing%20on%20the%20outcomes%20of%20Expert%20Group%20Meetings_25Feb2025.pdf\">DESA Remarks</a></span></div></li>\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-03/TPs%20EGM%20on%20SDG%208%20results.pdf\">ILO Remarks</a></span></div></li>\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-03/Remarks%20by%20Sarah%20Hendriks%20-%20Presentation%20of%20the%20report%20of%20the%20EGM%20on%20SDG%205.pdf\">UN Women Remarks</a></span></div></li>\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-03/SDG3-EGM-MS-briefing-slides_27Feb.pdf\">WHO and UNFPA Remarks</a></span></div></li>\n    \n  </ul>\n\n</div>\n<div class=\"item-list progs-docs\">\n      <h3>Summaries</h3>\n  \n  <ul>\n\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-03/HLPF%20EGM%20infocus%20SDGs%202025_SDG%203_summary_FINAL_0.pdf\">Summary of SDG 3 EGM</a></span></div></li>\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-04/SDG%205%20EGM%20Summary%20Report_0.pdf\">Summary of SDG 5 EGM</a></span></div></li>\n          <li><div class=\"views-field views-field-views-conditional-field\"><span class=\"field-content\"><a href=\"/sites/default/files/2025-04/Summary%20report%20-%20EGM%20on%20SDG8%20-%20final_0.pdf\">Summary of SDG 8 EGM</a></span></div></li>\n    \n  </ul>\n\n</div>\n\n\t\t</div>\n\t\n\t\t        \n\t\t</div>\n</span></div>\n\t\t</div>\n\t\n\t\t</div>\n</div>\n\n\t\t</div>\n\t\t</div>\n\t\t<div id=\"egms\" role=\"tabpanel\" aria-labelledby=\"egms-tab\" class=\"tab-pane fade \">\n\t\t<h3>\n\t\t</h3>\n\t\t<div>\n\t\t<strong>\n\t\t\n\t\t</strong>\n\t\t</div>\n\t\t<div>\n\t\t  <div class=\"paragraph paragraph--type--tabs paragraph--view-mode--tabs-content\">\n          \n            <div class=\"clearfix text-formatted field field--name-field-paragraph-content field--type-text-long field--label-hidden field__item\"><p>Geneva, 12 Feb 2025: <a href=\"http://sdgs.un.org/events/expert-group-meeting-sdg-3-preparation-hlpf-2025-57473\" rel=\"nofollow\"><span>Expert Group Meeting on SDG 3 | Department of Economic and Social Affairs</span></a></p><p>New York, 21-22 Jan 2025: <a href=\"http://sdgs.un.org/HLPF/2025/ThematicReviewEGMs/SDG5\" rel=\"nofollow\">Expert Group Meeting on SDG 5 | Department of Economic and Social Affairs</a></p><p>New York, 6-7 Feb 2025: <a href=\"http://sdgs.un.org/HLPF/2025/ThematicReviewEGMs/SDG8\" rel=\"nofollow\"><span>Expert Group Meeting on SDG 8 | Department of Economic and Social Affairs</span></a></p><p>12-13 May 2025: <a href=\"http://sdgs.un.org/events/expert-group-meeting-sdg14-preparation-hlpf-2025-advancing-sustainable-inclusive-science-and\" rel=\"nofollow\"><span>Expert Group Meeting on SDG 14 | Department of Economic and Social Affairs</span></a></p></div>\n      \n      </div>\n\n\t\t</div>\n\t\t</div>\n\t\t<div id=\"member_states_briefing\" role=\"tabpanel\" aria-labelledby=\"member_states_briefing-tab\" class=\"tab-pane fade \">\n\t\t<h3>\n\t\t</h3>\n\t\t<div>\n\t\t<strong>\n\t\t\n\t\t</strong>\n\t\t</div>\n\t\t<div>\n\t\t  <div class=\"paragraph paragraph--type--tabs paragraph--view-mode--tabs-content\">\n          \n            <div class=\"clearfix text-formatted field field--name-field-paragraph-content field--type-text-long field--label-hidden field__item\"><p><span lang=\"EN-GB\"><strong>DESA &nbsp;organized a Briefing for Member States and stakeholders on the </strong></span><span><strong>outcomes of the EGMs on Thursday 27 February 2025,</strong> from <strong>3:00 pm – 4:30 pm, in Conference Room 12</strong> at the United Nations Headquarters. See Concept Note and Programme </span><a href=\"http://sdgs.un.org/documents/briefing-outcomes-expert-group-meetings-27-february-2025-57622\" rel=\"nofollow\"><span>here</span></a><span>. This informal briefing was an opportunity to share key messages and solutions from the EGMs to support preparations for the HLPF review of SDGs that will be in-focus this year including SDGs 3, 5, and 8 as well as SDGs 14 and 17.&nbsp;</span></p><p>&nbsp;</p><p><a href=\"http://sdgs.un.org/documents/desa-remarks-57752\" rel=\"nofollow\"><span lang=\"EN-GB\"><strong>Welcome and Introductory Remarks: </strong></span><em><span lang=\"EN-GB\">Lotta Tahtinen, Director, Office of Intergovernmental Support and Coordination for Sustainable Development,</span></em><span lang=\"EN-GB\"><strong> </strong></span><em><span lang=\"EN-GB\">UNDESA</span></em></a></p><p><span lang=\"EN-GB\"><strong>Presentations on EGM key messages and solutions:</strong></span></p><p><a href=\"http://sdgs.un.org/documents/who-and-unfpa-remarks-57754\" rel=\"nofollow\"><span lang=\"EN-GB\"><strong>SDG 3 – Good Health and Wellbeing:</strong> </span><em><span lang=\"EN-GB\">Igor Pokanevych, Senior External Relations Officer, WHO Office at the UN; Ayman Abdelmohsen, Chief Sexual and Reproductive Health and Rights Branch, UNFPA</span></em></a><span>&nbsp;</span></p><p><a href=\"http://sdgs.un.org/documents/un-women-remarks-57749\" rel=\"nofollow\"><span lang=\"EN-GB\"><strong>SDG 5 – Gender Equality: </strong></span><em><span lang=\"EN-GB\">Sarah Hendricks, Director, Policy Programme and Intergovernmental Division, UN Women</span></em></a><span lang=\"EN-GB\">&nbsp;</span></p><p><a href=\"http://sdgs.un.org/documents/ilo-remarks-57768\" rel=\"nofollow\"><span lang=\"EN-GB\"><strong>SDG 8 – Decent Work and Economic Growth: </strong></span><em><span lang=\"EN-GB\">Dino Corell, Senior Multilateral Relations Officer, ILO</span></em></a><span>&nbsp;</span></p><p><a href=\"http://sdgs.un.org/documents/cross-cutting-messages-57757\" rel=\"nofollow\"><span lang=\"EN-GB\"><strong>Cross cutting messages for the SDGs in focus:&nbsp;</strong></span><em><span lang=\"EN-GB\"> Astra Bonini, Chief, Integrated Policy Analysis Branch, DSDG, UN DESA</span></em></a><span>&nbsp;</span></p></div>\n      \n      </div>\n\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t<hr>\n\t\t<section>\n\t\t<div class=\"heading-related row\">\n\t\t<div class=\"col-12\">\n\t\t<h3>Related Topics</h3>\n\t\t</div>\n\t\t</div>\n\t\t<div>\n\t\t<div class=\"row row-spacing\">\n\t\t\n    \n    <div class=\"card card-custom topic-02 col-12 col-sm-6 col-lg-4\">\n      <div class=\"card-content-topics\">\n          <a href=\"/topics/health-and-population\">\n              <img class=\"card-image\" src=\"\n\n    /sites/default/files/2020-04/matheus-ferrero-yfmjALh1S6s-unsplash_1.jpg\n\">\n          </a>\n          <div class=\"card-body\">\n              <a href=\"/topics/health-and-population\">\n                  <h4 class=\"card-title\">\n            <div class=\"field field--name-name field--type-string field--label-hidden field__item\">Health and population</div>\n      </h4>\n              </a>\n                                              <div class=\"label-group\">\n                      <span class=\"label-group-text\">Related Goals</span>\n                      <div class=\"label-group-content\">\n                        \n    \n<span class=\"badge badge-primary goal-3\">\n\t<a href=\"/goals/goal3\">3</a>\n</span>\n\n                      </div>\n                  </div>\n                        </div>\n      </div>\n  </div>\n\n    \n    <div class=\"card card-custom topic-02 col-12 col-sm-6 col-lg-4\">\n      <div class=\"card-content-topics\">\n          <a href=\"/topics/gender-equality-and-womens-empowerment\">\n              <img class=\"card-image\" src=\"\n\n    /sites/default/files/2020-07/topics_15-gendereq