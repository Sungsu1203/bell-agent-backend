ttom: 1.5rem; } .mobile #article-view .article-sytool .helper-tool-group .dropdown-pane[data-dropdown] { top: 100% !important; left: 50% !important; margin-top: 0.5rem; transform: translateX(-50%); } } #article-view .article-sytool .helper-tool-group .dropdown { position: relative; } @media print, screen and (max-width: 39.99875em) { .mobile #article-view .article-sytool .helper-tool-group .dropdown { position: static; } } #article-view .article-sytool .helper-tool-group > *:hover { position: relative; z-index: 5; } @media print, screen and (max-width: 74.99875em) { .mobile #article-view .article-sytool .helper-tool-group > *:hover { z-index: 50; } } @media print, screen and (max-width: 39.99875em) { .mobile #article-view .article-sytool .helper-tool-group > *:hover { position: static; z-index: auto; } } #article-view .article-sytool .helper-tool-group > * + * { margin-top: calc(-1 * var(--tool-border-width)); } @media print, screen and (max-width: 74.99875em) { .mobile #article-view .article-sytool .helper-tool-group > * + * { margin-top: 0; } }\n</style>\n\r\n\r\n<div id=\"article-view\" class=\"atlview\">\r\n\t<div class=\"atlview-wrapper\">\r\n\t\t\r\n\t\t\r\n<script>\r\n\t// 기사면 상단 네비게이션 호출\r\n\tarticleHeader.setScroll();\r\n\t\r\n\t$(window).scroll(function() {\r\n        var currY = $(this).scrollTop();\r\n        var postHeight = $(this).height();\r\n        var scrollHeight = $('body').height();\r\n        var scrollPercent = (currY / (scrollHeight - postHeight)) * 100;\r\n        $('.aht-bar').css('width', scrollPercent +\"%\");\r\n\r\n\t\t// hide for font size dropdown\r\n\t\tif(currY < 300) {\r\n\t\t$(\"#fontsize-sticky\").foundation(\"close\");\r\n\t\t}\r\n    });\r\n</script>\r\n\r\n<!-- 기사면 상단 네비게이션 //-->\r\n<div id=\"sticky-header\">\r\n\r\n\t<!-- 이전/다음 기사 버튼 //-->\r\n\t<button type=\"button\" onclick=\"javascript:articleHeader.move(\r\n\t\t'prev',\r\n\t\t'embargo_date',\r\n\t\t'1719379651_524025',\r\n\t\t'S1N3',\r\n\t\t'S2N13',\r\n\t\t'');\" class=\