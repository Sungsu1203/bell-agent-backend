m/chosunbiz/PMFS5X7QZCVDPBIZ4AHKOSFNJA.jpg\",\"width\":530}},\"taxonomy\":{\"primary_section\":{\"_id\":\"/entertainment/enter_general\",\"name\":\"연예일반\"}},\"type\":\"story\",\"website_url\":\"/entertainment/enter_general/2025/01/28/JEKEOSI3XEHZS6UOGX2Z4HRFQU/\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/entertainment/enter_general\",\"name\":\"연예일반\"},\"website_url\":\"/entertainment/enter_general/2025/01/28/JEKEOSI3XEHZS6UOGX2Z4HRFQU/\"}}},{\"_id\":\"5SB3THTMKBRDGRH57OJF4YUZDI\",\"canonical_url\":\"/entertainment/enter_general/2024/03/28/5SB3THTMKBRDGRH57OJF4YUZDI/\",\"credits\":{\"by\":[{\"name\":\"OSEN\"}]},\"description\":{\"basic\":\" ‘용감한 형사들3’에서 영화 '악인전'의 모티브가 된 사건이 공개된다.오는 29일 방송되는 티캐스트 E채널 ‘용감한 형사들3’(연출 이지선) 31회에는 김태용, 전주삼 형사가 출연해 직접 해결한 수사 일지를 펼친다.이날 소개되는 사건은 전날 밤 회식을 마친 뒤, 직장동료와 찜질방에 다녀오겠다던 남편이 다음 날까지 귀가하지 않고 휴대전화 전원도 꺼져 있다는\"},\"display_date\":\"2024-03-27T23:41:00Z\",\"headlines\":{\"basic\":\"회식 후 갑자기 사라진 남편…영화 '악인전' 모티브된 실제 사건 ('용감한 형사들3')\"},\"promo_items\":{\"basic\":{\"_id\":\"IAZL4T6JAIYFU4NJD6Q7ODLB7Q\",\"caption\":\"\",\"credits\":{},\"height\":547,\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/IAZL4T6JAIYFU4NJD6Q7ODLB7Q.jpg?auth=cbd266066d9721638a8b6b239cf1fe0f0c1b91654dcb126047d3190cab016c7b&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/IAZL4T6JAIYFU4NJD6Q7ODLB7Q.jpg?auth=cbd266066d9721638a8b6b239cf1fe0f0c1b91654dcb126047d3190cab016c7b&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/IAZL4T6JAIYFU4NJD6Q7ODLB7Q.jpg?auth=cbd266066d9721638a8b6b239cf1fe0f0c1b91654dcb126047d3190cab016c7b&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/IAZL4T6JAIYFU4NJD6Q7ODLB7Q.jpg?auth=cbd266066d9721638a8b6b239cf1fe0f0c1b91654dcb126047d3190cab016c7b&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/IAZL4T6JAIYFU4NJD6Q7ODLB7Q.jpg?auth=cbd266066d9721638a8b6b239cf1fe0f0c1b91654dcb126047d3190cab016c7b&width=650&height=650&smart=true\"},\"type\":\"image\",\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/IAZL4T6JAIYFU4NJD6Q7ODLB7Q.jpg\",\"width\":650}},\"taxonomy\":{\"primary_section\":{\"_id\":\"/entertainment/enter_general\",\"name\":\"연예일반\"}},\"type\":\"story\",\"website_url\":\"/entertainment/enter_general/2024/03/28/5SB3THTMKBRDGRH57OJF4YUZDI/\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/entertainment/enter_general\",\"name\":\"연예일반\"},\"website_url\":\"/entertainment/enter_general/2024/03/28/5SB3THTMKBRDGRH57OJF4YUZDI/\"}}}],\"_id\":\"c2e497359abf5c51b50219e9edd37947df770fc20c2b720a763addaaac06d6ff\"},\"expires\":1759137127618,\"lastModified\":1759135326670},\"{\\\"exdistributor\\\":\\\"\\\",\\\"exstory\\\":\\\"SUFOALA6GVSDEHD2IZJITKBLT4\\\",\\\"limit\\\":5,\\\"section\\\":\\\"스포츠\\\",\\\"type\\\":\\\"story\\\"}\":{\"data\":{\"content_elements\":[{\"_id\":\"RBOEPTVLAJBNHM4DQ4IQHTUYO4\",\"canonical_url\":\"/sports/2025/09/29/RBOEPTVLAJBNHM4DQ4IQHTUYO4/\",\"credits\":{\"by\":[{\"_id\":\"SEO-ILWON\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"서일원 기자\",\"middleName\":\"Seo Il-won\"}},\"name\":\"일원 서\",\"url\":\"\"}]},\"description\":{\"basic\":\"프로야구 통산 등판 경기 4위와 홀드 3위에 빛나는 롯데의 왼팔 투수 진해수(39)가 유니폼을 벗는다. 롯데 구단은 29일 진해수가 구단을 통해 은퇴 의사를 밝혔다고 전했다. 부산 출신의 진해수는 경남중과 부경고를 졸업하고 2005년 KIA 타이거즈에 입단해 주로 불펜 투수로 활약했다. 이후 SK 와이번스(현 SSG 랜더스)와 LG 트윈스를 거쳐 2024년 롯데 유니폼을 입고 고향에 돌아왔다. 진해수는 프로 통산 842경기에 등판해 25승 31패 2세이브 157홀드 평균자책점 5.02라는 성적을 남겼다. 157홀드는 프로야구 역대 통산 홀드 3위에 해당하는 기록이다. 진해수는 지난해 6월 KT와 경기에서 투수 중 역대 5번째로 800경기 출장이라는 대기록을 세웠다. 그보다 많은 경기를 등판한 투수도 정우람(...\"},\"display_date\":\"2025-09-29T01:32:38.287Z\",\"headlines\":{\"basic\":\"‘통산 842경기·홀드 3위’ 롯데 진해수 은퇴 “팬께 진심으로 감사”\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/O32MZLGJERCUZFQQ7B6C3LIQKY.jpg?auth=0817d6ed048c0746c0c2314fe64ee09d7e5870850652f60b26eba4fac8bdfbdf&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/O32MZLGJERCUZFQQ7B6C3LIQKY.jpg?auth=0817d6ed048c0746c0c2314fe64ee09d7e5870850652f60b26eba4fac8bdfbdf&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/O32MZLGJERCUZFQQ7B6C3LIQKY.jpg?auth=0817d6ed048c0746c0c2314fe64ee09d7e5870850652f60b26eba4fac8bdfbdf&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/O32MZLGJERCUZFQQ7B6C3LIQKY.jpg?auth=0817d6ed048c0746c0c2314fe64ee09d7e5870850652f60b26eba4fac8bdfbdf&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/O32MZLGJERCUZFQQ7B6C3LIQKY.jpg?auth=0817d6ed048c0746c0c2314fe64ee09d7e5870850652f60b26eba4fac8bdfbdf&width=647&height=647&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/O32MZLGJERCUZFQQ7B6C3LIQKY.jpg\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/sports\",\"name\":\"스포츠\"}},\"type\":\"story\",\"website_url\":\"/sports/2025/09/29/RBOEPTVLAJBNHM4DQ4IQHTUYO4/\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/sports\",\"name\":\"스포츠\"},\"website_url\":\"/sports/2025/09/29/RBOEPTVLAJBNHM4DQ4IQHTUYO4/\"}}},{\"_id\":\"OFES3OXOVLQHVXVIEIIQ2UKBGI\",\"canonical_url\":\"/sports/sports_general/2025/09/22/OFES3OXOVLQHVXVIEIIQ2UKBGI/\",\"credits\":{\"by\":[{\"name\":\"OSEN\"}]},\"description\":{\"basic\":\" 대전 삼성화재 블루팡스 배구단이 창단 30주년을 기념해 해외클럽팀을 초대해 친선경기를 치른다.일본 도레이 애로우즈 시즈오카를 초청해 진행되는 ‘삼성화재 배구단 창단 30주년 기념 해외클럽 교류전’은 오는 27일 오후 2시 대전충무체육관에서 진행되며, 관중들은 무료 입장해 경기를 관람할 수 있다. 또한 해당 경기는 KBSN스포츠 채널을 통해 생중계될 예정이\"},\"display_date\":\"2025-09-22T02:11:00Z\",\"headlines\":{\"basic\":\"삼성화재, 창단 30주년 기념 日 도레이 애로우즈 초청 친선전 개최\"},\"promo_items\":{\"basic\":{\"_id\":\"D6HINGACIIA4AITSA7G3U5TY5I\",\"caption\":\"\",\"credits\":{},\"height\":662,\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/D6HINGACIIA4AITSA7G3U5TY5I.png?auth=a9f6fed05e0a72c03895313b7215586d6429297309c67b99ec197aebccc60744&width=530&height=530&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/D6HINGACIIA4AITSA7G3U5TY5I.png?auth=a9f6fed05e0a72c03895313b7215586d6429297309c67b99ec197aebccc60744&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/D6HINGACIIA4AITSA7G3U5TY5I.png?auth=a9f6fed05e0a72c03895313b7215586d6429297309c67b99ec197aebccc60744&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/D6HINGACIIA4AITSA7G3U5TY5I.png?auth=a9f6fed05e0a72c03895313b7215586d6429297309c67b99ec197aebccc60744&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/D6HINGACIIA4AITSA7G3U5TY5I.png?auth=a9f6fed05e0a72c03895313b7215586d6429297309c67b99ec197aebccc60744&width=530&height=530&smart=true\"},\"type\":\"image\",\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/D6HINGACIIA4AITSA7G3U5TY5I.png\",\"width\":530}},\"taxonomy\":{\"primary_section\":{\"_id\":\"/sports/sports_general\",\"name\":\"스포츠 일반\"}},\"type\":\"story\",\"website_url\":\"/sports/sports_general/2025/09/22/OFES3OXOVLQHVXVIEIIQ2UKBGI/\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/sports/sports_general\",\"name\":\"스포츠 일반\"},\"website_url\":\"/sports/sports_general/2025/09/22/OFES3OXOVLQHVXVIEIIQ2UKBGI/\"}}},{\"_id\":\"RA7SAAT625SVZB5TGQB7PTDLCQ\",\"canonical_url\":\"/sports/baseball/2025/09/12/RA7SAAT625SVZB5TGQB7PTDLCQ/\",\"credits\":{\"by\":[{\"name\":\"OSEN\"}]},\"description\":{\"basic\":\" 12일 잠실구장에서 열릴 예정이던 프로야구 LG 트윈스와 NC 다이노스의 시즌 15차전 맞대결이 우천 취소됐다. 이날 잠실구장은 오후 5시 무렵 가랑비가 내리기 시작했다. 그라운드에 방수포를 덮었고, 관중들은 입장했다. 이후 빗줄기가 조금 가늘어지자, 방수포를 걷어내고 그라운드 정비 작업을 시작했다. 전광판에는 오후 6시40분 지연 시작을 알렸다. 그러나\"},\"display_date\":\"2025-09-12T10:42:00Z\",\"headlines\":{\"basic\":\"한화도 LG도 나란히 우천 취소, 3.5경기 차 그대로…한화는 지옥의 8연전, LG는 10월 추후 편성\"},\"promo_items\":{\"basic\":{\"_id\":\"QBOANUT3WYC2LYEI6Z2IN2SMF4\",\"caption\":\"\",\"credits\":{},\"height\":399,\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/QBOANUT3WYC2LYEI6Z2IN2SMF4.jpg?auth=2d45a83254d658ae7727db52d1564cd6ab86288be81332222132de6be3ddf314&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/QBOANUT3WYC2LYEI6Z2IN2SMF4.jpg?auth=2d45a83254d658ae7727db52d1564cd6ab86288be81332222132de6be3ddf314&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/QBOANUT3WYC2LYEI6Z2IN2SMF4.jpg?auth=2d45a83254d658ae7727db52d1564cd6ab86288be81332222132de6be3ddf314&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/QBOANUT3WYC2LYEI6Z2IN2SMF4.jpg?auth=2d45a83254d658ae7727db52d1564cd6ab86288be81332222132de6be3ddf314&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/QBOANUT3WYC2LYEI6Z2IN2SMF4.jpg?auth=2d45a83254d658ae7727db52d1564cd6ab86288be81332222132de6be3ddf314&width=650&height=650&smart=true\"},\"type\":\"image\",\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/QBOANUT3WYC2LYEI6Z2IN2SMF4.jpg\",\"width\":650}},\"taxonomy\":{\"primary_section\":{\"_id\":\"/sports/baseball\",\"name\":\"야구\"}},\"type\":\"story\",\"website_url\":\"/sports/baseball/2025/09/12/RA7SAAT625SVZB5TGQB7PTDLCQ/\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/sports/baseball\",\"name\":\"야구\"},\"website_url\":\"/sports/baseball/2025/09/12/RA7SAAT625SVZB5TGQB7PTDLCQ/\"}}}],\"_id\":\"856fdcdb14b35e8e31c271aae82d7de276ccf047a99260175751f04c1483d564\"},\"expires\":1759137583066,\"lastModified\":1759135782170}},\"story-feed\":{\"{\\\"excludeDistributorNames\\\":\\\"Stockplus,News1_WEB,pickcon,Sellymon,Osen\\\",\\\"excludeSections\\\":\\\"/real_estate/aptbot, /stock/c-biz_bot, /chosunbiz-k, /csr, /entertainment, /sport, /en, /moneymove\\\",\\\"includeContentTypes\\\":\\\"story\\\",\\\"includeSections\\\":\\\"\\\",\\\"size\\\":10}\":{\"data\":{\"content_elements\":[{\"_id\":\"JOAASW6ZPJE3XJB67HTD6O2QUE\",\"canonical_url\":\"/notice/appointment/2025/09/29/JOAASW6ZPJE3XJB67HTD6O2QUE/\",\"credits\":{\"by\":[{\"_id\":\"hong-areum\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"홍아름 기자\",\"middleName\":\"Hong A-reum\"}},\"name\":\"아름 홍\",\"org\":\"서울\",\"url\":\"\"}]},\"description\":{\"basic\":\"&lt;전보&gt; ◇과장급 ▲지역과학기술진흥과장 최영실 (2025년 10월 1일자)\"},\"display_date\":\"2025-09-29T09:06:41.156Z\",\"headlines\":{\"basic\":\"[인사] 과학기술정보통신부\",\"mobile\":\"\"},\"label\":{},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/notice/appointment\",\"name\":\"인사\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/notice/appointment\",\"name\":\"인사\"},\"website_url\":\"/notice/appointment/2025/09/29/JOAASW6ZPJE3XJB67HTD6O2QUE/\"}}},{\"_id\":\"THPCL53KPZHHXJGVNLQIUOAXKM\",\"canonical_url\":\"/stock/finance/2025/09/29/THPCL53KPZHHXJGVNLQIUOAXKM/\",\"credits\":{\"by\":[{\"_id\":\"Lee-HakJun\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"이학준 기자\",\"middleName\":\"Lee Hak-jun\"}},\"name\":\"학준 이\",\"org\":\"서울\",\"url\":\"\"}]},\"description\":{\"basic\":\"이억원 금융위원장은 석유화학산업 구조개편과 관련해 기업이 충분한 자구노력을 했다는 전제 아래에서만 금융 지원이 가능하다는 원칙을 다시 한번 강조했다. 이 위원장은 29일 서울 중구 은행연합회에서 열린 20곳 은행장과의 간담회를 마치고 기자들과 만난 자리에서 석유화학 구조조정 관련 질문에 대해 “가장 중요한 것은 기업들이 다시 생존하고 경쟁력을 갖춰야 하는 것”이라면서도 “대주주의 철저한 자구노력 전제 하에 같이 실사에도 참여해 지원할 수 있다는 원칙은 유효하다”고 했다. 금융 당국은 석유화학 업계의 자구노력과 고통 분담이 전제돼야 금융 지원에 나설 수 있다고 강조해 왔다. 권대영 금융위 부위원장은 지난달 21일 열린 석유화학 사업재편을 위한 간담회에서 “자기 뼈를 깎는 자구노력과 구체적이고 타당한 사업재편 ...\"},\"display_date\":\"2025-09-29T09:06:17.1Z\",\"headlines\":{\"basic\":\"이억원 “석유화학 재편, 대주주 철저한 자구노력 있어야 지원 가능”\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/DNWVVRY3RRIOXONPXTAITVVL4Y.jpg?auth=81e9e53e6d115bfe1e6eba3e79d68991c75544743bdb46c5f1f6c4d11edb1f99&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/DNWVVRY3RRIOXONPXTAITVVL4Y.jpg?auth=81e9e53e6d115bfe1e6eba3e79d68991c75544743bdb46c5f1f6c4d11edb1f99&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/DNWVVRY3RRIOXONPXTAITVVL4Y.jpg?auth=81e9e53e6d115bfe1e6eba3e79d68991c75544743bdb46c5f1f6c4d11edb1f99&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/DNWVVRY3RRIOXONPXTAITVVL4Y.jpg?auth=81e9e53e6d115bfe1e6eba3e79d68991c75544743bdb46c5f1f6c4d11edb1f99&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/DNWVVRY3RRIOXONPXTAITVVL4Y.jpg?auth=81e9e53e6d115bfe1e6eba3e79d68991c75544743bdb46c5f1f6c4d11edb1f99&width=1264&height=1264&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/DNWVVRY3RRIOXONPXTAITVVL4Y.jpg\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/stock/finance\",\"name\":\"금융\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/stock/finance\",\"name\":\"금융\"},\"website_url\":\"/stock/finance/2025/09/29/THPCL53KPZHHXJGVNLQIUOAXKM/\"}}},{\"_id\":\"T6L37IT7GJDNJOUJAIASUGIRMQ\",\"canonical_url\":\"/science-chosun/science/2025/09/29/T6L37IT7GJDNJOUJAIASUGIRMQ/\",\"credits\":{\"by\":[{\"_id\":\"yeom-hyuna\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"염현아 기자\",\"middleName\":\"Yeom Hyun-a\"}},\"name\":\"현아 염\",\"url\":\"\"}]},\"description\":{\"basic\":\"한국표준과학연구원(KRISS)이 실제 사람 눈 구조를 정밀하게 재현한 ‘인공 눈’을 개발했다고 29일 밝혔다. 이번 기술은 안과에서 사용하는 망막 진단 장비의 성능을 객관적으로 평가하고 보정할 수 있는 기준을 제공해, 망막 질환의 조기 진단과 치료 정확도를 크게 높일 것으로 기대된다. 망막은 빛을 감지해 시각 정보를 뇌로 전달하는 중요한 조직이다. 그러나 고령화, 전자기기 사용 증가, 유전적 요인 등으로 망막 질환 환자가 꾸준히 늘고 있다. 망막 손상은 회복이 어려워 조기 진단과 지속적인 모니터링이 특히 중요하다. 현재 안과에서는 광간섭단층촬영(OCT)이나 형광안저혈관조영술 등 다양한 장비를 이용해 망막을 검사하지만, 병원과 장비마다 측정값이 다르고 이를 비교하거나 보정할 수 있는 표준 기준이 없어 정확성에...\"},\"display_date\":\"2025-09-29T09:05:30.061Z\",\"headlines\":{\"basic\":\"실제 눈과 닮은 ‘인공 눈’ 개발…망막 질환 진단 정확도 높인다\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/PALQOKT3VFBNRGKCCUYQTIXOGE.jpg?auth=c1026bcfab45f1a7232f43b10598192c6afe419f652d689b870abf73888e189b&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/PALQOKT3VFBNRGKCCUYQTIXOGE.jpg?auth=c1026bcfab45f1a7232f43b10598192c6afe419f652d689b870abf73888e189b&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/PALQOKT3VFBNRGKCCUYQTIXOGE.jpg?auth=c1026bcfab45f1a7232f43b10598192c6afe419f652d689b870abf73888e189b&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/PALQOKT3VFBNRGKCCUYQTIXOGE.jpg?auth=c1026bcfab45f1a7232f43b10598192c6afe419f652d689b870abf73888e189b&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/PALQOKT3VFBNRGKCCUYQTIXOGE.jpg?auth=c1026bcfab45f1a7232f43b10598192c6afe419f652d689b870abf73888e189b&width=1264&height=1264&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/PALQOKT3VFBNRGKCCUYQTIXOGE.jpg\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/science-chosun/science\",\"name\":\"과학\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/science-chosun/science\",\"name\":\"과학\"},\"website_url\":\"/science-chosun/science/2025/09/29/T6L37IT7GJDNJOUJAIASUGIRMQ/\"}}},{\"_id\":\"FXXESEGKY5BAPKX3J5ZU77MIBY\",\"canonical_url\":\"/science-chosun/bio/2025/09/29/FXXESEGKY5BAPKX3J5ZU77MIBY/\",\"credits\":{\"by\":[{\"_id\":\"heo-jiyoon\",\"additional_properties\":{\"original\":{\"byline\":\"허지윤 기자\",\"middleName\":\"Heo Ji-yoon\"}},\"name\":\"지윤 허\",\"org\":\"서울\"}]},\"description\":{\"basic\":\"##한미약품##은 미국 제약기업 길리어드사이언스(Gilead Sciences Inc.), 헬스호프파마(Health Hope Pharma (UK) Limited)와 한미약품 플랫폼 기술인 오라스커버리(ORASCOVERY) 기반 경구 흡수 강화제 엔세퀴다르(Encequidar)에 대한 기술 이전 계약을 체결했다고 29일 공시했다. 계약 규모는 최대 3450만달러(483억원)다. 경구 흡수 강화제는 약물이 입을 통해 복용될 때 장에서 체내로 흡수되는 효율을 높여주는 물질이다. 이번 계약은 한미약품과 헬스호프파마가 기존 전략적 협력 관계를 수정해 헬스호프파마가 보유했던 엔세퀴다르에 대한 한국 외 권리를 길리어드에 부여한 것이다. 이에 따라 길리어드는 한미약품이 제공하는 원료의약품(API), 완제의약품, 기술 노하우...\"},\"display_date\":\"2025-09-29T09:05:10.305Z\",\"headlines\":{\"basic\":\"한미약품, 美 길리어드에 흡수 강화제 기술 수출…최대 483억원 규모\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/UXL7NR32MNBD5AD2VOVJWTRFKA.jfif?auth=73439de9543638f49610c59a17f31a53e6ed487b0d26bd8464457008af265d89&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/UXL7NR32MNBD5AD2VOVJWTRFKA.jfif?auth=73439de9543638f49610c59a17f31a53e6ed487b0d26bd8464457008af265d89&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/UXL7NR32MNBD5AD2VOVJWTRFKA.jfif?auth=73439de9543638f49610c59a17f31a53e6ed487b0d26bd8464457008af265d89&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/UXL7NR32MNBD5AD2VOVJWTRFKA.jfif?auth=73439de9543638f49610c59a17f31a53e6ed487b0d26bd8464457008af265d89&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/UXL7NR32MNBD5AD2VOVJWTRFKA.jfif?auth=73439de9543638f49610c59a17f31a53e6ed487b0d26bd8464457008af265d89&width=1264&height=1264&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/UXL7NR32MNBD5AD2VOVJWTRFKA.jfif\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/science-chosun/bio\",\"name\":\"제약 바이오\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/science-chosun/bio\",\"name\":\"제약 바이오\"},\"website_url\":\"/science-chosun/bio/2025/09/29/FXXESEGKY5BAPKX3J5ZU77MIBY/\"}}},{\"_id\":\"MEKFAGB7UVFR5MG7TRT5HOLNTQ\",\"canonical_url\":\"/science-chosun/science/2025/09/29/MEKFAGB7UVFR5MG7TRT5HOLNTQ/\",\"credits\":{\"by\":[{\"_id\":\"yeom-hyuna\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"염현아 기자\",\"middleName\":\"Yeom Hyun-a\"}},\"name\":\"현아 염\",\"url\":\"\"}]},\"description\":{\"basic\":\"암 발생 원인이나 진행 양상은 물론 치료법도 전혀 다르지만 겉모습은 흡사한 ‘쌍둥이’ 뇌종양이 있다. 암세포 모양이나 조직 구조가 워낙 비슷해 오진이 잦았다. 미국 과학자들이 두 뇌종양을 정확하게 구분하는 인공지능(AI)을 개발했다.  하버드 의대 연구진은 “교모세포종과 원발성 중추신경계 림프종(PCNSL)을 카메라로 찍어 98% 정확도로 구분해내는 AI 도구 ‘픽쳐(PICTURE)’를 개발했다”고 국제 학술지 ‘네이처 커뮤니케이션즈(Nature Communications)’ 29일(현지 시각) 발표했다. 교모세포종은 뇌세포에서 발생하는 가장 흔하고 공격적인 종양이다. 반면 PCNSL은 면역세포에서 생기지만 종종 교모세포종으로 잘못 진단된다. 치료 전략도 정반대다. 교모세포종은 가능한 한 종양을 절제해야 하...\"},\"display_date\":\"2025-09-29T09:00:00Z\",\"headlines\":{\"basic\":\"쌍둥이처럼 구별 힘든 뇌종양, AI가 98% 구분\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/PFKPDNDOX5ERLIJSZNHCUSJCCE.png?auth=bd0205a904a082e410291d3ef0aec59048125f4526f0171752d82bcde7200abc&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/PFKPDNDOX5ERLIJSZNHCUSJCCE.png?auth=bd0205a904a082e410291d3ef0aec59048125f4526f0171752d82bcde7200abc&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/PFKPDNDOX5ERLIJSZNHCUSJCCE.png?auth=bd0205a904a082e410291d3ef0aec59048125f4526f0171752d82bcde7200abc&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/PFKPDNDOX5ERLIJSZNHCUSJCCE.png?auth=bd0205a904a082e410291d3ef0aec59048125f4526f0171752d82bcde7200abc&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/PFKPDNDOX5ERLIJSZNHCUSJCCE.png?auth=bd0205a904a082e410291d3ef0aec59048125f4526f0171752d82bcde7200abc&width=633&height=633&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/PFKPDNDOX5ERLIJSZNHCUSJCCE.png\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/science-chosun/science\",\"name\":\"과학\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/science-chosun/science\",\"name\":\"과학\"},\"website_url\":\"/science-chosun/science/2025/09/29/MEKFAGB7UVFR5MG7TRT5HOLNTQ/\"}}},{\"_id\":\"6YWIZLEY75GTHLVGDRKIS7PYGU\",\"canonical_url\":\"/distribution/fashion-beauty/2025/09/29/6YWIZLEY75GTHLVGDRKIS7PYGU/\",\"credits\":{\"by\":[{\"_id\":\"kim-eunyoung\",\"additional_properties\":{\"original\":{\"byline\":\"김은영 기자\",\"middleName\":\"Kim Eun-young\"}},\"name\":\"은영 김\",\"org\":\"서울\"}]},\"description\":{\"basic\":\"영원아웃도어의 아웃도어 브랜드 노스페이스가 국내 스포츠 클라이밍의 발전 및 저변 확대에 앞장서고 있다.  29일 관련 업계에 따르면 영원아웃도어는 지난 20~28일 열린 ‘2025 국제스포츠클라이밍연맹(IFSC) 서울 스포츠클라이밍·파라클라이밍 세계선수권대회’를 공식 후원한 데 이어, 27일 대한산악연맹과 공동 주최·주관한 ‘제29회 노스페이스컵 전국 스포츠클라이밍대회’를 개최했다.  ‘서울 스포츠클라이밍 세계선수권’에서는 노스페이스 소속 선수인 서채현 선수가 여자 리드 부문에서 동메달을 획득했고, 정지민 선수는 스피드 부문에서 4위를 기록했다. 또 노스페이스가 2010년부터 후원하는 대한민국 스포츠클라이밍 국가대표팀이 금메달 1개와 동메달 2개를 획득했다.  1997년 국내 시장에 출범한 노스페이스는 업계...\"},\"display_date\":\"2025-09-29T08:58:45.446Z\",\"headlines\":{\"basic\":\"영원아웃도어 노스페이스, 국내 스포츠클라이밍 저변 확대 앞장\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/2BDXFERJQVMOTLWIG76OO5Q2PU.jpg?auth=ce5c518e79dea7ba7b4e06de6ba354c72cd1df89d193514e980a5c1a6ca65ffe&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/2BDXFERJQVMOTLWIG76OO5Q2PU.jpg?auth=ce5c518e79dea7ba7b4e06de6ba354c72cd1df89d193514e980a5c1a6ca65ffe&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/2BDXFERJQVMOTLWIG76OO5Q2PU.jpg?auth=ce5c518e79dea7ba7b4e06de6ba354c72cd1df89d193514e980a5c1a6ca65ffe&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/2BDXFERJQVMOTLWIG76OO5Q2PU.jpg?auth=ce5c518e79dea7ba7b4e06de6ba354c72cd1df89d193514e980a5c1a6ca65ffe&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/2BDXFERJQVMOTLWIG76OO5Q2PU.jpg?auth=ce5c518e79dea7ba7b4e06de6ba354c72cd1df89d193514e980a5c1a6ca65ffe&width=1264&height=1264&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/2BDXFERJQVMOTLWIG76OO5Q2PU.jpg\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/distribution/fashion-beauty\",\"name\":\"패션·뷰티\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/distribution/fashion-beauty\",\"name\":\"패션·뷰티\"},\"website_url\":\"/distribution/fashion-beauty/2025/09/29/6YWIZLEY75GTHLVGDRKIS7PYGU/\"}}},{\"_id\":\"OPWBJX62RBFSJIAJSG4OY7REHA\",\"canonical_url\":\"/stock/stock_general/2025/09/29/OPWBJX62RBFSJIAJSG4OY7REHA/\",\"credits\":{\"by\":[{\"_id\":\"kang-junga\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"강정아 기자\",\"middleName\":\"Kang Jung-a\"}},\"name\":\"정아 강\",\"url\":\"\"}]},\"description\":{\"basic\":\"부동산 조각투자 상품과 같은 신종증권을 거래할 수 있는 시장이 곧 열릴 것으로 보인다. 한국거래소는 신종증권시장 운영규정은 오는 10월 중 시행하고, 상장 예비 심사 신청도 받을 계획이다. 29일 금융투자업계에 따르면 거래소는 지난 22일 신종증권시장 운영 규정을 제정하고, 관계사들로부터 운영 규정 시행세칙 관련 의견을 수렴하고 있다. 10월 1일까지 모인 의견에 큰 문제가 없다면 10월 중으로 규정을 바로 시행할 예정이다. 규정이 시행되면 신종증권 상장 절차를 위한 근거가 마련되는 만큼, 곧바로 상장 예비 심사 접수가 시작된다. 신규 상장 신청과 승인까지 걸리는 시간을 고려할 때 이르면 올해 말 신종증권시장 1호 상품이 등장할 수 있다. 거래소 관계자는 “신종증권 예비 심사 청구가 연내에 들어오면 이르면 ...\"},\"display_date\":\"2025-09-29T08:56:30.501Z\",\"headlines\":{\"basic\":\"‘조각투자 시장’ 개장 임박… 거래소, 10월 제도 시행 후 상장 접수\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/5B4ABAKAE7YNVEZM7FK4B7QGVQ.jpg?auth=b97285fe47b3222dd7ce1616611ad6ed81ee595b274ca1485943e841750fbe7d&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/5B4ABAKAE7YNVEZM7FK4B7QGVQ.jpg?auth=b97285fe47b3222dd7ce1616611ad6ed81ee595b274ca1485943e841750fbe7d&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/5B4ABAKAE7YNVEZM7FK4B7QGVQ.jpg?auth=b97285fe47b3222dd7ce1616611ad6ed81ee595b274ca1485943e841750fbe7d&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/5B4ABAKAE7YNVEZM7FK4B7QGVQ.jpg?auth=b97285fe47b3222dd7ce1616611ad6ed81ee595b274ca1485943e841750fbe7d&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/5B4ABAKAE7YNVEZM7FK4B7QGVQ.jpg?auth=b97285fe47b3222dd7ce1616611ad6ed81ee595b274ca1485943e841750fbe7d&width=1080&height=1080&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/5B4ABAKAE7YNVEZM7FK4B7QGVQ.jpg\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/stock/stock_general\",\"name\":\"증권 일반\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/stock/stock_general\",\"name\":\"증권 일반\"},\"website_url\":\"/stock/stock_general/2025/09/29/OPWBJX62RBFSJIAJSG4OY7REHA/\"}}},{\"_id\":\"L5ZZL2HGOBFE3IFGFVMXEBRGV4\",\"canonical_url\":\"/policy/politics/assembly/2025/09/29/L5ZZL2HGOBFE3IFGFVMXEBRGV4/\",\"credits\":{\"by\":[{\"_id\":\"Park-sukhyeon\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"박숙현 기자\",\"middleName\":\"Park Suk-hyeon\"}},\"name\":\"숙현 박\",\"org\":\"서울\",\"url\":\"\"}]},\"description\":{\"basic\":\"더불어민주당이 조희대 대법원장 청문회를 30일 예정대로 진행하기로 했다. 조 대법원장이 불출석 의사를 통보해 순조로운 절차가 어려울 것이라는 전망 속에서도, 청문회를 하루 앞두고 실시 여부를 논의한 끝에 일정을 그대로 강행하기로 한 것이다. 민주당은 조 대법원장이 끝내 나오지 않을 경우, 다음 달 대법원 국정감사에서 현장 국감을 포함해 청문회에 준하는 수준으로 진행하겠다는 방침이다. 박수현 민주당 수석대변인은 29일 고위전략회의 및 비공개 최고위원회의 후 기자들과 만나 “내일 청문회는 예정대로 진행된다”고 밝혔다. 이어 “순조로운 청문 절차가 진행되지 않을 것이기 때문에 의사진행발언 등을 통해 유감을 표할 것”고 밝혔다. 이어 “대법원 국감을 청문회 수준으로 할 것”이라고 덧붙였다.  민주당은 필요하면 대법...\"},\"display_date\":\"2025-09-29T08:55:43.509Z\",\"headlines\":{\"basic\":\"與, ‘조희대 청문회’ 30일 예정대로 진행…“불출석 땐 청문회 수준 국감”\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/YY7ARU5PYVOL3GL3OEBYP2VLFM.JPG?auth=57e0a4d358b894f6835a2b98f5d9719f05213bfc1c815952d47a2c4ad762aded&width=616&height=616&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/YY7ARU5PYVOL3GL3OEBYP2VLFM.JPG?auth=57e0a4d358b894f6835a2b98f5d9719f05213bfc1c815952d47a2c4ad762aded&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/YY7ARU5PYVOL3GL3OEBYP2VLFM.JPG?auth=57e0a4d358b894f6835a2b98f5d9719f05213bfc1c815952d47a2c4ad762aded&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/YY7ARU5PYVOL3GL3OEBYP2VLFM.JPG?auth=57e0a4d358b894f6835a2b98f5d9719f05213bfc1c815952d47a2c4ad762aded&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/YY7ARU5PYVOL3GL3OEBYP2VLFM.JPG?auth=57e0a4d358b894f6835a2b98f5d9719f05213bfc1c815952d47a2c4ad762aded&width=1264&height=1264&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/YY7ARU5PYVOL3GL3OEBYP2VLFM.JPG\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/policy/politics/assembly\",\"name\":\"국회·정당\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/policy/politics/assembly\",\"name\":\"국회·정당\"},\"website_url\":\"/policy/politics/assembly/2025/09/29/L5ZZL2HGOBFE3IFGFVMXEBRGV4/\"}}},{\"_id\":\"ZCDC7LPH2VGU7HZ7KTUTL2AXTE\",\"canonical_url\":\"/real_estate/real_estate_general/2025/09/29/ZCDC7LPH2VGU7HZ7KTUTL2AXTE/\",\"credits\":{\"by\":[{\"_id\":\"jo-eunim\",\"additional_properties\":{\"original\":{\"byline\":\"조은임 기자\",\"middleName\":\"Jo Eun-im\"}},\"name\":\"은임 조\",\"org\":\"서울\"}]},\"description\":{\"basic\":\"대우건설이 서울 용산구 ‘청파1구역’ 재개발 사업 시공사로 선정됐다고 29일 밝혔다.  이 사업은 서울 용산구 청파동2가 11-1번지 일대에 지하 5층~지상 25층, 10개동, 공동주택 626가구 및 부대복리시설을 짓는 사업이다. 공사비는 3556억원(VAT 별도) 규모다.  대우건설은 하이엔드 브랜드 ‘써밋’을 적용해 단지명을 ‘루이리스 써밋’으로 제안했다. ‘루이리스 써밋은 ‘왕실(Royal)과 프랑스 왕실의 상징 ’백합(Lis)‘을 결합한 명칭이다. 루미리스 써밋은 프랑스의 건축 거장인 장 미셸 빌모트와의 협업을 통해 공급될 예정이다. 대우건설은 프랑스 왕실의 유산을 현대적으로 재해석해 이를 랜드마크 외관과 조경, 그리고 커뮤니티 시설에 담아낼 계획이다. 단지 내에는 1660㎡ 규모의 대형 중앙광장과 ...\"},\"display_date\":\"2025-09-29T08:54:21.542Z\",\"headlines\":{\"basic\":\"대우건설, 용산 ‘청파1구역 재개발’ 시공사로 선정… ‘루이리스 써밋’ 제안\",\"mobile\":\"\"},\"label\":{},\"promo_items\":{\"basic\":{\"resizedUrls\":{\"1x1_lg\":\"https://biz.chosun.com/resizer/v2/VANEJAFVJ5AUXCDKJJAJVYYY2I.png?auth=e8f819583387133e26d0f377aa43e9cf331caefa44a586563cf8b4c8a0ddc2cb&width=583&height=583&smart=true\",\"1x1_md\":\"https://biz.chosun.com/resizer/v2/VANEJAFVJ5AUXCDKJJAJVYYY2I.png?auth=e8f819583387133e26d0f377aa43e9cf331caefa44a586563cf8b4c8a0ddc2cb&width=400&height=400&smart=true\",\"1x1_sm\":\"https://biz.chosun.com/resizer/v2/VANEJAFVJ5AUXCDKJJAJVYYY2I.png?auth=e8f819583387133e26d0f377aa43e9cf331caefa44a586563cf8b4c8a0ddc2cb&width=184&height=184&smart=true\",\"1x1_xs\":\"https://biz.chosun.com/resizer/v2/VANEJAFVJ5AUXCDKJJAJVYYY2I.png?auth=e8f819583387133e26d0f377aa43e9cf331caefa44a586563cf8b4c8a0ddc2cb&width=80&height=80&smart=true\",\"1x1_xxl\":\"https://biz.chosun.com/resizer/v2/VANEJAFVJ5AUXCDKJJAJVYYY2I.png?auth=e8f819583387133e26d0f377aa43e9cf331caefa44a586563cf8b4c8a0ddc2cb&width=583&height=583&smart=true\"},\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/VANEJAFVJ5AUXCDKJJAJVYYY2I.png\"}},\"related_content\":{\"basic\":[]},\"taxonomy\":{\"primary_section\":{\"_id\":\"/real_estate/real_estate_general\",\"name\":\"부동산 일반\"}},\"type\":\"story\",\"websites\":{\"chosunbiz\":{\"website_section\":{\"_id\":\"/real_estate/real_estate_general\",\"name\":\"부동산 일반\"},\"website_url\":\"/real_estate/real_estate_general/2025/09/29/ZCDC7LPH2VGU7HZ7KTUTL2AXTE/\"}}},{\"_id\":\"TM354MHG55DC5M5TTY6HOUO4S4\",\"canonical_url\":\"/policy/politics/assembly/2025/09/29/TM354MHG55DC5M5TTY6HOUO4S4/\",\"credits\":{\"by\":[{\"_id\":\"Song-Bokgyu\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"byline\":\"송복규 기자\",\"middleName\":\"Song Bok-gyu\"}},\"name\":\"복규 송\",\"url\":\"\"}]},\"description\":{\"basic\":\"친명(親이재명)계 현역 의원이 대거 포함된 원외조직 더민주전국혁신회의(혁신회의)는 29일 한미 관세 협상과 관련해 “도널드 트럼프 미 행정부가 선불로 3500억 달러, 나아가 5500억 달러까지 요구했다는 보도에 국민적 분노가 폭발하고 있다”고 비판했다. 혁신회의는 이날 논평을 내고 “이는 동맹의 탈을 쓴 도둑질이며, 대한민국을 경제 식민지로 전락시키려는 파렴치한 만행”이라며 이같이 밝혔다. 이들은 “1985년 미국이 무역적자 개선을 명분으로 달러 약세·엔화 강세를 유도하는 플라자 합의를 일본에 강요한 결과 일본 경제는 장기불황에 빠져 ‘잃어버린 30년’을 고통스럽게 견뎌야만 했다”면서 “지금 미국의 요구는 한국 경제를 뿌리째 흔들고 미래 세대의 숨통을 조이는 제2의 플라자 합의에 다름 아니다”라고 했다. ...\"},\"display_date\":\"2025-09-29T08:44:12.994Z\",\"headlines\":{\"basic\":\"‘친명 조직’ 혁신회의 “