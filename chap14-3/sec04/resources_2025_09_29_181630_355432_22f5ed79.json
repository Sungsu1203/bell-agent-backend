">\n        </iframe></noscript><div id=\"fusion-app\"><div style=\"display:none\" id=\"article\" data-fusion-collection=\"layouts\" data-fusion-type=\"article\" data-fusion-message=\"Could not render component [layouts:article]\"></div></div><script id=\"fusion-metadata\" type=\"application/javascript\">window.Fusion=window.Fusion||{};Fusion.arcSite=\"chosunbiz\";Fusion.contextPath=\"/pf\";Fusion.mxId=\"00000000\";Fusion.deployment=\"415\";Fusion.globalContent={\"_id\":\"O6NI3OX5CBAO3LFEDLSMV2LAQE\",\"canonical_url\":\"/it-science/ict/2025/09/22/O6NI3OX5CBAO3LFEDLSMV2LAQE/\",\"canonical_website\":\"chosunbiz\",\"content_elements\":[{\"_id\":\"OPWEBKUPANPBZHV7PHMC2SZKOI\",\"additional_properties\":{\"link\":\"\"},\"caption\":\"엔비디아 로고가 새겨진 GPU 모듈./로이터연합뉴스 \",\"credits\":{\"affiliation\":[{\"name\":\"REUTERS\"}],\"by\":[{\"name\":\"Tyrone Siu\"}]},\"height\":4347,\"resizedUrls\":{\"article_leadart\":\"https://biz.chosun.com/resizer/v2/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG?auth=133f2033929614afd3552acdd1085d0bd15202d627d30e786ef5128abddc6742&width=1280\",\"article_leadart_lg\":\"https://biz.chosun.com/resizer/v2/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG?auth=133f2033929614afd3552acdd1085d0bd15202d627d30e786ef5128abddc6742&width=2560\",\"article_lg\":\"https://biz.chosun.com/resizer/v2/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG?auth=133f2033929614afd3552acdd1085d0bd15202d627d30e786ef5128abddc6742&width=616\",\"article_md\":\"https://biz.chosun.com/resizer/v2/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG?auth=133f2033929614afd3552acdd1085d0bd15202d627d30e786ef5128abddc6742&width=464\",\"article_sm\":\"https://biz.chosun.com/resizer/v2/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG?auth=133f2033929614afd3552acdd1085d0bd15202d627d30e786ef5128abddc6742&width=216\",\"social_share\":\"https://biz.chosun.com/resizer/v2/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG?auth=133f2033929614afd3552acdd1085d0bd15202d627d30e786ef5128abddc6742&width=1200&height=630&smart=true\"},\"type\":\"image\",\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/OPWEBKUPANPBZHV7PHMC2SZKOI.JPG\",\"width\":6520},{\"_id\":\"GVX7FTSTLVAD3EJZ5KVONQOHIE\",\"additional_properties\":{},\"content\":\"중국 정부가 삼성전자와 SK하이닉스의 최신 그래픽 D램 ‘GDDR7’이 탑재된 엔비디아의 저사양 인공지능(AI) 칩 ‘RTX 프로 6000D’ 구매를 금지한 가운데, 두 회사 모두 제품군과 시장 다변화를 꾀하고 있는 만큼 여파가 제한적일 것이란 전망이 우세하다. 다만 국내 메모리 반도체 업계는 미·중 기술 갈등이 불확실성을 키우고 있는 점을 고려해 규제 동향을 예의주시하고 있다.\",\"type\":\"text\"},{\"_id\":\"DVVIRQQJXJEHJMYVLQ5CW6PLRM\",\"additional_properties\":{},\"content\":\"<b>◇ “잠재 시장 축소 아쉽지만… 충격은 미미”</b>\",\"type\":\"text\"},{\"_id\":\"Y4DWCBRR6RB55KZIAGM7765JPM\",\"additional_properties\":{},\"content\":\"지난 17일(현지시각) 파이낸셜타임스(FT) 등에 따르면 중국 국가사이버정보판공실(CAC)은 알리바바 등 자국 빅테크 기업에 엔비디아의 최신 저사양 AI 칩 ‘RTX 프로 6000D’의 주문과 테스트를 중단하라고 지시했다. RTX 프로 6000D는 미국의 수출 규제에 맞춰 성능을 대폭 낮춘 중국 전용 모델로, 엔비디아는 고성능 HBM(고대역폭메모리) 대신 상대적으로 저렴한 GDDR7을 탑재했다. 가격도 HBM이 들어간 또 다른 중국용 AI 칩 ‘H20’의 절반 수준에 그친다. 로이터는 샘플 테스트 결과 RTX 프로 6000D의 성능이 엔비디아의 최신 소비자용 플래그십 GPU(그래픽처리장치) ‘RTX 5090’보다 낮게 측정됐다고 전했다.\",\"type\":\"text\"},{\"_id\":\"CXLOMLGKLRCJHMLLVFLMCOSH6A\",\"additional_properties\":{},\"content\":\"현재까지 나온 조치로는 삼성전자와 SK하이닉스가 받을 영향이 그리 크지 않다는 의견이 다수다. RTX 프로 6000D에 들어가는 GDDR7 물량은 삼성전자가 가장 많이 공급하지만, 수익성을 좌우할 수준은 아닌 것으로 파악된다. 반도체 업계 관계자는 “모든 규제는 시장 축소를 초래하므로 잠재적 시장이 닫히는 건 아쉬운 일”이라면서도 “애초 시장이 컸던 게 아니기 때문에 현재까지의 상황은 관리 가능한 수준이며 이번 사안이 사업의 핵심에 직접적인 영향을 미친다고 보긴 어렵다”고 말했다. 또 다른 업계 관계자도 “메모리 반도체 공급사 입장에서는 수요 불확실성이 커진 건 맞지만 영향이 크다고 보는 건 과장된 시선”이라고 말했다. \",\"type\":\"text\"},{\"_id\":\"ZFRGX5RU2BCDPKTAFMZUN2U7PM\",\"additional_properties\":{},\"content\":\"김양팽 산업연구원 연구위원은 “잠재적으로 공급할 수 있는 물량이 축소될 수 있다는 점은 아쉽지만, 중장기적인 영향은 크지 않을 것”이라며 “통상 엔비디아는 제품 출시에 앞서 1년 단위의 장기 공급 계약을 체결하기 때문에 메모리 기업들은 이미 약속된 물량을 다른 제품군을 통해 소화할 수 있다”고 말했다. \",\"type\":\"text\"},{\"_id\":\"VQTQ6IWBZVFBXDUDKBMPVAMC34\",\"additional_properties\":{},\"content\":\"국내 메모리 반도체 기업들은 중국 시장의 변수와 무관하게 더 큰 사업 기회에 집중하는 모양새다. 엔비디아의 차세대 AI 가속기 ‘루빈’ 플랫폼에는 HBM4(6세대 HBM)와 함께 GDDR7이 탑재된다. 엔비디아는 삼성전자에 GDDR7 주문량을 늘리고 있으며 SK하이닉스 역시 GDDR7 공급 경쟁에 참여하며 차세대 시장을 공략하고 있다. 강성철 한국반도체디스플레이기술학회 연구위원은 “RTX 프로 6000D용 GDDR7 물량이 기업의 전체 수익성을 크게 좌우할 수준은 아니다”라며 “궁극적으로 AI 칩용 HBM과 GDDR7의 전체 수요는 미·중 갈등과 무관하게 꾸준히 늘어날 것”이라고 전망했다. \",\"type\":\"text\"},{\"_id\":\"X5NWC5YLYBPGDEPLSY75FAPKQY\",\"additional_properties\":{\"link\":\"\"},\"caption\":\"삼성전자의 GDDR7./뉴스1\",\"credits\":{\"affiliation\":[{\"name\":\"News1\"}],\"by\":[{\"name\":\"(고양=뉴스1) 황기선 기자\"}]},\"height\":2771,\"resizedUrls\":{\"article_leadart\":\"https://biz.chosun.com/resizer/v2/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG?auth=cbcfc14f273346aa3611304eae30cc247ca8c5e1ee4484a3ec30b1444860ebc0&width=1280\",\"article_leadart_lg\":\"https://biz.chosun.com/resizer/v2/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG?auth=cbcfc14f273346aa3611304eae30cc247ca8c5e1ee4484a3ec30b1444860ebc0&width=2560\",\"article_lg\":\"https://biz.chosun.com/resizer/v2/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG?auth=cbcfc14f273346aa3611304eae30cc247ca8c5e1ee4484a3ec30b1444860ebc0&width=616\",\"article_md\":\"https://biz.chosun.com/resizer/v2/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG?auth=cbcfc14f273346aa3611304eae30cc247ca8c5e1ee4484a3ec30b1444860ebc0&width=464\",\"article_sm\":\"https://biz.chosun.com/resizer/v2/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG?auth=cbcfc14f273346aa3611304eae30cc247ca8c5e1ee4484a3ec30b1444860ebc0&width=216\",\"social_share\":\"https://biz.chosun.com/resizer/v2/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG?auth=cbcfc14f273346aa3611304eae30cc247ca8c5e1ee4484a3ec30b1444860ebc0&width=1200&height=630&smart=true\"},\"type\":\"image\",\"url\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/X5NWC5YLYBPGDEPLSY75FAPKQY.JPG\",\"width\":3691},{\"_id\":\"A74GUE3UDJAKLICSVN7UM5Q52Q\",\"additional_properties\":{},\"content\":\"<b>◇ 中 시장서 엔비디아 입지 축소… 중국산 칩 대체율 급증</b>\",\"type\":\"text\"},{\"_id\":\"NUJSSY4PDRGANLPFEBAWV5BM6I\",\"additional_properties\":{},\"content\":\"RTX 프로 6000D의 중국 내 수요가 기대에 미치지 못하고 있는 점도 여파가 크지 않을 것이란 전망에 힘을 보태고 있다. 중국 정부가 자국 AI 칩 생태계를 키우면서 엔비디아의 저사양 칩 수요를 빠르게 대체하고 있기 때문이다. 실제로 올 2분기 엔비디아 데이터센터 매출에서 중국이 차지하는 비중은 한 자릿수로 낮아졌다. 이 틈을 타 중국 기업들은 전투력을 끌어올리고 있다. 중국 화웨이는 자체 AI 칩 ‘어센드 910C’가 엔비디아의 2세대 전 주력 AI 칩인 ‘A100’보다 2.5배 높은 성능을 구현했다고 주장하며 공급을 확대 중이다. 나아가 자체 HBM을 탑재한 차세대 AI 칩 ‘어센드 950’을 내년 출시하겠다고 선언했다. \",\"type\":\"text\"},{\"_id\":\"4BFX3EJA65GYNBCADTPITJQ6ZY\",\"additional_properties\":{},\"content\":\"화웨이뿐만이 아니다. 중국 AI 반도체 설계 기업 캠브리콘은 엔비디아 A100을 겨냥한 대체 제품을 출시해 올 상반기 매출이 44배 급증했다. 중국 알리바바도 반도체 설계 자회사 ‘핑터우거(T-head)’의 AI 칩을 데이터센터에 도입해 중국 2위 이동통신사 차이나유니콤을 고객으로 유치하는 등 성과를 내고 있다. 이런 흐름에 따라 중국 AI 칩 시장의 자국산 제품 비중은 2023년 17%에서 2027년 55%까지 높아질 것으로 글로벌 투자은행 번스타인은 전망했다. 최설화 메리츠증권 연구원은 “중국 당국이 정책적으로 중국산 칩 사용을 적극 추진하고 있어 외산 칩 대체 속도가 매우 빠르다”며 “중국 기업들은 단일 칩 성능 한계를 극복하기 위해 클러스터와 소프트웨어 통합 전략으로 경쟁력을 확보하고 있다”고 말했다.\",\"type\":\"text\"},{\"_id\":\"7OACQWMJDRELNAXUENCUPHCGLE\",\"additional_properties\":{},\"content\":\"이 때문에 업계 일각에서는 중국 정부의 이번 조치를 자국산으로 대체 가능한 보급형 AI 칩 시장에서 기술 주권을 강조한 상징적 조치로 해석한다. 반도체 업계 관계자는 “중국 정부의 세부 조치를 살펴보면, H20 등 다른 AI 칩에 대한 언급 없이 주문 금지가 RTX 프로 6000D에만 국한됐다”며 “향후 제재가 확대될 가능성은 지켜봐야겠지만, 현재로선 엔비디아 칩 자체가 필요 없다는 게 아닌 ‘이 정도 사양은 자국산으로 대체할 수 있다’는 자신감을 보여주는 상징적 조치에 가깝다고 보고 있다”고 말했다. \",\"type\":\"text\"}],\"created_date\":\"2025-09-19T03:50:18.324Z\",\"credits\":{\"by\":[{\"_id\":\"choi-jihui\",\"additional_properties\":{\"original\":{\"byline\":\"최지희 기자\",\"email\":\"hee@chosunbiz.com\",\"image\":\"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/chosunbiz/f8a92461-6020-4bf2-b19d-e397b1a0c84d.png\",\"middleName\":\"Choi Ji-hui\",\"role\":\"편집국 IT부 기자\",\"suffix\":\"Staff writer, IT News Desk\",\"url\":\"https://biz.chosun.com/people/choi-jihui/\"}},\"image\":{\"url\":\"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/chosunbiz/f8a92461-6020-4bf2-b19d-e397b1a0c84d.png\"},\"name\":\"지희 최\",\"org\":\"서울\",\"resizedUrls\":{\"author\":\"https://biz.chosun.com/resizer/v2/https%3A%2F%2Fauthor-service-images-prod-us-east-1.publishing.aws.arc.pub%2Fchosunbiz%2Ff8a92461-6020-4bf2-b19d-e397b1a0c84d.png?auth=7e86df909b8eb475a7e6b3151e31c2b878f0e9da7a9ecca4b2587c40bc3350e6&width=108&height=108&smart=true\"},\"type\":\"author\"},{\"_id\":\"chun-byungsoo\",\"additional_properties\":{\"original\":{\"affiliations\":\"\",\"bio\":\"\",\"bio_page\":\"\",\"byline\":\"전병수 기자\",\"email\":\"outstanding@chosunbiz.com\",\"image\":\"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/chosunbiz/d188e6f2-79e8-4235-92d2-b3a617e63b6c.png\",\"longBio\":\"안녕하세요 전병수 기자입니다.\",\"middleName\":\"Chun Byung-soo\",\"suffix\":\"Staff writer, IT News Desk\",\"url\":\"https://biz.chosun.com/people/chun-byungsoo/\"}},\"image\":{\"url\":\"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/chosunbiz/d188e6f2-79e8-4235-92d2-b3a617e63b6c.png\"},\"name\":\"병수 전\",\"org\":\"서울\",\"resizedUrls\":{\"author\":\"https://biz.chosun.com/resizer/v2/https%3A%2F%2Fauthor-service-images-prod-us-east-1.publishing.aws.arc.pub%2Fchosunbiz%2Fd188e6f2-79e8-4235-92d2-b3a617e63b6c.png?auth=075a82c3da946e53e8ff6bb08e01f38de4c536f4a20613be85599859739c15b8&width=108&height=108&smart=true\"},\"type\":\"author\",\"url\":\"\"}]},\"description\":{\"basic\":\"\"},\"display_date\":\"2025-09-21T21:00:00Z\",\"distributor\":{\"name\":\"ChosunBiz\"},\"first_publish_date\":\"2025-09-21T21:00:00Z\",\"headlines\":{\"basic\":\"中, 삼성전자·SK하이닉스 D램 탑재한 엔비디아 저사양 AI 칩 구매 금지… “韓 반도체 시장 영향 제한적” \",\"mobile\":\"\"},\"label\":{\"send_to_polly\":{\"text\":\"Yes\"}},\"last_updated_date\":\"2025-09-21T21:05:57.534Z\",\"related_content\":{},\"source\":{\"system\":\"composer\"},\"subheadlines\":{\"basic\":\"中, 엔비디아 ‘RTX 프로 6000D’ 구매 금지 조치에 삼성전자·SK하이닉스도 영향<br>“수요 불확실성 커졌으나 중국용 물량 제한적” “위험 관리 가능 수준”<br>토종 AI 칩 육성 속도내는 中… “‘기술 주권’ 과시 성격도”<br>\"},\"subtype\":\"default\",\"taxonomy\":{\"primary_section\":{\"_id\":\"/it-science/ict\",\"additional_properties\":{\"original\":{\"ancestors\":{\"default\":[\"/it-science\"]}}},\"name\":\"ICT\",\"path\":\"/it-science/ict\"},\"sections\":[{\"_id\":\"/it-science/ict\",\"name\":\"ICT\"},{\"_id\":\"/it-science\",\"name\":\"IT\"}]},\"type\":\"story\",\"website_url\":\"/it-sc