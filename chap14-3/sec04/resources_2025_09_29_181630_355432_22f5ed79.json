ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=1200&height=630&smart=true\",\"cmc\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=1440&height=560&smart=true\",\"cmc_sm\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=216\",\"cmc_md\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=464\",\"cmc_lg\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=616\",\"fusion_feed\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=1440&height=560&smart=true\",\"original\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=1440&height=560&smart=true\",\"author\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=108&height=108&smart=true\",\"author_vip\":\"https://biz.chosun.com/resizer/v2/TLBXXZB7JZGZDKCFK4UALPZUNQ.png?auth=bdb5d70ddf2c5656801c099323a8e0c2e629ade6773010a0d7833a74aabb9dae&width=184\"}}}},{\"canonical_url\":\"/international/international_general/2025/09/18/IFYNX26UERBU5GXVLGDCKKHPFY/\",\"canonical_website\":\"chosunbiz\",\"content_elements\":[{\"_id\":\"G6JYNUHRA5C53N5LAWSRW5MJZY\",\"additional_properties\":{\"comments\":[],\"inline_comments\":[]},\"content\":\"<b>“단일 칩 성능 면에서는 여전히 미국에 한 세대 뒤처져 있지만, 클러스터 기반 컴퓨팅 기술로 이를 극복할 것이다.”</b>\",\"type\":\"text\"},{\"_id\":\"3Z77LUC42ZHQDDQNPB722GV4UU\",\"additional_properties\":{\"comments\":[],\"inline_comments\":[]},\"content\":\"중국 반도체 산업을 이끌고 있는 런정페이 화웨이(华为) 회장의 말이다. 그는 지난 6월 중국 관영 인민일보 인터뷰에서 이렇게 밝히면서 미국의 압박에 대해 “어려운 것은 생각하지 않고, 그저 한 걸음 한 걸음 앞으로 나갈 뿐”이라고 밝혔다. \",\"type\":\"text\"},{\"_id\":\"U3T4AP5XHREKTCQKTAGYDB2GOE\",\"additional_properties\":{\"comments\":[],\"inline_comments\":[]},\"content\":\"그리고 화웨이는 18일 오전(현지시각) 새로운 반도체 기술을 공개했다. 자사 어센드(Asend) 제품이 장착된 그래픽카드를 최대 1만5488개까지 연결할 수 있는 기술이다. 화웨이는 현재 100만개의 그래픽카드로 구성된 초대형 클러스터를 운영하고 있다고도 밝혔다. 런정페이 회장이 앞서 언급했던 클러스터 기반 컴퓨팅 기술이 실현된 것이다.\",\"type\":\"text\"},{\"_id\":\"63V4MARKSVMI5MFXNXJNLG7CW4\",\"additional_properties\":{\"countryId\":45,\"expiration_date\":\"2025-10-26T05:59:06.640Z\",\"fullSizeResizeUrl\":\"/resizer/v2/63V4MARKSVMI5MFXNXJNLG7CW4.jpg?auth=b80c2c404879dacf73d791352535a86b12104d3dc4eb012b741eec3650864a09\",\"galleries\":[],\"iptc_source\":\"AFP\",\"iptc_title\":\"STF\",\"keywords\":[\"ai\",\"computers\",\"horizontal\"],\"mime_type\":\"image/jpeg\",\"originalName\":\"PAF20250728194501009_145902.jpg\",\"originalUrl\":\"https://cloudfront-ap-northeast-1.images.arcpublishing.com/chosunbiz/63V4MARKSVMI5MFXNXJNLG7CW4.jpg\",\"proxyUrl\":\"/resizer/v2/63V4MARKSVMI5MFXNXJNLG7CW4.jpg?auth=b80c2c404879dacf73d791352535a86b12104d3dc4eb012b741eec3650864a09\",\"published\":true,\"resizeUrl\":\"/resizer/v2/63V4MARKSVMI5MFXNXJNLG7CW4.jpg?auth=b80c2c404879dacf73d791352535a86b12104d3dc4eb012b741eec3650864a09\",\"restricted\":false,\"takenOn\":\"2025-07-28T04:17:41Z\",\"thumbnailResizeUrl\":\"/resizer/v2/63V4MARKSVMI5MFXNXJNLG7CW4.jpg?auth=b80c2c404879dacf73d791352535a86b12104d3dc4eb012b741eec3650864a09&width=300\",\"version\":2,\"etag\":\"fb5566701dfc5d9873d31a289eb8a04e\",\"sequencer\":\"00688711A69E8AD384\",\"alt_text\":\"\",\"link\":\"\"},\"address\":{\"locality\":\"Shanghai\",\"country_name\":\"CHN\"},\"auth\":{\"1\":\"b80c2c404879dacf73d791352535a86b12104d3dc4eb012b741eec3650864a09\"},\"caption\":\"지난 7월 상하이 세계인공지능대회(WAIC)에 차려진 화웨이 부스. /AFP연합뉴스\",\"copyright\":\"AFP or licensors\",\"created_date\":\"2025-07-28T05:59:06Z\",\"credits\":{\"affiliation\":[{\"name\":\"YNA\