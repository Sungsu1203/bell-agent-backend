Uncertainty</h2>\r\n                        <p class=\"date\">July 2025</p>\r\n                    </div>\r\n                </div>\r\n                <div class=\"over-hero-caption\">\r\n                    <p class=\"contain\"></p>\r\n                </div>\r\n\r\n\r\n\r\n\r\n\r\n        </div>\r\n\r\n\r\n\r\n<!-- BEGIN CONTENT -->\r\n<script>\r\n                var trackSpeechify = function (trackingEvent) {\r\n                    console.log('speechify tracking');\r\n                    digitalData = {\r\n                        page: {\r\n                            pageInfo: {\r\n                                [trackingEvent]: window.location.href.toLowerCase()\r\n                            }\r\n                        }\r\n                    };\r\n                    _satellite.track(trackingEvent);\r\n                };\r\n\r\n                import(\r\n                    \"/Assets/IMF/js/speechifyapi.min.js\"\r\n                ).then(async (speechifyWidget) => {\r\n                    // this parent element for your article or listenable content\r\n                    const articleRootElement = document.querySelector(\"div.contain-70 > div.full-width:not(.flex-buttons-container)\");\r\n                    const voiceLangMap =\r\n                    {\r\n                        'en': 'John',\r\n'ar': 'Fatima',\r\n'es': 'Javier',\r\n'fr': 'Louise',\r\n'ja': 'Sakura',\r\n'ru': 'Ivan',\r\n'zh': 'Yarong',\r\n'pt': 'Benicio',\r\n                    };\r\n\r\n                var selectedVoice = voiceLangMap['en'];\r\n\r\n                //Add spechify node to DOM\r\n                var speechifyNode = document.createElement('div');\r\n                speechifyNode.classList.add('container');\r\n                speechifyNode.classList.add('custom-container');\r\n                speechifyNode.classList.add('speechify-player-flagship');\r\n                var speechifyRoot = document.createElement('div');\r\n                speechifyRoot.id = 'speechify-root';\r\n                speechifyNode.appendChild(speechifyRoot);\r\n\r\n                const headerElement = document.querySelector(\"div.full-width > div.contain-70 > div.full-width:not(.flex-buttons-container) > h4\");\r\n                 \r\n                if (headerElement) {\r\n                    headerElement.after(speechifyNode);\r\n                }\r\n\r\n                const widget = speechifyWidget.makeSpeechifyExperience({\r\n                rootElement: articleRootElement,\r\n                        useSpeechifyRoot: true,\r\n                        visibility: {\r\n                    showWidget: false,\r\n                            showWidgetOnPlay: true,\r\n                        },\r\n                    defaultVoice: selectedVoice,\r\n                    ignoreElements: (element) =>\r\n                        element.tagName === \"TABLE\" ||\r\n                        element.classList.contains(\"imf-com\") ||\r\n                        element.classList.contains(\"article-belt\")\r\n                    });\r\n                await widget.mount();\r\n\r\n                    widget.addEventListener((event, playerState) => {\r\n                    if (event.type === 'play') {\r\n                            trackSpeechify(\"speechifyPlayClick\");\r\n                    }\r\n                    else if (event.type === 'pause') {\r\n                    }\r\n                    else if (event.type === 'resume') {\r\n                    }\r\n                    else if (event.type === 'skipped-forward') {\r\n                    }\r\n                    else if (event.type === 'skipped-backward') {\r\n                    }\r\n                });\r\n            });\r\n</script>\r\n    <article class=\"detail-wrapper\">\r\n        \r\n                <div class=\"full-width\">\r\n                    <!-- STICKY NAV -->\r\n                    <div id=\"fixednav\" >\r\n                        <ul class=\"contain-70 hz-nav flex-container\">\r\n\r\n                                    <li><a href=\"#Overview\">Overview</a></li>\r\n                                    <li><a href=\"#Projections\">Projections Table</a></li>\r\n                                    <li><a href=\"#tools\">Data Tools</a></li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n            <div class=\"full-width padded-vertical-20 contain-70\">\r\n                <div class=\"dropdown\">\r\n                    <button class=\"dropbtn\">English <i class=\"fal fa-chevron-down\"></i></button>\r\n                    <div class=\"dropdown-content\">\r\n                            <a title=\"العربية\" href=\"/ar/Publications/WEO/Issues/2025/07/29/world-economic-outlook-update-july-2025\">العربية</a>\r\n                            <a title=\"espa&#241;ol\" href=\"/es/Publications/WEO/Issues/2025/07/29/world-economic-outlook-update-july-2025\">espa&#241;ol</a>\r\n                            <a title=\"fran&#231;ais\" href=\"/fr/Publications/WEO/Issues/2025/07/29/world-economic-outlook-update-july-2025\">fran&#231;ais</a>\r\n                            <a title=\"日本語\" href=\"/ja/Publications/WEO/Issues/2025/07/29/world-economic-outlook-update-july-2025\">日本語</a>\r\n                            <a title=\"русский\" href=\"/ru/Publications/WEO/Issues/2025/07/29/world-economic-outlook-update-july-2025\">русский</a>\r\n                            <a title=\"中文\" href=\"/zh/Publications/WEO/Issues/2025/07/29/world-economic-outlook-update-july-2025\">中文</a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <!-- END NOINDEX -->\r\n\r\n\r\n\r\n                    <div class=\"contain-70 full-width flex-buttons-container push padded-vertical-20\">\r\n<a href=\"/-/media/Files/Publications/WEO/2025/update/july/english/text.ashx\" class=\"bg-btn btn padded-10\" >Download Full Report                                <li class=\"fal fa-download\"></li>\r\n</a>                    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n                <a name=\"Overview\"></a>\r\n                <div class=\"full-width flag-back padded-vertical-20\">\r\n                    <div class=\"contain-70\">\r\n\r\n\r\n\r\n\r\n                        \r\n            <div class=\"full-width\">\r\n                <h4 class=\"large-bold\">Global growth expected to decelerate as trade-related distortions wane</h4>\r\n\r\n                        <div class=\"flag-cover-box\">\r\n<a href=\"/-/media/Files/Publications/WEO/2025/update/july/english/text.ashx\" ><img src=\"/-/media/Images/IMF/Publications/WEO/2025/july/world-economic-outlook-update-july-2025-report-cover.ashx?h=2200&amp;w=1700&amp;la=en\" alt=\"World Economic Outlook Update, July 2025: Global Economy: Tenuous Resilience amid Persistent Uncertainty\" /></a>                        </div>\r\n\r\n                <p>Global growth is projected at 3.0 percent for 2025 and 3.1 percent in 2026, an upward revision from the April 2025 <em>World Economic Outlook</em>. This reflects front-loading ahead of tariffs, lower effective tariff rates, better financial conditions, and fiscal expansion in some major jurisdictions. </p>\n<p>Global inflation is expected to fall, but US inflation is predicted to stay above target. Downside risks from potentially higher tariffs, elevated uncertainty, and geopolitical tensions persist. </p>\n<p>Restoring confidence, predictability, and sustainability remains a key policy priority.</p>\r\n\r\n            </div>\r\n        <div class=\"full-width flex-container\">\r\n            <ul class=\"icon-list hz\">\r\n                                <li>\r\n<a href=\"/-/media/Files/Publications/WEO/2025/update/july/english/text.ashx\" ><img src=\"/-/media/Images/IMF/Flagship/section-images/icon-pdf.ashx?la=en\" alt=\"\" />Full Report</a>\r\n                                </li>\r\n                                <li>\r\n<a href=\"https://www.imf.org/en/Videos/view?vid=6376294087112\" ><img src=\"/-/media/Images/IMF/Flagship/section-images/icon-video.ashx?la=en\" alt=\"\" />Press Conference</a>\r\n                                </li>\r\n                                <li>\r\n<a href=\"/en/News/Articles/2025/07/29/sp072925-pierre-olivier-gourinchas-opening-remarks-world-economic-outlook-update-july-2025\" ><img src=\"/-/media/Images/IMF/Flagship/section-images/icon-blog.ashx?la=en\" alt=\"\" />Opening Remarks</a>\r\n                                </li>\r\n                                <li>\r\n<a href=\"/-/media/Files/Publications/WEO/2025/update/july/english/data/weo-update-july-2025.ashx\" ><img src=\"/-/media/Images/IMF/Flagship/section-images/icon-database.ashx?la=en\" alt=\"\" />Data</a>\r\n                                </li>\r\n            </ul>\r\n        </div>\r\n\r\n\r\n\r\n        <div class=\"full-width flex-container padded-vertical-40 videos-module\">\r\n\r\n                    <div class=\"cell belt-item\">\r\n\r\n\r\n                        <div class=\"resp-container\">\r\n                            <iframe src=\"//players.brightcove.net/45228659001/vJB8SrG2L_default/index.html?videoId=6376248604112\" allowfullscreen=\"\" allow=\"encrypted-media\" style=\"position: absolute; top: 0px; right: 0px; bottom: 0px; left: 0px; width: 100%; height: 100%;\"></iframe>\r\n                        </div>\r\n                    </div>\r\n                            <div class=\"cell belt-item\">\r\n\r\n                                <div class=\"sharethis_custom\">\r\n                                    <div class=\"st-custom-button\" data-network=\"facebook\" data-url=\"https://www.imf.org/-/media/Images/IMF/Publications/WEO/2025/july/english/world-economic-outlook-update-july-2025-growth-projections-by-region.ashx\">\r\n                                        <i class=\"fb\">\r\n                                            <img alt=\"facebook sharing button\" src=\"https://platform-cdn.sharethis.com/img/facebook.svg\">\r\n                