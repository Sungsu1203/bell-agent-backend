+\r\n\t\t'</ul>'\r\n\t\t);\r\n\r\n\t\t}\r\n\r\n\t\tsetTimeout(function(){\r\n\t\tsubNav1()\r\n\t\t},350);\r\n\r\n\t});\r\n\r\n</script>\r\n<!--\r\n<div class=\"sub_nav1\">\r\n\t<div class=\"sub_nav1_inner\">\r\n\t\t<div class=\"home\"><a href=\"../main/index.html\">Home</a></div>\r\n\t\t<div class=\"depth\">\r\n\t\t<a href=\"./index.html\">PR Center</a>\r\n\t\t<ul>\r\n\t\t<li><a href=\"../about_sdi/index.html\">SAMSUNG SDI</a></li>\r\n\t\t<li><a href=\"../esg/sustainability_tab01.html\">ESG</a></li>\r\n\t\t<li><a href=\"../business/index.html\">BUSINESS</a></li>\r\n\t\t<li><a href=\"../ir/ir-activity/index.html\">IR</a></li>\r\n\t\t<li><a href=\"../career/index.html\">CAREER</a></li>\r\n\t\t<li><a href=\"../sdi_now/index.html\">PR Center</a></li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t<div class=\"depth\">\r\n\t\t<a href=\"./index.html\">삼성SDI News</a>\r\n\t\t<ul>\r\n\t\t<li><a href=\"./index.html\">삼성SDI News</a></li>\r\n\t\t<li><a href=\"./column.html\">Column</a></li>\r\n\t\t<li><a href=\"./media.html\">Youtube</a></li>\r\n\t\t</ul>\r\n\t\t</div>\r\n\t</div>\t\t\r\n</div> \r\n -->\r\n\t\t<!-- subnavi end -->\r\n\r\n\t\t<div class=\"content_inner\">\r\n\t\t<div class=\"cont_item risk_system\">\r\n\t\t<div class=\"cont_head\">\r\n\t\t<h3 class=\"titmain\">전사 리스크 관리 체계</h3>\r\n\t\t<p>삼성SDI는 이사회를 중심으로 사업, 재무, 안전환경 등 경영환경에서 발생할 수 있는 다양한 리스크를 종합적으로 관리하며 주요 의사결정을 수행합니다.</p>\r\n\t\t</div>\r\n\t\t<div class=\"cont_body\">\r\n\t\t<figure>\r\n\t\t<img src=\"/resources/images/esg/risk_management_img_01.svg\" alt=\"\" class=\"pc\">\r\n\t\t<img src=\"/resources/images/esg/risk_management_img_01_mo.svg\" alt=\"\" class=\"mo\">\r\n\t\t<figcaption class=\"blind\">\r\n\t\t<ul>\r\n\t\t<li>\r\n\t\t이사회\r\n\t\t<ul>\r\n\t\t<li>\r\n\t\t경영위원회\r\n\t\t<ul>\r\n\t\t<li>\r\n\t\t경영지원실\r\n\t\t<ul>\r\n\t\t<li>신사업, 수주, 투자 등 전략 리스크</li>\r\n\t\t<li>시장, 신용, 유동성 등 재무 리스크</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t품질보증실, 구매팀, People팀\r\n\t\t<ul>\r\n\t\t<li>품질, 원자재 수급, 보안 등 운영 리스크</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t지속가능경영위원회\r\n\t\t<ul>\r\n\t\t<li>\r\n\t\t지속가능경영 사무국\r\n\t\t<ul>\r\n\t\t<li>기후 위기 대응 비재무 리스크</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t상생협력사무국, 지속가능경영사무국\r\n\t\t<ul>\r\n\t\t<li>공급망 ESG 관리 비재무 리스크</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\tGlobal안전/기술센터, People팀\r\n\t\t<ul>\r\n\t\t<li>안전, 전염병 등 비재무 리스크</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t컴플라이언스팀,  법무팀, 감사팀\r\n\t\t<ul>\r\n\t\t<li>컴플라이언스, 공시 등 비재무 리스크</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t</figcaption>\r\n\t\t</figure>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"cont_item\">\r\n\t\t<div class=\"cont_head\">\r\n\t\t<h3 class=\"titmain\">기후 위기 관리</h3>\r\n\t\t<p>삼성SDI는 중&#183;장기적 관점에서 기후 위기에 따른 리스크과 기회 요인 분석 및 대응 방안을 마련해, 기후 위기와 관련한 글로벌 규제 강화와 고객, 투자자 등 이해관계자의 요구에 효과적으로 대응하고 있습니다. </p>\r\n\t\t</div>\r\n\t\t<div class=\"cont_body\">\r\n\t\t<b class=\"img_tit txt_info\">&#60;리스크 관리 내부 프로세스&#62;</b>\r\n\t\t<figure>\r\n\t\t<img src=\"/resources/images/esg/risk_management_img_02.svg\" alt=\"\" class=\"pc\">\r\n\t\t<img src=\"/resources/images/esg/risk_management_img_02_mo.svg\" alt=\"\" class=\"mo\">\r\n\t\t<figcaption class=\"blind\">\r\n\t\t<ol>\r\n\t\t<li>기후 위기 관련 전사적 이슈 파악</li>\r\n\t\t<li>리스크/기회 요인 도출 및 영향평가</li>\r\n\t\t<li>우선순위 점검 및 대응 전략 / 실행 계획 수립</li>\r\n\t\t<li>지속가능경영 협의회 보고</li>\r\n\t\t<li>지속가능경영 위원회 보고</li>\r\n\t\t<li>ESG\tWorking\tGroup 실행</li>\r\n\t\t<li>지속 가능 경영사무국 모니터링 및 진단</li>\r\n\t\t</ol>\r\n\t\t</figcaption>\r\n\t\t</figure>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"cont_item\">\r\n\t\t<div class=\"cont_head\">\r\n\t\t<h3 class=\"titmain\">공급망 리스크 관리</h3>\r\n\t\t<p>공급망 리스크에는 파트너사에서 발생할 수 있는 환경&#183;사회적 리스크뿐만 아니라 파트너사가 삼성SDI에 납품할 부품을 구매하는 과정에서 발생할 수 있는 리스크도 포함됩니다. 삼성SDI의 구매 리스크 관리 방법은 크게 4단계로 구분합니다.</p>\r\n\t\t</div>\r\n\t\t<div class=\"cont_body\">\r\n\t\t<b class=\"img_tit txt_info\">&#60;구매 리스크 관리 방법&#62;</b>\r\n\t\t<figure>\r\n\t\t<img src=\"/resources/images/esg/risk_management_img_03.svg\" alt=\"리스크 규명, 리스크평가, 리스크 대응, 리스크 이력 관리\" class=\"pc\">\r\n\t\t<img src=\"/resources/images/esg/risk_management_img_03_mo.svg\" alt=\"리스크 규명, 리스크평가, 리스크 대응, 리스크 이력 관리\" class=\"mo\">\r\n\t\t</figure>\r\n\t\t<span id=\"anchor01\"></span>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"cont_item\">\r\n\t\t<div class=\"cont_head linkpoink\">\r\n\t\t<h3 class=\"titmain mb40\">조세전략</h3>\r\n\t\t</div>\r\n\t\t<div class=\"cont_body\">\r\n\t\t<div class=\"cont_txt\">\r\n\t\t<h4 class=\"titsub1B\">세무 관리 정책</h4>\r\n\t\t<p class=\"color_g2\">삼성SDI는 당사가 진출하는 여러 국가에서 정직하고 성실하게 세무 신고 및 납부를 이행하고 있으며, 상업적 실질이 없는 조세 구조를 사용해 조세를 회피하지 않고, 조세피난처 등을 이용한 국가 간 소득 이전 및 조세 회피 거래를 하지 않습니다. 당사는 각 국가의 과제 정책을 성실히 이행하며 변화하는 세무 정책에 발맞춰 적극적으로 대응하고 있습니다. 이를 위해 모든 세무 담당 임직원은 적법한 삼성SDI의 세무 정책에 따라 업무를 수행하고 있습니다.</p>\r\n\t\t</div>\r\n\t\t<div class=\"cont_txt\">\r\n\t\t<h4 class=\"titsub1B\">세무 리스크 평가</h4>\r\n\t\t<p class=\"color_g2\">삼성SDI는 당사가 영위하는 모든 사업 활동에서 세무 리스크를 최소화하려고 노력합니다. 일반적인 재화 거래 및 주식의 취득, 신규 사업 진출, 국제거래, 거래구조의\t변경 등 모든 부문에서 세무적인 문제가 없도록 필요시, 외부 전문가의 컨설팅 또는 협업을 통해 예상치 못한 리스크를 파악하고, 파악된 문제점은 개선하고 있습니다.</p>\r\n\t\t</div>\r\n\t\t<div class=\"cont_txt\">\r\n\t\t<h4 class=\"titsub1B\">세무 리스크 관리</h4>\r\n\t\t<p class=\"color_g2\">세무 리스크 관리는 전사적으로 공개되어야 하며, 통일성이 있어야 합니다. 삼성SDI는 세무 리스크 관리를 위해 동일한 의사결정 체계의 확립, 컴플라이언스 교육, 통일된\t회사 운영 지침 등으로 신중한 세무 리스크 관리가 이뤄지고 있습니다. 일반적인 경비처리부터 국제 거래에 이르기까지 각국의 과세 당국에서 요구하고 있는 적법한 증빙을 보관 및 관리하고 있으며 특히 제3자 및 특수관계자 거래에 있어서 정상적 범위의 가격을 유지하고 있습니다.</p>\r\n\t\t</div>\r\n\t\t<div class=\"cont_txt\">\r\n\t\t<h4 class=\"titsub1B\">세무 관리로 지역사회 발전 기여</h4>\r\n\t\t<p class=\"color_g2\">삼성SDI는 각국의 세무 정책에 맞는 세금을 납부함으로써 당사가 진출한 각국의 지역사회 발전에 이바지하고 있습니다. 법인 소득에 대한 법인세, 각종 거래에서 발생하는 부가세 및 고용 창출 효과로 비롯된 원천세 등 지역사회 발전에 긍정적인 역할을 하고 있습니다.<span id=\"anchor02\"></span></p>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"cont_item\">\r\n\t\t<div class=\"cont_head linkpoink\">\r\n\t\t<h3 class=\"titmain mb40\">전략물자 관리</h3>\r\n\t\t</div>\r\n\t\t<div class=\"cont_txt\">\r\n\t\t<h4 class=\"titsub1B\">자율 수출 관리 이행 선언문</h4>\r\n\t\t<p class=\"color_g2\">당사는 글로벌 기업으로 국제안보 및 지속가능 경영을 위해 전략물자 수출관리의 중요성을 인식하며, 다음과 같이 선언합니다.</p>\r\n\t\t<div class=\"declaration\">\r\n\t\t<ul>\r\n\t\t<li>\r\n\t\t<p class=\"txtB_req\">하나,</p>\r\n\t\t<p class=\"txtR color_g2\">우리 모든 임직원은 전략물자 수출 관리제도의 올바른 이행이 국제안보 및 세계 평화 유지를 위한 기업의 사회적 책임이라는 것을 깊이 인식하고,<br class=\"pc\"> 이를 공유하도록 노력한다.</p>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<p class=\"txtB_req\">하나,</p>\r\n\t\t<p class=\"txtR color_g2\">우리 모든 임직원은 전략물자를 자율적으로 관리하기 위한 필요 조직과 운영체계를 구축하기 위해 노력하며, 회사의 모든 조직은 자율수출관리기구의 효율적 체계적인 운영을 위해 적극 협조한다.</p>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t<p class=\"txtB_req\">하나,</p>\r\n\t\t<p class=\"txtR color_g2\">우리 모든 임직원은 정부의 전략물자 수출관리 정책에 적극 협력하며, 전략물자의 불법 수출 등 대외무역법에 위반되는 행위를 하지 않도록 최선의 노력을 다한다.</p>\r\n\t\t</li>\r\n\t\t</ul>\r\n\t\t<div class=\"ceo_sign\">\r\n\t\t<div>\r\n\t\t<p class=\"txt_infoR\">삼성SDI 주식회사</p>\r\n\t\t<p class=\"txt\">대표이사 최 주 선</p>\r\n\t\t</div>\r\n\t\t<figure>\r\n\t\t<img src=\"/resources/images/esg/social_img_sign.svg\" alt=\"서명\">\r\n\t\t</figure>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</section>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\t<div id=\"bg_modal\"></div>\r\n\r\n\t\r\n\t\r\n\r\n<div id=\"footer_wrap\">\r\n\t<div class=\"quick\">\r\n\t\t<button type=\"button\" class=\"btn_top\" title=\"최상단으로 이동하기\"><img src=\"/resources/images/layout/btn_top.png\" alt=\"최상단 이동\"></button>\r\n\t</div>\r\n\t<footer id=\"footer\">\r\n\t\t<div class=\"inner\">\r\n\t\t<ul class=\"site_terms\">\r\n\t\t<li><a href=\"https://audit.samsungsdi.com:40195/audit/\" title=\"윤리 &#183; 준법경영 새창열기\" target=\"_blank\">윤리 &#183; 준법경영</a></li>\r\n\t\t<li><a href=\"/security-report.html\" title=\"보안신고센터로 이동하기\">보안신고센터</a></li>\r\n\t\t<li><a href=\"https://gsrm.samsungsdi.com/\" title=\"파트너사 새창열기\" target=\"_blank\">파트너사</a></li>\r\n\t\t<li><a href=\"/b2b-billing.html\" title=\"B2B대금결제로 이동하기\">B2B대금결제</a></li>\r\n\t\t<li><a href=\"/