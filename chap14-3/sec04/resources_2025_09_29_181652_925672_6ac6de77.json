          if (seriesData.code_del != 'y') {\n                                                contboxA_html += \n                            \"       <a href=\\\"javascript:void(0);\\\" title=\\\"연재기사 구독\\\" class=\\\"subscription subscribe_link noing\\\" onclick=\\\"subscription('set', $(this)); sendGAAttrEvent(event);\\\" data-subs_type=\\\"series\\\" data-subs_title=\\\"\" + seriesData.title.replace('\"', '') + \"\\\" data-code=\\\"\" + seriesData.code + \"\\\" data-area=\\\"listSeries_top\\\" ep_event_page=\\\"\" + visitCh + \"_article_general\\\" ep_event_area=\\\"article_contents_연재기사_구독\\\" ep_event_label=\\\"\" + seriesData.title.replace('\"', '') + \"\\\">구독</a>\\n\";\n                                                contboxA_html += \n                            \"       <a href=\\\"javascript:void(0);\\\" title=\\\"연재기사 구독 취소\\\" class=\\\"subscription subscribe_link ing active\\\" onclick=\\\"subscription('del', $(this)); sendGAAttrEvent(event);\\\" data-subs_type=\\\"series\\\" data-subs_title=\\\"\" + seriesData.title.replace('\"', '') + \"\\\" data-code=\\\"\" + seriesData.code + \"\\\" data-area=\\\"listSeries_top\\\" style=\\\"display:none;\\\" ep_event_page=\\\"\" + visitCh + \"_article_general\\\" ep_event_area=\\\"article_contents_연재기사_구독취소\\\" ep_event_label=\\\"\" + seriesData.title.replace('\"', '') + \"\\\">구독</a>\\n\";\n                                            } else {\n                                                contboxA_html += \n                            \"       <a href=\\\"javascript:void(0);\\\" title=\\\"연재종료\\\" class=\\\"subscribe_btn_end\\\">연재종료</a>\\n\";\n                                            }\n                                            contboxA_html += \n                            \"   </span>\\n\";\n                                        }\n                                    }\n                                    contboxA_html +=\n                            \"</article>\\n\";\n\n                                    if (isEmpty(datas) != true && Object.keys(datas).length > 0) {\n                                        contboxA_html +=\n                            \"<ul>\\n\";\n                                        $.each(datas, function(key, value) { \n                                            if (key >= 3) return false;\n\n                                            $.each(value, function(k, v) { \n                                                var contboxA_gaEventAction = '경향신문';\n\n                                                contboxA_html +=\n                            \"   <li>\\n\";\n                                                if (data.type == 'major') { \n                                                    if (v.proc_url.toLowerCase().includes(linkSk.toLowerCase())) { \n                                                        contboxA_gaEventAction = '스포츠경향';\n                                                    } else if (v.proc_url.toLowerCase().includes(linkWk.toLowerCase())) { \n                                                        contboxA_gaEventAction = '주간경향';\n                                                    } else if (v.proc_url.toLowerCase().includes(linkLk.toLowerCase())) { \n                                                        contboxA_gaEventAction = '레이디경향';\n                                                    }\n\n                                                    contboxA_html += \n                            \"       <a href=\\\"\" + v.proc_url + \"\\\" title=\\\"\" + v.title.replace('\"', '') + \"\\\" onclick=\\\"sendGAAttrEvent(event);\\\" ep_event_page=\\\"\" + visitCh + \"_article_general\\\" ep_event_area=\\\"\" + data.gaEventArea + \"\\\" ep_event_label=\\\"\" + v.title.replace('\"', '') + \"\\\" ep_event_action=\\\"전환_\" + contboxA_gaEventAction + \"_기사\\\">\\n\" +\n                            \"           \" + v.proc_title.replace(/\\[.*?\\]/g, '').trim() + \"\\n\" +\n                            \"       </a>\\n\";\n                                                } else { \n                                                    if (v.link.toLowerCase().includes(linkSk.toLowerCase())) { \n                                                        contboxA_gaEventAction = '스포츠경향';\n                                                    } else if (v.link.toLowerCase().includes(linkWk.toLowerCase())) { \n                                                        contboxA_gaEventAction = '주간경향';\n                                                    } else if (v.link.toLowerCase().includes(linkLk.toLowerCase())) { \n                                                        contboxA_gaEventAction = '레이디경향';\n                                                    }\n\n                                                    contboxA_html += \n                            \"       <a href=\\\"\" + v.link + \"\\\" title=\\\"\" + v.alt_title + \"\\\" onclick=\\\"sendGAAttrEvent(event);\\\" ep_event_page=\\\"\" + visitCh + \"_article_general\\\" ep_event_area=\\\"\" + data.gaEventArea + \"\\\" ep_event_label=\\\"\" + v.alt_title + \"\\\" ep_event_action=\\\"전환_\" + contboxA_gaEventAction + \"_기사\\\">\\n\" +\n                            \"           \" + v.art_title.replace(/\\[.*?\\]/g, '').trim() + \"\\n\" +\n                            \"       </a>\\n\";\n                                                }\n                                                contboxA_html +=\n                            \"   </li>\\n\";\n                                            });\n                                        });\n                                        contboxA_html +=\n                        \"</ul>\\n\";\n                                    }\n                                }\n\n                                $('#contboxA').html(contboxA_html);\n                            }\n                        }\n\n                        if (window.innerWidth < 768) {\n                            if ($('#contboxA').length > 0 && $('#contboxA').css(\"display\") === \"none\") { \n                                $('#contboxA').show(); \n                            }\n\n                            var contentsBoxA = '';\n                            //contentsBoxA = {\"type\":\"latest\",\"data\":{\"title\":\"경제\",\"articles\":{\"202509291038001\":{\"art_id\":\"202509291038001\",\"art_title\":\"동전 은퇴의 시대···10원부터 500원까지, 설 교환액 올해는 ‘0원’이었다\",\"alt_title\":\"동전 은퇴의 시대···10원부터 500원까지, 설 교환액 올해는 ‘0원’이었다\",\"proc_title\":\"동전 은퇴의 시대···10원부터 500원까지, 설 교환액 올해는 ‘0원’이었다\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.02de31eed043408588ee968c560853bf_P1.png\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.02de31eed043408588ee968c560853bf_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291038001\",\"summary\":\"명절마다 최소 수십만원씩은 있었던 새 동전 교환수요가 올해 설부터 사라졌다. 반면 5만원권 새 지폐 교환수요는 올해 설에 최대치를 기록했다.\\n\\n국회 기획재정위원회 소속 차규근 조국혁신당 의원이 29일 한국은행에서 받은 자료를 보면, 한은은 올해 설을 앞둔 1월 13&#8764;24일 343억4000만원어치 화폐를 신권으로 바꿔줬다.\\n\\n5만원권 수요는 158억6000만원으로 역대 최대치를 기록했다. 1년 전인 지난해 설(148억8000만원)보다 10억원가량 늘었다. 1만원권 교환 규모는 올해 설(140억1000만원)이 지난해 설(149억3000만원)보다 10억원 가까이 작았다.\\n\\n올해부터 새 동전 교환은 자취를 감췄다. 올 설에는 10원, 50원, 100원, 500원 등 모든 종류의 동전 교환액이 0원으로 집계됐다. 지난해 설엔 10원 동전 10만원, 50원 동전 50만원, 100원 동전 200만원, 500원 동전 900만원이 교환된 것과 대조적이다. 최근 현금 사용이 갈수록 ...\",\"video_src\":\"\",\"hit\":9151},\"202509291644001\":{\"art_id\":\"202509291644001\",\"art_title\":\"결국 백기 든 카카오톡…‘친구 목록’ 되살린다\",\"alt_title\":\"결국 백기 든 카카오톡…‘친구 목록’ 되살린다\",\"proc_title\":\"결국 백기 든 카카오톡…‘친구 목록’ 되살린다\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.c2523c2841ef4770ba3c6f5ad6952800_P1.png\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.c2523c2841ef4770ba3c6f5ad6952800_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291644001\",\"summary\":\"대규모 개편 이후 이용자들의 거센 질타를 받은 카카오톡이 엿새 만에 결국 백기를 들었다.\\n\\n카카오는 카카오톡 첫 화면에 전화번호부식 ‘친구 목록’을 띄우는 방식으로 친구 탭을 개선한다고 29일 밝혔다.\\n\\n카카오톡 애플리케이션(앱)을 열면 바로 띄워졌던 피드형 게시물은 별도의 ‘소식’ 메뉴를 통해 볼 수 있도록 한다. 개발 일정 등을 고려하면 개선은 4분기 내에 이뤄질 예정이다.\\n\\n카카오톡이 서비스 출시 15년 만에 단행한 개편을 되돌린 것은 이용자들의 항의가 쇄도했기 때문이다. 앞서 지난 23일 카카오는 쇼트폼 기능 추가, 생성형 인공지능(AI) 챗GPT 탑재 등을 포함한 카카오톡 개편안을 공개했다.\\n\\n그러나 개편 직후 여론은 들끓었다. 기존 전화번호부식 친구 목록 대신 인스타그램과 같이 친구가 올린 사진·동영상 등 콘텐츠를 모아 보여주는 방식으로 바뀐 친구 탭이 문제였다. 이용자들은 궁금하지 않은 지인의 프로필 변동 내역이 표시되는 것이 피로하다고 지적했다. 일부 이용자들은 온...\",\"video_src\":\"\",\"hit\":2764},\"202509291440001\":{\"art_id\":\"202509291440001\",\"art_title\":\"한은 “외환보유고상 대미 직접투자 여력 최대 연 200억달러”\",\"alt_title\":\"한은 “외환보유고상 대미 직접투자 여력 최대 연 200억달러”\",\"proc_title\":\"한은 “외환보유고상 대미 직접투자 여력 최대 연 200억달러”\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/rcv.YNA.20250903.PYH2025090307650001300_P1.jpg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/rcv.YNA.20250903.PYH2025090307650001300_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291440001\",\"summary\":\"외환보유액을 줄이지 않고 마련할 수 있는 대미 직접투자 금액이 연간 최대 200억달러(약 29조원) 수준이라는 한국은행 추산이 나왔다. 도널드 트럼프 미국 대통령 임기 내 3500억달러(491조원)를 ‘선불’로 내라는 미국 요구를 이행하는 게 사실상 불가능하다는 뜻이다.\\n\\n한은은 29일 오기형 더불어민주당 의원에게 제출한 서면 답변에서 “특별법 제정 등을 통한 법률 리스크 해소를 전제할 경우, 외환보유액 운용수익·외환 시장매입 등 외환보유액 감소를 초래하지 않는 방식으로 조달할 수 있는 외환당국의 자금은 연간 150억달러(21조원) 내외”라고 밝혔다. 한은은 민간 부문에선 정책금융기관의 한국계 외화채권(KP) 발행 등을 통해 연간 50억달러(7조원)를 추가로 조달할 수 있다고 설명했다.\\n\\n즉 외환보유액 감소 없이 연간 확보할 수 있는 자금은 최대 200억달러 수준으로, 이는 미국이 요구하는 3500억달러에 크게 못 미친다. 3500억달러를 3년 내 집행할 경우 외환보유액이 급...\",\"video_src\":\"\",\"hit\":1108},\"202509291428001\":{\"art_id\":\"202509291428001\",\"art_title\":\"LG생활건강, 신임 CEO에 로레알 출신 이선주 사장 선임\",\"alt_title\":\"LG생활건강, 신임 CEO에 로레알 출신 이선주 사장 선임\",\"proc_title\":\"LG생활건강, 신임 CEO에 로레알 출신 이선주 사장 선임\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.f2181a1a7fdf4e5d817d18a29150aac6_P3.jpeg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.f2181a1a7fdf4e5d817d18a29150aac6_P3.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291428001\",\"summary\":\"LG생활건강은 29일 이사회를 열고 다음달 1일자로 이선주 사장(55·사진)을 신임 최고경영자(CEO)에 선임했다고 밝혔다.\\n\\n이 신임 사장은 글로벌 화장품 기업인 로레알 출신으로, 화장품 업계에서 30년간 몸담으며 키엘·입생로랑·메디힐 등 다양한 브랜드를 키워낸 마케팅 전문가이자 경영인이다.\\n\\n로레알 코리아 홍보와 기업 커뮤니케이션 분야에서 시작해 입생로랑과 키엘 브랜드 총괄매니저(GM)를 맡았고, 한국에서 키엘 브랜드를 미국에 이어 글로벌 매출 2위 국가로 성장시키며 주목받았다. 키엘 국제사업개발 수석부사장을 맡으면서는 키엘을 랑콤에 이어 로레알 럭셔리 부문 내 2위 브랜드로 도약시키고 글로벌 매출 2배 성장을 달성했다.\\n\\n이후 엘엔피코스메틱 글로벌전략본부 사장 및 미국법인 지사장으로 근무하며 마스크팩 브랜드인 메디힐의 미국 시장 진출을 진두지휘했다. 유니레버 자회사인 카버코리아 대표이사로 부임해 AHC 브랜드 BI(Brand Identity) 정립 및 경쟁력 강화에도 이바지...\",\"video_src\":\"\",\"hit\":634},\"202509291701011\":{\"art_id\":\"202509291701011\",\"art_title\":\"김윤덕 국토부 장관 “종합적으로 검토해 부동산 대책 발표…보유세는 강화해야”\",\"alt_title\":\"김윤덕 국토부 장관 “종합적으로 검토해 부동산 대책 발표…보유세는 강화해야”\",\"proc_title\":\"김윤덕 국토부 장관 “종합적으로 검토해 부동산 대책 발표…보유세는 강화해야”\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.f386fc0257694f88b35ab1ce81ed2921_P1.jpg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.f386fc0257694f88b35ab1ce81ed2921_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291701011\",\"summary\":\"김윤덕 국토교통부 장관이 추석 연휴 이후 금융·세제 등을 망라한 범부처 차원의 부동산 종합대책을 내놓을 가능성을 시사했다. 정부가 9·7 부동산 공급대책을 발표한 이후에도 수도권 선호지역 아파트값 상승폭이 매주 커지는 데 대응하기 위한 차원으로 보인다. 김 장관은 사견임을 전제로 부동산 보유세 강화가 필요하다고 했다.\\n\\n김 장관은 29일 정부세종청사 인근 식당에서 취임 후 첫 기자간담회를 열고 수도권 아파트값과 관련해 “상당히 오르는 추세를 보이고 있어 매우 심각하게 바라보고 있다”고 밝혔다.\\n\\n최근 부동산 시장에선 정부가 조만간 수도권 일부 지역을 규제지역으로 추가 지정할 것이라는 전망이 지배적이다. 서울 강남3구·용산구와 달리 규제에서 벗어난 서울 마포·성동구와 경기도 과천·분당 등지에 매수 수요가 쏠리며 집값이 큰 폭으로 상승하고 있어서다.\\n\\n김 장관은 “추석 전에 (집값 상승과 관련해) 일정한 대응이 필요한 게 아니냐는 의견도 있었지만, (문재인 정부 당시) 국토부가 발 ...\",\"video_src\":\"\",\"hit\":388},\"202509291044001\":{\"art_id\":\"202509291044001\",\"art_title\":\"무비자 시행 첫날, 인천항에 ‘유커’ 2000여명 입국···지역경제 ‘특수’ 기대\",\"alt_title\":\"무비자 시행 첫날, 인천항에 ‘유커’ 2000여명 입국···지역경제 ‘특수’ 기대\",\"proc_title\":\"무비자 시행 첫날, 인천항에 ‘유커’ 2000여명 입국···지역경제 ‘특수’ 기대\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.a8563c52681e4c1ab587ea5b0388a161_P1.jpg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.a8563c52681e4c1ab587ea5b0388a161_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291044001\",\"summary\":\"중국인 단체관광객(유커)에 대한 무비자 입국이 시행된 첫날, 인천항에 유커 2000여명이 크루즈로 입항했다.\\n\\n인천항만공사는 29일 오전 6시 30분쯤 중국 톈진에서 출발한 천진동방국제크루즈의 ‘드림(Dream)호’가 인천항 크루즈터미널에 들어왔다고 밝혔다.\\n\\n중국~일본~제주 등 동북아 단기 노선을 운항하는 7만7000t의 드림호에는 유커 2189명과 승무원 563명이 탑승했다. 지난 27일 중국 톈진을 출발한 드림호는 이날 오후 10시에 다시 톈진으로 출항한다.\\n\\n이날 크루즈로 입항한 유커들은 차이나타운과 신포시장, 경복궁 등 인천과 서울의 주요 관광지를 방문했다.\\n\\n인천시와 인천항만공사는 이날 인천항 1·8부두 상상플랫폼 광장에서 지역 먹거리와 전통공연, 개화기 의상 체험 제공, 지역상품 판매 부스 등 크루즈 환대 행사를 개최했다. 또한 크루즈 승무원들에게는 무료 셔틀버스를 제공, 송도관광을 유도했다.\\n\\n이날 인천항에 입항한 드림호는 한국 정부가 유커들에 대해 무비자 입국...\",\"video_src\":\"\",\"hit\":371},\"202509291214001\":{\"art_id\":\"202509291214001\",\"art_title\":\"전체 펀드 판매잔고, 사상 첫 1000조원 돌파\",\"alt_title\":\"전체 펀드 판매잔고, 사상 첫 1000조원 돌파\",\"proc_title\":\"전체 펀드 판매잔고, 사상 첫 1000조원 돌파\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/rcv.YNA.20250929.PYH2025092902170001300_P1.jpg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/rcv.YNA.20250929.PYH2025092902170001300_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291214001\",\"summary\":\"국내 펀드 판매잔고가 사상 처음으로 1000조원을 넘어섰다.\\n\\n29일 금융투자협회에 따르면 증권사, 은행 등 금융회사에서 판매된 전체 펀드 판매잔고는 지난 8월 말 기준 1002조9890억원으로 집계됐다. 지난해 말(872조8000억원) 대비 약 14.9%(130조2000억원) 늘어났다.\\n\\n펀드 판매잔고는 상장지수펀드(ETF) 등 상장시장에서 거래되는 펀드를 제외한 공모·사모펀드의 잔고를 뜻한다. ETF 등 상장펀드를 포함한 국내 전체 펀드시장 규모는 8월 말 순자산총액 기준으로 1308조8000억원을 기록했다.\\n\\n유형별로 보면, 일반 대중이 가입할 수 있는 공모펀드의 잔액(302조5000억원)이 지난해 말(233조원) 대비 29.8% 늘어났다. 전문투자자가 투자하는 사모펀드 잔액은 지난해 말(639조8000억원)보다 9.5% 증가한 700조5000억원으로 집계됐다.\\n\\n잔액은 사모펀드가 공모펀드보다 두 배 넘게 많았지만 계좌 수는 사모펀드 9만개(0.2%), 공모펀드 3593만개...\",\"video_src\":\"\",\"hit\":237},\"202509291030001\":{\"art_id\":\"202509291030001\",\"art_title\":\"서울시, 2031년 착공목표량의 64% ‘한강벨트’에 집중공급한다\",\"alt_title\":\"서울시, 2031년 착공목표량의 64% ‘한강벨트’에 집중공급한다\",\"proc_title\":\"서울시, 2031년 착공목표량의 64% ‘한강벨트’에 집중공급한다\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250928.5569ca42b3844bdf95b5ebb826009bf1_P1.jpg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250928.5569ca42b3844bdf95b5ebb826009bf1_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291030001\",\"summary\":\"서울시가 재개발·재건축 과정에서 필요한 행정절차를 추가로 단축한다. 사업시행인가부터 이주완료까지 평균 18년6개월이 걸리는 정비기간을 최대 12년으로 줄인다는 계획이다.\\n\\n각종 협의·검증 과정에서 반복 시행하는 절차를 줄인다. 조합이 보호 사각지대에 있는 세입자에 대한 추가 이주대책을 내놓을 경우 용적률 인센티브도 제공한다. 사업추진 과정에서 발생하는 고질적인 지연 요소들을 제거하겠다는 취지다.\\n\\n서울시는 또 정비사업 의지가 높고, 집값 상승폭이 큰 한강벨트 등 선호지역에 2031년까지 전체 공급목표량(착공기준·31만 가구)의 63.8%인 19만8000가구를 집중 공급하기로 했다.\\n\\n서울시는 이같은 내용의 ‘신속통합기획 2.0’ 추진계획을 29일 발표했다. 민간주도의 주택공급 방식을 그대로 유지하면서 정비사업 과정에서의 각종 ‘인·허가 규제’를 대폭 간소화해 정비사업에 속도를 내겠다는 것이다.\\n\\n서울시는 그동안 정비지수제 폐지, 신통기획 도입, 사업성 보정계수 적용, 정비사업...\",\"video_src\":\"\",\"hit\":148},\"202509291048011\":{\"art_id\":\"202509291048011\",\"art_title\":\"‘국민 세단’이 돌아왔다…현대차, ‘2026 쏘나타 디 엣지’ 출시\",\"alt_title\":\"‘국민 세단’이 돌아왔다…현대차, ‘2026 쏘나타 디 엣지’ 출시\",\"proc_title\":\"‘국민 세단’이 돌아왔다…현대차, ‘2026 쏘나타 디 엣지’ 출시\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.409bc53e1773482ca7cd7f1cab3166f5_P1.jpg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250929.409bc53e1773482ca7cd7f1cab3166f5_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291048011\",\"summary\":\"현대자동차가 중형 세단 쏘나타의 연식 변경 모델인 ‘2026 쏘나타 디 엣지’를 출시한다고 29일 밝혔다.\\n\\n쏘나타 디 엣지는 기존에 고객 선호도가 높았던 필수 사양들로 실속 있게 구성한 신규 트림 ‘S’가 추가된 것이 특징이다.\\n\\nS트림은 엔트리 트림인 ‘프리미엄’을 기반으로 12.3인치 클러스터·내비게이션, 후측방 충돌 방지 보조, 고속도로 주행 보조, 1열 통풍 시트, 듀얼 풀오토 에어컨 등을 탑재했다.\\n\\n기존 트림에도 다양한 편의·안전 사양을 기본으로 적용했다.\\n\\n프리미엄 트림에는 전방 충돌방지 보조, 스마트 크루즈 컨트롤(스탑앤고 기능 포함), 전자식 룸미러(ECM)가 적용됐고, 주력 트림인 익스클루시브 트림에는 원격 스마트 주차 보조, 서라운드 뷰 모니터, 후측방 모니터, 측방 주차 거리 경고, 후방 주차 충돌 방지 보조 등의 기능을 넣었다.\\n\\n또 최상위 트림인 ‘인스퍼레이션’에 나파 가죽 시트와 메탈 페달을 기본 적용해 고급스러움을 더했다.\\n\\n아울러 현대차는 고객...\",\"video_src\":\"\",\"hit\":97},\"202509291537011\":{\"art_id\":\"202509291537011\",\"art_title\":\"“임시공휴일 지정해도 소비진작 효과 크지 않아”\",\"alt_title\":\"“임시공휴일 지정해도 소비진작 효과 크지 않아”\",\"proc_title\":\"“임시공휴일 지정해도 소비진작 효과 크지 않아”\",\"image\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250123.48d77d9080ac4b88b66c01c9a7fba958_P1.jpeg\",\"webp\":\"https:\\/\\/img.khan.co.kr\\/news\\/2025\\/09\\/29\\/news-p.v1.20250123.48d77d9080ac4b88b66c01c9a7fba958_P1.webp\",\"link\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291537011\",\"summary\":\"추석·설 등 명절 연휴 전후로 임시공휴일이 지정돼 연휴 기간이 늘더라도 소비진작 효과는 크지 않다는 한국은행 분석이 나왔다.\\n\\n한은은 29일 이 같은 내용을 담은 ‘고빈도 데이터를 통해 본 날씨·요일의 소비 영향’ 보고서를 발표했다. 한은이 임시공휴일이 포함된 2023년 추석 및 올해 설 연휴와 임시공휴일이 없었던 2023년 설 및 2024년 설·추석을 비교한 결과, 연휴 기간 전후 4주간 일평균 카드사용액에 큰 변화가 없는 것으로 나타났다.\\n\\n한은은 “연휴 전후로 소비가 대체되는 가운데 임시공휴일로 인해 발생하는 영업일 감소 효과와 연휴 기간 대면소비 증가 효과가 상쇄됐을 가능성이 있다”고 밝혔다.\\n\\n임시공휴일이 낀 명절 연휴 시작 전 1주간 일평균 카드사용액은 여타 명절보다 10% 이상 증가하는 흐름을 보였다. 반면 연휴 종료 후 1주간 카드사용액은 5~8% 정도 감소했다. 한은은 “연휴가 평소보다 길어져 소비를 앞당기는 ‘소비의 기간간 대체효과’에 기인한 것으로 보인다”고 ...\",\"video_src\":\"\",\"hit\":69}}},\"gaEventArea\":\"article_contents_섹션_많이본기사\"};\n                            if (isEmpty(majorArticles) != true && Object.keys(majorArticles).length > 0) { \n                                contentsBoxA = { type : \"major\", data : { title : \"지금 가장 주목받는 기사\", articles : { ...majorArticles } }, gaEventArea : \"article_contents_지금가장주목받는기사\" }; \n                            }\n\n                            if (isEmpty(contentsBoxA) != true && Object.keys(contentsBoxA).length > 0) { \n                                if (contentsBoxA.type == 'series') { \n                                    var articleSeries = [];\n                                    if (isEmpty(articleSeries) != true && Object.keys(articleSeries).length > 0) {\n                                        draw_contentsA(contentsBoxA, articleSeries);\n                                    } else { \n                                        draw_contentsA(contentsBoxA);\n                                    }\n                                } else { \n                                    draw_contentsA(contentsBoxA);\n                                }\n                            }\n                        } else { \n                            if ($('#contboxA').length > 0 && $('#contboxA').css(\"display\") === \"block\") { \n                                $('#contboxA').hide();\n                            }\n                        }\n                        </script>\n<p class=\"content_text text-l\">DS 부문의 경우 올해 고대역폭메모리(HBM)를 비롯한 반도체 사업의 전반적인 부진에 대해 반성하고, 근원적 경쟁력을 회복하기 위한 해법을 모색하는 게 급선무다. 미국 도널드 트럼프 2기 행정부 집권을 앞두고 미·중 갈등 심화 등 대외 변수가 큰 만큼 내년 반도체 시황을 공유하며 리스크 최소화 대책을 심도있게 논의할 것으로 보인다.</p><p class=\"content_text text-l\">한 부회장과 전 부회장은 지난달 1일 창립 55주년 기념사에서 “임직원 모두가 사활을 걸고 본질인 기술 리더십을 더욱 강화해 한치의 부족함 없는 품질 경쟁력을 확보해야 한다”며 “고객에게 더 나은 경험과 편리한 삶을 제공할 수 있도록 세상에 없는 기술, 세상을 바꿀 수 있는 기술을 선제적으로 확보해 미래 차별화 경쟁력의 원천으로 만들어 나가자”고 강조했다.</p>\n\n\t\t</div>\n\t\t</section>\n\n                <script src=\"https://static.khan.co.kr/js/khan/view_fontSize.js\" charset=\"UTF-8\"></script>\n                <!-- // 기사 본문 -->\n\n                <!-- 기사 본문 하단 -->\n\t\t<footer>\n                    <div class=\"footerFirst\">\n\n                    <!-- 기자 카드 -->\n                    <div class=\"editor-wrap\" ep_page_scrollarea='{\"1280\":2,\"1024\":2,\"768\":2,\"393\":2}'>\n\t\t<div class=\"swiper-container\">\n\t\t<ul class=\"swiper-wrapper alone\">\n\t\t<li class=\"swiper-slide\">\n\t\t<dl>\n\t\t<dt>\n\t\t<div class=\"photo\">\n                                                <picture>\n                                                    <!-- <source type=\"image/webp\" srcset=\"https://img.khan.co.kr/spko/sub_2017/img_thumb_human_profile.webp\" loading=\"lazy\">\n                    