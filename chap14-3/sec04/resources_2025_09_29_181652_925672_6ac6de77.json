kr\\/ranking\\/khan\\/mobile\\/MATop\\/1170_1759130765_4qbeY3piXQDFQmwG.png\",\"relations\":[],\"data_id\":1175,\"menu_id\":null,\"menu_code\":\"KM_25_MATop\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1170_1759130765_4qbeY3piXQDFQmwG.webp\",\"proc_title\":\"결국 고개숙인 오세훈 “한강버스 운항중단 시민께 송구”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291400001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291400001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291141001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291141001\",\"sec_id\":\"940202\",\"title\":\"‘국정자원 화재 원인’ 배터리, 작년 6월 ‘교체 권고’ 받았었다\",\"relation_members_only\":[null],\"summary\":\"국가정보자원관리원(국정자원) 화재 원인으로 지목된 무정전·전원 장치(UPS) 리튬이온 배터리에 대해 지난해 정기검사 점검 업체가 ‘교체 권고’를 한 것으로 확인됐다.\\n행정안전부는 29일 “지난 26일 국정자원 대전본원 5층 7-1 전산실의 화재 원인으로 추정되는 ‘무정전·전원 장치(UPS)’ 리튬이온 배터리는 사용연한 10년이 지나 교체 권고를 받았다”고 밝혔다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1176_1759116664_4TDbrT4ROkMQGnyb.jpg\",\"relations\":[],\"data_id\":1176,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle1\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1176_1759116664_4TDbrT4ROkMQGnyb.webp\",\"proc_title\":\"‘국정자원 화재 원인’ 배터리, 작년 6월 ‘교체 권고’ 받았었다\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291141001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291141001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291037001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291037001\",\"sec_id\":\"910402\",\"title\":\"정청래 “국민은 대통령도 쫓아내…조희대가 뭐라고 청문회 거부하나”\",\"relation_members_only\":[null],\"summary\":\"정청래 더불어민주당 대표는 29일 “조희대 대법원장이 뭐라고 진실을 밝히기 위한 국회 청문회를 거부하나”라며 “얼토당토않은 궤변을 늘어놓지 말고 당당히 출석해 진실을 밝히라”고 말했다.\\n정 대표는 이날 오전 국회에서 열린 민주당 최고위원회의에 참석해 “입법·행정·사법부는 다 하늘과 헌법 아래 존재한다”라며 이같이 말했다. 앞서 국회 법제사법위원회에선 민주당이 주도해 오는 30일 조 대법원장 등에 대한 청문회를 열기로 의결했다. 조 대법원장은 법관의 독립 심판을 규정한 헌법 제103조 등을 이유로 들며 불출석 의견서를 제출했다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":null,\"date_picker1\":null,\"date_picker2\":null,\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1174_1759118260_xTXHi7EXJEa9cTz8.jpg\",\"relations\":[],\"data_id\":1177,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle1\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1174_1759118260_xTXHi7EXJEa9cTz8.webp\",\"proc_title\":\"정청래 “국민은 대통령도 쫓아내…조희대가 뭐라고 청문회 거부하나”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291037001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291037001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291043001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291043001\",\"sec_id\":\"910100\",\"title\":\"노만석 검찰총장 대행 “검찰청 폐지에 참담···적극 대응”\",\"relation_members_only\":[null],\"summary\":\"노만석 검찰총장 직무대행이 검찰청 폐지를 담은 정부조직법 개정안이 지난 26일 국회 본회의를 통과한 것과 관련해 29일 검찰 구성원들에게 서신을 보내 “매우 참담하고 무거운 책임감을 느낀다”며 “일선의 의견을 바탕으로 적극적으로 대응하겠다”고 밝혔다. 검찰 내에서 지휘부 책임론이 제기되자 조직 불만을 달래고 나선 것으로 풀이된다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":null,\"date_picker1\":null,\"date_picker2\":null,\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1177_1759116666_DEQx6wQpqz8Lew7W.jpg\",\"relations\":[],\"data_id\":1178,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle1\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1177_1759116666_DEQx6wQpqz8Lew7W.webp\",\"proc_title\":\"노만석 검찰총장 대행 “검찰청 폐지에 참담···적극 대응”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291043001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291043001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291004001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291004001\",\"sec_id\":\"620109\",\"title\":\"협상 결렬 땐 경기도 버스 80% ‘스톱’···버스노사 최종협상 D-1\",\"relation_members_only\":[null],\"summary\":\"오는 30일로 예정된 경기도 버스노사 최종협상이 결렬되면 10월 1일 첫 차부터 경기도 버스의 80%가 멈춘다.\\n경기도는 경기지역 50개 버스업체가 속한 경기도버스노조협의회(이하 경기버스노조)가 총파업을 예고함에 따라 비상근무체제에 돌입하기로 했다고 29일 밝혔다.\\n경기도는 파업이 현실화될 경우를 대비해 시군 및 경기도버스운송사업조합 등 유관기관과 협력 체계를 구축하고 도를 중심으로 비상수송대책본부를 구성해 24시간 비상근무 체계를 가동한다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1178_1759114901_Gf3fjqqJ2XHkHZGK.png\",\"relations\":[],\"data_id\":1179,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle1\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1178_1759114901_Gf3fjqqJ2XHkHZGK.webp\",\"proc_title\":\"협상 결렬 땐 경기도 버스 80% ‘스톱’···버스노사 최종협상 D-1\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291004001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291004001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509281830001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509281830001\",\"sec_id\":\"910100\",\"title\":\"‘정치검찰’이 자초한 검찰청 폐지···수사기관 통제·수사력 보존은 과제로\",\"relation_members_only\":[null],\"summary\":\"검찰청 폐지를 담은 정부조직법 개정안이 지난 26일 국회 본회의를 통과했다. 검찰은 새 정부조직법 공포 후 1년 뒤인 내년 하반기 간판을 내린다. 광복 후 미 군정 시기인 1948년 8월 검찰청법이 제정·공포되면서 법원으로부터 독자적인 조직을 구축한 지 78년 만이다.\\n검찰은, ‘순사’로 상징되는, 일제강점기 비대했던 초법적 경찰 권력을 통제하려는 목적으로 설립됐다. 1982년 ‘단군 이래 최대 금융사기’라 불린 이철희·장영자 사건 수사, 1995년 전두환·노태우 전 대통령 구속 기소, 2002년 불법 대선자금 수사 등 대형 비리 수사로 국민적 지지를 받기도 했다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":null,\"date_picker1\":null,\"date_picker2\":null,\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1177_1759094513_bZ2o1XCgI1OFWv7V.jpg\",\"relations\":[],\"data_id\":1180,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle1\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle1\\/1177_1759094513_bZ2o1XCgI1OFWv7V.webp\",\"proc_title\":\"‘정치검찰’이 자초한 검찰청 폐지···수사기관 통제·수사력 보존은 과제로\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509281830001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509281830001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291056001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291056001\",\"sec_id\":\"910100\",\"title\":\"또 열린 혐중의 입···국힘 김민수 “무비자 입국으로 범죄·전염병 확산 가능성”\",\"relation_members_only\":[null],\"summary\":\"김민수 국민의힘 최고위원이 29일 시작된 중국인 무비자 입국과 관련해 “국민 안전을 담보로 한 위험한 도박”이라며 중국인들의 범죄 행위와 전염병 확산에 유의하라고 주장했다. 국민의힘 내에서 중국인을 무분별하게 범죄인 취급하는 등 극우 일각의 혐중 정서에 편승하는 양상이 나타나고 있다.\\n김 최고위원은 이날 인천 중구 인천관광공사에서 열린 현장 최고위원회의에서 “중국이 자국민의 출국을 제한하고 있는 와중에 우리나라로 몰려드는 중국인의 정체가 궁금하지 않을 수 없다”며 이같이 말했다. 정부는 이날부터 내년 6월30일까지 중국인 관광객 무비자 입국을 시행한다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1191_1759130767_ix1OPeqdD371QNfI.jpg\",\"relations\":[],\"data_id\":1191,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle2\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1191_1759130767_ix1OPeqdD371QNfI.webp\",\"proc_title\":\"또 열린 혐중의 입···국힘 김민수 “무비자 입국으로 범죄·전염병 확산 가능성”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291056001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291056001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291442001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291442001\",\"sec_id\":\"910203\",\"title\":\"대통령실 “이시바 총리 답방, 한·일 셔틀외교 정착 의미···21년 만 지방서 정상회담”\",\"text_style\":[\"news_flash\"],\"relation_members_only\":[null],\"summary\":\"대통령실은 오는 30일 이시바 시게루 일본 총리가 답방 형식으로 방한하는 것을 두고 “한·일 셔틀외교가 복원·정착됐다는 의미”라며 “일본 총리가 양자 방한 계기로 서울 이외 도시를 방문하는 건 2004년 7월 고이즈미 일본 총리가 제주도를 방문해 노무현 전 대통령과 정상회담을 가진 이후 21년 만의 일”이라고 29일 밝혔다.\\n위성락 대통령실 국가안보실장은 이날 용산 대통령실에서 브리핑을 열고 “신정부 출범 3개월여만에 한·일 정상 간의 상호 방문을 완성해 소통과 협력의 선순환을 공고히 하겠다는 의지가 천명됐다는 의의가 있다”며 이같이 말했다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1192_1759130769_umk6VBcEAcZhd4oA.jpg\",\"relations\":[],\"data_id\":1192,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle2\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1192_1759130769_umk6VBcEAcZhd4oA.webp\",\"proc_title\":\"<span class=\\\"tag tag-red\\\">속보<\\/span>대통령실 “이시바 총리 답방, 한·일 셔틀외교 정착 의미···21년 만 지방서 정상회담”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291442001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291442001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291127001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291127001\",\"sec_id\":\"910302\",\"title\":\"“영사관·변호사에 감사”···잔류 택했던 ‘마지막 석방 한국인’, 첫 심경 밝혀\",\"relation_members_only\":[null],\"summary\":\"미국 이민세관단속국(ICE)의 조지아주 한국인 대규모 구금 사태 당시 귀국 대신 미국 잔류를 택했던 한국인 1명이 보석 석방된 이후 첫 심경을 밝혔다.\\n29일 연합뉴스에 따르면 30대 한인 이모씨는 전날 연합뉴스에 보낸 메시지를 통해 “제가 석방될 때까지 많은 분께 도움을 받았다”며 영사관 관계자와 변호사에게 감사의 뜻을 표했다.\\n이씨는 “아직 (이민법원) 재판이 남아있는 상황이라 자세한 이야기는 어렵다”면서도 “앞으로 재판에 성실히 임하겠다”고 했다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1195_1759115604_KN68DUiuyGdK8C1c.jpg\",\"relations\":[],\"data_id\":1193,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle2\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1195_1759115604_KN68DUiuyGdK8C1c.webp\",\"proc_title\":\"“영사관·변호사에 감사”···잔류 택했던 ‘마지막 석방 한국인’, 첫 심경 밝혀\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291127001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291127001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291048021\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291048021\",\"sec_id\":\"970201\",\"title\":\"사퇴 압박 시달리던 에릭 애덤스 뉴욕 시장 결국 “재선 도전 포기”\",\"relation_members_only\":[null],\"summary\":\"차기 뉴욕 시장 선거에서 조란 맘다니 민주당 후보의 당선을 막으려는 세력으로부터 사퇴 압박에 시달린 에릭 애덤스 현 미국 뉴욕 시장이 시장직 재선 도전을 포기했다.\\n애덤스 시장은 28일(현지시간) 엑스에 올린 영상에서 “나는 더는 선거운동을 이어갈 수 없다”며 중도 사퇴 의사를 밝혔다. 애덤스 시장은 내년 초 시장직에서 물러나게 된다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1192_1759125222_UvKhcadYFeA6tRhU.gif\",\"relations\":[],\"data_id\":1194,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle2\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MAMajorArticle2\\/1192_1759125222_UvKhcadYFeA6tRhU.webp\",\"proc_title\":\"사퇴 압박 시달리던 에릭 애덤스 뉴욕 시장 결국 “재선 도전 포기”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291048021\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291048021\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509290600091\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509290600091\",\"sec_id\":\"920202\",\"title\":\"‘예매전쟁’ SRT 좌석, 10월부턴 주 3280석 더 줄어든다\",\"text_style\":[\"lone\"],\"relation_members_only\":[null],\"summary\":\"승차권 ‘품귀’ 현상이 이어지고 있는 수서고속철도(SRT) 좌석이 추석 연휴 직후부터 주당 3000석 이상 줄어드는 것으로 확인됐다. 열차 고장이나 이상 징후가 발생했을 때 투입할 예비편성 열차를 수서역에 상시 대기시키는 안전 조치가 10월부터 시행되면서다. SRT 운영사인 에스알(SR)의 역량이 제한적인데 정부가 경전선 등 3개 노선을 무리하게 개통을 밀어붙인 결과라는 지적이 나온다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1171_1759096058_0qG0DFWDxfpXk9Mr.jpg\",\"relations\":[],\"data_id\":1195,\"menu_id\":null,\"menu_code\":\"KM_25_MAMajorArticle2\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1171_1759096058_0qG0DFWDxfpXk9Mr.webp\",\"proc_title\":\"<span class=\\\"tag tag-blue\\\">단독<\\/span>‘예매전쟁’ SRT 좌석, 10월부턴 주 3280석 더 줄어든다\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509290600091\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509290600091\",\"videos\":[],\"is_videoArticle\":\"n\"}};\n                    if (isEmpty(newsroomPick) != true && Object.keys(newsroomPick).length > 0) { \n                        var newsroomPickArticle_cnt = 8;\n                        var newsroomPickArticle = new Array();\n                        if (Object.keys(commonDedup).length > 0) {\n                            newsroomPickArticle = Object.fromEntries(Object.entries(newsroomPick).filter(([key]) => !commonDedup.includes(key)));\n                        } else { \n                            newsroomPickArticle = newsroomPick;\n                        }\n\n                        var select_newsroomPicks = Object.keys(newsroomPickArticle).slice(0, newsroomPickArticle_cnt);\n                        select_newsroomPicks.forEach(k => { newsroomPicks[k] = newsroom