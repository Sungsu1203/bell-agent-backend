/adstream_sx.ads/www.khan.co.kr/news@x61', '160', '600', '우측 하단 여백 배너', 'ads4', '2000', '');\r\n                                }\r\n                            </script>\r\n                        </div>\r\n                        <!-- // [pc-AD] 기사면 우측 하단 여백 배너 (160x600) -->                    </div>\n                </div>\n\t\t</div>\n\n            <!-- 기사 본문 영역 -->\n\t\t<article>\n                <!-- 기사 본문 상단 -->\n\t\t<header>\n                    <!-- 탭 타이틀 영역 -->\n\t\t<ul class=\"category\">\n                        <!-- 탭 타이틀 -->\n\t\t<li>\n\t\t<a href=\"https://www.khan.co.kr/economy\" title=\"경제\" class=\"category\" onclick=\"sendGAAttrEvent(event);\" ep_event_page=\"pc_article_general\" ep_event_area=\"article_header_카테고리\" ep_event_label=\"경제\" ep_event_action=\"전환_경향신문_섹션\">경제</a>\n\t\t</li>\n                        <!-- // 탭 타이틀 -->\n\n\t\t</ul>\n                    <!-- // 탭 타이틀 영역 -->\n\n                    <!-- 기사 제목 -->\n\t\t<h1>삼성전자, 불확실성 돌파구 찾을까…글로벌 전략회의 돌입</h1>\n                    <!-- // 기사 제목 -->\n\n                    <!-- 기사 입력/수정일 -->\n\t\t<div class=\"date\">\n\t\t<a href=\"javascript:void(0);\" title=\"기사 입력/수정일\" onclick=\"toggle_dateExpand($(this)); sendGAAttrEvent(event);\" ep_event_page=\"pc_article_general\" ep_event_area=\"article_header_발행일\" ep_event_label=\"펼침\">\n                            <p>입력 2024.12.17 10:45</p>\n                            <p>수정 2024.12.17 14:38</p>\n                            <span class=\"txt\">펼치기/접기</span>\n                        </a>\n\t\t</div>\n                    <!-- // 기사 입력/수정일 -->\n\n\t\t<ul class=\"bottom\">\n                        <!-- 바이라인 -->\n\t\t<li class=\"editor\">\n<a href=\"https://www.khan.co.kr/reporter_article.html?id=20\" onclick=\"sendGAAttrEvent(event);\" title=\"배문규 기자의 다른 기사 보기(새창)\" data-gId=\"20\" ep_event_page=\"pc_article_general\" ep_event_area=\"article_header_기자\" ep_event_label=\"배문규\" ep_event_action=\"전환_기자\">배문규 기자</a>\n\t\t</li>\n                        <!-- // 바이라인 -->\n\n                        <!-- 기사 읽기 및 요약 -->\n\t\t<li class=\"read\">\n\t\t</li>\n                        <!-- // 기사 읽기 및 요약 -->\n\n\t\t</ul>\n\t\t</header>\n                <!-- // 기사 본문 상단 -->\n\n                <!-- 기사 본문 -->\n\t\t<section class=\"art_cont\">\n\t\t<div class=\"art_body\" id=\"articleBody\" itemprop=\"articleBody\">\n\t\t<div class=\"art_photo photo_center\">\n\t\t<div class=\"art_photo_wrap\">\n                            <picture>\n                                <source media=\"(max-width:767px)\" type=\"image/webp\" srcset=\"https://img.khan.co.kr/news/r/600xX/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.webp\">\n                                <source media=\"(min-width:768px) and (max-width:1279px)\" type=\"image/webp\" srcset=\"https://img.khan.co.kr/news/r/700xX/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.webp\">\n                                <source media=\"(min-width:1280px)\" type=\"image/webp\" srcset=\"https://img.khan.co.kr/news/r/700xX/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.webp\">\n                                <source media=\"(max-width:767px)\" type=\"image/jpeg\" srcset=\"https://img.khan.co.kr/news/r/600xX/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.jpeg\">\n                                <source media=\"(min-width:768px) and (max-width:1279px)\" type=\"image/jpeg\" srcset=\"https://img.khan.co.kr/news/r/700xX/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.jpeg\">\n                                <source media=\"(min-width:1280px)\" type=\"image/jpeg\" srcset=\"https://img.khan.co.kr/news/r/700xX/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.jpeg\">\n                                <img width=\"700\" src=\"https://img.khan.co.kr/news/2024/12/17/news-p.v1.20241217.3bf4a8a5dc314ab2951abb498b1bf00b_P1.jpeg\" alt=\"서울 서초구 삼성전자 사옥에 깃발이 휘날리고 있다.   한수빈 기자\" fetchpriority=high />\n                            </picture>\n\t\t<p class=\"caption\" style=\"width : 700px\">서울 서초구 삼성전자 사옥에 깃발이 휘날리고 있다.   한수빈 기자</p>\n\t\t</div>\n\t\t</div>\n<p class=\"content_text text-l\">최근 연말 인사와 조직 개편을 마무리한 삼성전자가 글로벌 복합 위기의 돌파구를 찾기 위해 내년 사업 전략을 논의한다.</p><p class=\"content_text text-l\">17일 재계에 따르면 삼성전자는 이날부터 사흘간 글로벌 전략회의를 열고 내년 사업 계획 구상에 나선다. 이날은 디바이스경험(DX) 부문의 전사와 모바일 경험(MX)사업부가, 18일은 영상디스플레이(VD)와 생활가전(DA)사업부가 회의를 진행하고, 19일에는 반도체 사업을 담당하는 디바이스솔루션(DS) 부문이 회의를 한다.</p><!-- KH_View_MCB_25 -->\r\n            <!-- [pc-AD] 기사면 본문배너 1 (250x250) -->\r\n            <div class=\"banner-article-left type-pc\">\r\n                <div class=\"ad-wrapper\">\r\n                    <div class=\"ad-inner-wrap\" style=\"width:250px;height:250px;\">\r\n                        <div id=\"ads28\">\r\n                            <script>\r\n                                if (typeof is_mobile !== 'undefined' && is_mobile === false) {\r\n                                    createIframe('//adv.khan.co.kr/RealMedia/ads/adstream_sx.ads/www.khan.co.kr/news@x17', '250', '250', '기사면 본문 배너1', 'ads28', '0', ''); \r\n                                }\r\n                            </script>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <!--// [pc-AD] 기사면 본문배너 1 (250x250) -->\r\n            <script>\r\n                $(document).ready(function() { // 애드블록 체크\r\n                    if (typeof is_mobile !== 'undefined' && is_mobile === false) {\r\n                        setTimeout(function() {\r\n                                let content = $(\"#ads28 iframe\")\r\n\r\n                                if (!content.length || content[0].offsetWidth === 0 || content[0].offsetHeight === 0 || content.css(\"display\") === \"none\") {\r\n                                    content.parent().parent().parent().parent().hide();\r\n                                } else {\r\n                                }\r\n                        },50)\r\n                    }\r\n                })\r\n            </script><!-- MKH_View_MCA_25 -->\r\n<!-- [m-AD] 모바일웹 기사면 본문 배너 (250x250) -->\r\n<div class=\"banner-article-right type-mo\">\r\n    <div class=\"ad-wrapper\">\r\n        <div class=\"ad-inner-wrap\" style=\"width:200px;height:200px;\">\r\n            <div id=\"mAds2\">\r\n                <script>\r\n                    if (typeof is_mobile !== 'undefined' && is_mobile === true) {\r\n                        createIframe(\"//adv.khan.co.kr/RealMedia/ads/adstream_sx.ads/m.www.khan.co.kr/newspage@x14\",\"200\",\"200\",\"본문 배너\",\"mAds2\",\"0\",\"\");\r\n                    }\r\n                </script>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<!-- // [m-AD] 모바일웹 기사면 본문 배너 (250x250) --><p class=\"content_text text-l\">삼성전자는 매년 6월과 12월에 각 부문장 주재 아래 글로벌 전략회의를 열어왔다. 한종희 DX부문장(부회장)과 전영현 DS부문장(부회장)이 각각 회의를 주관한다. 이재용 회장은 예년처럼 회의에 직접 참석하지 않고 추후 사업 전략 등을 보고받을 예정인 것으로 알려졌다.</p><p class=\"content_text text-l\">이번 회의에서는 제품별 판매 확대 전략, 고환율 등에 따른 리스크 관리 전략 등이 논의될 것으로 전망된다. MX 사업부는 노태문 사업부장(사장)을 중심으로 갤럭시 S25 등 내년 상반기 라인업의 판매 전략을 점검할 것으로 보인다. 프리미엄폰에서 우위를 유지하는 동시에 중국 공세에 대응한 중저가 제품 판매 확대 전략을 모색할 것으로 예상된다. TV·가전 사업의 경우 내년 1월 열리는 세계 최대 가전·정보기술(IT) 전시회 ‘CES 2025’에서 선보일 신제품 등 제품별 운영 방안을 점검하고, 삼성 TV 플러스와 가전 구독 서비스 확대 방안을 논의할 것으로 보인다.</p>\n                        <!-- 기사 본문 콘텐츠 박스 -->\n                        <div class=\"contbox-wrap\" id=\"contboxA\" style=\"display:none;\">                            \n                        </div>\n                        <!-- // 기사 본문 콘텐츠 박스 -->\n\n                        <script>\n                        function draw_contentsA(data, seriesData=null) {\n                            if (isEmpty(data) == true || Object.keys(data).length == 0) { return ''; } \n                            \n                            var data_articles = new Array();\n                            if ((isEmpty(data.type) != true && data.type != 'major') && (Object.keys(data.data.articles).length > 0 && Object.keys(commonDedup).length > 0)) {\n                                data_articles = Object.fromEntries(Object.entries(data.data.articles).filter(([key]) => !commonDedup.includes(key)));\n                            } else { \n                                data_articles = data.data.articles;\n                            }\n\n                            var datas = Object.entries(data_articles).map(([k, v]) => { return { [k]: v }; });\n                            if (isEmpty(data.type) != true && data.type == 'major') {\n                                datas.shuffle();\n                            }\n\n                            if ($('#contboxA').length > 0) { \n                                var linkSk = \"https://sports.khan.co.kr\";\n                                var linkWk = \"https://weekly.khan.co.kr\";\n                                var linkLk = \"https://weekly.khan.co.kr\";\n\n                                var contboxA_html = '';\n                                if (isEmpty(data.type) != true) {\n                                    var contentsA_dataType = data.type;\n                                    if (data.type == 'major') { \n                                        contentsA_dataType = 'latest';\n                                    }\n\n                                    if (!$('#contboxA').hasClass(contentsA_dataType)) {                                         \n                                        $('#contboxA').addClass(contentsA_dataType);\n                                    }\n                                    \n                                    contboxA_html +=\n                            \"<article>\\n\" +\n                            \"   <span class=\\\"title\\\">\\n\";\n                                    if (data.type == 'major') { \n                                        contboxA_html +=\n                            \"       \" + data.data.title + \"\\n\";\n                                   