ject.keys(recommendArticles));\n                            } else {\n                                commonDedup = Object.keys(recommendArticles);\n                            }\n                        }\n                    } \n\n/*\n                    var newsroomPicks = {};\n                    var newsroomPick = {\"202509291609001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291609001\",\"sec_id\":\"910203\",\"title\":\"‘이재명의 입’ 김남준 제1부속실장, 대통령실 대변인에…강유정과 2인체제로\",\"text_style\":[\"news_flash\"],\"relation_members_only\":[null],\"summary\":\"김남준 대통령실 제1부속실장이 대변인으로 임명됐다. 강유정 대변인과 2인 체제로 운영된다.\\n강훈식 대통령비서실장은 29일 서면 브리핑을 통해 “대변인을 추가해 대국민 소통도 더 늘리겠다”며 이 같이 발표했다.\\n‘이재명의 입’으로 불리는 김 대변인은 성남 지역 방송기자 출신으로 2014년 성남시 대변인으로 영입돼 이 대통령과 줄곧 함께했다. 경기도 언론비서관·선거대책본부 대변인 등을 거쳤으며, 이 대통령의 최측근 그룹에서 언론 소통 역할을 담당해왔다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"radio\":\"normal\",\"select\":\"a\",\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1164_1759130574_fuewBJKSzyoYaay7.png\",\"relations\":[],\"data_id\":1164,\"menu_id\":null,\"menu_code\":\"KM_25_MATop\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1164_1759130574_fuewBJKSzyoYaay7.webp\",\"proc_title\":\"<span class=\\\"tag tag-red\\\">속보<\\/span>‘이재명의 입’ 김남준 제1부속실장, 대통령실 대변인에…강유정과 2인체제로\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291609001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291609001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291622001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291622001\",\"sec_id\":\"910203\",\"title\":\"‘이 대통령 30년 보좌’ 김현지, 제1부속실장에…“국회서 결정하면 국감 출석”\",\"text_style\":[\"news_flash\"],\"relation_members_only\":[null],\"summary\":\"국회 운영위원회 출석 여부를 놓고 논란이 불거진 김현지 대통령실 총무비서관이 김남준 제1부속실장의 후임으로 보직 이동했다.\\n대통령실 관계자는 29일 “김현지 총무비서관이 김 실장의 후임으로 제1부속실장으로 자리를 옮겼다”고 밝혔다. 김 비서관이 있던 총무비서관 자리에는 윤기천 제2부속실장이 보직 이동했다.\\n대통령실은 이번 인사가 김 실장의 대변인 발탁에 따른 연쇄 이동이라고 설명했다. 김 비서관의 국회 출석을 둘러싼 여야 공방과는 무관하다는 취지다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1165_1759130763_Y6pvDrn9GjgO1sLD.jpg\",\"relations\":[],\"data_id\":1165,\"menu_id\":null,\"menu_code\":\"KM_25_MATop\",\"thumbnail_webp\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1165_1759130763_Y6pvDrn9GjgO1sLD.webp\",\"proc_title\":\"<span class=\\\"tag tag-red\\\">속보<\\/span>‘이 대통령 30년 보좌’ 김현지, 제1부속실장에…“국회서 결정하면 국감 출석”\",\"proc_url\":\"https:\\/\\/www.khan.co.kr\\/article\\/202509291622001\",\"proc_murl\":\"https:\\/\\/m.khan.co.kr\\/article\\/202509291622001\",\"videos\":[],\"is_videoArticle\":\"n\"},\"202509291642001\":{\"media\":\"khan\",\"art_type\":\"article\",\"members_only\":\"N\",\"art_id\":\"202509291642001\",\"sec_id\":\"960100\",\"title\":\"중고차 값 뺨치는 ‘970만원’···K팝 암표 최고가, 에스파·블랙핑크 아니라 ‘이 그룹’\",\"text_style\":[\"lone\"],\"relation_members_only\":[null],\"summary\":\"최근 3년 간 신고된 공연 암표 5000여 건 중 발권 취소 등 조치가 이뤄진 경우는 3.8%에 불과한 것으로 조사됐다. 지난해 공연법이 개정되며 처벌이 강화됐지만, 정가 15~20만원짜리 K팝 공연 티켓이 온라인상에서 최대 970만원까지 치솟는 등 암표는 여전히 기승을 부리고 있다.\\n국회 문화체육관광위원회 소속 민형배 더불어민주당 의원이 29일 한국콘텐츠진흥원으로부터 제출받은 ‘공연 암표 신고 주요 현황’에 따르면, 2023년부터 2025년 8월까지 총 5405건의 암표 신고가 접수됐다.\\n\",\"sub_title\":null,\"text1\":null,\"rank_url\":null,\"url1\":null,\"color_picker\":\"black\",\"date_picker1\":null,\"time_picker1\":\"00:00\",\"date_picker2\":null,\"time_picker2\":\"00:00\",\"thumbnail\":\"\\/\\/img.khan.co.kr\\/ranking\\/khan\\/mobile\\/MATop\\/1166_1759133711_WFnd98jFAcHF2eES.jpg\",\"relations\":[],\"data_id\":1166,\"menu_id\":null,\"menu_code\":\"KM_25_MATop\",\"thumbnail_webp\":\"\\/\\/im