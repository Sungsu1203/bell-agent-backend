# ─────────────── Dev/Optional ───────────────
# 렌더(머메이드 → PNG)
RENDER_GRAPH=0

RAG_CHUNK_CHARS=2400
RAG_CHUNK_OVERLAP=200
RAG_EMBED_BATCH=64
RAG_TOKEN_BUDGET_PER_REQ=250000
RAG_EMBEDDING_MODEL=text-embedding-3-large
WEB_SEARCH_RAW_FETCH_TOP=8  # WEB_SEARCH_RAW_FETCH_TOP=0 원문로딩 지연 줄임
WEB_FETCH_TIMEOUT_CONNECT=5
WEB_FETCH_TIMEOUT_READ=12
WEB_FETCH_BUDGET_SECONDS=25

# ===== Web search =====
SKIP_WEB_SEARCH=0                # 1이면 웹검색 전체 건너뜀(로컬만)
MAX_SEARCH_QUERIES_PER_ROUND=4   # 라운드당 웹쿼리 상한
RAG_TOP_K=6                      # retrieve top-k

# ===== Research loop (옵션) =====
BLOCKAGI_AGENT_ROLE=""           # 'research analyst'면 라운드형 연구 모드
BLOCKAGI_ITERATION_COUNT=1
ITERATION_COUNT=1                # 연구 라운드 수(정수)
RESEARCH_HALT_THRESHOLD=0        # 이 값 이하이면 '무신규'로 간주
RESEARCH_MIN_ROUNDS=1            # 최소 라운드 수
RESEARCH_MAX_NO_NEW_ROUNDS=1     # '무신규' 라운드 연속 허용치
RESEARCH_PLANNER_ANNOUNCE=0      # 1이면 플래너 계획을 바로 커뮤니케이터가 요약 출력

# ===== Writer behavior =====
AUTO_WRITE_AFTER_RAG=1           # 1=벡터검색 뒤 자동 집필, 0=수동(벡터 검색만 함)
AUTO_FOOTNOTE=1                  # 자동각주/출처 라벨링 시도 ON, 0이면 OFF

# ===== RAG: Local files =====
# 여러 글롭은 | 로 연결. / 는 OS에 맞춰 자동 변환됩니다.
LOCAL_RAG_GLOBS=resources/*/local/**/*.pdf|tests/refs/**/*.md
LOCAL_RAG_PDF_MAX_PAGES=30
LOCAL_RAG_MAX_TEXT_CHARS=200000

# 셋팅 예

# 조기중단 및 라운드 정책을 손대려면 .env에서:
# RESEARCH_MIN_ROUNDS=1                 # 최소 라운드수(이전 종료 방지)
# RESEARCH_MAX_NO_NEW_ROUNDS=1           # '무신규' 연속 라운드 허용치
# COUNT_PREVIEW_URLS=0                    # 프리뷰 URL 카운트 안 함(기본)
# MAX_INDEXED_PER_ROUND=200             # 0=무제한, >0 이면 상한

# LOCAL_RAG_GLOBS=resources/<topic-slug>/local/**/*.pdf|resources/<topic-slug>/local/**/*.md|resources/<topic-slug>/local/**/*.docx|resources/<topic-slug>/local/**/*.pptx|resources/<topic-slug>/local/**/*.html|resources/<topic-slug>/local/**/*.htm|resources/<topic-slug>/local/**/*.txt|D:\my_refs\ev\**\*.pdf|D:\my_refs\ev\**\*.md|D:\my_refs\ev\**\*.docx|D:\my_refs\ev\**\*.pptx|D:\my_refs\ev\**\*.html|D:\my_refs\ev\**\*.htm|D:\my_refs\ev\**\*.txt|notes\**\*.md|notes\**\*.txt
# 또는 채팅으로 그때그때 추가
# User: add_local: D:\company\refs\ev\*.pdf; notes\ev_market.md
# User: 최신 자료로 RAG 업데이트

# ===== Chroma / topic (옵션) =====
CLEAR_CHROMA_ON_START=1
ALLOW_GLOBAL_CLEAR=0
# TOPIC_SLUG=default              # 고정 토픽 슬러그가 필요할 때만 사용
# CHROMA_DIR=                     # 기본값은 data/chroma_store/<topic_slug>

# ===== Gatekeeping for sources (옵션) =====
# 1이면 web_search_agent가 허용 도메인만 프리뷰/인덱싱
GATE_KEEP_SOURCES=1               # 게이트 끄기 0
# 허용 도메인 화이트리스트(쉼표로 구분). 필요시 iea.org 등 추가
# ALLOWED_DOMAINS는 쉼표 구분, 소문자 매칭(포함 검사) 입니다. sub.molit.go.kr 같은 서브도메인도 자동 허용.
# 게이트를 켜면 검색 JSON도 우선 필터링 후 인덱싱하므로, 원치 않는 상업 리서치/스크립트 페이지가 벡터스토어에 쌓이는 걸 막습니다.
# 게이트로 인해 0건이 되면 자동으로 원본 JSON을 사용하도록 해 인덱싱 전체가 멈추는 걸 방지합니다.
# ALLOWED_DOMAINS=iea.org,me.go.kr,molit.go.kr,motie.go.kr,korea.kr,mss.go.kr,moef.go.kr,kei.re.kr,kama.or.kr,kotra.or.kr,kepco.co.kr,kesis.kr

ALLOWED_DOMAINS=iea.org,oecd.org,irena.org,imf.org,worldbank.org,unep.org,kdi.re.kr,kiet.re.kr,moef.go.kr,korea.kr,kotra.or.kr,kei.re.kr


