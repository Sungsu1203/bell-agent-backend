n\t\t<div class=\"popContainer\" style=\"width: 890px\"><!-- style=\"width:450px\" 추가해주세요-->\r\n\t\t<button id=\"layerImgClose\" class=\"close\">닫기</button>\r\n\t\t<div class=\"popH1\">\r\n\t\t<h2>계속과제 묶어보기 도움말</h2>\r\n\t\t</div>\r\n\t\t<div class=\"popCnt alarmInfo\">\r\n\t\t<img src=\"/images/th/2021/continueProject1.jpg\" alt=\"계속과제 묶어보기 이미지\" width=\"100%\"/>\r\n\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\r\n\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\r\n</script>\r\n\r\n<!-- .alarmInfo min-heigth : 60px; -->\r\n<div class=\"layerWrap dpNone\" id=\"instrBoxLayerBg\">\r\n\t<div class=\"popWrap\" id=\"instrBoxLayer\">\r\n\t\t<div class=\"popContainer\" style=\"width:400px\"><!-- style=\"width:450px\" 추가해주세요-->\r\n\t\t<button id=\"layerinstrBoxClose\" onclick=\"fn_layerinstrBoxClose(); return false;\" class=\"close\">닫기</button>\r\n\t\t<div class=\"popH1\">\r\n\t\t<h2>관심정보함담기</h2>\r\n\t\t</div>\r\n\t\t<div class=\"popCnt alarmInfo\">\r\n\t\t<h3 id=\"instrFolderNm\"><i></i>기본폴더<span style=\"color:red;\">♥</span>에 담겼습니다.</h3>\r\n\t\t<h3><i></i><span style=\"color:blue;\">마이페이지 > 관심정보함</span>에서 확인하세요.</h3>\r\n\t\t</div>\r\n\t\t<div class=\"btnWrap al_c\">\r\n\t\t<button type=\"button\" class=\"btn-lg other\" onclick=\"fn_layerinstrBoxClose(); return false;\">닫기</button>\r\n\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\r\n\r\n\r\n\r\n</script>\r\n\r\n<!-- .alarmInfo min-heigth : 60px; -->\r\n<div class=\"layerWrap dpNone\" id=\"instrBoxContainLayerBg\">\r\n\t<div class=\"popWrap\" id=\"instrBoxContainLayer\">\r\n\t\t<div class=\"popContainer\" style=\"width:300px;\"><!-- style=\"width:450px\" 추가해주세요-->\r\n\t\t<button type=\"button\" id=\"layerInstrBoxClose\" onclick=\"fn_instrBoxContainClose()\" class=\"close\">닫기</button>\r\n\t\t<div class=\"popH1\">\r\n\t\t<h2>관심정보함담기</h2>\r\n\t\t</div>\r\n\t\t<div class=\"popCnt alarmInfo\">\r\n\t\t<div class=\"alarmInner\">\r\n\t\t<div class=\"fieldsetBox\">\r\n\t\t<ul>\r\n\t\t\r\n\t\t</ul>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"btnWrap al_c\">\r\n\t\t<button type=\"button\" class=\"btn-lg other\" id=\"instrBoxContainBtnReg\" onclick=\"fn_instrBoxContainBtnReg()\">관심정보함 담기</button>\r\n\t\t</div>\r\n\t\t<div class=\"smallDescript\">\r\n\t\t<p> 관심한 정보는<a href=\"/ThMyPageNew.do\"><span><strong>마이페이지</strong><strong>관심정보함</strong></span></a>에서 확인 가능합니다. </p>\r\n<!-- \t\t<p> 확인 가능합니다. </p> -->\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\t\t\r\n\r\n<script type=\"text/javascript\">\r\n$(function(){\r\n\r\n\t$(document).on('click', '.chatbotClose', function(e){\r\n\t\t$('.chatbot').hide();\r\n\t});\r\n\r\n\t$(document).on('click', '.betaOpinion', function(e){\r\n// \t\tlocation.href = '/ThNewBoardWriteOp.do?boardDivCd=08&boardDivSeqNo=9&sysTypeCd=09';\r\n\r\n\r\n\t\tvar tmpNum = 0;\r\n\t\t//개발서버\r\n\t\turl = '/ThNewBoardWriteOp.do?boardDivCd=08&boardDivSeqNo=9&sysTypeCd=09';\r\n\t\tgoReaction(url, 'width=1280, height=850');\r\n\r\n\t});\r\n\r\n});\r\n\r\n\r\n</script>\r\n<style>\r\n.chatbotClose {\r\n\twidth: 2rem;\r\n    height: 2rem;\r\n    background: url(/include/images/ico/ico_close_bk.svg) no-repeat;\r\n    left: -20px;\r\n    bottom: 110px;\r\n}\r\n</style>\r\n<!-- 챗봇 -->\r\n<span class=\"chatbot\">\r\n\t<a href=\"javascript:void(0);\" class=\"chatbotClose\"><i></i></a>\r\n<!-- \t<button type=\"button\" class=\"betaOpinion\"><i></i><span>Beta</span>개선의견</button> -->\r\n<button type=\"button\" id=\"chatbotBtn\" class=\"chatbotBtn\"><i></i></button>\r\n<!-- \t\t<img src=\"./images/th/2018/icon_ntischatbot.svg\" alt=\"NTIS ChatBot\"> -->\r\n<!-- \t\t<span style=\"display: inline;\">엔디와의 대화를 통해 <br>국가R&D정보를 찾아보세요~</span> -->\r\n<!-- \t</button> -->\r\n</span>\r\n\r\n<div id=\"chatbotLayer\" style=\"position: fixed; width:500px; height: 100%; right: 0;top:0; background-color: #f8f8f8;z-index: 10000; box-shadow: -3px 0 3px rgba(125, 125, 125, .4); display: none;\">\r\n\t<iframe id=\"visualChartFrame\" name=\"visualChartFrame\" style=\"width: 500px; height: calc(100%); border:none;\" title=\"빈프레임\" src=\"https://www.ntis.go.kr/chatbot/chatbot/chatting/ntisChatbotLayer.do?ntisUserId=\"></iframe>\r\n</div>\r\n\t</div>\r\n</body>\r\n</html>",
