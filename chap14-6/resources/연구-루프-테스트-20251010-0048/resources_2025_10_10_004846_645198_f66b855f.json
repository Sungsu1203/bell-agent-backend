y')[0].style.overflow = \"auto\";\r\n\t});\r\n\r\n\r\n\t$('#btnNtfcPopup').click(function(e){\r\n\t\te.preventDefault();\r\n\t\tvar winfeatures = \"toolbar=no,location=no,status=no,menubar=no,scrollbars=no,resizable=no,width=1200px,height=750px\";\r\n\r\n\t\twindow.open(\"/ThMyPageNewSearchResList.do\", \"blng_org_cd\",\"left=0, top=0, width=1200, height=750, status=no, toolboars=no ,scrollbars=yes\");\r\n\t})\r\n});\r\n\r\n// 신청하기\r\n$(document).on('click', '#layerBtnReg', function(e){\r\n\r\n\tvar newSearchResNtfc = {\r\n\t\t  searchCntnts : strTitle\r\n\t\t, searchKywd : '연료전지'\r\n\t\t, sendCcl : $('[name=sendCcl]:checked').val()\r\n\t\t, searchUrl : document.location.href\r\n\t\t, searchApiUrl : ''\r\n\t\t, searchCnt : '49889'\r\n\t}\r\n\r\n\tCommon.getNewSearchResNtfcDupYn(newSearchResNtfc, getNewSearchResNtfcDupYnCallback);\r\n\r\n});\r\n\r\nfunction getNewSearchResNtfcDupYnCallback(data) {\r\n\tif (data == 1) {\r\n\r\n\t\tjAlert('이미 신규 검색결과 알림이 신청되었습니다.\\n \"마이페이지 > 보관함 > 신규 검색결과 알림\"을 확인 하시기 바랍니다. \\n 재신청 시 상위 메뉴에서 삭제후 신청하시기 바랍니다.', \"알 림\");\r\n\t\t$('#layerNtfcClose').click();\r\n\r\n\t} else {\r\n\r\n\t\tvar newSearchResNtfc = {\r\n\t\t  searchCntnts : strTitle\r\n\t\t, searchKywd : '연료전지'\r\n\t\t, sendCcl : $('[name=sendCcl]:checked').val()\r\n\t\t, searchUrl : document.location.href\r\n\t\t, searchApiUrl : ''\r\n\t\t, searchCnt : '49889'\r\n\t\t}\r\n\r\n\t\tjConfirm(newSearchResNtfc.searchCntnts + \" / \" + newSearchResNtfc.searchKywd + \"에 대한 신규 검색결과 알림을 신청하시겠습니까?\", '알 림', function(confirm){\r\n\t\tif (confirm) {\r\n\t\tCommon.doNewSearchResNtfcInsert(newSearchResNtfc, doNewSearchResNtfcInsertCallback)\r\n\t\t}\r\n\t\t})\r\n\t}\r\n}\r\n\r\nfunction doNewSearchResNtfcInsertCallback(data) {\r\n\r\n\tjAlert(data.searchCntnts + \" / \" + data.searchKywd + \"에 대한 신규 검색결과 알림이 신청되었습니다.\", \"알 림\");\r\n\t$('#layerNtfcClose').click();\r\n}\r\n\r\n\r\n</script>\r\n\r\n<div class=\"layerWrap dpNone\" id=\"ntfcLayerBg\">\r\n\t<div class=\"popWrap\" id=\"ntfcLayer