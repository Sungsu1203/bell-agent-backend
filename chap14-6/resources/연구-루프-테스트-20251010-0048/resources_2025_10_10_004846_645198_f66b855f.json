== \"\"){\r\n\t\tshowMsg = \"\";\r\n\t\t}else {\r\n\t\tshowMsg = \"<ul><li>해당 키워드를 찾으시나요?\";\r\n\t\tshowMsg += \" <a href='javascript:;' onclick='originalSearch();' style='color:#0874d8;'><b>\"+ checkSearchWord + \"</b></a></li></ul>\";\r\n\t\t}\r\n\t\t}\r\n// \t\t}\r\n\t\tif(\"\" != showMsg){\r\n\t\t$('#messageShow').html(showMsg);\r\n\t\t$('#messageShow').show();\r\n\r\n\t\t// 2021.11.08 kh - 오탈자로 검색 결과가 없는 경우 - 자동전환 결과, 입력값 그대로 유지 (PDR 이미지 기준)\r\n// \t\tif($(\"#checkCount\").val() == 0) $(\"#searchWord\").val(originalSearchWord);\r\n\t\t}\r\n\r\n\t\t$('.item_wrap').click(function(){\r\n\t\t$('#trkoImg').val($(this).attr('id'));\r\n\t\tlocation.href = $('#trkoImgLink').attr('href')+\"&trkoImg=\"+$('#trkoImg').val();\r\n\t\t});\r\n\r\n\t\t// 인력 소속기관 \\n => , 로 변경\r\n\t\t$('span[data-name=humanOrg]').each(function(){\r\n\r\n\t\tvar replaceContent = $(this).html().replace(/\\\\n/g, ',');\r\n\t\t$(this).html(replaceContent.replace(\",)\",\")\"));\r\n\r\n\t\t});\r\n\r\n\t\t// 인기검색어 일간/주간/월간\r\n\t\t$('button[id*=btnPopular]').click(function(e){\r\n\t\te.preventDefault();\r\n\t\t$('button[id*=btnPopular]').removeClass('other');\r\n\t\t$(this).addClass('other');\r\n\r\n\t\t$.ajax({\r\n\t\turl : '/ThSearchResultPopularList.do',\r\n\t\tdata : {searchCategory : 'popular', range : $(this).val()},\r\n\t\tdataType : 'html'\r\n\t\t}).done(function(data){\r\n\t\tvar list = $.parseHTML(data);\r\n\r\n\t\t$('#searchResultPopular').remove();\r\n\t\t$('#searchResultPopularUpper').append(list);\r\n// \t\t$('#searchResultPopular').css('border-bottom', '1px solid #d7d7d7');\r\n\t\t}).fail(function(e){\r\n\t\tjAlert('서버에 오류가 발생하였습니다.', '알림');\r\n\t\t});\r\n\r\n\t\t});\r\n\r\n\t// 오늘의 R&D 일간/주간/월간\r\n\t$('button[id*=btnTodayRnD]').click(function(e){\r\n\t\te.preventDefault();\r\n\t\t$('button[id*=btnTodayRnD]').removeClass('other');\r\n\t\t$(this).addClass('other');\r\n\r\n\t\t$('#todayRnDDaychart').hide();\r\n\t\t$('#todayRnDWeekchart').hide();\r\n\r\n\t\tlet idBtn = $(this).attr('id');\r\n\r\n\t\tdayChart.dispose();\r\n\t\tweekChart.dispose();\r\n\r\n\t\tif(idBtn == 'btnTodayRnDDay'){\r\n\t\ttodayRnDDaychart();\r\n\t\t$('#todayRnDDaychart').show();\r\n\t\t}else{\r\n\t\ttodayRnDWeekchart();\r\n\t\t$('#todayRnDWeekchart').show();\r\n\t\t}\r\n\r\n\t});\r\n\r\n\r\n\t// 분석서비스 팝업\r\n\t$('.btnSearchAnalysis1').click(function(e){\r\n\t\t//컬렉션 별 카운트\r\n\t\tvar searchCnt = $(this).attr('data-count');\r\n\t\t//컬렉션 이름\r\n\t\tvar searchGubun = $(this).attr('data-id');\r\n\t\t//컬렉션 별 url\r\n\t\tvar searchUrl = $(this).attr('data-url');\r\n\r\n\t\tif ($('#loginYn').val() == '0') {\r\n\t\treturn getAlertLogin();\r\n\t\t} else {\r\n\t\t\r\n\t\t\r\n\t\tif(searchCnt > 5000 && searchGubun == 'project'){\r\n\t\tjAlert('과제 분석 건수를 5천건 이하로 조정하여 주시기 바랍니다.','알림',function(){});\r\n\t\treturn false;\r\n\t\t} else if(searchCnt > 5000 && searchGubun == 'rpaper'){\r\n\t\tjAlert('논문 분석 건수를 5천건 이하로 조정하여 주시기 바랍니다.','알림',function(){});\r\n\t\treturn false;\r\n\t\t} else if(searchCnt > 5000 && searchGubun == 'rpatent'){\r\n\t\tjAlert('특허 분석 건수를 5천건 이하로 조정하여 주시기 바랍니다.','알림',function(){});\r\n\t\treturn false;\r\n\t\t} else {\r\n// \t\tvar win =  window.open(searchUrl+'searchWord='+$('#searchWord').val()+'&totalCount='+searchCnt+'&userId=&displayCount=10&naviCount=30&sortBy=RANK/DESC&I04=2/NOTSAME&collection='+searchGubun);\r\n\t\tvar win =  window.open(searchUrl+'?&query=%EC%97%B0%EB%A3%8C%EC%A0%84%EC%A7%80&displayCount=3&naviCount=30&collection=total&sortby=RANK%2FDESC&totalCount='+searchCnt, \"PROJECT_SVC\", 'width=1280, height=800, top=0, left=0, scrollbars=yes, resizable=yes, status=yes, toolbar=no, menubar=no');\r\n\t\twin.focus();\r\n\t\t}\r\n\t\t\r\n\t\t}\r\n\t});\r\n\r\n\t// total count가 0인 경우, 최소 height setting : 650px\r\n\t\r\n\r\n\t// Go to the top\r\n\tvar currentPosition = parseInt($(\"#btnIConTop\").css(\"Top\"));\r\n\tvar asideTop = parseInt($(\".aside\").css(\"height\"));\r\n\tvar asideTop = 900;\r\n\tvar stopPosition =  parseInt($('#content').css(\"height\"));\r\n\r\n\t//footer의 border-top이 content 시작과 겹침\r\n\t//맨위로 (btnICon)이 들어갈 자리가 부족하여 form height 수정\r\n// \tif(asideTop > stopPosition){\r\n// \t\t$('#searchForm').height(asideTop+85);\r\n// \t} else {\r\n// \t\t$('#searchForm').height(stopPosition);\r\n// \t}\r\n\r\n\tif(asideTop>currentPosition){\r\n\t\tvar newPosition = $(window).scrollTop() + $(window).height()-300;\r\n\t\tif (asideTop > newPosition) {\r\n\t\tnewPosition = asideTop;\r\n\t\t}\r\n\t\tif (newPosition > (stopPosition-50)) {\r\n\t\tnewPosition = (asideTop-5);\r\n\t\t}\r\n\r\n\t\t$(\"#btnIConTop\").css(\"top\",newPosition);\r\n\t}\r\n\r\n\t$(\"#btnIConTop\").css(\"display\",\"block\");\r\n\r\n\t$(window).scroll(function() {\r\n\t\tvar newPosition = $(window).scrollTop() + $(window).height()-375;\r\n\r\n\t\tif (asideTop > newPosition) {\r\n\t\tnewPosition = asideTop;\r\n\t\t}\r\n\r\n\t\tif (newPosition > (stopPosition-50)) {\r\n\t\tnewPosition = ($('#searchForm').height()-50);\r\n\t\t}\r\n\r\n\t\t$(\"#btnIConTop\").stop().animate({\"top\":newPosition+\"px\"},100);\r\n\t});\r\n\r\n\t//살펴보기 상단에서 종료\r\n\t$('#closeDiscover').click(function(e){\r\n\t\te.preventDefault();\r\n\t\t$('.j_guide').find('div').css('display','none');\r\n\t\t$('#discoverWrap').css('display','block');\r\n\t\t$('.j_guide').css('display','none');\r\n\t\t$('html, body').css('overflow', '');\r\n\t});\r\n\r\n\t//그만보기\r\n\t$('#stopDiscover').click(function(e){\r\n\t\te.preventDefault();\r\n\t\tif($('#stopDiscover').prop('checked') == true){\r\n\t\t$('#discover').css('display','none');\r\n\t\t}\r\n\t\t$('html, body').css('overflow', 'auto');\r\n\t});\r\n\r\n\t// 살펴보기 클릭시, 스크롤바 숨김\r\n\t$('#discover').on('scroll touchmove mousewheel', function(e) {\r\n\t\te.preventDefault();\r\n\t\te.stopPropagation();\r\n\t\treturn false;\r\n\t});\r\n\r\n\ttodayRnDDaychart();\r\n\ttodayRnDWeekchart()\r\n\r\n\t/*tooltip*/\r\n\t$('.schHelp').on(\"click\", function() {\r\n\t\tif($(this).next().hasClass('act')){\r\n\t\t$(this).next().removeClass('act');\r\n\t\t} else {\r\n