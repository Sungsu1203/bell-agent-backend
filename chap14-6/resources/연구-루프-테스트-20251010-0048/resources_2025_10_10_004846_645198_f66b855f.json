    "raw_content": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"ko\" xml:lang=\"ko\">\r\n<head>\t\r\n\t<title>연구분야별 연구동향</title>\r\n\t<link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\"/>\r\n\t<link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\"/>\r\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\r\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n\t\r\n\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/jquery.mCustomScrollbar.css?v=20210603\" rel=\"stylesheet\" />\r\n\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/fontawesome-all.min.css\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/common.css?v=20250522\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/base.css?v=20250522_1\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/common2021.css?v=20230517\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/sub2021.css?v=20250321\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/theme-setting.css?v=20250207\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/search/jquery.autocomplete.css?v=20220711\" rel=\"stylesheet\"/>\r\n\t \r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/jquery-1.11.3.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/jquery.mousewheel.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/jquery.mCustomScrollbar.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/js/jquery.form.js\"></script>\r\n\t<script type=\"text/javascript\">var language 