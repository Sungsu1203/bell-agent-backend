    "raw_content": "<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n\r\n    <meta charset=\"UTF-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"title\" content=\"중소벤처기업부\"/>\r\n    <meta name=\"keywords\" content=\"중소벤처기업부, 중기부, 중소기업\"/>\r\n    <meta name=\"description\" content=\"중소기업중앙회 등 기관 중소기업 조사, 통계 DB화 검색, 내려받기 등 제공.\"/>\r\n    <meta property=\"og:type\" content=\"website\"/>\r\n    <meta property=\"og:title\" content=\"중소벤처기업부\"/>\r\n    <meta property=\"og:description\" content=\"중소기업중앙회 등 기관 중소기업 조사, 통계 DB화 검색, 내려받기 등 제공.\"/>\r\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no\">\r\n    <title>\r\n         보도자료 -  보도자료  -  알림소식  - 중소벤처기업부\r\n    </title>\r\n    <link rel=\"shortcut icon\" href=\"/images/smba/favicon2.ico\" type=\"image/x-icon\"/>\r\n\r\n    <script>\r\n        const activeProfile = \"\";\r\n        const isDev = activeProfile === \"gioinfra_dev\";\r\n    </script>\r\n    <script src=\"/js/dev/AssertUtil.js\"></script>\r\n    <script src=\"/libs/jquery/gioinfra-jquery-3.7.1_new.js\"></script>\r\n    <script src=\"/libs/swiper/swiper11.1.1_new.js\"></script>\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/libs/swiper/swiper11.1.1_new.css?version=1760026097641\">\r\n    <script src=\"/libs/scrollbar/scrollbar_new.js\"></script>\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/libs/scrollbar/scrollbar_new.css?version=1760026097641\">\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/libs/gioSelect/gioSelect-1.0.1_new.css?version=1760026097641\">\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/libs/datepicker/datepicker_new.css?version=1760026097641\">\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/pattern_new.css?version=1760026097641\">\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/style_new.css?version=1760026097641\">\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/main_new.css?version=1760026097641\">\r\n\t\r\n    \t<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/board_new.css?version=1760026097641\">\r\n    \r\n    <script src=\"/js/common_new.js\"></script>\r\n    <script src=\"/js/main_new.js\"></script>\r\n    \r\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/sub_new.css?version=1760026097641\">\r\n        <script src=\"/js/sub_new.js\"></script>\r\n    \r\n\r\n    \r\n\r\n    <script src=\"/js/pagination.js\"></script>\r\n    <script src=\"/js/jquery.printarea.js\"></script>\r\n\r\n    <script>\r\n        let tabList = [];\r\n        let isSelectedExist = false;\r\n\r\n        \r\n\r\n        function getTabInTabs(menuCode) {\r\n            let tab = tabList.find(tab => tab.menuCode === menuCode);\r\n            if (tab.subTabList.length > 0) {\r\n                let tabInTabHtml = '';\r\n                let seeAllHtml = '';\r\n                tab.subTabList.forEach((subTab, index) => {\r\n\r\n                    if (isSelectedExist) {\r\n                        tabInTabHtml += '<div class=\"swiper-slide ' + (subTab.selected ? 'active' : '') + '\" id=\"tab_list_0' + (index + 1) + '\" aria-selected=\"' + (subTab.selected ? 'true' : 'false') + '\" aria-controls=\"panel_list_0' + (index + 1) + '\">';\r\n                    } else {\r\n                        if (index === 0) {\r\n                            tabInTabHtml += '<div class=\"swiper-slide active\" id=\"tab_list_0' + (index + 1) + '\" aria-selected=\"true\" aria-controls=\"panel_list_0' + (index + 1) + '\">';\r\n                        } else {\r\n                            tabInTabHtml += '<div class=\"swiper-slide\" id=\"tab_list_0' + (index + 1) + '\" aria-selected=\"false\" aria-controls=\"panel_list_0' + (index + 1) + '\">';\r\n                        }\r\n                    }\r\n                    tabInTabHtml += '<button type=\"button\" class=\"btn-tab\" onclick=\"goToTabMenu(\\'' + subTab.userMenuUrl + '\\')\" data-menu-cd=\"' + subTab.menuCode + '\">' + subTab.menuNm + '' + (subTab.selected ? '<i class=\"sr-only created\"> 선택됨</i>' : '') + '</button>';\r\n                    tabInTabHtml += '</div>';\r\n                    seeAllHtml += '<li>';\r\n                    seeAllHtml += '<div class=\"opt\" data-id=\"tab_list_0' + (index + 1) + '\" aria-selected=\"' + (subTab.selected ? 'true' : 'false') + '\" aria-controls=\"panel_list_0' + (index + 1) + '\">';\r\n                    seeAllHtml += '<button type=\"button\" class=\"btn-tab\" onClick=\"goToTabMenu(\\'' + subTab.userMenuUrl + '\\')\" data-menu-cd=\"' + subTab.menuCode + '\">' + subTab.menuNm + '' + (subTab.selected ? '<i class=\"sr-only created\"> 선택됨</i>' : '') + '</button>';\r\n                    seeAllHtml += '</div>';\r\n                });\r\n                if (tabInTabHtml !== '') {\r\n                    $('#tab-in-tab').css({'visibility': 'initial'});\r\n\r\n                    $('#tab-in-tab-swiper').html(tabInTabHtml);\r\n                    $('#tab-in-tab-ul').html(seeAllHtml);\r\n                } else {\r\n                    $('#tab-in-tab').css({'visibility': 'hidden'});\r\n                }\r\n            }\r\n        }\r\n\r\n        function goToTabMenu(userMenuUrl) {\r\n            let isTabInTab = false;\r\n\r\n            const target = $(event.target);\r\n\r\n            if (!target.closest(\"#tab\").length) {\r\n                isTabInTab = true;\r\n            }\r\n\r\n            const selectedIndex = target.closest(\"div\").index();\r\n\r\n            const visibleFirstIndex = target.closest(\"div\").closest(\".swiper-wrapper\").find(\".swiper-slide-active\").closest(\"div\").index();\r\n\r\n            const visibleOrder = Math.abs(visibleFirstIndex - selectedIndex);\r\n\r\n            if (isTabInTab) {\r\n                setTabInTabSlideIndex(visibleOrder);\r\n            } else {\r\n                setTabSlideIndex(visibleOrder);\r\n            }\r\n\r\n            location.href = userMenuUrl;\r\n        }\r\n\r\n    </script>\r\n\r\n    <script>\r\n        $(document).ready(function() {\r\n            if (tabList.length > 0) {\r\n                let tabHtml = '';\r\n                tabList.forEach((tab, index) => {\r\n                    tabHtml += '<div class=\"swiper-slide ' + (tab.selected ? 'active' : '') + '\" id=\"tab_list_0' + (index + 1) + '\" aria-selected=\"' + (tab.selected ? 'true' : 'false') + '\" aria-controls=\"panel_list_0' + (index + 1) + '\">';\r\n                    if (tab.subTabList.length > 0) {\r\n                        tabHtml += '<button type=\"button\" class=\"btn-tab\" onclick=\"goToTabMenu(\\'' + tab.subTabList[0].userMenuUrl + '\\')\" data-menu-cd=\"' + tab.menuCode + '\">' + tab.menuNm + '' + (tab.selected ? '<i class=\"sr-only created\"> 선택됨</i>' : '') + '</button>';\r\n\r\n                    } else {\r\n                        tabHtml += '<button type=\"button\" class=\"btn-tab\" onclick=\"goToTabMenu(\\'' + tab.userMenuUrl + '\\')\" data-menu-cd=\"' + tab.menuCode + '\">' + tab.menuNm.replaceAll(\")\", \")<br/>\") + '' + (tab.selected ? '<i class=\"sr-only created\"> 선택됨</i>' : '') + '</button>';\r\n                    }\r\n                    tabHtml += '</div>';\r\n\r\n                    if (tab.selected) {\r\n                        getTabInTabs(tab.menuCode);\r\n                    }\r\n                });\r\n                if (tabHtml !== '') {\r\n                    // $('#tab').show();\r\n                    $('#tab').css({'visibility' : 'initial'});\r\n                    $('#tab .swiper-wrapper').html(tabHtml);\r\n                } else {\r\n                    // $('#tab').hide();\r\n                    $('#tab').css({'visibility' : 'hidden'});\r\n                }\r\n\r\n                /* setTabListData();\r\n                setTabInTabListData(); */\r\n            }\r\n\r\n            $('.btn-tab').on('click', function() {\r\n                $(this).parent().removeClass('active');\r\n                $(this).parent().addClass('active');\r\n            });\r\n            \r\n            //서브화면일때만 탭 함수호출\r\n            var mainUrl = '/site/smba/ex/bbs/View.do?cbIdx=86';\r\n            var order = '2020301000000';\r\n            if(!(mainUrl == '/site/smba/main.do' && order == '2000000000000')){\r\n            \tsetTabListData();\r\n                setTabInTabListData();\r\n            }\r\n\r\n        });\r\n    </script>\r\n\r\n\t<script>\r\n\t\tfunction setScreenSize() {\r\n\t\tlet vh = window.innerHeight * 0.01;\r\n\r\n\t\tdocument.documentElement.style.setProperty('--vh', vh + 'px' );\r\n\t\t}\r\n\r\n\t\tsetScreenSize();\r\n\t\twindow.addEventListener('resize', () => setScreenSize())\r\n\t</script>\r\n\r\n</head>\r\n\r\n\r\n<body>\r\n\r\n<div id=\"skip-nav\">\r\n    <ul>\r\n        <li><a href=\"#contents\">본문 바로가기</a></li>\r\n        <li><a href=\"#head-gnb\">주메뉴 바로가기</a></li>\r\n    </ul>\r\n</div>\r\n\r\n<div id=\"wrap\">\r\n    <header id=\"header\" >\r\n        <div class=\"header-in\">\r\n            \r\n\r\n\r\n\r\n\r\n<script>\r\n\r\n    function goToSearch(query) {\r\n        let form = document.createElement(\"form\");\r\n        form.setAttribute(\"method\", \"POST\");\r\n        form.setAttribute(\"action\", \"https://search.mss.go.kr/mssSearch/search.do\");\r\n        form.setAttribute(\"target\", \"_blank\");\r\n\r\n        let hiddenField = document.createElement(\"input\");\r\n        hiddenField.setAttribute(\"type\", \"hidden\");\r\n        hiddenField.setAttribute(\"name\", \"query\");\r\n        hiddenField.setAttribute(\"value\", query);\r\n\r\n        form.appendChild(hiddenField);\r\n\r\n        document.body.appendChild(form);\r\n        form.submit();\r\n    }\r\n\r\n    $(document).ready(function () {\r\n        $(\"#BtnTotalSearchPC\").click(function () {\r\n            var searchKeyword = $(\"#totalSearchPC\").val();\r\n            if (searchKeyword === \"\") {\r\n                alert(\"검색어를 입력해주세요.\");\r\n          