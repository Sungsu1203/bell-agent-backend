SearchKywds = clickSearchKywdAll.split(\",\");\r\n\r\n\t\t$('#'+selectedId+' input[name*=searchOption]').val('');\r\n\t\t$('#'+selectedId+' select[name=searchYearFrom]').val('');\r\n\t\t$('#'+selectedId+' select[name=searchYearTo]').val('');\r\n\r\n\t\tfor(i=0;i<clickSearchKywds.length;i++){\r\n\t\tvar title = clickSearchKywds[i].split(\":\")[0].trim();\r\n\t\tvar kywd = clickSearchKywds[i].split(\":\")[1].trim();\r\n\r\n\t\t//searchlist_project\r\n\r\n\t\t$('#'+selectedId+' input[name*=searchTitle]').each(function(){\r\n\t\tif($(this).val()==title){\r\n\t\tidx=$(this).attr('name').replace('searchTitle','');\r\n\t\t$('#'+selectedId+' input[name=searchOption'+idx+']').val(kywd);\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t$('#'+selectedId+' input[name=searchSelectTitle1]').each(function(){\r\n\t\tif($(this).val()==title){\r\n\t\t$('#'+selectedId+' select[name=searchYearFrom]').val(kywd.split('~')[0].trim());\r\n\t\t$('#'+selectedId+' select[name=searchYearTo]').val(kywd.split('~')[1].trim());\r\n\t\t}\r\n\t\t});\r\n\r\n\t\t}\r\n\r\n\t\t$('#btnSearchDetail').trigger('click');\r\n\r\n\t});\r\n\r\n\r\n\t$('.loginpop .btn_close').click(function(e){\r\n\r\n\t\t$('#logoutpopWrap').toggleClass('act');\r\n\t});\r\n});\r\n\r\n/**\r\n * 최근 본 게시물 삭제\r\n */\r\nfunction closeRecently(sn) {\r\n\tCommon.doSearchHistInfoDelete(sn,doNewBoardCommentInsertUpdateDeleteCallback);\r\n}\r\n\r\n/**\r\n * 최근 본 게시물 삭제 Callback\r\n */\r\nfunction doNewBoardCommentInsertUpdateDeleteCallback(data) {\r\n\r\n\t// 최근본 게시물 리스트\r\n\tCommon.getSearchHistInfoList($('#userId').val(), getSearchHistInfoListCallback);\r\n}\r\n\r\n/**\r\n * 최근 본 게시물 리스트 Callback\r\n */\r\nfunction getSearchHistInfoListCallback(searchHistInfo) {\r\n\r\n\tif (searchHistInfo != null) {\r\n\r\n\t\tvar commentListHtml = '';\r\n\t\tif (searchHistInfo != null) {\r\n\r\n\t\tfor (var i = 0 ; i < searchHistInfo.length ; i++) {\r\n\t\tcommentListHtml += '<div class=\"recentlyitem\">';\r\n\t\tcommentListHtml += '<a href=\"'+searchHistInfo[i].url+'\">'+ searchHistInfo[i].title + ' <img src=\"/images/th/2017/newwindow.png\" title=\"팝업표시\" alt=\"팝업표시\" class=\"help\" style=\"vertical-align:middle;\"></a>';\r\n\t\tcommentListHtml += '<a href=\"javascript:closeRecently('+searchHistInfo[i].sn+')\" class=\"close_small\"><span class=\"screenout\">닫기</span></a>';\r\n\t\tcommentListHtml += '</div>';\r\n\t\t}\r\n\t\t}\r\n\r\n\t\t$('.recentlyseen_list').html(commentListHtml);\r\n\t}\r\n}\r\n\r\n\r\nfunction fn_updateSlctCd(slctCd){\r\n\tvar cd = \"\";\r\n\tif(slctCd=='R'){\r\n\t\tcd = \"D\";\r\n\t} else {\r\n\t\tcd = \"R\";\r\n\t}\r\n\r\n\t$.ajax({\r\n\t\turl: '/ThUpdateSlctCd.do',\r\n\t\tdata: { 'slctCd':cd\r\n\t\t},\r\n\t\tsuccess: function(data) {\r\n\t\tlocation.reload();\r\n\t        },\r\n\t        error: function(e) {\r\n\r\n\t        }\r\n\t});\r\n}\r\n\r\nfunction run(searchWord) {\r\n\r\n\talert(searchWord);\r\n\tvar engChosung = searchWord;\r\n\tvar engChosungReg = \"[\" + engChosung + \"]\";\r\n\tvar engJungsung = {k:0,o:1,i:2,O:3,j:4,p:5,u:6,P:7,h:8,hk:9,ho:10,hl:11,y:12,n:13,nj:14,np:15,nl:16,b:17,m:18,ml:19,l:20};\r\n\tvar engJungsungReg = \"hk|ho|hl|nj|np|nl|ml|k|o|i|O|j|p|u|P|h|y|n|b|m|l\";\r\n\tvar engJongsung = {\"\":0,r:1,R:2,rt:3,s:4,sw:5,sg:6,e:7,f:8,fr:9,fa:10,fq:11,ft:12,fx:13,fv:14,fg:15,a:16,q:17,qt:18,t:19,T:20,d:21,w:22,c:23,z:24,x:25,v:26,g:27};\r\n\tvar engJongsungReg = \"rt|sw|sg|fr|fa|fq|ft|fx|fv|fg|qt|r|R|s|e|f|a|q|t|T|d|w|c|z|x|v|g|\";\r\n\tvar regExp = new RegExp(\"(\"+engChosungReg+\")(\"+engJungsungReg+\")((\"+engJongsungReg+\")(?=(\"+engChosungReg+\")(\"+engJungsungReg+\"))|(\"+engJongsungReg+\"))\",\"g\");\r\n\r\n\tvar converter = function (args, cho, jung, jong) {\r\n\t\treturn String.fromCharCode(engChosung.indexOf(cho) * 588 + engJungsung[jung] * 28 + engJongsung[jong] + 44032);\r\n\t};\r\n\r\n\tvar result = args.replace(regExp, converter);\r\n\talert(JSON.stringify(result)+\"Eng to Kor\");\r\n\treturn result;\r\n}\r\n\r\n\r\nvar convertEngToKor2 = (function () {\r\n\tvar engChosung = \"rRseEfaqQtTdwWczxvg\"\r\n\tvar engChosungReg = \"[\" + engChosung + \"]\";\r\n\tvar engJungsung = {k:0,o:1,i:2,O:3,j:4,p:5,u:6,P:7,h:8,hk:9,ho:10,hl:11,y:12,n:13,nj:14,np:15,nl:16,b:17,m:18,ml:19,l:20};\r\n\tvar engJungsungReg = \"hk|ho|hl|nj|np|nl|ml|k|o|i|O|j|p|u|P|h|y|n|b|m|l\";\r\n\tvar engJongsung = {\"\":0,r:1,R:2,rt:3,s:4,sw:5,sg:6,e:7,f:8,fr:9,fa:10,fq:11,ft:12,fx:13,fv:14,fg:15,a:16,q:17,qt:18,t:19,T:20,d:21,w:22,c:23,z:24,x:25,v:26,g:27};\r\n\tvar engJongsungReg = \"rt|sw|sg|fr|fa|fq|ft|fx|fv|fg|qt|r|R|s|e|f|a|q|t|T|d|w|c|z|x|v|g|\";\r\n\tvar regExp = new RegExp(\"(\"+engChosungReg+\")(\"+engJungsungReg+\")((\"+engJongsungReg+\")(?=(\"+engChosungReg+\")(\"+engJungsungReg+\"))|(\"+engJongsungReg+\"))\",\"g\");\r\n\r\n\tvar converter = function (args, cho, jung, jong) {\r\n\t\treturn String.fromCharCode(engChosung.indexOf(cho) * 588 + engJungsung[jung] * 28 + engJongsung[jong] + 44032);\r\n\t};\r\n\r\n\treturn (function (args) {\r\n\r\n\t\tvar result = args.replace(regExp, converter);\r\n\t\talert(result);\r\n\t\treturn result;\r\n\r\n\t});\r\n\r\n})();\r\n\r\nfunction run2(engStr) {\r\n\tconvertEngToKor2(engStr);\r\n}\r\n\r\n//검색결과보기 - 오탈자 적용 검색이 아닌 사용지가 입력한 실제 검색어로 검색 진행하는 구분자\r\nfunction originalSearch(){\r\n\t$(\"#originalSearchGubun\").val(\"original\");\r\n\tvar checkCount = $(\"#checkCount\").val();\r\n\tif($(\"#checkCount\").val() == 0){\r\n\t\t$(\"#searchWord\").val( $(\"#originalSearchWord\").val() );\r\n\t}else{\r\n\t\t//leesy 추가 - checkWord의 경우 span값이 포함되어 있는 경우가 있음 >> span 제거\r\n\t\t$(\"#searchWord\").val($(\"#checkSearchWord\").val().replace(/<span[^>]*>(.*?)<\\/span>/g, \"$1\"));\r\n\t}\r\n\t$('#btnHeaderSearch').trigger('click');\r\n}\r\n\r\n\r\n// function btnLoginClose(e){\r\n// \tvar LayerPopup = $(\".loginpopWrap \");\r\n// \tif(LayerPopup.has(e.target).length === 0){\r\n// \t  LayerPopup.removeClass(\"act\");\r\n// \t}\r\n// }\r\n\r\n//이름 클릭시 레이어 팝업 생성 후 외부영역 클릭 시 팝업 닫기\r\n$(document).mouseup(function (e){\r\n  var LayerPopup = $