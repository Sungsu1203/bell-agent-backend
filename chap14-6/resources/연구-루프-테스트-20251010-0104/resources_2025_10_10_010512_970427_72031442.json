%\" height=\"600px\" frameborder='0' marginwidth=\"0\" marginheight=\"0\"></iframe>\r\n\t\t</div>\r\n\t\t\r\n\t\t\r\n\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\t\r\n\t<script type=\"text/javascript\">\r\n\t\r\n\t\t$(\"#fieldTempD04\").prop(\"checked\", true);\r\n\t\r\n\r\n\t\r\n\t\tfncMajorCitationList();\r\n\t\tfncReSearchTrend();\r\n\t\t$(\".sectionbox.topic\").show();\r\n\t\r\n\t\r\n\t$(function(){\r\n\t\t$(\"#fieldTemp\").on(\"click\", function() {\r\n\t\tif($(\"#fieldTemp\").prop(\"checked\")){\r\n\t\t$(\"input[id^='fieldTemp']\").prop(\"checked\", true);\r\n\t\t}else {\r\n\t\t$(\"input[id^='fieldTemp']\").prop(\"checked\", false);\r\n\t\t}\r\n\t\t});\r\n\t\t\r\n\t\t$(\"input[id^='fieldTemp']\").on(\"click\", function(e) {\r\n\t\tif(!$(e.target).prop(\"checked\")){\r\n\t\tif($(\"#fieldTemp\").prop(\"checked\")){\r\n\t\t$(\"#fieldTemp\").prop(\"checked\", false);\r\n\t\t}\r\n\t\t}\r\n\t\t});\r\n\t});\r\n\t</script>\r\n\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n<style>\r\n.chatbot-icobox {position: fixed;bottom: 50px;left: calc(50% + 700px);z-index: 98;animation: chatbotMove 1s ease-in-out 0s infinite alternate;}\r\n.chatbot-icobox:hover {animation: none;}\r\n.chatbot-icobox .chatbot-icobox-hide-btn {position: absolute;top: 0;left: 0;display: block;overflow: hidden;border-radius: 50%;}\r\n.chatbot-icobox .chatbot-open-btn {display: block;overflow: hidden;border-radius: 10px;font-size: 0;}\r\n.chatbot-icobox img{max-width: 93px}\r\n@keyframes chatbotMove {0% { transform:translateY(0);}100% { transform:translateY(-15px);}}\r\n</style>\r\n<aside class=\"chatbot-icobox\">\r\n\t<a href=\"javascript:$('.chatbot-icobox').fadeOut('fast');\" class=\"chatbot-icobox-hide-btn\" title=\"챗봇 아이콘 닫기\"><img src=\"/kciportal/resources/newkci/image/kor/chatbot_closebtn.png\" alt=\"닫기 아이콘\"/></a>\r\n\t<a href=\"http://pf.kakao.com/_xfymxaxj/chat\" target=\"_blank\" title=\"카카오 챗봇 새창 연결\" class=\"chatbot-open-btn\"><img src=\"/kciportal/resources/newkci/image/kor/i