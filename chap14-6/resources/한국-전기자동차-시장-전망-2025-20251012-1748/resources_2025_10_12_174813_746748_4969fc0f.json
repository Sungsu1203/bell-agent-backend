n\t\t<td>모빌리티자동차국 자동차운영보험과</td>\r\n\t\t<th scope=\"row\">작성(조사)체계 및 절차</th>\r\n\t\t<td>시·도 → 국토교통부</td>\r\n\t\t</tr>\r\n\t\t<th scope=\"row\">작성(조사)대상</th>\r\n\t\t<td colspan=\"3\">지역별로 등록된 각종 차량</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<th scope=\"row\">작성(조사)근거</th>\r\n\t\t<td colspan=\"3\">승인번호 제116015호(승인일자 1975-07-29)<br>\r\n\t\t통계법 제18조 규정에 의한 승인통계지정, 통계법 제27조 규정에 의한 통계공표</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<th scope=\"row\">작성(조사)목적</th>\r\n\t\t<td colspan=\"3\">시·도별로 등록된 자동차의 제반사항을 파악하여 교통행정의 기초자료로 활용</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<th scope=\"row\">작성(조사)방법</th>\r\n\t\t<td colspan=\"3\"></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<th scope=\"row\">공표주기</th>\r\n\t\t<td colspan=\"3\">익월말</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<th scope=\"row\">공표방법</th>\r\n\t\t<td colspan=\"3\">「국토교통통계연보」, 국토교통통계누리(http://stat.molit.go.kr)</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t<th scope=\"row\">주석</th>\r\n\t\t<td colspan=\"3\"></td>\r\n\t\t</tr>\r\n\t\t</tbody>\r\n\t\t</table>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"mu-accordion-item\">\r\n\t\t<div class=\"mu-accordion-head\">\r\n\t\t<a href=\"#none\" title=\"펼치기\" class=\"mu-accordion-title\">통계 관련파일</a>\r\n\t\t</div>\r\n\t\t<div class=\"mu-accordion-body\">\r\n\t\t<div class=\"description-area\">\r\n\t\t<dl class=\"summary-info\">\r\n\t\t<dt>통계 일반자료</dt>\r\n\t\t<dd>\r\n\t\t<ul class=\"file-sch-list\">\r\n\t\t\r\n\t\t<li>\r\n\t\t<a href=\"/portal/common/downLoadFile.do\" onclick=\"javascript:downFile('2025년 09월 자동차 등록자료 통계.xlsx','2025년 09월 자동차 등록자료 통계.xlsx','/stat_file/','IfrFile');return false;\">\r\n\t\t<span class=\"btn-down\"><i class=\"mu-icon-svg attach\"></i>다운로드</span>\r\n\t\t<em>- 2025년 09월 자동차 등록자료 통계.xlsx</em>\r\n\t\t</a>\r\n\t\t</li>\r\n\t\t\r\n\t\t<li>\r\n\t\t<a href=\"/portal/common/downLoadFile.do\" onclick=\"javascript:downFile('2025년 09월 이륜차 신고현황 통계.xlsx','2025년 09월 이륜차 신고현황 통계.xlsx','/stat_file/','IfrFile');return false;\">\r\n\t\t<span class=\"btn-down\"><i class=\"mu-icon-svg attach\"></i>