<li id=\"depth1_li0500000000\"><a href=\"/menu.es?mid=a10501000000\">연구원소식</a></li>\n\t<li id=\"depth1_li0600000000\"><a href=\"/menu.es?mid=a10601000000\">정보공개</a></li>\n\t<li id=\"depth1_li0700000000\"><a href=\"/menu.es?mid=a10701000000\">APEC 연구컨소시엄</a></li>\n\t<li id=\"depth1_li0800000000\"><a href=\"/menu.es?mid=a10801000000\">KIEP Library</a></li>\n</ul>\n\n\t\t</div>\n\t\t</div>\n\t\t\n\t\t<div class=\"item\">\n\t\t<div class=\"list\">\n\t\t<button class=\"label\" title=\"2depth 메뉴 열기\">보고서</button>\n\t\t\n\n<ul id=\"head_menu_depth2\" class=\"list depth2\">\n\t<li id=\"depth2_li0101000000\"><a href=\"/menu.es?mid=a10101010000\">보고서</a></li>\n\t<li id=\"depth2_li0102000000\"><a href=\"/menu.es?mid=a10102060000\">현안자료</a></li>\n\t<li id=\"depth2_li0105000000\"><a href=\"/menu.es?mid=a10105010000\">영문자료</a></li>\n\t<li id=\"depth2_li0104000000\"><a href=\"/menu.es?mid=a10104010000\">멀티미디어자료</a></li>\n\t<li id=\"depth2_li0103000000\"><a href=\"/menu.es?mid=a10103010000\">연구성과정보</a></li>\n\t<li id=\"depth2_li0106000000\" class=\"last\"><a href=\"/menu.es?mid=a10106010000\">EAER(영문학술지)</a></li>\n</ul>\n\n\t\t</div>\n\t\t</div>\n\t\t\n\t\t\n\t\t<div class=\"item\">\n\t\t<div class=\"list\">\n\t\t<button class=\"label\" title=\"3depth 메뉴 열기\">기본연구보고서</button>\n\t\t\n\n<ul id=\"head_menu_depth3\" class=\"list depth3\">\n\t<li id=\"depth3_li0101010000\"><a href=\"/menu.es?mid=a10101010000\">전체보고서</a></li>\n\t<li id=\"depth3_li0101020000\"><a href=\"/menu.es?mid=a10101020000\">연구보고서</a></li>\n\t<li id=\"depth3_li0101200000\"><a href=\"/menu.es?mid=a10101200000\">기본연구보고서</a></li>\n\t<li id=\"depth3_li0101030000\"><a href=\"/menu.es?mid=a10101030000\">연구자료</a></li>\n\t<li id=\"depth3_li0101040000\"><a href=\"/menu.es?mid=a10101040000\">중장기통상전략연구</a></li>\n\t<li id=\"depth3_li0101050000\"><a href=\"/menu.es?mid=a10101050000\">전략지역심층연구</a></li>\n\t<li id=\"depth3_li0101060000\"><a href=\"/menu.es?mid=a10101060000\">ODA 정책연구</a></li>\n\t<li id=\"depth3_li0101070000\"><a hr