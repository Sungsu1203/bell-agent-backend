    "raw_content": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"ko\" xml:lang=\"ko\">\r\n<head>\t\r\n\t<title>연구분야별 연구동향</title>\r\n\t<link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\"/>\r\n\t<link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\"/>\r\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\r\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n\t\r\n\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/jquery.mCustomScrollbar.css?v=20210603\" rel=\"stylesheet\" />\r\n\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/fontawesome-all.min.css\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/common.css?v=20250522\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/base.css?v=20250522_1\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/common2021.css?v=20230517\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/sub2021.css?v=20250321\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/resources/newkci/css/theme-setting.css?v=20250207\" rel=\"stylesheet\" />\r\n\t<link type=\"text/css\" href=\"/kciportal/search/jquery.autocomplete.css?v=20220711\" rel=\"stylesheet\"/>\r\n\t \r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/jquery-1.11.3.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/jquery.mousewheel.min.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/jquery.mCustomScrollbar.js\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/js/jquery.form.js\"></script>\r\n\t<script type=\"text/javascript\">var language = \"null\"; </script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/common.js?v=202506\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/search/jquery.autocomplete.js?v=20220711\"></script>\r\n\t\r\n\r\n\r\n<script type=\"text/javascript\" src=\"/kciportal/resources/js/print.js\"></script>\r\n<script type=\"text/javascript\" src=\"/kciportal/resources/js/highchart/highcharts.js\" ></script> \r\n<script type=\"text/javascript\">\r\n\t\r\n\tfunction lf_print_win(){//프린트. 공통 프린트는 차트가 출력되지 않아서 \r\n\t\tvar id = $(event.target).closest(\".sectionbox\").attr(\"id\");\r\n\t\tvar url=\"/kciportal//view/po/search/researchPrintPop.jsp?targetId=\"+id;\r\n\t\twindow.open(url,\"pop\",\"width=850,height=500,status=yes\");\r\n\t}\r\n\t\r\n\tfunction lf_exceldown(){\r\n\t\t//console.log($(\"input[name='poResearchTrendSearchBean.largMajorCd']\").val());\r\n\t\tvar frm = document.frm;\r\n\t\tfrm.action = \"/kciportal/po/search/retriveJournalCitationDetailExcel.kci\";\r\n\t\tfrm.target = \"_self\";\r\n\t\tfrm.method = \"post\";\r\n\t    frm.submit();\r\n\t    \r\n\t    \r\n\t\t//var largMajorCd = $(\"input[name='poResearchTrendSearchBean.largMajorCd']\").val();\r\n\t\t//location.href = 'retriveJournalCitationDetailExcel.kci?year='+$(\"#citationYear\").html()+\"&largMajorCd=\"+largMajorCd+\"&largMajorCd=\"+\";\r\n\t} \r\n\t\r\n\t/* function lf_exceldown2() {\r\n\t\tconsole.log($(event.target));\r\n\t} */\r\n\t   \r\n\tfunction fncGoLargClasList(largMajorCd){\r\n\t\tvar frm = document.frm;\r\n\t\tfrm.elements[\"clasSearchBean.largMajorCd\"].value = largMajorCd;\r\n\t\tfrm.elements[\"clasSearchBean.middMajorCd\"].value = \"All\";\r\n\t\tfrm.elements[\"poResearchTrendSearchBean.researchTrend\"].value = \"changeLargMajorCd\";\r\n\t\tfrm.action = \"/kciportal/po/search/poFielResearchTrendList.kci\";\r\n\t\tfrm.method = \"post\";\r\n\t    frm.submit();\r\n\t}\r\n\t\r\n\t\r\n\t//분야별 인용지수\r\n\tfunction fncMajorCitationList(){\r\n\t\tvar html = \"\";