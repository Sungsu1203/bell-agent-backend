+data.list[i].IMMEDIACY_INDEX+\"</td>\";\r\n\t\thtml += \"\t<td>\"+data.list[i].EX_IMFACT+\"</td>\";\r\n\t\thtml += \"\t<td>\"+data.list[i].SELF_CITED_RATE+\"%</td>\";\r\n\t\thtml += \"</tr>\";\r\n\t\t}\r\n\t\thtml += \"\t</tbody>\";\r\n\t\thtml += \"</table>\";\r\n\t\t\r\n\t\t$(\"#citationYear\").html(data.year);\r\n\t\t$(\"#majorCitationListResult\").html(html);\r\n\t\t}\r\n  \t});\r\n\t}\r\n\r\n\t\r\n\tfunction fncReSearchTrend(){\r\n\t\thttp = jQuery.ajax({\r\n\t   \t\turl\t\t: \"/kciportal/po/search/poResearchTrendList.kci\",\r\n\t   \t\ttype\t: \"POST\",\r\n\t   \t\tdata\t: $(\"#frm\").serialize(),\r\n\t\tdataType: 'html',\r\n\t   \t\tasync\t: true,\r\n\t\tbeforeSend\t: function(){\r\n\t   \t\t},   \r\n\t   \t\terror: function(xhr, status, error) {\r\n//\t    \t\talert(error);\r\n\t\t}, \r\n\t\tsuccess : function (html){\r\n\t\t$(\"#reSearchTrend\").html(html);\r\n\t\t//fncArtiCntList();\r\n\t\t  \tvar largMajorNm = $(\".tab-wrap .unit_tab li.current a\").text();\r\n\t\tvar checkedMiddMajorNm = $(\"input.middMajorCd:checked\").map(function(){return this.getAttribute(\"title\");}).get().join(\", \");\r\n\t\t if(checkedMiddMajorNm == \"\"){\r\n\t\tcheckedMiddMajorNm = largMajorNm;\r\n\t\t}else{\r\n\t\tcheckedMiddMajorNm = largMajorNm + \" > \" +checkedMiddMajorNm;\r\n\t\t}\r\n\t\t$(\".researchName\").html(checkedMiddMajorNm);\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\t//검색하기\r\n\tfunction fncSearch(){\r\n// \t\tfncMajorCitationList();\r\n// \t\tfncReSearchTrend();\r\n\t\t\r\n\t\tvar frm = document.frm;\r\n\t\tfrm.action = \"/kciportal/po/search/poFielResearchTrendList.kci\";\r\n\t\tfrm.target = \"_self\";\r\n\t\tfrm.method = \"post\";\r\n\t    frm.submit();\r\n\r\n\t}\r\n\r\n\tfunction fncArtiChart(json, index){\r\n\t\tvar length = json.list.length; //차트 그릴 data 길이\r\n\t\tif(length > 0){\r\n\t\tvar str_year='년';\t\t//년(text)\r\n\t\tvar date   = [];\r\n\t\tvar artiCnt1 = [];\r\n\t\tvar citeCnt = [];\r\n\t\tvar artiTotal = 0;\r\n\t\tvar start = 0;\r\n\t\tif(length - 10