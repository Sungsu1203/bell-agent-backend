= \"null\"; </script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/resources/newkci/js/common.js?v=202506\"></script>\r\n\t<script type=\"text/javascript\" src=\"/kciportal/search/jquery.autocomplete.js?v=20220711\"></script>\r\n\t\r\n\r\n\r\n<script type=\"text/javascript\" src=\"/kciportal/resources/js/print.js\"></script>\r\n<script type=\"text/javascript\" src=\"/kciportal/resources/js/highchart/highcharts.js\" ></script> \r\n<script type=\"text/javascript\">\r\n\t\r\n\tfunction lf_print_win(){//프린트. 공통 프린트는 차트가 출력되지 않아서 \r\n\t\tvar id = $(event.target).closest(\".sectionbox\").attr(\"id\");\r\n\t\tvar url=\"/kciportal//view/po/search/researchPrintPop.jsp?targetId=\"+id;\r\n\t\twindow.open(url,\"pop\",\"width=850,height=500,status=yes\");\r\n\t}\r\n\t\r\n\tfunction lf_exceldown(){\r\n\t\t//console.log($(\"input[name='poResearchTrendSearchBean.largMajorCd']\").val());\r\n\t\tvar frm = document.frm;\r\n\t\tfrm.action = \"/kciportal/po/search/retriveJournalCitationDetailExcel.kci\";\r\n\t\tfrm.target = \"_self\";\r\n\t\tfrm.method = \"post\";\r\n\t    frm.submit();\r\n\t    \r\n\t    \r\n\t\t//var largMajorCd = $(\"input[name='poResearchTrendSearchBean.largMajorCd']\").val();\r\n\t\t//location.href = 'retriveJournalCitationDetailExcel.kci?year='+$(\"#citationYear\").html()+\"&largMajorCd=\"+largMajorCd+\"&largMajorCd=\"+\";\r\n\t} \r\n\t\r\n\t/* function lf_exceldown2() {\r\n\t\tconsole.log($(event.target));\r\n\t} */\r\n\t   \r\n\tfunction fncGoLargClasList(largMajorCd){\r\n\t\tvar frm = document.frm;\r\n\t\tfrm.elements[\"clasSearchBean.largMajorCd\"].value = largMajorCd;\r\n\t\tfrm.elements[\"clasSearchBean.middMajorCd\"].value = \"All\";\r\n\t\tfrm.elements[\"poResearchTrendSearchBean.researchTrend\"].value = \"changeLargMajorCd\";\r\n\t\tfrm.action = \"/kciportal/po/search/poFielResearchTrendList.kci\";\r\n\t\tfrm.method = \"post\";\r\n\t    frm.submit();\r\n\t}\r\n\t\r\n\t\r\n\t//분야별 인용지수\r\n\tfunction fncMajorCitationList(){\r\n\t\tvar html = \"\";\r\n\t\t\r\n\t\thttp = jQuery.ajax({\r\n   \t\turl\t\t: \"/kciportal/po/search/poMajorCitationListAjax.kci\",\r\n   \t\ttype\t: \"POST\",\r\n   \t\tdata\t: $(\"#frm\").serialize(),\r\n\t\tdataType: 'json',\r\n   \t\tasync\t: true,\r\n\t\tbeforeSend\t: function(){\r\n\t\t$(\"#majorCitationList\").show();\r\n   \t\t},   \r\n   \t\terror: function(xhr, status, error) {\r\n//    \t\talert(error);\r\n\t\t}, \r\n\t\tsuccess : function (data){\r\n\t\t\r\n\t\thtml += \"<table class=\\\"is_tbl alignCenter\\\">\";\r\n\t\thtml += \"\t<caption>인용지수</caption>\";\r\n\t\thtml += \"\t<thead>\";\r\n\t\thtml += \"\t<tr>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">대분류</th>\";\r\n\t\tif(data.middCheck == \"Y\"){\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">중분류</th>\";\r\n\t\t}\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">학술지 종수</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">총 논문 수</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">총 피인용 횟수</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">자기피인용 횟수</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">KCI IF<br/>(2년)</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">즉시성지수</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">KCI IF<br/>(2년, 자기인용제외)</th>\";\r\n\t\thtml += \"\t\t<th scope=\\\"col\\\">자기인용 비율<br/>(2년)</th>\";\r\n\t\thtml += \"\t</tr>\";\r\n\t\thtml += \"\t</thead>\";\r\n\t\thtml += \"\t\t<tbody>\";\r\n\t\t\r\n\t\tfor (i = 0; i < data.list.length; i++) { \r\n\t\thtml += \"<tr>\";\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\thtml += \"\t<td>\"+data.list[i].L_MAJOR+\"</td>\";\r\n\t\tif(data.middCheck == \"Y\"){\r\n\t\thtml += \"\t<td>\"+data.list[i].MAJOR+\"</td>\";\r\n\t\t}\r\n\t\t\r\n\t\thtml += \"\t<td>\"+dataComma(data.list[i].SERE_CNT)+\"</td>\";\r\n\t\thtml += \"\t<td>\"+dataComma(data.list[i].ARTI_CNT)+\"</td>\";\r\n\t\thtml += \"\t<td>\"+dataComma(data.list[i].CITE_CNT)+\"</td>\";\r\n\t\thtml += \"\t<td>\"+dataComma(data.list[i].EX_CITE_CNT)+\"</td>\";\r\n\t\thtml += \"\t<td>\"+data.list[i].IMFACT+\"</td>\";\r\n\t\thtml += \"\t<td>\"+data.list[i].IMMEDIACY_INDEX+\"</td>\";\r\n\t\thtml += \"\t<td>\"+data.list[i].EX_IMFACT+\"</td>\";\r\n\t\thtml += \"\t<td>\"+data.list[i].SELF_CITED_RATE+\"%</td>\";\r\n\t\thtml += \"</tr>\";\r\n\t\t}\r\n\t\thtml += \"\t</tbody>\";\r\n\t\thtml += \"</table>\";\r\n\t\t\r\n\t\t$(\"#citationYear\").html(data.year);\r\n\t\t$(\"#majorCitationListResult\").html(html);\r\n\t\t}\r\n  \t});\r\n\t}\r\n\r\n\t\r\n\tfunction fncReSearchTrend(){\r\n\t\thttp = jQuery.ajax({\r\n\t   \t\turl\t\t: \"/kciportal/po/search/poResearchTrendList.kci\",\r\n\t   \t\ttype\t: \"POST\",\r\n\t   \t\tdata\t: $(\"#frm\").serialize(),\r\n\t\tdataType: 'html',\r\n\t   \t\tasync\t: true,\r\n\t\tbeforeSend\t: function(){\r\n\t   \t\t},   \r\n\t   \t\terror: function(xhr, status, error) {\r\n//\t    \t\talert(error);\r\n\t\t}, \r\n\t\tsuccess : function (html){\r\n\t\t$(\"#reSearchTrend\").html(html);\r\n\t\t//fncArtiCntList();\r\n\t\t  \tvar largMajorNm = $(\".tab-wrap .unit_tab li.current a\").text();\r\n\t\tvar checkedMiddMajorNm = $(\"input.middMajorCd:checked\").map(function(){return this.getAttribute(\"title\");}).get().join(\", \");\r\n\t\t if(checkedMiddMajorNm == \"\"){\r\n\t\tcheckedMiddMajorNm = largMajorNm;\r\n\t\t}else{\r\n\t\tcheckedMiddMajorNm = largMajorNm + \" > \" +checkedMiddMajorNm;\r\n\t\t}\r\n\t\t$(\".researchName\").html(checkedMiddMajorNm);\r\n\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\t//검색하기\r\n\tfunction fncSearch(){\r\n// \t\tfncMajorCitationList();\r\n// \t\tfncReSearchTrend();\r\n\t\t\r\n\t\tvar frm = document.frm;\r\n\t\tfrm.action = \"/kciportal/po/search/poFielResearchTrendList.kci\";\r\n\t\tfrm.target = \"_self\";\r\n\t\tfrm.method = \"post\";\r\n\t    frm.submit();\r\n\r\n\t}\r\n\r\n\tfunction fncArtiChart(json, index){\r\n\t\tvar length = json.list.length; //차트 그릴 data 길이\r\n\t\tif(length > 0){\r\n\t\tvar str_year='년';\t\t//년(text)\r\n\t\tvar date   = [];\r\n\t\tvar artiCnt1 = [];\r\n\t\tvar citeCnt = [];\r\n\t\tvar artiTotal = 0;\r\n\t\tvar start = 0;\r\n\t\tif(length - 10 > 0){\r\n\t\tstart = length - 10; \r\n\t\t}\r\n\t\t\r\n\t\tfor(i=start; i<length; i++){\r\n\t\t\r\n\t\t\r\n\t\tdate.push(json.list[i][\"YEAR\"]+str_year);\r\n\t\t\r\n\t\tartiCnt1.push(json.list[i][\"YEARARTICNT\"]);\r\n\t\tciteCnt.push(json.list[i][\"YEARARTIIF\"]);\r\n\t\tartiTotal += json.list[i][\"YEARARTICNT\"];\r\n\t\t}\r\n\t\t\r\n\t\thighOption.chart.width=900;\r\n\t\thighOption.chart.renderTo=  'artiCntListResult-'+ index;\r\n\t\thighOption.chart.type='column';\r\n\t\thighOption.xAxis.categories = date;\r\n\t\thighOption.series[0].name=\"논문 수\";\t\r\n\t\thighOption.series[0].data=artiCnt1;\r\n\t\thighOption.series[1].name=\"KCI IF\";\t\r\n\t\thighOption.series[1].data=citeCnt;\r\n\t\thighOption.legend.align='center';\r\n\t\thighChart = new Highcharts.Chart(highOption);\r\n\t\t\r\n\t\t$(\"#artiTotal-\"+index).html(\"총 <b class=\\\"colorBlue\\\">\"+dataComma(artiTotal)+\"</b>건\");\r\n\t\t\r\n\r\n\t\tdate   = [];\r\n\t\tartiCnt1 = [];\r\n\t\tciteCnt = [];\r\n\t\tartiTotal = 0;\r\n\t\tfor(i=0; i<length; i++){\r\n\t\tdate.push(json.list[i][\"YEAR\"]+str_year);\r\n\t\tartiCnt1.push(json.list[i][\"YEARARTICNT\"]);\r\n\t\tciteCnt.push(json.list[i][\"YEARARTIIF\"]);\r\n\t\tartiTotal += json.list[i][\"YEARARTICNT\"];\r\n\t\t}\r\n\t\tvar chartWidth = length*70;\r\n\t\tif(chartWidth < 900) chartWidth = 900;\r\n\t\thighOption.chart.width=chartWidth;\r\n\t\thighOption.chart.height=400;\r\n\t\thighOption.xAxis.categories = date;\r\n\t\thighOption.series[0].data=artiCnt1;\r\n\t\thighOption.series[1].data=citeCnt;\r\n\t\thighOption.chart.renderTo='artiCntListAllResult-' + index;\r\n\t\thighOption.legend.align='right';\r\n\t\thighChart = new Highcharts.Chart(highOption);\r\n\t\t\r\n\t\t$(\"#artiAllTotal-\"+index).html(\"총 <b class=\\\"colorBlue\\\">\"+dataComma(artiTotal)+\"</b>건\"); \r\n\t\t}else{\r\n\t\t$(\"#artiTotal-\"+index).html(\"총 <b class=\\\"colorBlue\\\">0</b>건\");\r\n\t\t$(\"#artiCntListResult-\"+index).html(\"\"); \r\n\t\t}\r\n\t}\r\n\r\n\t/* 논문 목록수 차트 */\r\n\tvar colors = Highcharts.getOptions().colors;\r\n\t\t\r\n\t\thighOption ={\r\n\t\t        chart: {\r\n\t\t            renderTo: '',\r\n\t\t            type: '',\r\n\t\t            width: 0,\r\n\t\t            height: 300,\r\n\t\t            marginTop : 20,\r\n\t                marginBottom : 85,\r\n\t                marginLeft : 50,\r\n\t                marginRight : 50\r\n\t\t        },\r\n\t\t        credits:{\r\n\t\t        \tenabled:false\r\n\t\t        },\r\n\t\t       title: {\r\n\t\t            text: ' '\r\n\t\t        },\r\n\t\t        legend: {\r\n\t\t            enabled: true\r\n\t\t        },\r\n\t\t        xAxis: {\r\n\t\t            categories: [],\r\n\t\t            title:{\r\n\t\t            \tenabled: false,\r\n\t\t            \ttext:'년도'\r\n\t\t            }\r\n\t\t        },\r\n\t\t        yAxis: [{ // Primary yAxis\r\n\t                min : 0,\r\n\t                labels: {\r\n\t                    style: {\r\n\t                        color: colors[1]\r\n\t                    }\r\n\t                },\r\n\t                title: {\r\n\t                    text: \"KCI IF\",\r\n\t                    align: 'high',\r\n\t                    offset: 10,\r\n\t                    rotation: 0,\r\n\t                    y:-10,\r\n\t                    min : 0,\r\n\t                    style: {\r\n\t                        color: colors[1]\r\n\t                    }\r\n\t                }\r\n\t            }, { // Secondary yAxis\r\n\t                title: {\r\n\t                    text: \"논문 수\",\r\n\t                    align: 'high',\r\n\t                    offset: 40,\r\n\t                    rotation: 0,\r\n//\t                     x:-40,\r\n\t                    y:-10,\r\n\t                    style: {\r\n\t                        color: colors[0]\r\n\t                    }\r\n\t                },\r\n\t                labels: {\r\n\t                    min : 0,\r\n\t                    style: {\r\n\t                        color: colors[0]\r\n\t      